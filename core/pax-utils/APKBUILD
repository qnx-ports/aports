# Maintainer: Terence Ang <taang@qnx.com>
pkgname=pax-utils
pkgver=1.3.8
pkgrel=2
pkgdesc="ELF utils that can check files for security relevant properties"
url="https://wiki.gentoo.org/wiki/Hardened/PaX_Utilities"
arch="all"
makedepends="meson ninja"
checkdepends="python3-elftools"
license="GPL-2.0-only"
subpackages="$pkgname-doc"
source="https://dev.gentoo.org/~sam/distfiles/app-misc/pax-utils/pax-utils-$pkgver.tar.xz
    fix-qnx.patch
    fix-recursive.patch
"

build() {
    abuild-meson . build \
          -Dc_link_args="-lregex" \
          -Dlddtree_implementation=sh \
          -Duse_fuzzing=false \
          -Duse_seccomp=false \
          -Duse_libcap=disabled
    meson compile -C build
}

check() {
    meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}


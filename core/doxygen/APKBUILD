# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Contributor: Arthur Clark <mydevstuff@mail.com>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=doxygen
pkgver=1.17.0
pkgrel=0
pkgdesc="Documentation system for C++, C, Java, IDL and PHP"
url="https://www.doxygen.nl/"
arch="all"
license="GPL-2.0-or-later"
depends="libc++ libiconv sqlite-libs"
checkdepends="libxml2-utils"
makedepends="flex bison perl python3 cmake ninja sqlite-dev libc++-dev libiconv-dev"
subpackages="$pkgname-doc"
source="https://doxygen.nl/files/doxygen-$pkgver.src.tar.gz
        fix-tagfile-test.patch"

build() {
        # use_sys_sqlite3=ON is QNX-specific. The bundled sqlite3 takes a
        # QNX code path (#ifndef __QNXNTO__) that includes sys/dcmd_blk.h,
        # which is not present on QNX 8. Link the system sqlite instead.
        cmake -B build -G Ninja \
                -DGIT_EXECUTABLE=/bin/false \
                -DCMAKE_INSTALL_PREFIX=/usr \
                -DCMAKE_BUILD_TYPE=MinSizeRel \
                -Duse_sys_sqlite3=ON
        cmake --build build
}

check() {
        # Remove test that use bibtex
        rm -f ./testing/012_cite.dox
        ctest --test-dir build
}

package() {
        DESTDIR="$pkgdir" cmake --install build
}


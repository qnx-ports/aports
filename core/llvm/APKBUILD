# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=llvm
pkgver=21.1.3
pkgrel=6
_git_rev=3
pkgdesc="Low Level Virtual Machine compiler system."
arch="all"
url="https://llvm.org/"
license="Apache-2.0"
depends="
    qnx-io-sock
    qnx-gcc
    binutils
    libffi
    zlib
    zstd
    libxml2
    lz4-libs
    libcurl
    "
makedepends="
    python3
    sed
    cmake
    ninja
    perl
    qnx-io-sock-dev
    libffi-dev
    zlib-dev
    zstd-dev
    libxml2-dev
    lz4-dev
    curl-dev
    liblocale-shim-dev
    "
source="https://github.com/qnx-ports/llvm-project/archive/refs/tags/qnx-$pkgver-r$_git_rev.tar.gz
        libcxx.clang.cfg
        llvm.clang.cfg
        csetjmp.patch"
options="!check" # takes too long
subpackages="libc++:_libcxx
            libc++-dev:_libcxx_dev
            clang:_clang
            clang-dev:_clang_dev
            clang-libs:_clang_libs
            mlir:_mlir
            mlir-dev:_mlir_dev
            mlir-libs:_mlir_libs
            flang:_flang
            flang-dev:_flang_dev
            polly-dev:_polly_dev
            openmp:_omp
            openmp-dev:_omp_dev
            $pkgname-tools:_tools
            $pkgname-libs:_libs
            $pkgname-dev
            $pkgname-doc:_doc
            "
builddir="$srcdir/llvm-project-qnx-$pkgver-r$_git_rev"

build() {
    if [[ $CARCH == "x86_64" ]]; then
        _llvm_triplet="x86_64-pc-qnx"
    elif [[ $CARCH == "aarch64" ]]; then
        _llvm_triplet="aarch64-unknown-qnx"
    else
        die "$CARCH not supported"
    fi

    msg "Building llvm ($_llvm_triplet)"

    _cc=clang
    _cxx=clang++

    _shared_args="-DCMAKE_BUILD_TYPE=Release \
                  -DCMAKE_INSTALL_DOCDIR=share/doc \
                  -DCMAKE_INSTALL_LIBEXECDIR=bin \
                  -DLLVM_HOST_TRIPLE="$_llvm_triplet" \
                  -DLLVM_DEFAULT_TARGET_TRIPLE="$_llvm_triplet" \
                  -DLLVM_APPEND_VC_REV=OFF \
                  -DLLVM_BUILD_DOCS=OFF \
                  -DLLVM_BUILD_EXAMPLES=OFF \
                  -DLLVM_BUILD_TESTS=OFF \
                  \
                  -DLLVM_ENABLE_EH=OFF \
                  -DLLVM_ENABLE_ASSERTIONS=OFF \
                  -DLLVM_ENABLE_FFI=FORCE_ON \
                  -DLLVM_ENABLE_CURL=FORCE_ON \
                  -DLLVM_ENABLE_LIBEDIT=OFF \
                  -DLLVM_ENABLE_PIC=ON \
                  -DLLVM_ENABLE_RTTI=ON \
                  -DLLVM_ENABLE_ZLIB=FORCE_ON \
                  -DLLVM_ENABLE_ZSTD=FORCE_ON
                 "

    # build the bootstrapping toolchain
    _bootstrap_flags=""

    CC="$_cc" CXX="$_cxx" \
    cmake -B build-bootstrap -S llvm -G Ninja \
    -DCMAKE_CXX_FLAGS="$_bootstrap_flags" \
    -DCMAKE_EXE_LINKER_FLAGS="-lsocket" \
    -DCMAKE_SHARED_LINKER_FLAGS="-lsocket" \
    -DLLVM_BUILD_LLVM_DYLIB=OFF \
    -DLLVM_LINK_LLVM_DYLIB=OFF \
    -DCLANG_LINK_CLANG_DYLIB=OFF \
    -DCLANG_PLUGIN_SUPPORT=ON \
    -DLLVM_ENABLE_PROJECTS="clang" \
    -DLLVM_TARGETS_TO_BUILD="X86;AArch64" \
    $_shared_args

    ninja -C build-bootstrap

    # critical runtimes
    _critical_runtimes="libcxx;libcxxabi"

    CC=$PWD/build-bootstrap/bin/clang \
    CXX=$PWD/build-bootstrap/bin/clang++ \
    cmake -B build-dist-runtimes -G Ninja -S runtimes \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLLVM_HOST_TRIPLE="$_llvm_triplet" \
    -DLLVM_DEFAULT_TARGET_TRIPLE="$_llvm_triplet" \
    -DLLVM_ENABLE_RUNTIMES="$_critical_runtimes" \
    \
    -DLIBCXXABI_USE_LLVM_UNWINDER=OFF

    # configs for critical runtimes
    cp $srcdir/libcxx.clang.cfg $PWD/build-bootstrap/bin/clang.cfg || true
    cp $srcdir/libcxx.clang.cfg $PWD/build-bootstrap/bin/clang++.cfg || true
    ninja -C build-dist-runtimes

    # LLVM
    _runtimes="compiler-rt;flang-rt;openmp"
    _projects="clang;polly;mlir;flang;clang-tools-extra"
    _rt_realpath=$(realpath build-dist-runtimes)

    sed "s|DIST_RT|$_rt_realpath|g" $srcdir/llvm.clang.cfg > $PWD/build-bootstrap/bin/clang.cfg
    sed "s|DIST_RT|$_rt_realpath|g" $srcdir/llvm.clang.cfg > $PWD/build-bootstrap/bin/clang++.cfg

    CC=$PWD/build-bootstrap/bin/clang \
    CXX=$PWD/build-bootstrap/bin/clang++ \
    LD_LIBRARY_PATH="$_rt_realpath/lib:$LD_LIBRARY_PATH" \
    cmake -B build-dist-llvm -S llvm -G Ninja \
    $_shared_args \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLLVM_BUILD_LLVM_DYLIB=ON \
    -DLLVM_LINK_LLVM_DYLIB=ON \
    -DLLVM_INSTALL_UTILS=ON \
    -DLLVM_INSTALL_GTEST=ON \
    -DLLVM_ENABLE_PROJECTS="$_projects" \
    -DLLVM_ENABLE_RUNTIMES="$_runtimes" \
    \
    -DCOMPILER_RT_INCLUDE_TESTS=OFF \
    -DCOMPILER_RT_BUILD_SANITIZERS=OFF \
    -DCOMPILER_RT_BUILD_GWP_ASAN=OFF \
    -DCOMPILER_RT_BUILD_BUILTINS=OFF \
    -DCOMPILER_RT_USE_BUILTINS_LIBRARY=OFF \
    -DCOMPILER_RT_BUILD_PROFILE=ON \
    -DCOMPILER_RT_USE_LIBCXX=ON \
    -DSANITIZER_CXX_ABI=libc++ \
    \
    -DCLANG_VENDOR=QNX \
    -DLIBCLANG_BUILD_STATIC=ON \
    -DCLANG_LINK_CLANG_DYLIB=ON \
    -DCLANG_PLUGIN_SUPPORT=ON \
    -DCLANG_INCLUDE_TESTS=OFF \
    \
    -DMLIR_BUILD_MLIR_C_DYLIB=ON \
    -DMLIR_LINK_MLIR_DYLIB=ON \
    \
    -DFLANG_VENDOR=QNX \
    -DFLANG_INCLUDE_TESTS=OFF \
    \
    -DLIBOMP_LIBFLAGS="-lcatalog" \
    -DLIBOMP_ENABLE_SHARED=ON

    # config files for LLVM
    mkdir -p $PWD/build-dist-llvm/bin/
    sed "s|DIST_RT|$_rt_realpath|g" $srcdir/llvm.clang.cfg > $PWD/build-dist-llvm/bin/clang.cfg
    sed "s|DIST_RT|$_rt_realpath|g" $srcdir/llvm.clang.cfg > $PWD/build-dist-llvm/bin/clang++.cfg

    LD_LIBRARY_PATH="$_rt_realpath/lib:$LD_LIBRARY_PATH" \
    ninja -C build-dist-llvm
}

package() {
    depends="$pkgname-libs=$pkgver-r$pkgrel"

    # install LLVM
    _rt_realpath=$(realpath build-dist-runtimes)
    LD_LIBRARY_PATH="$_rt_realpath/lib:$LD_LIBRARY_PATH" \
    DESTDIR="$pkgdir" ninja -C build-dist-llvm install
}

_libcxx() {
    depends=""

    # install critical runtimes
    DESTDIR="$subpkgdir" ninja -C $builddir/build-dist-runtimes install
}

_libcxx_dev() {
    depends="!qnx-libc++-dev liblocale-shim-dev"

    mkdir -p "$subpkgdir"/usr/lib
    mv "$pkgdir"/../libc++/usr/include "$subpkgdir"/usr
    mv "$pkgdir"/../libc++/usr/share  "$subpkgdir"/usr
    mv "$pkgdir"/../libc++/usr/lib/*.a "$subpkgdir"/usr/lib
    mv "$pkgdir"/../libc++/usr/lib/*.so "$subpkgdir"/usr/lib
    mv "$pkgdir"/../libc++/usr/lib/*.json "$subpkgdir"/usr/lib
}

_clang() {
    depends="llvm-libs=$pkgver-r$pkgrel clang-libs=$pkgver-r$pkgrel openmp libc++"

    # /usr/bin
    amove usr/bin/amdgpu-arch
    amove usr/bin/analyze-build
    amove usr/bin/c-index-test
    amove usr/bin/clang*
    amove usr/bin/diagtool
    amove usr/bin/hmaptool
    amove usr/bin/intercept-build
    amove usr/bin/nvptx-arch
    amove usr/bin/analyze-c*
    amove usr/bin/intercept-c*
    amove usr/bin/c*-analyzer
    amove usr/bin/scan-build*
    amove usr/bin/scan-view*
    amove usr/bin/git-clang-format

    # extra tools in /usr/bin
    amove usr/bin/find-all-symbols
    amove usr/bin/modularize
    amove usr/bin/pp-trace
    amove usr/bin/run-clang-tidy

    # /usr/lib
    amove usr/lib/clang
    amove usr/lib/libear

    # /usr/share
    amove usr/share/clang

    # TODO: these should be python packages
    amove usr/share/scan-view
    amove usr/share/scan-build

    cat > "$subpkgdir"/usr/bin/c89 <<'EOF'
#!/bin/sh
_flavor="-std=c89"
for opt; do
	case "$opt" in
	-ansi|-std=c89|-std=iso9899:1990) _flavor="";;
	-std=*) echo "$(basename $0) called with non ANSI/ISO C option $opt" >&2
		exit 1;;
	esac
done
exec clang -Qunused-arguments $_flavor ${1+"$@"}
EOF

    cat > "$subpkgdir"/usr/bin/c99 <<'EOF'
#!/bin/sh
_flavor="-std=c99"
for opt; do
	case "$opt" in
	-std=c99|-std=iso9899:1999) _flavor="";;
	-std=*) echo "$(basename $0) called with non ISO C99 option $opt" >&2
		exit 1;;
	esac
done
exec clang -Qunused-arguments $_flavor ${1+"$@"}
EOF

    cat > "$subpkgdir"/usr/bin/gcc <<'EOF'
#!/bin/sh
exec clang -Qunused-arguments ${1+"$@"}
EOF

    cat > "$subpkgdir"/usr/bin/g++ <<'EOF'
#!/bin/sh
exec clang++ -Qunused-arguments ${1+"$@"}
EOF

    ln -s clang "$subpkgdir"/usr/bin/cc
    ln -s clang++ "$subpkgdir"/usr/bin/c++
    chmod 0755 "$subpkgdir"/usr/bin/c89
    chmod 0755 "$subpkgdir"/usr/bin/c99
    chmod 0755 "$subpkgdir"/usr/bin/gcc
    chmod 0755 "$subpkgdir"/usr/bin/g++
}

_clang_dev() {
    depends="llvm-dev=$pkgver-r$pkgrel clang-libs=$pkgver-r$pkgrel"

    # /usr/include
    amove usr/include/clang
    amove usr/include/clang-c
    amove usr/include/clang-tidy

    # /usr/lib
    amove usr/lib/cmake/clang
    amove usr/lib/libclang*.a
    amove usr/lib/libclang*.so
    amove usr/lib/libfindAllSymbols.a
}

_clang_libs() {
    depends="llvm-libs=$pkgver-r$pkgrel"

    # /usr/lib
    amove usr/lib/libclang*.so.*
    amove usr/lib/libscanbuild
}


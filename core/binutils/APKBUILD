# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=binutils
pkgver=2.43
pkgrel=0
pkgdesc="Tools necessary to build programs"
url="https://www.gnu.org/software/binutils/"
depends="zlib-ng zstd-libs jansson"
makedepends_build="bison flex texinfo zstd-dev jansson-dev"
makedepends_host="zlib-ng-dev"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.1-or-later AND BSD-3-Clause"
subpackages="$pkgname-dev $pkgname-doc"
source="https://mirror.csclub.uwaterloo.ca/gnu/binutils/binutils-$pkgver.tar.xz
        0001.patch
	0002.patch
	0003.patch
	0004.patch
	0005.patch
	0006.patch
	0007.patch
	0008.patch
	0009.patch
	0010.patch
	"
#TODO: id like to enable tests until we get it upstreamed
options="!check"
builddir="$srcdir/$pkgname-$pkgver"


build() {
    local _arch_configure=""

    if [[ "$CARCH" == "aarch64" ]]; then
        _arch_configure="--enable-fix-cortex-a53-843419 --enable-fix-cortex-a53-835769"
    fi
    # For some reason on arm the -fPIC is not passed to libtool with --with-pic so we just
    # force it here in CFLAGS/CXXFLAGS
    CFLAGS="${CFLAGS} -fPIC -O2 -D__QNXTARGET__ -Qunused-arguments" \
    CXXFLAGS="${CXXFLAGS}-fPIC  -O2 -D__QNXTARGET__ -Qunused-arguments" \
    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --sysconfdir=/etc \
        --with-lib-path=/usr/lib:/usr/local/lib \
        --with-bugurl=https://github.com/qnx-ports/aports/issues \
        --enable-plugins \
        --disable-gdb \
        --disable-gdbserver \
        --disable-gprofng \
        --disable-multilib \
        --disable-nls \
        --disable-werror \
        --enable-64-bit-bfd \
        --enable-colored-disassembly \
        --enable-default-execstack=no \
        --enable-default-hash-style=gnu \
        --enable-deterministic-archives \
        --enable-ld=default \
        --enable-new-dtags \
        --enable-relro \
        --enable-threads \
        --enable-shared \
        --enable-install-libiberty \
        --with-mmap \
        --with-pic \
        --with-system-zlib \
        --with-zstd \
        --enable-jansson \
	$_arch_configure

    make
}


package() {
	make tooldir="/usr" install DESTDIR="$pkgdir"
}



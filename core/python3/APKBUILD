# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=python3
pkgver=3.14.0
_basever=${pkgver%.*}
pkgrel=5
pkgdesc="High-level scripting language"
url="https://www.python.org/"
arch="all"
depends="sqlite sqlite-libs zlib-ng xz-libs readline libffi expat bzip2 lz4 libssl3 libcrypto3 ncurses qnx-io-sock qnx-fd-notify"
depends_dev="$pkgname=$pkgver-r$pkgrel sqlite-dev zlib-ng-dev xz-dev readline-dev libffi-dev expat-dev bzip2-dev lz4-dev openssl-dev ncurses-dev qnx-crypto-dev qnx-io-sock-dev qnx-fd-notify-dev"
makedepends="$depends_dev make pkgconf pkgconf-dev"
license="PSF-2.0"
provides="python"
subpackages="$pkgname-doc $pkgname-dev $pkgname-tests::noarch"
source="https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz
fix-qnx-python.patch
fix-locale.patch
EXTERNALLY-MANAGED
"
builddir="$srcdir/Python-$pkgver"

build() {
    if [[ $CBUILD = $CHOST ]]; then
        # Compile natively
        echo "No additional arguments are required"
    else
        # Cross compiling
        echo "This is can not be cross-compiled"
        exit 1;
    fi

    # Searches for timerfd_gettime() which we don't support.
    ./configure \
        ac_cv_header_sys_timerfd_h=no \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --enable-loadable-sqlite-extensions \
        --without-ensurepip \
        --with-system-expat \
        --enable-shared \
        CFLAGS="-D_QNX_SOURCE -O2 -fPIC -DTHREAD_STACK_SIZE=8388608" \
        LDFLAGS="-lsocket -lm -lgcc_s -lregex -lepoll -leventfd"

    make
}

package() {
    make DESTDIR="$pkgdir" install 
    msg "Python basever $_basever"
    ln -s python3 "$pkgdir"/usr/bin/python
    install -Dm644 "$srcdir"/EXTERNALLY-MANAGED \
        "$pkgdir"/usr/lib/python$_basever/EXTERNALLY-MANAGED
}

tests() {
    pkgdesc="The test modules from the main python package"

    amove usr/lib/python$_basever/test
}


# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=openrc
pkgver=0.63.1_p2
pkgrel=0
pkgdesc="OpenRC manages the services, startup and shutdown of a host"
url="https://github.com/OpenRC/openrc"
vcs_url="$url"
arch="all"
license="BSD-3-Clause"
depends="qnx-security qnx-memstream qnx-io-sock "
depends_dev="qnx-security-dev qnx-memstream-dev qnx-io-sock-dev ncurses-dev"
makedepends="meson ninja scdoc $depends_dev"
subpackages="$pkgname-dev $pkgname-doc $pkgname-bash-completion $pkgname-zsh-completion"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/openrc/archive/refs/tags/qnx-$pkgver.tar.gz
"
builddir="$srcdir/$pkgname-qnx-$pkgver"

build() {
    LDFLAGS="-lmemstream -lsocket" \
    abuild-meson . build
    meson compile -C build
}

check() {
	# QNX does not support $ORIGIN in rpath have to do it ourselves
	LD_LIBRARY_PATH="$(realpath build/src/librc):$(realpath build/src/libeinfo):$LD_LIBRARY_PATH" \
	meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

sha512sums="
7081ac8f9161606cdfd2cf4f8a5bcaf29550f7f0b1e8d22830a946ca367d4152df34272baefdb4cf9317171e2e77daf3ca25aa9b99a71037710777fcdecb6367  openrc-0.63.1_p2.tar.gz
"

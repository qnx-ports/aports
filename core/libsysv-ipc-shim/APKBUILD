# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=libsysv-ipc-shim
pkgver=0.1.0
pkgrel=2
pkgdesc="QNX ipc.h shim"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!check"
makedepends="clang"
subpackages="$pkgname-dev"
source="$pkgname-v$pkgver.tar.gz::https://github.com/qnx-ports/libsysv-ipc-shim/archive/refs/tags/v$pkgver.tar.gz
    "

build() {
    CC=clang ./build.sh
}

package() {
    mkdir -p "$pkgdir"/usr/include/shims
    mkdir -p "$pkgdir"/usr/lib

    cd $builddir
    cp -r include/sys "$pkgdir"/usr/include/shims
    cp -r libsysv-ipc.so "$pkgdir"/usr/lib
}

dev() {
    default_dev
    depends="$pkgname=$pkgver-r$pkgrel"
}

sha512sums="
3c36b3af4a33586a95f7e77051a3dc82522102976fcfa5ede278db35de8b7966828b6bd2bc0e205d764c720a9e33f4ed784c516cd308aafcbdf8514e9c94501d  libsysv-ipc-shim-v0.1.0.tar.gz
"

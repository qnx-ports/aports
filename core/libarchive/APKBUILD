pkgname=libarchive
pkgver=3.8.9
pkgrel=0
pkgdesc="Multi-format archive and compression library"
url="https://libarchive.org/"
arch="all"
license="BSD-2-Clause AND BSD-3-Clause AND LicenseRef-scancode-public-domain"
options="!check"
depends="libbz2 libcrypto3 lz4-libs xz-libs zlib-ng zstd-libs"
makedepends="bzip2-dev lz4-dev openssl-dev xz-dev zlib-ng-dev zstd-dev"
depends_dev=${makedepends}
subpackages="${pkgname}-dev ${pkgname}-doc ${pkgname}-tools"
source="https://libarchive.org/downloads/libarchive-${pkgver}.tar.xz"
builddir=${srcdir}/libarchive-${pkgver}

build() {
    CFLAGS="$CFLAGS -ffat-lto-objects -flto=auto" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --without-xml2
    make
}

package() {
    make DESTDIR=${pkgdir} install
}

tools() {
    pkgdesc="libarchive tools bsdtar and bsdcpio"   
    depends="$pkgname=$pkgver-r$pkgrel"
    amove usr/bin
}


sha512sums="

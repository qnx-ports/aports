# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=libxml2.13
pkgver=2.13.9
pkgrel=0
pkgdesc="XML parsing library, version 2.13"
url="https://gitlab.gnome.org/GNOME/libxml2"
arch="all"
license="MIT"
depends="zlib-ng xz-libs qnx-io-sock"
makedepends="zlib-ng-dev xz-dev qnx-io-sock-dev"
checkdepends="perl tar"
depends_dev="$makedepends !libxml2-dev"
subpackages="$pkgname-static $pkgname-dev"
source="https://download.gnome.org/sources/libxml2/${pkgver%.*}/libxml2-$pkgver.tar.xz
	CVE-2026-6732.patch
	CVE-2026-6732-test.patch
"
replaces="libxml2~2.13"
builddir="$srcdir/libxml2-$pkgver"

prepare() {
    default_prepare

    # We don't build libxml2 with icu.
    rm test/icu_parse_test.xml
}

build() {
    msg "$_python_path"
    CFLAGS="$CFLAGS -Wl,-z,stack-size=8388608" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --enable-static \
        --with-legacy \
        --with-lzma \
        --with-zlib \
	--with-python=no

    make
}

check() {
	rm -f test/ebcdic_566012.xml
	LD_LIBRARY_PATH="$(realpath $builddir/.libs):$LD_LIBRARY_PATH" make runtests
}


package() {
    make -j1 DESTDIR="$pkgdir" install

    # we dont need docs
    rm -rf "$pkgdir"/usr/share
    rm -rf "$pkgdir"/usr/bin
}



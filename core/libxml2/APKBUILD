pkgname=libxml2
pkgver=2.15.3
pkgrel=0
pkgdesc="XML parsing library, version 2"
url="https://gitlab.gnome.org/GNOME/libxml2"
arch="all"
license="MIT"
options="!check !tracedeps"
depends="zlib-ng xz-libs qnx-io-sock libiconv"
depends_dev="zlib-ng-dev xz-dev qnx-io-sock-dev"
makedepends="$depends_dev doxygen libiconv-dev docbook-xsl autoconf libtool automake"
subpackages="$pkgname-doc $pkgname-static $pkgname-dev $pkgname-utils"
source="https://download.gnome.org/sources/libxml2/${pkgver%.*}/libxml2-$pkgver.tar.xz"
if  [  -z "$BOOTSTRAP" ]; then
        makedepends="$makedepends python3-dev"
        subpackages="$subpackages python3-$pkgname:_python3"
        _python_configure="--with-python=yes"
        _python_path="$(realpath /usr/bin/python3)"
else
        _python_configure="--with-python=no"
        _python_path=""
fi

prepare() {
    default_prepare
    # libxml2 comes with libtool from 2019 which is missing a patch for qnx soname math
    # https://github.com/autotools-mirror/libtool/commit/a956f5ce7d98d77401c65c496262479ea5fcdfad
    autoreconf -fiv
}

build() {
    msg "$_python_path"
    PYTHON="$_python_path" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --enable-static \
        --with-legacy \
        --with-lzma \
        --with-zlib \
        --with-docs \
        $_python_configure
    make
}

check() {
        rm -f test/ebcdic_566012.xml
        make runtests
}


package() {
    make -j1 DESTDIR="$pkgdir" install
}

_python3() {
        depends="python3 $pkgname=$pkgver-r$pkgrel"
        pkgdesc="$pkgname python3 bindings"

        amove usr/lib/python3*
}


utils() {
    pkgdesc="XML utilities"
    depends="$pkgname=$pkgver-r$pkgrel"
    replaces="libxml2"

    amove usr/bin
}

sha512sums="
6f7f1aabd012454553e851bd1ee548fbd14d21c576f2b2ab9eeedab3dfba51392083f74b34f060e9b538baeea212cdb462b8669c214c711771fb9a897fdc1c60  libxml2-2.15.3.tar.xz
"

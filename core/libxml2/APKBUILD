# Maintainer: Terence Ang <taang@qnx.com>
pkgname=libxml2
pkgver=2.14.0
pkgrel=0
pkgdesc="XML parsing library, version 2"
url="https://gitlab.gnome.org/GNOME/libxml2"
arch="all"
license="MIT"
options="!check !tracedeps"
depends="zlib-ng xz-libs qnx-io-sock"
makedepends="zlib-ng-dev xz-dev qnx-io-sock-dev libiconv-dev"
# This builds libxml2.so.16, some components require libxml2.so.15 (2.13.9), thus headers would not be included.
# $pkgname-dev will be added back once the conflict is resolved.
# libxml2-dev-2.13.9-r3 would be the latest one
subpackages="$pkgname-doc $pkgname-static $pkgname-utils"
source="https://download.gnome.org/sources/libxml2/${pkgver%.*}/libxml2-$pkgver.tar.xz"
if  [  -z "$BOOTSTRAP" ]; then
	makedepends="$makedepends python3-dev"
	subpackages="$subpackages python3-$pkgname:_python3"
	_python_configure="--with-python=yes"
	_python_path="$(realpath /usr/bin/python3)"
else
	_python_configure="--with-python=no"
	_python_path=""
fi


build() {
    msg "$_python_path"
    PYTHON="$_python_path" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --enable-static \
        --with-legacy \
        --with-lzma \
        --with-zlib \
        $_python_configure
    make
}

check() {
	rm -f test/ebcdic_566012.xml
	make runtests
}


package() {
    make -j1 DESTDIR="$pkgdir" install

    # This avoids the inclusion of .h, .pc and .cmake files, and .so Symlinks
    # When conflicts of libxml2.so.15 (2.13.9) and libxml2.so.16 (2.14.0) are resolved, this can be removed.
    find "$pkgdir" -type f -name '*.h' -delete
    find "$pkgdir" -type f -name '*.pc' -delete
    find "$pkgdir" -type f -name '*.cmake' -delete
    find "$pkgdir" -type l -name '*.so' -delete
    find "$pkgdir"  -type d -empty -delete

}

_python3() {
	depends="python3"
	pkgdesc="$pkgname python3 bindings"

	amove usr/lib/python3*
}


utils() {
    pkgdesc="XML utilities"
    replaces="libxml2"

    amove usr/bin
}

sha512sums="

c72a580b4a7dfc2399f50ae8c2a65fe69905097357fabd88c666ba1189e3554ffc09dad1f1bda2e04073ba39ae7006fd18b12e8daa6972aca9346749c46ca7a4  qnx-broken-force.patch
"

# This can only be compiled natively on QNX
pkgname=libtool
pkgver=2.5.4
pkgrel=3
pkgdesc="A generic library support script"
url="https://www.gnu.org/software/libtool"
arch="all"
depends="perl libltdl"
makedepends="m4 help2man"
license="LGPL-2.0-or-later AND GPL-2.0-or-later"
subpackages="libltdl-static libltdl $pkgname-doc"
source="https://mirror.csclub.uwaterloo.ca/gnu/libtool/libtool-$pkgver.tar.gz
    qnx-broken-force.patch"
#source="https://ftp.gnu.org/gnu/libtool/libtool-$pkgver.tar.gz"
builddir="${srcdir}/libtool-${pkgver}"

build() {
    if [[ $CBUILD = $CHOST ]]; then
        # Compile natively
        echo "No additional arguments are required"
    else
        # Cross compiling
        echo "This can not be cross-compiled"
        exit 1;
    fi

   CHOST="$CHOST" \
   ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        CFLAGS="$CFLAGS -D_QNX_SOURCE -Qunused-arguments" \
        LDFLAGS="-lm -lregex -lgcc_s"

    make
}

package() {
    make DESTDIR="$pkgdir/" install
}

libltdl() {
	pkgdesc="Runtime libraries for GNU Libtool Dynamic Module Loader"
	depends=
	amove usr/lib/libltdl.so*
}



# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=filesystem
pkgver=1
pkgrel=4
pkgdesc="Base file system layout and files"
arch="noarch"
license="LicenseRef-QDL-Non-Commercial"
url="https://www.qnx.com"
# We are using debian's netbase for IANA databases
_nbver=6.5
source="protocols-$_nbver::https://salsa.debian.org/md/netbase/-/raw/v$_nbver/etc/protocols
    services-$_nbver::https://salsa.debian.org/md/netbase/-/raw/v$_nbver/etc/services
	nsswitch.conf
	passwd
	group
	hosts
"
options="!fhs !check"
builddir="$srcdir"

build() {
    # generate shadow
	awk -F: '{
		pw = ":!:"
		if ($1 == "root") { pw = "::" }
		print($1 pw ":0:::::")
	}' "$srcdir"/passwd > shadow
}

package() {
    mkdir -p "$pkgdir"
	cd "$pkgdir"
	install -m 0755 -d \
		dev \
		etc \
		etc/profile.d \
		mnt \
		run \
		usr usr/bin usr/lib usr/share usr/share/man \
		usr/local usr/local/bin usr/local/lib \
		var var/cache var/lib var/log
	install -d -m 1777 "$pkgdir"/var/tmp
    # Compatibility symlinks
    ln -sv usr/bin bin
    ln -sv usr/lib lib
    ln -sv /run var/run
	# Base files
	install -vm 0644 "$srcdir"/protocols-$_nbver "$pkgdir"/etc/protocols
	install -vm 0644 "$srcdir"/services-$_nbver "$pkgdir"/etc/services
	install -vm 0644 "$srcdir"/nsswitch.conf "$pkgdir"/etc/
	install -vm 0644 "$srcdir"/{passwd,group} "$pkgdir"/etc/
	install -vm 0600 "$srcdir"/shadow "$pkgdir"/etc/
	install -vm 0644 "$srcdir"/hosts "$pkgdir"/etc/
}


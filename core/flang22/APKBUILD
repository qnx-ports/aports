# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=flang22
_patch_rev=1
pkgver=22.1.4_p$_patch_rev
pkgrel=1
pkgdesc="Fortran language front-end for LLVM"
arch="all"
url="https://llvm.org"
vcs_url="https://github.com/qnx-ports/llvm-project"
license="Apache-2.0 WITH LLVM-exception"
options="!check" # fail to build
_lib_depends="llvm22-dev mlir22-dev clang22-dev"
depends="llvm22-libs clang22 libc++ libunwind binutils mlir22"
depends_dev="$pkgname=$pkgver-r$pkgrel $_lib_depends"
makedepends="cmake ninja $_lib_depends clang22-static clang22-extra-tools mlir22-static python3-dev"
source="
    https://github.com/qnx-ports/llvm-project/archive/refs/tags/qnx-${pkgver}.tar.gz"
builddir="$srcdir/llvm-project-qnx-${pkgver}"
_llvmver=${pkgver%%.*}

build() {
    CFLAGS="-fPIE" CXXFLAGS="-fPIE" LDFLAGS="-lsocket" \
    cmake -B build -S flang -G Ninja -Wno-dev \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/lib/llvm$_llvmver \
        -DCMAKE_INSTALL_RPATH=/usr/lib/llvm$_llvmver/lib \
        -DCMAKE_MODULE_PATH=$builddir/cmake/Modules \
        -DLLVM_CONFIG=/usr/lib/llvm$_llvmver/bin/llvm-config \
        -DLLVM_ENABLE_RUNTIMES="openmp" \
        -DCMAKE_POSITION_INDEPENDENT_CODE=TRUE \
        \
        -DFLANG_INCLUDE_TESTS=OFF \
        -DFLANG_VENDOR=QNX \
        -DENABLE_LINKER_BUILD_ID=ON \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_MAIN_SRC_DIR=$builddir/llvm
    ninja -C build

    # Runtime as well
    cmake -B build-rt -S runtimes -G Ninja -Wno-dev \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/lib/llvm$_llvmver \
        -DCMAKE_INSTALL_RPATH=/usr/lib/llvm$_llvmver/lib \
        -DCMAKE_MODULE_PATH=$builddir/cmake/Modules \
        -DLLVM_CONFIG=/usr/lib/llvm$_llvmver/bin/llvm-config \
        -DLLVM_ENABLE_RUNTIMES="flang-rt" \
        -DCMAKE_POSITION_INDEPENDENT_CODE=TRUE \
        \
        -DCMAKE_Fortran_COMPILER="$builddir"/build/bin/flang \
        -DCMAKE_Fortran_COMPILER_WORKS=yes \
        -DCMAKE_Fortran_FLAGS="" \
        -DFLANG_RT_INCLUDE_TESTS=OFF
    ninja -C build-rt
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    DESTDIR="$pkgdir" cmake --install build-rt
}

sha512sums="
70390f6c3d69066ccee0a887b76c5db6cbfa60b0ba1ae4e40d9762f5fb3420f5219ef08c8a656644ff29cb57d1d2642572b5f3f76a6d8106f35c23582e9110e1  qnx-22.1.4_p1.tar.gz
"

# Alpine-Contributor: Carlo Landmeter <clandmeter@alpinelinux.org>
# Apline-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=libunistring
pkgver=1.3
pkgrel=1
pkgdesc="Library for manipulating Unicode strings and C strings"
url="https://www.gnu.org/software/libunistring/"
arch="all"
depends="qnx-io-sock"
makedepends="qnx-io-sock-dev"
options="!check"
license="GPL-2.0-or-later OR LGPL-3.0-or-later"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="https://mirror.csclub.uwaterloo.ca/gnu/libunistring/libunistring-$pkgver.tar.xz"

build() {
    LIBS="$LIBS -lsocket" \
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --localstatedir=/var
    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
}

sha512sums="

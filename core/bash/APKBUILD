# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=bash
_basever=5.3
_patchlevel=9
_patchbase=${_basever/./}
pkgver="$_basever.$_patchlevel"
pkgrel=0
pkgdesc="The GNU Bourne Again shell"
url="https://git.savannah.gnu.org/cgit/bash.git/"
arch="all"
license="GPL-3.0-or-later"
depends="ncurses readline qnx-io-sock libintl libiconv"
makedepends="ncurses-dev readline-dev qnx-io-sock-dev gettext-dev libiconv-dev"
depends_dev=$makedepends
subpackages="${pkgname}-doc"
options="!check"
source="https://mirror.csclub.uwaterloo.ca/gnu/bash/bash-$_basever.tar.gz
    bashrc
    profile-bashrc.sh
    fix-qnx.patch
"
_i=1
_pad=00
while [ $_i -le $_patchlevel ]; do
	[ $_i -ge 10 ] && _pad="0"
	[ $_i -ge 100 ] && _pad=
	source="$source https://mirror.csclub.uwaterloo.ca/gnu/bash/bash-$_basever-patches/bash$_patchbase-$_pad$_i"
	_i=$(( _i + 1))
done
provides="/bin/sh"
provider_priority="1"
builddir="$srcdir"/bash-"$_basever"

export CFLAGS="$CFLAGS -DSYS_BASHRC='\"/etc/bash/bashrc\"'"

prepare() {
    # NOTE: This section is for applying the vendor patches, which are required to fix
    # security holes.  `default_prepare` does *not* apply vendor patches in the format
    # shipped with bash.  We also need to make sure vendor patches are applied before
    # our own.
    # If you disagree, please request an experimental rebuild with bash as /bin/sh,
    # before removing this section.
    for p in $source; do
        case $p in
        */bash[0-9][0-9]-[0-9]*)
            msg "$p (vendor)"
            patch -p0 -i "$srcdir"/${p##*/}
            ;;
        esac
    done
    default_prepare
    # preventively set Version to please 'apk version --check'
    sed -i "s/@PACKAGE_VERSION@/$pkgver/" "$builddir"/support/bash.pc.in
}

build() {
    # NOTE: -Wno-error=implicit-function-declaration bash does not provide any headers for its internal impl
    # of fallbacks ex wcswidth and bcopy so we have to allow these to be undefined at compile time
    # but its resolved a link time
    CFLAGS="$CFLAGS -O2 -Wl,-lregex,-lsocket,--stack,8388608 -Wno-error=implicit-function-declaration" \
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --enable-readline \
        --without-bash-malloc \
        --with-installed-readline
    make
}

check() {
    make test
}

package() {
	mkdir -p "$pkgdir"/etc/bash
	make DESTDIR="$pkgdir" install
	ln -s bash "$pkgdir"/usr/bin/sh
	install -Dm644  "$srcdir"/bashrc "$pkgdir"/etc/bash/bashrc
	install -Dm644  "$srcdir"/profile-bashrc.sh "$pkgdir"/etc/profile.d/00-bashrc.sh
	rm -rf "$pkgdir"/usr/share/locale
}


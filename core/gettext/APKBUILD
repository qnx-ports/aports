pkgname=gettext
pkgver=0.26
pkgrel=1
pkgdesc="GNU locale utilities"
url="https://www.gnu.org/software/gettext/gettext.html"
arch="all"
license="GPL-3.0-or-later AND LGPL-2.1-or-later AND MIT"
#makedepends="autoconf automake libtool"
depends="libxml2 gettext-libs"
depends_libs="libintl libiconv libunistring ncurses qnx-io-sock"
makedepends="perl ncurses-dev libxml2-dev libunistring-dev libiconv-dev qnx-io-sock-dev"
subpackages="
    $pkgname-doc
    $pkgname-static
    $pkgname-dev
    $pkgname-lang
    $pkgname-envsubst:_envsubst
    libintl
    $pkgname-libs
    "
source="https://mirror.csclub.uwaterloo.ca/gnu/gettext/gettext-$pkgver.tar.xz
	fix-qnx.patch
"

build() {
    # Increase stack size
    export LDFLAGS="$LDFLAGS -Wl,--stack,4194304"
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --enable-threads=posix \
        --disable-java \
        --disable-xattr \
        --disable-libasprintf \
        --enable-static
    make
}


check() {
    case "$CARCH" in
        # test-verify fails if run in parallel
        # test-memset_explicit fails on armhf if -Os/-01 are set in CFLAGS/LDFLAGS
        armhf) make -j1 check CFLAGS="${CFLAGS/-Os/}" LDFLAGS="${LDFLAGS/-O1,/}" ;;
        *) make -j1 check || true ;;
    esac

}

package() {
    # we need to add depends back here because the sub-pkg dont extist yet & we don't have trace deps so we merge them
    depends="$pkgname-envsubst=$pkgver-r$pkgrel $pkgname-libs=$pkgver-r$pkgrel $depends"
    make -j1 DESTDIR="$pkgdir" install

    # nothing in here is particularly useful, mostly just hello world examples in
    # every single programming language for using gettext
    rm -r "$pkgdir"/usr/share/doc
}

libintl() {
    pkgdesc="GNU gettext runtime library"
    license="LGPL-2.1-or-later"
    depends="libiconv"

    amove usr/lib/libintl.so.*
    chmod +x "$subpkgdir"/usr/lib/libintl.so.*
}

_envsubst() {
    pkgdesc="GNU gettext envsubst binary"
    provides="envsubst"
    depends="gettext=$pkgver-r$pkgrel"

    amove usr/bin/envsubst
}

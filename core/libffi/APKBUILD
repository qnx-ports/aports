# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=libffi
pkgver=3.8.0
pkgrel=0
pkgdesc="A portable foreign-function interface library."
arch="all"
license="MIT"
url="http://sourceware.org/libffi"
subpackages="${pkgname}-static ${pkgname}-dev ${pkgname}-doc"
makedepends="automake libtool texinfo"
source="https://github.com/qnx-ports/libffi/archive/refs/tags/qnx-v$pkgver-r$pkgrel.tar.gz"
builddir="$srcdir/$pkgname-qnx-v$pkgver-r$pkgrel"
  

prepare() {
    cd "$builddir"
    ./autogen.sh
}

build() {
    ./configure \
        --prefix=/usr \
        --docdir=/usr/share/doc/libffi \
        --disable-rpath

    make
}

package() {
    make DESTDIR="${pkgdir}" install
}
sha512sums="

# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=openmp
_patch_rev=1
pkgver=22.1.8_p$_patch_rev
pkgrel=0
pkgdesc="LLVM OpenMP Runtime Library"
arch="all"
url="https://llvm.org"
vcs_url="https://github.com/qnx-ports/llvm-project"
license="Apache-2.0 WITH LLVM-exception"
depends="qnx-io-sock libc++"
_lib_depends="qnx-io-sock-dev libc++-dev"
depends_dev="$pkgname=$pkgver-r$pkgrel $_lib_depends"
makedepends="cmake ninja $_lib_depends flang22 python3 python3-dev"
subpackages="$pkgname-static $pkgname-dev"
source="
    https://github.com/qnx-ports/llvm-project/archive/refs/tags/qnx-${pkgver}.tar.gz"
builddir="$srcdir/llvm-project-qnx-${pkgver}"
_llvmver=${pkgver%%.*}
options="!check"

build() {
    LDFLAGS="-lsocket" \
    cmake -B build -S openmp -G Ninja -Wno-dev \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DLIBOMP_ENABLE_FORTRAN=ON \
	-DLIBOMP_FORTRAN_MODULES=ON \
    	-DLIBOMP_FORTRAN_MODULES_COMPILER=/usr/lib/llvm22/bin/flang \
	-DCMAKE_Fortran_COMPILER=/usr/lib/llvm22/bin/flang \
	-DLIBOMP_LIBFLAGS="-lcatalog"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
4eaa186012335caf847d7244a071ecab2556bc3f97a4a6f6f291a00d0f9a7f6210b59f7b670803b93eba6763285c3e633b8f7f397aa3a55c1b6fc9070fa4f281  qnx-22.1.8_p1.tar.gz
"

# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=busybox
pkgver=1.36.1
pkgrel=10
arch="all"
pkgdesc="Size optimized toolbox of many common UNIX utilities"
url="https://www.busybox.net"
license="GPL-2.0-only"
depends="qnx-io-sock"
makedepends="qnx-io-sock-dev help2man diffutils"
subpackages="$pkgname-doc $pkgname-utils:utils"
source="$url/downloads/$pkgname-$pkgver.tar.bz2
    config
    fix-qnx.patch
"

build() {
    cp ../config .config
    # the -no-pie argument for LD is a hack that should be removed when clang's QNX support is fixed
    make LD="ld -no-pie" HOSTCFLAGS="-D_QNX_SOURCE" HOSTLDFLAGS="-lregex -lsocket"
}

package() {
    install -Dm755 busybox "$pkgdir"/usr/bin/busybox
    install -Dm644 docs/busybox.1 "$pkgdir"/usr/share/man/man1/busybox.1
    # utils
}

utils() {
    provides="coreutils"
    pkgdesc="Busybox (coreutils symlinks)"
    depends="$pkgname"

    _user_utils="adduser addgroup deluser delgroup add-shell remove-shell"
    _utils="date find getopt setopt sha256sum sha512sum tree unzip $_user_utils"
    mkdir -p "$subpkgdir"/usr/bin
    for util in $_utils; do
        ln -sv busybox "$subpkgdir"/usr/bin/$util
    done
}


# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=ca-certificates
pkgver=1
_curl_ver=8.23.0
_nss_ver=3.131.1
pkgrel=5
pkgdesc="CA certificates provider"
url="https://www.mozilla.org/en-US/about/governance/policies/security-group/certs/"
arch="noarch"
license="GPL-2.0-or-later"
subpackages="$pkgname-mozilla::noarch"
makedepends="perl"
options="!check"
triggers="ca-certificates.trigger=/usr/share/ca-certificates"
install="$pkgname.post-deinstall"
source="https://raw.githubusercontent.com/curl/curl/refs/tags/curl-${_curl_ver//./_}/scripts/mk-ca-bundle.pl
    https://raw.githubusercontent.com/mozilla/nss/refs/tags/NSS_${_nss_ver//./_}_RTM/lib/ckfw/builtins/certdata.txt
    update-ca-trust
    update-ca-trust.8.txt
"

build() {
    cd "$srcdir"
    perl mk-ca-bundle.pl -i -w 78 -n
}

package() {
    depends="p11-kit ca-certificates-bundle"

    install -Dvm755 "$srcdir"/update-ca-trust "$pkgdir"/usr/bin/update-ca-trust
    # TODO: Install the doc once we have asciidoc up and running
    #install -Dm644 "$srcdir"/update-ca-trust.8.txt
}

mozilla() {
    pkgdesc="Mozilla's set of trusted CA certificates"
    pkgver="$_nss_ver"
    depends=""
    provides="ca-certificates-bundle"
    provider_priority="1"

    install -Dm644 "$srcdir"/ca-bundle.crt "$subpkgdir"/usr/share/ca-certificates/trust-source/anchors/mozilla-ca-bundle.crt
}


# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=gzip
pkgver=1.15
pkgrel=0
pkgdesc="Popular data compression program"
subpackages="$pkgname-doc"
url="https://www.gnu.org/software/gzip/"
vcs_url="https://cgit.git.savannah.gnu.org/cgit/gzip.git"
arch="all"
license="GPL-3.0-or-later"
depends="grep less"
checkdepends="grep perl ncurses-terminfo"
source="https://mirror.csclub.uwaterloo.ca/gnu/gzip/gzip-$pkgver.tar.xz"

build() {
    # avoid text relocation
    export DEFS="NO_ASM "
    export CFLAGS="$CFLAGS -D_FORTIFY_SOURCE=0"
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info
    make
}

check() {
    make check
}

package() {
    make DESTDIR=$pkgdir install

    rm -rf "$pkgdir"/usr/lib/charset.alias
    rmdir -p "$pkgdir"/usr/lib 2>/dev/null || true

    ln -sf /usr/bin/gunzip "$pkgdir"/usr/bin/uncompress
}

sha512sums="
4a2ff92df8a49e1bbcbf65c3a70434660ad02f084d1b453f7dcaa8ee84f248cc4bb06f62bd8e57fea1e05ba1275c7c584ce97a58856e4ca6105f6417c8efbc3c  gzip-1.15.tar.xz
"

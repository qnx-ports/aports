pkgname=automake
pkgver=1.18
pkgrel=0
pkgdesc="GNU tool for automatically creating Makefiles"
url="https://www.gnu.org/software/automake"
arch="all"
depends="perl autoconf"
license="GPL-2.0-or-later"
subpackages="$pkgname-doc"
source="https://ftp.gnu.org/gnu/automake/automake-$pkgver.tar.xz"

build() {
   if [[ $CBUILD = $CHOST ]]; then
        # Compile natively
        echo "No additional arguments are required"
    else
        # Cross compiling
        echo "This can not be cross-compiled"
        exit 1;
    fi

   CHOST="$CHOST" \
   ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        CFLAGS=-D_QNX_SOURCE \
        LDFLAGS="-lm -lregex -lsocket -lgcc_s"

    make
}

package() {
    make DESTDIR="$pkgdir/" install
}



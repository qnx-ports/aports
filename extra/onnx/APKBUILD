# Maintainer: Deep Chordia <dchordia@qnx.com>
pkgname=onnx
_nanobind_dep=nanobind
_nanobind_ver=2.8.0
_robin_map_dep=robin-map
_robin_map_ver=1.3.0
pkgver=1.20.1
pkgrel=0
pkgdesc="Open standard for machine learning interoperability"
url="https://onnx.ai"
arch="all"
license="Apache-2.0"
depends="libc++"
depends_dev="
    libc++-dev
    protobuf-dev
    "
makedepends="
    $depends_dev
    cmake
    ninja
    gtest-dev
    python3-dev
    python3-pybind11-dev
    python3-numpy-dev
    python3-setuptools
    python3-wheel
    "
subpackages="
    python3-$pkgname-dev:py3_dev
    $pkgname-dev
    python3-$pkgname:py3
    "
source="
    $pkgname-$pkgver.tar.gz::https://github.com/onnx/onnx/archive/refs/tags/v$pkgver.tar.gz
    $_nanobind_dep-$_nanobind_ver.tar.gz::https://github.com/wjakob/nanobind/archive/refs/tags/v$_nanobind_ver.tar.gz
    $_robin_map_dep-$_robin_map_ver.tar.gz::https://github.com/Tessil/robin-map/archive/refs/tags/v$_robin_map_ver.tar.gz
    0001-add-qnx-build.patch
    "
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
  default_prepare

  mkdir -p "$srcdir"/$_nanobind_dep-$_nanobind_ver/ext/$_robin_map_dep
  cp -r "$srcdir"/$_robin_map_dep-$_robin_map_ver/* "$srcdir"/$_nanobind_dep-$_nanobind_ver/ext/robin_map
}

build() {
  PROTOC_PATH="/usr/bin/protoc"
  LDFLAFS="${LDFLAGS} -lregex" \
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_DATADIR=/usr/lib \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON \
    -DProtobuf_PROTOC_EXECUTABLE=${PROTOC_PATH} \
    -DONNX_BUILD_TESTS=ON
  cmake --build build

  CMAKE_ARGS="-DFETCHCONTENT_SOURCE_DIR_NANOBIND=$srcdir/$_nanobind_dep-$_nanobind_ver" python3 setup.py build
}

check() {
  ctest --test-dir build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$builddir"/onnx/*.proto -t "$pkgdir"/usr/include/onnx
  install -Dm644 "$builddir"/onnx/*.proto3 -t "$pkgdir"/usr/include/onnx

  python3 setup.py install --skip-build --root="$pkgdir"
}

py3_dev() {
  pkgdesc="Development files for Python3 bindings of $pkgname"
  depends="$pkgname-dev=$pkgver-r$pkgrel"

  cd "$pkgdir"
  for f in $(find usr/lib/python* -name "*.h" 2>/dev/null); do
    amove "$f"
  done
}

py3() {
  pkgdesc="Python3 bindings for $pkgname"
  depends="
        $pkgname=$pkgver-r$pkgrel
        libc++
        python3
        python3-protobuf
        python3-numpy
        python3-ml-dtypes
    "
  amove usr/lib/python*
}


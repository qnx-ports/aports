5bc6bdbbef89c79528a0b58804ea76387d254e0e4c839182f760e88d79f78b9bf813457ace94d1d3a60a498f6c955fe3eb2ea30d762c0fdb3124e1daddcd3fe5  0001-add-qnx-build.patch

# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=libxt
pkgver=1.3.1
pkgrel=0
pkgdesc="X11 toolkit intrinsics library"
url="https://xorg.freedesktop.org/"
arch="all"
license="MIT"
depends="libsm libice libx11"
depends_dev="libsm-dev libice-dev libx11-dev xorgproto"
makedepends="$depends_dev util-macros"
checkdepends="glib-dev"
subpackages="$pkgname-dev $pkgname-doc"
source="https://www.x.org/releases/individual/lib/libXt-$pkgver.tar.xz"
builddir="$srcdir"/libXt-$pkgver

build() {
	RAWCPP="/usr/bin/clang-cpp" \
	CFLAGS="$CFLAGS -DSA_RESTART=0" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-static
	make
}

check() {
	make check
}

package() {
	make -j1 DESTDIR="$pkgdir" install
}

sha512sums="
c220292f60b0f53134cf9364831a32bbaa9fa6bbb3a7143e917920957b7a48c616e946042747089f29ea9d8a18ecd64de620bcaf56d82462e7107de906f5db38  libXt-1.3.1.tar.xz
"


# Contributor: Cris Sinnott <csinnott@qnx.com>
# Maintainer: Deep Chordia <dchordia@blackberry.com>
pkgname=python3-dm-tree
pkgver=0.1.10
pkgrel=0
pkgdesc="Tree is a library for working with nested data structures"
url="https://github.com/google-deepmind/tree"
arch="all"
license="Apache-2.0"
depends="
	abseil-cpp>=20250814.1
	libc++
	python3
	python3-wrapt
	"
makedepends="
	abseil-cpp-dev
	cmake
	ninja
	python3-dev
	python3-pybind11
	python3-gpep517
	python3-setuptools
	python3-wheel
	"
checkdepends="
	python3-absl-py
	python3-attrs
	python3-numpy
	python3-pytest
	python3-wrapt
	"
source="https://files.pythonhosted.org/packages/source/d/dm-tree/dm_tree-$pkgver.tar.gz
	0001-setup-pass-CMAKE_ARGS.patch
	"
builddir="$srcdir/dm_tree-$pkgver"

build() {
	# System abseil-cpp and pybind11; FULLY_DISCONNECTED makes a missing one an error, not a download.
	export CMAKE_ARGS="-DUSE_SYSTEM_ABSEIL=ON -DUSE_SYSTEM_PYBIND11=ON
		-Dpybind11_DIR=$(python3 -m pybind11 --cmakedir)
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON"
	CFLAGS="$CFLAGS -fPIC" CXXFLAGS="$CXXFLAGS -fPIC" CC=clang CXX=clang++ \
		gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# Run from /tmp so pytest doesn't pick up the source tree/ dir over the installed package
	cp tree/tree_test.py /tmp/dm_tree_test.py
	(cd /tmp && "$builddir"/.testenv/bin/python3 -m pytest dm_tree_test.py \
		--junitxml="$startdir/junit-$pkgname.xml")
	rm -f /tmp/dm_tree_test.py
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
1c630ab899eb1d101d22cd2ead223a373886b0460a07c240a20959041ffc2f1e3e7891685e03fa3ae7fe3674cb4d272c3fbe031145b233269bd1a8dc2966aa6e  dm_tree-0.1.10.tar.gz
2fbceff3e29086eb14b8524c0cb08000b4e0ec2624c848dbcef5e2f1bbe37dec1f8ab073199ac54e6a8a1a13bc3ddc93c02c652e2f906658d9ef415d04b30d4e  0001-setup-pass-CMAKE_ARGS.patch
"

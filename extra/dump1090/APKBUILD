# Contributor: Ramya santoshi Timmaraju <rtimmaraju@qnx.com>

pkgname=dump1090
pkgver=1.0
pkgrel=0
pkgdesc="Mode S ADS-B decoder for RTL-SDR devices"
url="https://github.com/qnx-ports/dump1090"
arch="all"
license="BSD-3-Clause"

depends=""
makedepends="
	make
	rtl-sdr-dev
	libusb-dev
"
# No unit tests (UT) are provided for this library. Functional verification will be performed through real-time testing, 
# and the results will be validated to ensure successful operation.

options="!check"

source="
	$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/dump1090/archive/refs/heads/master.tar.gz
"

builddir="$srcdir/$pkgname-master"

build() {
	make \
		CC="$CC" \
		CFLAGS="$CFLAGS" \
		LDFLAGS="$LDFLAGS" \
		LDLIBS="-lrtlsdr -lusb-1.0 -lsocket -lpthread -lm"
}

package() {
	install -d "$pkgdir/usr/bin"

	install -m755 dump1090 \
		"$pkgdir/usr/bin/dump1090"

	if [ -f README.md ]; then
		install -d "$pkgdir/usr/share/doc/$pkgname"
		install -m644 README.md \
			"$pkgdir/usr/share/doc/$pkgname/"
	fi
}

sha512sums="
febde0f0327ea623ade10abbde16d28f300cb6c2acfe31be32c96eeb6f0e4ac00aa817df58da7fa497864a9e23281a26dd5269880bb67cf9a8e09c05c339ba7d  dump1090-1.0.tar.gz
"

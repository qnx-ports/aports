# Maintainer: Your Name <your.email@example.com>
pkgname=muslflt
pkgver=0.1
pkgrel=0
pkgdesc="musl compatibility helpers used in QNX ports"
url="https://github.com/qnx-ports/muslflt"
arch="all"
license="MIT"

makedepends="build-base"

source="muslflt-main.tar.gz::https://github.com/qnx-ports/muslflt/archive/refs/heads/main.tar.gz"
builddir="$srcdir/muslflt-main"

# Detect architecture
CARCH="${CARCH:-$(uname -m)}"
case "$CARCH" in
    x86_64|i?86)
        ARCH="x86_64"
        ;;
    aarch64|arm64|armv7*|RaspberryPi*)
        ARCH="aarch64le"
       
        ;;
    *)
        ARCH="$CARCH"
        ;;
esac

echo "Building for architecture: $ARCH"

build() {
    cd "$builddir"
      # Patch fenv.h to include correct path
    sed -i "s|<bits/fenv.h>|\"$ARCH/bits/fenv.h\"|" fenv/fenv.h

    # Remove x86_64 optimized math for non-x86 architectures
    if [ "$ARCH" != "x86_64" ]; then
        echo "Removing x86_64 optimized math for $ARCH"

        # Collect all C sources, skipping x86_64 asm if needed
        find . -name "*.c" ! -path "./math/x86_64/*" > sources.txt
        export CFLAGS="$CFLAGS -Dweak_alias(a,b)="
    else
        
    # Collect all C sources, skipping aarch64le  asm if needed
    find . -name "*.c" ! -path "./math/aarch64le/*" > sources.txt
        
    fi

    # Include directories
    INCLUDES="-I. \
              -I./include \
              -I./math \
              -I./math/$ARCH \
              -I./math/$ARCH/bits \
              -I./complex \
              -I./string \
              -I./fenv \
              -I./fenv/$ARCH/bits"

    # Compile all sources with PIC
    CFLAGS="$CFLAGS -fPIC \
                     -Wno-parentheses \
                     -Werror=implicit-function-declaration \
                     -Wno-unused-but-set-variable \
                     -Wno-implicit-int \
                     -Wno-implicit-function-declaration"

    $CC $CFLAGS $INCLUDES -c $(cat sources.txt)

    # Create libraries
    ar rcs libmuslflt.a *.o
    $CC -shared -o libmuslflt.so *.o

     # --- Build test executable ---
    echo "Building tests..."
    cd tests
    $CXX $CFLAGS -I../include -I../math -I../math/$ARCH -I../math/$ARCH/bits \
         -I../complex -I../string -I../fenv -I../fenv/$ARCH/bits \
         -L.. -lmuslflt -o test test.cpp
}

check() {
    cd "$builddir/tests"
    echo "Running test..."
    # Make sure the shared library can be found
    export LD_LIBRARY_PATH=..:$LD_LIBRARY_PATH
    ./test
}

package() {
    cd "$builddir"

    # Install libraries
    install -Dm755 libmuslflt.so "$pkgdir/usr/lib/libmuslflt.so"
    install -Dm644 libmuslflt.a "$pkgdir/usr/lib/libmuslflt.a"

    # Install headers
    mkdir -p "$pkgdir/usr/include/muslflt"
    find . -name "*.h" -exec install -Dm644 {} "$pkgdir/usr/include/muslflt/" \;
}

sha512sums="
e9660b3910194a58a2f7fe8483827b2bb7510c9fa37bfb9cd1b535ee4546c078756728e78686758119eda6b1be40aceb43535029f3c0c8abc763dc6f4e1449a9  muslflt-main.tar.gz
"
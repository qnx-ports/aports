pkgname=aws-crt-cpp
pkgver=0.37.3
pkgrel=0
pkgdesc="C++ wrapper around the aws-c-* libraries. Provides Cross-Platform Transport Protocols and SSL/TLS implementations for C++"
url="https://github.com/awslabs/aws-crt-cpp"
arch="all"
license="Apache-2.0"
depends_dev="aws-c-common-dev
             aws-c-cal-dev
             aws-c-io-dev
             s2n-tls-dev
             "
makedepends="$depends_dev
             cmake
             ninja
             "
subpackages="$pkgname-dev"
_aws_c_auth_commit="c6155516c4ed5267563fac4bbf208e6a7a9ee4c4"
_aws_c_compression_commit="d8264e64f698341eb03039b96b4f44702a9b3f83"
_aws_c_event_stream_commit="f43a3d24a7c1f8b50f709ccb4fdf4c7fd2827fff"
_aws_c_http_commit="acf31399077300c522315612dd2be09cfe48b5b8"
_aws_c_mqtt_commit="1d512d92709f60b74e2cafa018e69a2e647f28e9"
_aws_c_s3_commit="e9d1bde139f88b08aaa3bf0507f443f31ccede93"
_aws_c_sdkutils_commit="f678bda9e21f7217e4bbf35e0d1ea59540687933"
_aws_checksums_commit="c412c636091501c2cd544d23664c8d14999e9dcc"
source="$pkgname-$pkgver.tar.gz::https://github.com/awslabs/aws-crt-cpp/archive/refs/tags/v$pkgver.tar.gz
        $pkgname-$pkgver-aws_c_auth.tar.gz::https://github.com/awslabs/aws-c-auth/archive/$_aws_c_auth_commit.tar.gz
        $pkgname-$pkgver-aws_c_compression.tar.gz::https://github.com/awslabs/aws-c-compression/archive/$_aws_c_compression_commit.tar.gz
        $pkgname-$pkgver-aws_c_event_stream.tar.gz::https://github.com/awslabs/aws-c-event-stream/archive/$_aws_c_event_stream_commit.tar.gz
        $pkgname-$pkgver-aws_c_http.tar.gz::https://github.com/awslabs/aws-c-http/archive/$_aws_c_http_commit.tar.gz
        $pkgname-$pkgver-aws_c_mqtt.tar.gz::https://github.com/awslabs/aws-c-mqtt/archive/$_aws_c_mqtt_commit.tar.gz
        $pkgname-$pkgver-aws_c_s3.tar.gz::https://github.com/awslabs/aws-c-s3/archive/$_aws_c_s3_commit.tar.gz
        $pkgname-$pkgver-aws_c_sdkutils.tar.gz::https://github.com/awslabs/aws-c-sdkutils/archive/$_aws_c_sdkutils_commit.tar.gz
        $pkgname-$pkgver-aws_checksums.tar.gz::https://github.com/awslabs/aws-checksums/archive/$_aws_checksums_commit.tar.gz
        0001-add-qnx-build.patch
        "
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
  mv "$srcdir"/aws-c-auth-$_aws_c_auth_commit/* "$builddir"/crt/aws-c-auth
  mv "$srcdir"/aws-c-compression-$_aws_c_compression_commit/* "$builddir"/crt/aws-c-compression
  mv "$srcdir"/aws-c-event-stream-$_aws_c_event_stream_commit/* "$builddir"/crt/aws-c-event-stream
  mv "$srcdir"/aws-c-http-$_aws_c_http_commit/* "$builddir"/crt/aws-c-http
  mv "$srcdir"/aws-c-mqtt-$_aws_c_mqtt_commit/* "$builddir"/crt/aws-c-mqtt
  mv "$srcdir"/aws-c-s3-$_aws_c_s3_commit/* "$builddir"/crt/aws-c-s3
  mv "$srcdir"/aws-c-sdkutils-$_aws_c_sdkutils_commit/* "$builddir"/crt/aws-c-sdkutils
  mv "$srcdir"/aws-checksums-$_aws_checksums_commit/* "$builddir"/crt/aws-checksums

  default_prepare
}

build() {
  cmake -B build -G Ninja \
    -DCMAKE_C_FLAGS="$CFLAGS -Wno-deprecated-declarations" \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS -Wno-deprecated-declarations" \
    -DCMAKE_C_STANDARD_LIBRARIES="-lsocket -lepoll" \
    -DCMAKE_CXX_STANDARD_LIBRARIES="-lsocket -lepoll" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_DATADIR=/usr/lib \
    -DCMAKE_MODULE_PATH=/usr/lib/cmake/aws-c-common/modules \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=ON \
    -DBYO_CRYPTO=OFF \
    -DUSE_OPENSSL=ON \
    -DQNX=1
  cmake --build build
}

check() {
  ctest --test-dir build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}


# Alpine-Maintainer: Struan Robertson <contact@struanrobertson.co.uk>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-pytest-datadir
_pkgname=pytest-datadir
pkgver=1.9.0
pkgrel=0
pkgdesc="pytest plugin for test data directories and files"
url="https://github.com/gabrielcnr/pytest-datadir"
arch="noarch"
license="MIT"
depends="
	python3
	python3-pytest
"
makedepends="
	python3-setuptools_scm
	python3-wheel
	python3-installer
	python3-gpep517
"
checkdepends="python3-pytest"
source="$url/archive/v$pkgver/$_pkgname-v$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}



sha512sums="
074da0a7a2851c1d3ce4af2e04e3216d54aebb18ec683cd988087668ff64a29bdc5a55db9f58d68c9f7b084602a6016c9be30d45b503b38706ec362b3b13c9d9  pytest-datadir-v1.9.0.tar.gz
"

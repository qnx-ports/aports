# Contributor: Sören Tempel <soeren+alpinelinux@soeren-tempel.net>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=harfbuzz
pkgver=11.3.3
pkgrel=2
pkgdesc="Text shaping library"
url="https://harfbuzz.github.io/"
arch="all"
license="MIT"
depends_dev="
    icu-dev
    cairo-dev
    freetype-dev
    glib-dev
    graphite-dev
    "
makedepends="
    $depends_dev
    gobject-introspection-dev
    meson
    cmake
    ninja
    pkgconf
    pkgconf-dev
    clang
    libc++-dev
    "
checkdepends="python3 cairo"
depends="freetype glib graphite"
subpackages="
    $pkgname-static
    $pkgname-dev
    $pkgname-cairo
    $pkgname-gobject
    $pkgname-icu
    $pkgname-subset
    $pkgname-utils
    "
source="https://github.com/harfbuzz/harfbuzz/releases/download/$pkgver/harfbuzz-$pkgver.tar.xz"

build() {
    CC=clang \
    CXX=clang++ \
    CFLAGS="$CFLAGS -O2 -Qunused-arguments" \
    CXXFLAGS="$CXXFLAGS -O2 -Qunused-arguments" \
    CPPFLAGS="$CPPFLAGS -O2 -Qunused-arguments" \
    LDFLAGS="-llocale" \
    meson setup \
        --default-library=both \
        --prefix=/usr \
        -Dglib=enabled \
        -Dgobject=enabled \
        -Dgraphite=enabled \
        -Dicu=enabled \
        -Dfreetype=enabled \
        -Dtests=enabled \
        -Dcairo=enabled \
        -Ddocs=disabled \
        -Dintrospection=enabled \
        . output

    meson compile -C output
}

check() {
    # Some test outcomes are "FAIL" or "ERROR" and were documented as follows:
    # 28/215 src - harfbuzz:check-symbols                                 FAIL             0.28s   exit status 1
    # 29/215 src - harfbuzz:check-libstdc++                               FAIL             0.22s   exit status 1
    # 65/215 api - harfbuzz:test-paint                                    ERROR            0.11s   killed by signal 6 SIGABRT
    LD_LIBRARY_PATH="$builddir/output/src":$LD_LIBRARY_PATH \
    meson test --print-errorlogs -C output || msg "Some tests fail due to linking against libc++"
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

icu() {
    pkgdesc="Harfbuzz ICU support library"
    depends="
        $pkgname=$pkgver-r$pkgrel
        icu-libs
    "
    replaces="harfbuzz"

    amove usr/lib/lib*icu.so.*
}

gobject() {
    pkgdesc="Harfbuzz gobject library"
    depends="$pkgname=$pkgver-r$pkgrel"
    amove usr/lib/lib*gobject.so.*
}

cairo() {
    pkgdesc="Harfbuzz cairo library"
    depends="
        $pkgname=$pkgver-r$pkgrel
        cairo
    "
    amove usr/lib/lib*cairo.so.*
}

subset() {
    pkgdesc="Harfbuzz subset library"
    depends="$pkgname=$pkgver-r$pkgrel"
    amove usr/lib/lib*subset.so.*
}

utils() {
    pkgdesc="$pkgdesc (utilities)"
    depends="
        $pkgname=$pkgver-r$pkgrel
        $pkgname-cairo=$pkgver-r$pkgrel
        $pkgname-gobject=$pkgver-r$pkgrel
        $pkgname-subset=$pkgver-r$pkgrel
    "
    amove usr/bin
}

dev() {
    default_dev
    provides="harfbuzz-bootstrap-dev"
    provider_priority=2
}

sha512sums="

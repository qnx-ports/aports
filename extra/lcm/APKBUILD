# Maintainer: nnarayanamurthy <nnarayanamurthy@qnx.com>

pkgname=lcm
pkgver=1.5.2
pkgrel=0
pkgdesc="Lightweight Communications and Marshalling"
url="https://github.com/lcm-proj/lcm"
arch="all"
options="!check"
license="LGPL-2.1-or-later"
depends="
    glib
    libc++
    qnx-io-sock
    qnx-gcc-libs
"
makedepends="
    cmake
    libc++-dev
    ninja
    glib-dev
    qnx-io-sock-dev
"

subpackages="
    $pkgname-dev
    $pkgname-doc
"

source="$pkgname-$pkgver.tar.gz::https://github.com/lcm-proj/lcm/archive/refs/tags/v$pkgver.tar.gz
    0001-Add-QNX-Support.patch
    0002-Add-QNX-Support.patch
    "

build() {
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DLCM_ENABLE_JAVA=OFF \
        -DLCM_ENABLE_LUA=OFF \
        -DLCM_ENABLE_PYTHON=OFF \
    	-DCMAKE_EXE_LINKER_FLAGS="-lsocket" \
		-DCMAKE_SHARED_LINKER_FLAGS="-lsocket"

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

dev() {
    default_dev

    amove usr/lib/lcm
}

check() {
    ctest --test-dir build --output-on-failure
}


# Alpine-Contributor: Wen Heping <wenhepingalpine@sohu.com>
# Alpine-Contributor: Martell Malone <martellmalone@gmail.com>
# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-scipy
pkgver=1.17.1
pkgrel=0
pkgdesc="Python library for scientific computing"
url="https://www.scipy.org/"
arch="all"
license="BSD-3-Clause"
depends="python3-numpy libc++"
makedepends="
    cython
    flang
    openblas-dev
    python3-gpep517
    python3-meson-python
    python3-numpy-dev
    python3-numpy-f2py
    python3-pybind11-dev
    python3-setuptools
    python3-wheel
    python3-dev
    libc++-dev
    pythran
    qhull
    "
checkdepends="python3-pytest"
subpackages="$pkgname-tests"
source="https://pypi.io/packages/source/s/scipy/scipy-$pkgver.tar.gz
    qnx-_EXTERN_C.patch
    "
builddir="$srcdir"/scipy-$pkgver

build() {
    export CFLAGS="$CFLAGS -O3"
    export CXXFLAGS="$CXXFLAGS -O3"
    export LDFLAGS="$LDFLAGS -Wl,--no-as-needed -lgcc_s -lm"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    cd .testenv
    # There are some failures here because we're missing python3-hypothesis and
    # python3-pooch, which are both optional dependencies of tests.
    bin/python -c "from scipy import test; test('full')"
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

tests() {
    find "$pkgdir" -name tests -type d | while read -r p; do
        amove "${p#"$pkgdir"}"
    done
}

sha512sums="

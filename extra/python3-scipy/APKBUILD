f2c990a3e86bf2424ca4ad44b05e0507543934228ed20f0d5665ce809c0ab8ecd2616ea62b0ec9ecdc3323359d9a403919f02a9b1e88c3404a7111b87c65507d  qnx-_EXTERN_C.patch
"

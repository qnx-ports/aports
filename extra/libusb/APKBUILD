# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=libusb
pkgver=1.0.23
pkgrel=0
pkgdesc="Cross-platform user-mode USB device library"
url="https://github.com/qnx-ports/libusb"
arch="all"
license="LGPL-2.1-or-later"
makedepends="autoconf automake libtool pkgconf ninja libc++-dev qnx-libpci-dev  qnx-usb-dev"
depends="libc++ qnx-libpci"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/libusb/archive/refs/heads/libusb-1.0.23.tar.gz"
builddir="$srcdir/libusb-libusb-1.0.23"
options="!tracedeps !check"

prepare() {
	default_prepare
	cd "$srcdir/libusb-libusb-1.0.23"     
	./bootstrap.sh
}

build() {
    cd "$builddir" 
    
    export CC=clang
    export CXX=clang++
    export CFLAGS="$CFLAGS -D_QNX_SOURCE -g -O2 -fPIC"
    export CXXFLAGS="$CXXFLAGS -fPIC"
    export LDFLAGS="$LDFLAGS -L/usr/local/lib"
    export LIBS="$LIBS -lusbdi -lpci"

    ./configure \
        --host=$CHOST \
        --build=$CHOST \
        --prefix=/usr \
        --enable-shared \
        --disable-static \
        CFLAGS="$CFLAGS" \
        CXXFLAGS="$CXXFLAGS" \
        LDFLAGS="$LDFLAGS" \
        LIBS="$LIBS"

        echo "===== CONFIG.LOG ====="
        cat config.log
        echo "===== END CONFIG.LOG ====="
        return 1

    make
}

#Tests cannot be executed as the qnxuser, and the build must not be run as root. Therefore, 
#test execution is being disabled and verified the functional tests on root user .

package() {
    cd "$builddir"
    make DESTDIR="$pkgdir" install
    cd "$pkgdir/usr/lib"
    ln -sf libusb-1.0.so.0.2.0 libusb-1.0.so.0
    ln -sf libusb-1.0.so.0 libusb-1.0.so
}


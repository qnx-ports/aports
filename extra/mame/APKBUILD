# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=mame
pkgver=0.281
_pkgver=${pkgver/.}
pkgrel=0
pkgdesc="Multi Arcade Machine Emulator."
url="https://mamedev.org"
arch="all"
license="GPL-2.0-or-later"
depends="
    $pkgname-common
    sdl3
    sdl2-compat
    sdl2-ttf
    fontconfig
    freetype
    zlib
    libc++
    qnx-screen
    qnx-egl
    qnx-gles
    qnx-io-sock
    "
# MAME doesn't seem to have the option for a static build.
makedepends="
    brotli-dev
    bzip2-dev
    libiconv-dev
    expat-dev
    fontconfig-dev
    freetype-dev
    libpng-dev
    sdl3-dev
    sdl2-compat-dev
    sdl2-ttf-dev
    zlib-dev
    qnx-egl
    qnx-gles
    egl-headers
    gles-headers
    ncurses-dev
    qnx-io-sock-dev
    qnx-fs-core-dev
    qnx-fs-gpt-dev
    python3
    clang
    grep
    "
subpackages="
    $pkgname-common::noarch
    $pkgname-plugins::noarch
    $pkgname-doc
    $pkgname-lang
    $pkgname-data::noarch
    "
    #$pkgname-tools
_git_rev=1
source="
    ${pkgname}-${pkgver}-r${_git_rev}.tar.gz::https://github.com/qnx-ports/${pkgname}/archive/refs/tags/qnx-${pkgname}${_pkgver}-r${_git_rev}.tar.gz
    mame.patch
    mame.ini
    "
builddir="${srcdir}/${pkgname}-qnx-${pkgname}${_pkgver}-r${_git_rev}"

options="!check"

build() {
    if [[ $CARCH == "x86_64" ]]; then
    _arch=x64
    elif [[ $CARCH == "aarch64" ]]; then
    _arch=arm64
    else
    die "$CARCH not supported"
    fi

    export CC=clang
    export CXX=clang++

    JLEVEL=$(echo $MAKEFLAGS | grep -oE "\-j[0-9]+")
    JLEVEL=${JLEVEL/\-j}
    JLEVEL=${JLEVEL:-1}

    JLEVEL=${JLEVEL} \
    TESTS=0 \
    REGENIE=1 \
    ARCHOPTS="-D_QNX_SOURCE -DSDL_DISABLE_IMMINTRIN_H -w" \
    LDOPTS="-lsocket" \
    TARGETOS=qnx \
    SYMBOLS=0 \
    OSD=sdl \
    SDL_INI_PATH=/etc/mame \
    USE_QTDEBUG=0 \
    USE_TAPTUN=1 \
    NO_USE_XINPUT=1 \
    NO_X11=1 \
    NO_USE_MIDI=1 \
    USE_SYSTEM_LIB_ZLIB=1 \
    VERBOSE=1 \
    DEBUG=0 \
    make qnx_$_arch
}

package() {
    install -D -m755 mame "$pkgdir"/usr/bin/mame
    install -D -m644 docs/man/mame.6 "$pkgdir"/usr/share/man/man6/mame.6
    # We need tools=1 for this, but that causes build errors and is not a
    # priority.
    #for i in castool.1 \
    #    chdman.1 \
    #    floptool.1 \
    #    imgtool.1 \
    #    jedutil.1 \
    #    ldresample.1 \
    #    ldverify.1 \
    #    romcmp.1
    #do
    #    install -D -m644 docs/man/"$i" "$pkgdir"/usr/share/man/man1/"$i"
    #done

    install -D -m644 "$srcdir"/mame.ini "$pkgdir"/etc/mame/mame.ini
    install -d -m755 "$pkgdir"/usr/share/mame/roms

    for i in artwork \
        bgfx \
        hash \
        hlsl \
        ini \
        keymaps \
        language \
        plugins \
        samples
    do
        cp -r "$i" "$pkgdir"/usr/share/mame
    done

    #for i in castool \
    #    chdman \
    #    floptool \
    #    imgtool \
    #    jedutil \
    #    ldresample \
    #    ldverify \
    #    romcmp
    #do
    #    install -Dm755 "$i" -t "$pkgdir"/usr/bin
    #done
}

common() {
    pkgdesc="MAME - Common configuration files"
    amove etc/mame/mame.ini \
    usr/share/mame/roms
}

data() {
    pkgdesc="Distribution data files for MAME"

    amove usr/share/mame
}

plugins() {
    pkgdesc="Distribution plugins for MAME"

    amove usr/share/mame/plugins
}


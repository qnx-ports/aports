# Maintainer: Karol Frackiewicz <kfrackiewicz@qnx.com>
pkgname=bandicoot
pkgver=4.0.1
pkgrel=0
pkgdesc="C++ library for GPU accelerated linear algebra"
url="https://coot.sourceforge.io/"
arch="all"
license="Apache-2.0"
depends="
    armadillo
    clblast
    openblas
    qnx-opencl
"
makedepends="
    cmake
    armadillo-dev
    clblast-dev
    openblas-dev
    opencl-headers
"
subpackages="$pkgname-dev"
source="
    https://sourceforge.net/projects/coot/files/bandicoot-4.0.1.tar.xz
    0001-row-col-xvec-traits.patch
"

# Test compilation runs out of memory if RAM < 16GB.
# Test execution requires an OpenCL device
options="!check"

build() {

    case "$options" in
        *"!check"*)
            cmake -B build \
                -DCMAKE_BUILD_TYPE=Release \
                -DOPENBLAS_PROVIDES_LAPACK=true \
                -DCMAKE_INSTALL_PREFIX=/usr \
                -DBUILD_TESTS=OFF \
                -DFIND_OPENCL=ON
            cmake --build build
            ;;
        *)
            cmake -B build \
                -DCMAKE_BUILD_TYPE=Release \
                -DOPENBLAS_PROVIDES_LAPACK=true \
                -DCMAKE_INSTALL_PREFIX=/usr \
                -DBUILD_TESTS=ON \
                -DFIND_OPENCL=ON
            cmake --buuld build -- -j1
            ;;
    esac
}

check() {
    cmake --build build --target test
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}


# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintianer: Aaron Bassett <abassett@qnx.com>
pkgname=cups
pkgver=2.4.16
pkgrel=0
pkgdesc="The CUPS Printing System"
url="https://github.com/OpenPrinting/cups/"
arch="all"
license="Apache-2.0"
depends_dev="libgcrypt-dev gnutls-dev zlib-dev avahi-dev"
makedepends="
	$depends_dev
	avahi-dev
	dbus-dev
	libjpeg-turbo-dev
	libpaper-dev
	qnx-io-sock-dev
	libc++-dev
	libxcrypt-dev
	autoconf
	"
depends="cups-client poppler-utils openssl dbus libc++ $pkgname-libs"
install="cups.pre-install"
pkggroups="lp lpadmin"
pkgusers="lp"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-doc
	$pkgname-libs
	ipptool
	$pkgname-client
	$pkgname-openrc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/cups/archive/refs/tags/qnx-v$pkgver.tar.gz
	$pkgname.logrotate
	cupsd.initd
	cups-nostrip.patch
	"
options="!check"
builddir="$srcdir/$pkgname-qnx-v$pkgver"

prepare() {
    default_prepare
    # force update for qnx linking to libsocket
    autoconf
}

build() {
	CFLAGS="$CFLAGS -U_FORTIFY_SOURCE" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--sbindir=/usr/bin \
		--localstatedir=/var \
		--with-menudir=/usr/share/applications \
		--with-icondir=/usr/share/icons \
		--with-logdir=/var/log/cups \
		--with-docdir=/usr/share/cups \
		--with-rundir=/run/cups \
		--with-cupsd-file-perm=0755 \
		--with-cups-user=lp \
		--with-cups-group=lp \
		--with-system-groups=lpadmin \
		--with-domainsocket=/run/cups/cups.sock \
		--disable-libusb \
		--without-rcdir \
		--without-php \
		--disable-pam \
		--enable-raw-printing \
		--enable-dbus \
		--with-dbusdir=/usr/share/dbus-1 \
		--enable-libpaper \
		--enable-ssl=yes \
		--enable-gnutls \
		--disable-launchd

	make
}

package() {
	make BUILDROOT="$pkgdir" install

	cd "$pkgdir"

	# These no longer works since CUPS >= 1.6 (http://www.cups.org/str.php?L4120).
	rm -rf usr/share/cups/banners/* \
		usr/share/cups/data/testprint

	install -D -m 644 "$srcdir"/cups.logrotate etc/logrotate.d/cups
	install -D -m 755 "$srcdir"/cupsd.initd etc/init.d/cupsd

	if [ -e usr/share/applications/cups.desktop ] ; then
		sed -i 's|^Exec=htmlview http://localhost:631/|Exec=xdg-open http://localhost:631/|g' \
			usr/share/applications/cups.desktop
	fi
	find usr/share/cups/model -name "*.ppd" -exec gzip -n9f {} +
}

dev() {
	default_dev

	# needed for main cups operation
	mv "$subpkgdir"/usr/share/cups/ppdc/* \
		"$pkgdir"/usr/share/cups/ppdc
	rmdir "$subpkgdir"/usr/share/cups/ppdc
}

libs() {
	pkgdesc="CUPS libraries"
	depends="avahi-libs gnutls libxcrypt qnx-io-sock zlib-ng"
	replaces="libcups"

	amove 'usr/lib/*.so*'
	install -d "$pkgdir"/etc/cups
}

ipptool() {
	pkgdesc="Perform internet printing protocol requests"
	depends="$pkgname-libs"

	amove usr/bin/ipptool \
		usr/share/cups/ipptool
}

client() {
	pkgdesc="CUPS command-line client programs"
	depends="$pkgname-libs libc++ libpaper dbus"

	amove usr/bin
}

doc() {
	default_doc

	amove usr/share/cups/help
}



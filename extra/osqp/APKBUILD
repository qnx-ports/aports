# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=osqp
pkgver=1.0.0
pkgrel=0
pkgdesc="Optimization solver for Quadratic Programs (QPs)"
url="https://github.com/osqp/osqp"
arch="all"
license="Apache-2.0"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/osqp/osqp/archive/refs/tags/v$pkgver/$pkgver.tar.gz
	0001-CMakeLists.patch
"
depends="libc++"
makedepends="
	libc++-dev
	cmake
	ninja
"
checkdepends="python3-scipy openblas-dev"
subpackages="
	$pkgname-static
	$pkgname-dev
"
options="net"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DOSQP_BUILD_UNITTESTS=ON
	cmake --build build
}

check() {
	ctest --test-dir build --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

dev() {
    default_dev
    amove usr/share/osqp/codegen_files/Makefile
}

sha512sums="

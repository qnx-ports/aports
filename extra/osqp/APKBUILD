eaabb2383b168a0ca3fbffa8d824973199a21b48287b3adc168c8108bad728e1ce3c68af5205a87257984ec7b9a8521390d27edf4bdf71f29e83dee0ce17c4fd  0001-CMakeLists.patch
"

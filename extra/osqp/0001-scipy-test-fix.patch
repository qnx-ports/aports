+-q = sp.randn(n)
++q = randn(n)
+ A = sparse.random(m, n, random_state=rg).tolil()  # Lil for efficiency
+-u = 3 + sp.randn(m)
+-l = -3 + sp.randn(m)
++u = 3 + randn(m)
++l = -3 + randn(m)

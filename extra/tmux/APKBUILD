a136279af8a843c4d59229f0b25db1caa782f8e76198b3a07228d0d023a13a20a2e6cc17a3e817a36e6b8b8e8503f19ce3403d1db3aec709e3b8cbf1b3db8f86  qnx-compat.patch
"

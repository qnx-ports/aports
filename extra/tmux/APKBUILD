# Maintainer: Leo Shen <yishen@qnx.com>
# Alpine-Maintainer: Celeste <cielesti@protonmail.com>
maintainer="Celeste <cielesti@protonmail.com>"
pkgname=tmux
pkgver=3.6a
pkgrel=0
pkgdesc="Tool to control multiple terminals from a single terminal"
url="https://tmux.github.io"
arch="all"
license="ISC"
depends="ncurses-terminfo-base libevent ncurses qnx-io-sock-dev"
makedepends="bison texinfo libevent-dev ncurses-dev qnx-io-sock-dev"
subpackages="$pkgname-doc"
source="https://github.com/tmux/tmux/releases/download/$pkgver/tmux-$pkgver.tar.gz
    qnx-compat.patch
"

prepare() {
    default_prepare
    update_config_sub
}

build() {
    CFLAGS="$CFLAGS -Wl,-lsocket,-lregex" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --localstatedir=/var \
        --enable-sixel
    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install

    install -D -m644 example_tmux.conf \
        "$pkgdir"/usr/share/doc/$pkgname/examples/$pkgname.conf
    install -Dm644 CHANGES README -t "$pkgdir"/usr/share/doc/$pkgname/
}



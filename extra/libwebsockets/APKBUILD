0f9bf9fd22c12e4038245bef92bf7c9528cd764efc58f986d9c4ae3ac570257f9f8f4e736f4b34cd31ce48793488a0f0949145fc8269f75f0873ca9b0be3a8bf  add_qnx_support.patch
"

# Maintainer: Omar Shrit <omar@avontech.fr>
pkgname=mlpack
pkgver=4.7.0
pkgrel=0
pkgdesc="Fast, header-only C++ machine learning library"
url="https://www.mlpack.org/"
arch="all"
license="BSD-3-Clause"

depends="
    ensmallen
    cereal
    openmp
    qnx-gcc-libs
    qnx-microkernel
    armadillo
    ensmallen
    cereal
    libc++
"
makedepends="
    cmake
    ${depends}
"
options="!check" # tests/examples can be heavy; enable later after base package works

source="https://www.mlpack.org/files/mlpack-${pkgver}.tar.gz"

subpackages="${pkgname}-dev"

build() {
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_CXX_FLAGS="-Wno-missing-template-arg-list-after-template-kw" \

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="

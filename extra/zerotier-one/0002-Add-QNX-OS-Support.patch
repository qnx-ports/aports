diff --git a/make-qnx.mk b/make-qnx.mk
new file mode 100644
index 000000000..57ce84341
--- /dev/null
+++ b/make-qnx.mk
@@ -0,0 +1,123 @@
+# QNX build rules — modeled on make-bsd.mk
+# Requires GNU make
+
+INCLUDES=-isystem ext -Iext/prometheus-cpp-lite-1.0/core/include -Iext/prometheus-cpp-lite-1.0/simpleapi/include -Iext/opentelemetry-cpp-api-only/include
+DEFS=
+LIBS=-lsocket
+
+include objects.mk
+
+ONE_OBJS+=osdep/QNXEthernetTap.o
+ONE_OBJS+=osdep/PortMapper.o
+ONE_OBJS+=ext/http-parser/http_parser.o
+
+ifeq ($(ZT_CONTROLLER),1)
+	ZT_NONFREE=1
+endif
+ifeq ($(ZT_NONFREE),1)
+	include objects-nonfree.mk
+	ONE_OBJS+=$(CONTROLLER_OBJS)
+	override DEFS += -DZT_NONFREE_CONTROLLER
+endif
+
+# Always use bundled miniupnpc and libnatpmp on QNX (no system packages to detect)
+override DEFS+=-DZT_USE_MINIUPNPC
+override DEFS+=-DMINIUPNP_STATICLIB -DMINIUPNPC_SET_SOCKET_TIMEOUT -DMINIUPNPC_GET_SRC_ADDR
+override DEFS+=-D_BSD_SOURCE -D_DEFAULT_SOURCE
+override DEFS+=-DOS_STRING="\"QNX/$(shell uname -r)\""
+override DEFS+=-DMINIUPNPC_VERSION_STRING="\"2.0\""
+override DEFS+=-DUPNP_VERSION_STRING="\"UPnP/1.1\""
+override DEFS+=-DENABLE_STRNATPMPERR
+ONE_OBJS+=ext/miniupnpc/connecthostport.o ext/miniupnpc/igd_desc_parse.o \
+	ext/miniupnpc/minisoap.o ext/miniupnpc/minissdpc.o ext/miniupnpc/miniupnpc.o \
+	ext/miniupnpc/miniwget.o ext/miniupnpc/minixml.o ext/miniupnpc/portlistingparse.o \
+	ext/miniupnpc/receivedata.o ext/miniupnpc/upnpcommands.o ext/miniupnpc/upnpdev.o \
+	ext/miniupnpc/upnperrors.o ext/miniupnpc/upnpreplyparse.o
+ONE_OBJS+=ext/libnatpmp/natpmp.o ext/libnatpmp/getgateway.o
+
+ifeq ($(ZT_SANITIZE),1)
+	override DEFS+=-fsanitize=address -DASAN_OPTIONS=symbolize=1
+endif
+
+ifeq ($(ZT_DEBUG),1)
+	CFLAGS+=-Wall -Wno-deprecated -g -O -pthread $(INCLUDES) $(DEFS)
+	LDFLAGS=
+	STRIP=echo
+	ZT_TRACE=1
+node/Salsa20.o node/SHA512.o node/C25519.o node/AES.o node/Poly1305.o: CFLAGS=-Wall -O2 -g -pthread $(INCLUDES) $(DEFS)
+else
+	CFLAGS?=-O3 -fstack-protector
+	CFLAGS+=-Wall -Wno-deprecated -fvisibility=hidden -fstack-protector -pthread $(INCLUDES) -DNDEBUG $(DEFS)
+	LDFLAGS=
+	STRIP=strip
+endif
+
+ifeq ($(ZT_TRACE),1)
+	override DEFS+=-DZT_TRACE
+endif
+
+# Platform identifier (matches ZT_BUILD_PLATFORM values used in other makefiles)
+ZT_BUILD_PLATFORM=13
+
+# Architecture detection from compiler target triple
+CC_MACH=$(shell $(CC) -dumpmachine | cut -d '-' -f 1)
+ZT_ARCHITECTURE=999
+ifeq ($(CC_MACH),aarch64)
+	ZT_ARCHITECTURE=4
+	override DEFS+=-DZT_NO_TYPE_PUNNING -march=armv8-a+crypto
+endif
+ifeq ($(CC_MACH),x86_64)
+	ZT_ARCHITECTURE=2
+endif
+
+ifeq ($(ZT_ARCHITECTURE),999)
+ERR=$(error FATAL: architecture could not be determined from $(CC) -dumpmachine: $(CC_MACH))
+.PHONY: err
+err: ; $(ERR)
+endif
+
+override DEFS+=-DZT_BUILD_PLATFORM=$(ZT_BUILD_PLATFORM) -DZT_BUILD_ARCHITECTURE=$(ZT_ARCHITECTURE) -DZT_SOFTWARE_UPDATE_DEFAULT="\"disable\""
+
+CXXFLAGS+=$(CFLAGS) -std=c++17 -Wno-nontrivial-memcall
+
+all: one
+
+one: $(CORE_OBJS) $(ONE_OBJS) one.o
+	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o zerotier-one $(CORE_OBJS) $(ONE_OBJS) one.o $(LIBS)
+	$(STRIP) zerotier-one
+	ln -sf zerotier-one zerotier-idtool
+	ln -sf zerotier-one zerotier-cli
+
+zerotier-one: one
+zerotier-idtool: one
+zerotier-cli: one
+zerotier-selftest: selftest
+
+libzerotiercore.a: $(CORE_OBJS)
+	ar rcs libzerotiercore.a $(CORE_OBJS)
+	ranlib libzerotiercore.a
+
+core: libzerotiercore.a
+
+selftest: $(CORE_OBJS) $(ONE_OBJS) selftest.o
+	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o zerotier-selftest selftest.o $(CORE_OBJS) $(ONE_OBJS) $(LIBS)
+	$(STRIP) zerotier-selftest
+
+clean:
+	rm -rf *.a *.o node/*.o nonfree/controller/*.o osdep/*.o service/*.o \
+		ext/http-parser/*.o ext/miniupnpc/*.o ext/libnatpmp/*.o \
+		zerotier-one zerotier-idtool zerotier-selftest zerotier-cli \
+		$(ONE_OBJS) $(CORE_OBJS)
+
+debug: FORCE
+	$(MAKE) -j ZT_DEBUG=1
+
+install: one
+	cp zerotier-one /usr/bin/zerotier-one
+	ln -sf /usr/bin/zerotier-one /usr/bin/zerotier-cli
+	ln -sf /usr/bin/zerotier-one /usr/bin/zerotier-idtool
+
+uninstall: FORCE
+	rm -f /usr/bin/zerotier-one /usr/bin/zerotier-cli /usr/bin/zerotier-idtool
+
+FORCE:

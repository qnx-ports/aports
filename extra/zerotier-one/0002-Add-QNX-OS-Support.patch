+#ifndef ZT_QNXETHERNETTAP_HPP
+#define ZT_QNXETHERNETTAP_HPP
+
+#include "../node/MAC.hpp"
+#include "../node/MulticastGroup.hpp"
+#include "EthernetTap.hpp"
+
+#include <atomic>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace ZeroTier {
+
+class QNXEthernetTap : public EthernetTap {
+  public:
+	QNXEthernetTap(
+		const char* homePath,
+		unsigned int concurrency,
+		bool pinning,
+		const MAC& mac,
+		unsigned int mtu,
+		unsigned int metric,

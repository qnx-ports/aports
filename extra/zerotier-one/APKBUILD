# Alpine-Maintainer: Kyle Parisi <kyleparisi@gmail.com>
# Maintainer: Narayana Murthy <nnarayanamurthy@qnx.com>
pkgname=zerotier-one
pkgver=1.16.1
pkgrel=0
pkgdesc="ZeroTier One allows systems to join and participate in ZeroTier virtual networks."
url="https://www.zerotier.com/"
arch="all"
license="GPL-3.0-or-later"
depends="openssl
	libc++
    qnx-io-sock
	"
makedepends="openssl-dev
	libc++-dev
	qnx-io-sock-dev
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/zerotier/ZeroTierOne/archive/refs/tags/$pkgver.tar.gz
	$pkgname.initd
    0001-Add-QNX-Support.patch
    0002-Add-QNX-OS-Support.patch
	"
builddir="$srcdir"/ZeroTierOne-$pkgver

build() {
	make
}

check() {
	make selftest && ./zerotier-selftest
}

package() {
	install -d "/usr/bin"
	install -Dm755 \
		"$builddir/zerotier-one" \
		"$pkgdir/usr/bin/zerotier-one"

	install -Dm755 \
		"$builddir/zerotier-cli" \
		"$pkgdir/usr/bin/zerotier-cli"

	install -Dm755 \
		"$builddir/zerotier-idtool" \
		"$pkgdir/usr/bin/zerotier-idtool"
}


 #endif
 
+#if defined(__QNXNTO__)
+#ifndef __UNIX_LIKE__
+#define __UNIX_LIKE__
+#endif
+// Bridge GCC/Clang compiler builtins (__BYTE_ORDER__, __ORDER_BIG_ENDIAN__) to the
+// BSD-style macros (__BYTE_ORDER, __BIG_ENDIAN, __LITTLE_ENDIAN) used throughout this
+// codebase. QNX does not ship <endian.h>; byte-order is available via compiler builtins only.
+#ifndef __BYTE_ORDER
+#define	__BIG_ENDIAN	4321
+#define	__LITTLE_ENDIAN	1234
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+#define __BYTE_ORDER __BIG_ENDIAN
+#elif defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
+#define __BYTE_ORDER __LITTLE_ENDIAN
+#else
+// Fallback: assume little-endian (safe for all known QNX targets)
+#define __BYTE_ORDER __LITTLE_ENDIAN
+#endif
+#endif
+#endif
+
 #ifndef __BYTE_ORDER
 #include <endian.h>
 #endif

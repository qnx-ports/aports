# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=mediapipe
pkgver=0.10.26
pkgrel=0
pkgdesc="Library of customizable ML solutions for live and streaming multimedia"
url="https://ai.google.dev/edge/mediapipe"
arch="all"
license="Apache-2.0"
depends="python3-$pkgname=$pkgver-r$pkgrel"
py3depends="
    python3
    python3-absl-py
    python3-attrs
    python3-cffi
    python3-contourpy
    python3-cycler
    python3-flatbuffers
    python3-fonttools
    python3-jax
    python3-jaxlib
    python3-kiwisolver
    python3-matplotlib
    python3-ml-dtypes
    python3-numpy
    python3-opencv
    python3-opt-einsum
    python3-packaging
    python3-pillow
    python3-protobuf=5.29.3-r0
    python3-cparser
    python3-parsing
    python3-dateutil
    python3-scipy
    python3-sentencepiece
    python3-six
    python3-sounddevice
    libc++
    "
makedepends="
    bazel6
    cmake
    libc++-dev
    ninja
    protobuf=27.2-r0
    protobuf-dev=27.2-r0
    opencv-dev
    python3-dev
    python3-packaging
    python3-setuptools
    python3-wheel
    "
checkdepends="$py3depends"
subpackages="
    python3-$pkgname-cpu:py3cpu
    python3-$pkgname:py3
    "
_git_rev=0
source="$pkgname-$pkgver-r$_git_rev.tar.gz::https://github.com/qnx-ports/$pkgname/archive/refs/tags/qnx-v$pkgver-r$_git_rev.tar.gz
    python_BUILD.bazel
    python_defs.bzl
    python_WORKSPACE
    python_qnx_BUILD.bazel
    python_qnx_WORKSPACE
    cpp_qnx_BUILD.bazel
    cpp_qnx_WORKSPACE
    buildbase_qnx_BUILD.bazel
    buildbase_qnx_WORKSPACE
    qnx.patch
    "
builddir="$srcdir/$pkgname-qnx-v$pkgver-r$_git_rev"

stagecpu="stage-cpu"
stage="stage"

prepare() {
    default_prepare

    # Remove the old repository cache
    rm -rf $(bazel info repository_cache)

    # Remove the old abuild cache
    bazel clean --expunge

    # Create the toolchain to register our local python.
    mkdir "$builddir"/python
    cp -L $srcdir/python_BUILD.bazel "$builddir"/python/BUILD.bazel
    cp -L $srcdir/python_defs.bzl "$builddir"/python/defs.bzl
    cp -L $srcdir/python_WORKSPACE "$builddir"/python/WORKSPACE
    # And now... We need a lot of local paths for system files to exist here.
    mkdir "$builddir"/python_qnx
    cp -L $srcdir/python_qnx_BUILD.bazel "$builddir"/python_qnx/BUILD.bazel
    cp -L $srcdir/python_qnx_WORKSPACE "$builddir"/python_qnx/WORKSPACE
    ln -s /usr/bin "$builddir"/python_qnx/bin
    mkdir "$builddir"/python_qnx/include
    ln -s /usr/include/python3.14 "$builddir"/python_qnx/include/python3.14
    mkdir "$builddir"/python_qnx/lib
    ln -s /usr/lib/python3.14 "$builddir"/python_qnx/lib/python3.14
    ln -s /usr/lib/libpython3.so "$builddir"/python_qnx/lib/libpython3.so
    ln -s /usr/lib/libpython3.14.so "$builddir"/python_qnx/lib/libpython3.14.so
    ln -s "$builddir"/python_qnx/bin/python3 "$builddir"/python_qnx/python

    mkdir "$builddir"/cpp_qnx
    cp -L $srcdir/cpp_qnx_BUILD.bazel "$builddir"/cpp_qnx/BUILD.bazel
    cp -L $srcdir/cpp_qnx_WORKSPACE "$builddir"/cpp_qnx/WORKSPACE

    # Finally, toolchains for ninja and cmake to override rules_foreign_cc.
    mkdir -p "$builddir"/buildbase_qnx/bin
    cp -L $srcdir/buildbase_qnx_BUILD.bazel "$builddir"/buildbase_qnx/BUILD.bazel
    cp -L $srcdir/buildbase_qnx_WORKSPACE "$builddir"/buildbase_qnx/WORKSPACE

    sed -i "s|__version__ = 'dev'|__version__ = '$pkgver'|" "$builddir"/setup.py
}

build() {
    # We're doing an install to a custom staging directory so we can trigger a
    # separate build during the build() phase.
    mkdir -p "$stagecpu"
    mkdir -p "$stage"

    export CUSTOM_BAZEL_ARGS="
        --override_repository=python=python
        --override_repository=python_qnx=python_qnx
        --extra_toolchains=@python_qnx//:qnx_py_toolchain
        --extra_toolchains=@python_qnx//:qnx_py_toolchain2
        --extra_toolchains=@python_qnx//:qnx_py_cc_toolchain
        --extra_toolchains=//cpp_qnx:qnx_cc_toolchain_x64
        --extra_toolchains=//cpp_qnx:qnx_cc_toolchain_arm64
        --extra_toolchains=//buildbase_qnx:qnx_cmake_toolchain
        --extra_toolchains=//buildbase_qnx:qnx_ninja_toolchain
        "

    # Preliminary build without GPU.
    # Links against the host opencv package by default.
    export BAZEL_CXXOPTS=-std=c++17
    export MEDIAPIPE_DISABLE_GPU=1
    export PROTOC=/usr/bin/protoc
    python3 setup.py build_py --link-opencv
    python3 setup.py install --skip-build --root="$builddir/$stagecpu"

    # Now the GPU build.
    export MEDIAPIPE_DISABLE_GPU=0
    python3 setup.py build_py --link-opencv
    python3 setup.py install --skip-build --root="$builddir/$stage"
}

check() {
    # No actual tests, instead we're verifying importing the py package.
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 setup.py install --skip-build

    # Module name exists under $builddir
    mkdir test
    cd test
    ../.testenv/bin/python3 -c "import mediapipe"
}

package() {
    mkdir -p "$pkgdir"
    # A bit hacky but... We're using the same name for both the cpu and gpu
    # versions of mediapipe, so we need to avoid collisions
    cp -r "$stage" "$pkgdir"
    cp -r "$stagecpu" "$pkgdir"
}

py3() {
    pkgdesc="Python3 wrapper for $subpkgname"
    depends="$py3depends"

    mkdir -p "$subpkgdir"/usr/lib
    mv "$pkgdir/$stage"/usr/lib/python3* "$subpkgdir"/usr/lib/
    rm -rf "$pkgdir/$stage"
}

py3cpu() {
    pkgdesc="Python3 wrapper for $subpkgname"
    depends="$py3depends"
    provides="python3-$pkgname=$pkgver-r$pkgrel"
    replaces="python3-$pkgname"

    mkdir -p "$subpkgdir"/usr/lib
    mv "$pkgdir/$stagecpu"/usr/lib/python3* "$subpkgdir"/usr/lib/
    rm -rf "$pkgdir/$stagecpu"
}


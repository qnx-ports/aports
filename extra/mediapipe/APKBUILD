# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=mediapipe
pkgver=0.10.26
pkgrel=0
pkgdesc="Library of customizable ML solutions for live and streaming multimedia"
url="https://ai.google.dev/edge/mediapipe"
arch="all"
license="Apache-2.0"
makedepends="
    bazel6
    cmake
    libc++-dev
    ninja
    protobuf=27.2-r0
    protobuf-dev=27.2-r0
    opencv-dev
    python3-packaging
    python3-setuptools
    python3-wheel
    "
subpackages="
    python3-$pkgname-cpu:py3
    "
source="$pkgname-$pkgver.tar.gz::https://github.com/google-ai-edge/$pkgname/archive/refs/tags/v$pkgver.tar.gz
    python_BUILD.bazel
    python_defs.bzl
    python_WORKSPACE
    python_qnx_BUILD.bazel
    python_qnx_WORKSPACE
    cpp_qnx_BUILD.bazel.tpl
    cpp_qnx_WORKSPACE
    buildbase_qnx_BUILD.bazel
    buildbase_qnx_WORKSPACE
    qnx.patch
    "
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
    default_prepare

    # Remove the old repository cache
    rm -rf $(bazel info repository_cache)

    # Remove the old abuild cache
    bazel clean --expunge

    # Create the toolchain to register our local python.
    mkdir $builddir/python
    cp -L $srcdir/python_BUILD.bazel $builddir/python/BUILD.bazel
    cp -L $srcdir/python_defs.bzl $builddir/python/defs.bzl
    cp -L $srcdir/python_WORKSPACE $builddir/python/WORKSPACE
    # And now... We need a lot of local paths for system files to exist here.
    mkdir $builddir/python_qnx
    cp -L $srcdir/python_qnx_BUILD.bazel $builddir/python_qnx/BUILD.bazel
    cp -L $srcdir/python_qnx_WORKSPACE $builddir/python_qnx/WORKSPACE
    ln -s /usr/bin $builddir/python_qnx/bin
    mkdir $builddir/python_qnx/include
    ln -s /usr/include/python3.14 $builddir/python_qnx/include/python3.14
    mkdir $builddir/python_qnx/lib
    ln -s /usr/lib/python3.14 $builddir/python_qnx/lib/python3.14
    ln -s /usr/lib/libpython3.so $builddir/python_qnx/lib/libpython3.so
    ln -s /usr/lib/libpython3.14.so $builddir/python_qnx/lib/libpython3.14.so
    ln -s /usr/share $builddir/python_qnx/share
    ln -s $builddir/python_qnx/bin/python3 $builddir/python_qnx/python

    # Create the toolchain to register our local clang.
	case "$CARCH" in
		x86_64)	        _cpu="x64" ;;
		aarch64)		_cpu="arm64"  ;;
	esac

    mkdir $builddir/cpp_qnx
    sed "s|%CPU%|$_cpu|" $srcdir/cpp_qnx_BUILD.bazel.tpl > $srcdir/cpp_qnx_BUILD.bazel
    cp $srcdir/cpp_qnx_BUILD.bazel $builddir/cpp_qnx/BUILD.bazel
    cp -L $srcdir/cpp_qnx_WORKSPACE $builddir/cpp_qnx/WORKSPACE

    # Finally, toolchains for ninja and cmake to override rules_foreign_cc.
    mkdir -p $builddir/buildbase_qnx/bin
    cp -L $srcdir/buildbase_qnx_BUILD.bazel $builddir/buildbase_qnx/BUILD.bazel
    cp -L $srcdir/buildbase_qnx_WORKSPACE $builddir/buildbase_qnx/WORKSPACE

    sed -i "s|__version__ = 'dev'|__version__ = '0.10.26'|" $builddir/setup.py
}

build() {
    # Preliminary build without GPU.
    # Links against the host opencv package by default.
    export BAZEL_CXXOPTS=-std=c++17
    export MP_DISABLE_GPU=1
    export PROTOC=/usr/bin/protoc
    python3 setup.py build_py --link-opencv
}

check() {
    # No actual tests, instead we're verifying importing the py package.
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 setup.py install --skip-build

    # Module name exists under $builddir
    mkdir test
    cd test
    ../.testenv/bin/python3 -c import mediapipe
}

package() {
    python3 setup.py install --skip-build --root="$pkgdir"
}

py3() {
    pkgdesc="Python3 wrapper for $subpkgname"
    depends="
        python3
        python3-absl-py
        python3-attrs
        python3-cffi
        python3-contourpy
        python3-cycler
        python3-flatbuffers
        python3-fonttools
        python3-jax
        python3-jaxlib
        python3-kiwisolver
        python3-matplotlib
        python3-ml-dtypes
        python3-numpy
        python3-opencv
        python3-opt-einsum
        python3-packaging
        python3-pillow
        python3-protobuf
        python3-cparser
        python3-parsing
        python3-dateutil
        python3-scipy
        python3-sentencepiece
        python3-six
        python3-sounddevice
        libc++
        "

    amove usr/lib/python*
}


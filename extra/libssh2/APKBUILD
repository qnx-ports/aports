# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Narayana Murthy <nnarayanamurthy@qnx.com>
pkgname=libssh2
pkgver=1.11.1
pkgrel=0
pkgdesc="library for accessing ssh1/ssh2 protocol servers"
url="https://libssh2.org/"
arch="all"
options="!check"
license="BSD-3-Clause"
depends="qnx-io-sock zlib-ng libssl3 libcrypto3"
makedepends_host="openssl-dev>3 zlib-ng-dev qnx-io-sock"
checkdepends="bash"
subpackages="$pkgname-dbg $pkgname-static $pkgname-dev $pkgname-doc"
source="https://www.libssh2.org/download/$pkgname-$pkgver.tar.gz
	0001-Add-QNX-Support.patch
    CVE-2026-55199.patch
    CVE-2026-55200.patch
    CVE-2026-7598.patch
    0002-tap-driver-qnx-avoid-cat-fd3.patch
	"

build() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --localstatedir=/var \
        --with-crypto=openssl \
        --with-libssl-prefix=$CBUILDROOT/ \
        --disable-docker-tests \
        --disable-rpath \
        --disable-examples-build
    make
}

check() {
	# with --disable-docker-tests above only mansyntax.sh and test_simple are
	# run, other tests require docker and a running sshd
    make check VERBOSE=1
}

package() {
	make DESTDIR="$pkgdir" install
}


# Alpine-Contributor: Fabian Affolter <fabian@affolter-engineering.ch>
# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-pillow
pkgver=12.1.1
pkgrel=0
pkgdesc="Python Imaging Library"
url="https://python-pillow.org/"
arch="all"
license="MIT-CMU"
depends="python3 qnx-io-sock"
makedepends="
    freetype-dev
    fribidi-dev
    lcms2-dev
    libjpeg-turbo-dev
    libpng-dev
    libwebp-dev
    libxcb-dev
    openjpeg-dev
    python3-gpep517
    python3-pybind11
    python3-setuptools
    python3-wheel
    python3-dev
    tiff-dev
    qnx-io-sock-dev
    zlib-dev
    "
checkdepends="python3-pytest python3-numpy"
source="https://files.pythonhosted.org/packages/source/p/pillow/pillow-$pkgver.tar.gz"
builddir="$srcdir/pillow-$pkgver"
options="!check" # todo

build() {
    export CFLAGS="$CFLAGS -O2 -lz -fPIC"
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 setup.py test
    python3 selftest.py
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="

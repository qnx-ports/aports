# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=spirv-cross
_pkgname=SPIRV-Cross
pkgver=1.4.321.0
pkgrel=0
pkgdesc="API and commands for SPIR-V runtime reflection"
url="https://github.com/KhronosGroup/SPIRV-Cross"
arch="all"
license="Apache-2.0"
depends="libc++"
depends_dev="libc++-dev"
# python3 and spirv-tools are needed for building tests.
makedepends="$depends_dev cmake glslang ninja python3 spirv-tools"
checkdepends="glslang python3 spirv-tools"
subpackages="$pkgname-cli $pkgname-static $pkgname-dev"
source="spirv-cross-$pkgver.tar.gz::https://github.com/KhronosGroup/SPIRV-Cross/archive/refs/tags/vulkan-sdk-$pkgver.tar.gz
    c_standard.patch"
builddir="$srcdir/$_pkgname-vulkan-sdk-$pkgver"

build() {
    export CFLAGS="$CFLAGS -Qunused-arguments"
    export CXXFLAGS="$CXXFLAGS -Qunused-arguments"

    # We need two separate builds in order to get both the CLI and a shared dist.
    # These installs do not overlap.
    cmake -B build-cli -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -Dspirv-cross-glslang="/usr/bin/glslangValidator" \
        -Dspirv-cross-spirv-as="/usr/bin/spirv-as" \
        -Dspirv-cross-spirv-val="/usr/bin/spirv-val" \
        -Dspirv-cross-spirv-opt="/usr/bin/spirv-opt"

    cmake -B build-shared -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DSPIRV_CROSS_CLI=OFF \
        -DSPIRV_CROSS_STATIC=OFF \
        -DSPIRV_CROSS_SHARED=ON \
        -DSPIRV_CROSS_ENABLE_TESTS=OFF

    cmake --build build-cli
    cmake --build build-shared
}

check() {
    # Another case of floating-point inaccuracies.
    ctest --test-dir build-cli -E "spirv-cross-test|spirv-cross-test-no-opt|spirv-cross-test-metal|spirv-cross-test-hlsl|spirv-cross-test-hlsl-no-opt|spirv-cross-test-opt|spirv-cross-test-metal-opt|spirv-cross-test-hlsl-opt|spirv-cross-test-reflection|spirv-cross-test-ue4|spirv-cross-test-ue4-opt|spirv-cross-test-ue4-no-opt"
}

package() {
    DESTDIR="$pkgdir" cmake --install build-cli
    DESTDIR="$pkgdir" cmake --install build-shared
}

dev() {
    default_dev

    amove usr/share/spirv_cross_c_shared
}

static() {
    default_static

    amove usr/share/spirv_cross_c
    amove usr/share/spirv_cross_core
    amove usr/share/spirv_cross_cpp
    amove usr/share/spirv_cross_glsl
    amove usr/share/spirv_cross_hlsl
    amove usr/share/spirv_cross_msl
    amove usr/share/spirv_cross_reflect
    amove usr/share/spirv_cross_util
    amove usr/lib/pkgconfig/spirv-cross-c.pc
}

cli() {
    pkgdesc="$_pkgname CLI client"
    depends="libc++"

    amove usr/bin/spirv-cross
}

sha512sums="

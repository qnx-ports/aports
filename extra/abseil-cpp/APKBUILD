# Alpine-Contributor: Bart Ribbers <bribbers@disroot.org>
# Alpine-Maintainer: Leon White <badfunkstripe@gmail.com>
# Maintainer: Elliott Mazzuca <emazzuca@qnx.com>
pkgname=abseil-cpp
pkgver=20250814.1
pkgrel=0
pkgdesc="Abseil Common Libraries (C++)"
url="https://abseil.io/"
arch="all"
license="Apache-2.0"
depends="libc++"
depends_dev="libc++-dev"
makedepends="
	$depends_dev
	cmake
	ninja
	"
checkdepends="gtest-dev tzdata"
subpackages="$pkgname-dev $pkgname-test:_test"
source="https://github.com/abseil/abseil-cpp/archive/$pkgver/abseil-cpp-$pkgver.tar.gz
	0002-abseil.patch
	test.patch
	0001-qnx-sig-t.patch
	"

# Alpine ships all Abseil runtime libraries in one package rather than one
# APK per libabsl_*.so. QNX follows the same shape: splitting per library
# caused abuild to generate broken inter-package dependencies because it could
# not resolve sibling Abseil sonames to their split packages automatically.
# The -test split is a QNX addition for two upstream-installed test-helper
# libraries that downstream CMake consumers require (see _test() below).

_configure() {
	local _builddir="$1"
	shift

	cmake -B "$_builddir" -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_CXX_STANDARD=17 \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_SKIP_INSTALL_RPATH=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DABSL_PROPAGATE_CXX_STD=ON \
		"$@"
}

build() {
	_configure build \
		-DABSL_BUILD_TESTING=ON \
		-DABSL_BUILD_TEST_HELPERS=ON \
		-DABSL_USE_EXTERNAL_GOOGLETEST=ON \
		-DABSL_FIND_GOOGLETEST=ON
	cmake --build build

	# A second build directory is used for the install payload. Tests are
	# disabled so test executables are not installed, but test-helper libraries
	# (absl::scoped_mock_log, absl::status_matchers) are kept because downstream
	# packages like protobuf reference those CMake targets at build time. This
	# keeps gtest and gmock out of the normal Abseil runtime install.
	_configure build-install \
		-DABSL_BUILD_TESTING=OFF \
		-DABSL_BUILD_TEST_HELPERS=ON \
		-DABSL_USE_EXTERNAL_GOOGLETEST=ON \
		-DABSL_FIND_GOOGLETEST=ON
	cmake --build build-install
}

check() {
	case "$CARCH" in
	s390x) local _extratest="|absl_stacktrace_test" ;;
	esac

	# Add all Abseil library directories to LD_LIBRARY_PATH for tests.
	# Use absolute paths because ctest-launched tests may run outside $builddir.
	local libdirs=$(find "$builddir"/build/absl -name "*.so" -exec dirname {} \; | sort -u | tr '\n' ':')
	export LD_LIBRARY_PATH="$libdirs:$LD_LIBRARY_PATH"

	# QNX installs tzdata but does not populate /usr/share/zoneinfo, so any
	# test that loads a named timezone (e.g. America/New_York) aborts immediately.
	# Point TZDIR at Abseil's own bundled timezone data so named-zone tests run
	# against known-good data instead of hitting a missing file.
	export TZDIR="$builddir/absl/time/internal/cctz/testdata/zoneinfo"

	# Signal and proc tests: fail on QNX because they require Linux-specific
	# signal delivery or /proc paths that are absent on QNX.
	local qnx_exclude="absl_failure_signal_handler_test"
	# Flag tests: rely on /proc/self/exe or Linux procfs for flag introspection.
	qnx_exclude="$qnx_exclude|absl_flags_flag_test|absl_flags_usage_test"
	# Log tests: depend on Linux-specific signal handlers or procfs in log sink formatting.
	qnx_exclude="$qnx_exclude|absl_log_format_test|absl_log_sink_test|absl_scoped_mock_log_test"
	qnx_exclude="$qnx_exclude|absl_log_stripping_test|absl_random_mock_distributions_test"
	# Random distribution tests: QNX libc produces different IEEE 754 rounding in
	# edge cases (least-significant-bit differences in subnormal and boundary values).
	# Same class of failure as absl_str_format_convert_test excluded below.
	qnx_exclude="$qnx_exclude|absl_random_bernoulli_distribution_test|absl_random_beta_distribution_test"
	qnx_exclude="$qnx_exclude|absl_random_poisson_distribution_test|absl_random_exponential_distribution_test"
	qnx_exclude="$qnx_exclude|absl_random_gaussian_distribution_test|absl_random_uniform_real_distribution_test"
	qnx_exclude="$qnx_exclude|absl_random_internal_iostream_state_saver_test"
	# Float and charconv precision: QNX libc strtod/printf produce different rounding
	# from glibc in IEEE 754 edge cases. Same root cause as the random distribution failures.
	qnx_exclude="$qnx_exclude|absl_numbers_test|absl_charconv_test"
	# Concurrency: hangs or exits non-zero on QNX. Candidate root cause is QNX
	# condvar/mutex semantics differing from Linux pthreads. JIRA: [TO FILE].
	qnx_exclude="$qnx_exclude|absl_blocking_counter_test"

	# https://github.com/abseil/abseil-cpp/pull/1888
	ctest --test-dir build -E "absl_str_format_convert_test|absl_raw_hash_set_test$_extratest|$qnx_exclude"
}

package() {
	DESTDIR="$pkgdir" cmake --install build-install
}

dev() {
	default_dev
	depends="$pkgname=$pkgver-r$pkgrel $pkgname-test=$pkgver-r$pkgrel libc++-dev"
}

_test() {
	pkgdesc="Abseil C++ test helper libraries"
	depends="$pkgname=$pkgver-r$pkgrel gmock gtest"

	# Abseil's CMake install rules unconditionally place two test-helper shared
	# libraries on disk: libabsl_scoped_mock_log and libabsl_status_matchers.
	# These are not test executables; they are libraries that downstream packages
	# (e.g. protobuf) link their own test binaries against. Abseil's installed
	# abslTargets.cmake always references them, so they must be present on disk
	# for any downstream CMake configure to succeed.
	# They are split here rather than kept in the main runtime package because
	# they depend on gtest and gmock, which should not be transitive dependencies
	# of a normal Abseil install.
	amove usr/lib/libabsl_scoped_mock_log.so.*
	amove usr/lib/libabsl_status_matchers.so.*
}


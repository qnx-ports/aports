for _lib in $_libs; do
	subpackages="$subpackages $pkgname-${_lib//_/-}:abseillib"
	depends="$depends $pkgname-${_lib//_/-}=$pkgver-r$pkgrel"
done

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_CXX_STANDARD=17 \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_SKIP_INSTALL_RPATH=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DABSL_BUILD_TESTING="$(want_check && echo ON || echo OFF)" \
		-DABSL_BUILD_TEST_HELPERS=ON \
		-DABSL_USE_EXTERNAL_GOOGLETEST=ON \
		-DABSL_PROPAGATE_CXX_STD=ON \
		-DABSL_FIND_GOOGLETEST=ON
	cmake --build build
}

check() {
	# Add all Abseil library directories to LD_LIBRARY_PATH for tests.
	# Use absolute paths because ctest-launched tests may run outside $builddir.
	local libdirs=$(find "$builddir"/build/absl -name "*.so" -exec dirname {} \; | sort -u | tr '\n' ':')
	export LD_LIBRARY_PATH="$libdirs:$LD_LIBRARY_PATH"

	# Signal and proc tests: fail on QNX because they require Linux-specific
	# signal delivery or /proc paths that are absent on QNX.
	local qnx_exclude="absl_failure_signal_handler_test"
	# Flag tests: rely on /proc/self/exe or Linux procfs for flag introspection.
	qnx_exclude="$qnx_exclude|absl_flags_flag_test|absl_flags_usage_test"
	# Log tests: depend on Linux-specific signal handlers or procfs in log sink formatting.
	qnx_exclude="$qnx_exclude|absl_log_format_test|absl_log_sink_test|absl_scoped_mock_log_test"
	qnx_exclude="$qnx_exclude|absl_log_stripping_test|absl_random_mock_distributions_test"
	# Random distribution tests: QNX libc produces different IEEE 754 rounding in
	# edge cases (least-significant-bit differences in subnormal and boundary values).
	# Same class of failure as absl_str_format_convert_test excluded below.
	qnx_exclude="$qnx_exclude|absl_random_bernoulli_distribution_test|absl_random_beta_distribution_test"
	qnx_exclude="$qnx_exclude|absl_random_poisson_distribution_test|absl_random_exponential_distribution_test"
	qnx_exclude="$qnx_exclude|absl_random_gaussian_distribution_test|absl_random_uniform_real_distribution_test"
	qnx_exclude="$qnx_exclude|absl_random_internal_iostream_state_saver_test"
	# Float and charconv precision: QNX libc strtod/printf produce different rounding
	# from glibc in IEEE 754 edge cases. Same root cause as the random distribution failures.
	qnx_exclude="$qnx_exclude|absl_numbers_test|absl_charconv_test"
	# Concurrency: hangs or exits non-zero on QNX. Candidate root cause is QNX
	# condvar/mutex semantics differing from Linux pthreads.
	qnx_exclude="$qnx_exclude|absl_blocking_counter_test"

	# https://github.com/abseil/abseil-cpp/pull/1888
	ctest --test-dir build -E "absl_str_format_convert_test|absl_raw_hash_set_test|$qnx_exclude"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

abseillib() {
	pkgdesc="Abseil Common C++ library: $subpkgname"
	depends="libc++"

	local libname="${subpkgname#"$pkgname"-}"
	amove usr/lib/libabsl_${libname//-/_}.so.*
}

_scoped_mock_log() {
	pkgdesc="Abseil Common C++ library: $subpkgname"
	# Links directly against gtest/gmock, which must be declared explicitly
	# since QNX abuild does not resolve them via soname scanning.
	depends="libc++ gmock gtest"

	amove usr/lib/libabsl_scoped_mock_log.so.*
}

_test() {
	pkgdesc="Abseil C++ test helper libraries (meta-package)"
	depends="abseil-cpp-scoped-mock-log=$pkgver-r$pkgrel"

	# QNX abuild requires a non-empty staging directory even for metadata-only
	# subpackages. mkdir -p is intentional.
	mkdir -p "$subpkgdir"
}

pkgname=abseil-cpp
pkgver=20230802.1
pkgrel=0
pkgdesc="Abseil Common Libraries (C++)"
url="https://abseil.io/"
arch="all"
license="Apache-2.0"
depends_dev="
    libc++-dev
    "
makedepends="
    $depends_dev
    cmake
    gtest-dev
    ninja
    "
checkdepends="tzdata"
subpackages="$pkgname-dev"
_git_rev=0
source="$pkgname-$pkgver-r$_git_rev.tar.gz::https://github.com/qnx-ports/abseil-cpp/archive/refs/tags/qnx_$pkgver-r$_git_rev.tar.gz"
builddir="$srcdir/$pkgname-qnx_$pkgver-r$_git_rev"
options="!check" # We're not testing this version.

_libs="
    bad_any_cast_impl
    bad_optional_access
    bad_variant_access

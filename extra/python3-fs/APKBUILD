pkgname=python3-fs
_pkgname=fs
pkgver=2.4.16
pkgrel=0
pkgdesc="Python's filesystem abstraction layer"
options="!check" # Tests fail on builder
url="https://pypi.org/project/fs/"
arch="noarch"
license="MIT"
depends="python3 python3-appdirs python3-six python3-setuptools"
makedepends="python3-setuptools"
checkdepends="python3-mock python3-openssl python3-psutil python3-pyftpdlib"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz
    catch-EPERM.patch
    "
builddir="$srcdir"/$_pkgname-$pkgver

build() {
    python3 setup.py build
}

check() {
    python3 setup.py test
}

package() {
    python3 setup.py install --skip-build --root="$pkgdir"
}


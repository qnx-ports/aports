pkgname=ensmallen
pkgver=3.11.0
pkgrel=0
pkgdesc="Flexible C++ library for efficient numerical optimization"
url="https://ensmallen.org/"
arch="all"
license="BSD-3-Clause"

depends="
    armadillo-dev
    bandicoot-dev
    clblast-dev
"
makedepends="
    cmake
    armadillo-dev
    bandicoot-dev
    clblast-dev
"

source="https://ensmallen.org/files/ensmallen-3.11.0.tar.gz"

build() {
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}


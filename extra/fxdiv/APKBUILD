# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=fxdiv
_pkgname=FXdiv
pkgver=1.0.0_git20200417
_pkgver=b408327ac2a15ec3e43352421954f5b1967701d1
pkgrel=0
pkgdesc="Header-only integer division via fixed-point multiplication"
url="https://github.com/Maratyszcza/FXdiv"
arch="all"
license="MIT"
depends="$pkgname-dev"
makedepends="
    cmake
    ninja
    libc++-dev
    "
subpackages="$pkgname-dev"
source="${pkgname}-${pkgver}.tar.gz::https://github.com/Maratyszcza/${_pkgname}/archive/${_pkgver}.tar.gz"
builddir="${srcdir}/${_pkgname}-${_pkgver}"

build() {
    cmake3.5 -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_CXX_FLAGS="-Qunused-arguments -w" \
        -DBUILD_SHARED_LIBS=ON \
        -DINSTALL_GTEST=OFF \
        -DFXDIV_BUILD_BENCHMARKS=OFF
    cmake3.5 --build build
}

check() {
    ctest3.5 --test-dir build
}

package() {
    DESTDIR="$pkgdir" cmake3.5 --install build
}

sha512sums="
d46d7c1437eccf8dc5ab5e51b0641d190839451ab059c8a24a220a9cf05a84a66b5d08c3ff730622efe491152a8378a2c726fd9abad19a3df98db40d6a13e4b9  fxdiv-1.0.0_git20200417.tar.gz
"

# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-beniget
pkgver=0.4.2
pkgrel=0
pkgdesc="Extract semantic information about static Python code"
url="https://github.com/serge-sans-paille/beniget"
arch="noarch"
license="BSD-3-Clause"
depends="python3-gast"
makedepends="python3-gpep517 python3-setuptools python3-wheel"
checkdepends="python3-pytest"
source="$pkgname-$pkgver.tar.gz::https://github.com/serge-sans-paille/beniget/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/beniget-$pkgver"

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pytest
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="
24a6bef4fa06cf5322c4f8b60a3685d3f9e6f095b2412d08bd04fd633bbb6bacaf8881194c4c2247da0a0fd969500dcd852d05fa2554fdc92a6fbda8a647e08e  python3-beniget-0.4.2.tar.gz
"

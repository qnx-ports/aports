# Alpine-Contributor: Alex Yam <alex@alexyam.com>
# Alpine-Contributor: Leo <thinkabit.ukim@gmail.com>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=gyp
pkgver=0.21.1
pkgrel=0
pkgdesc="Generate Your Projects Meta-Build system"
options="!check" # Tests currently fail
url="https://gyp.gsrc.io"
arch="noarch"
license="BSD-3-Clause"
depends="python3 ninja python3-packaging"
makedepends="python3-gpep517 python3-setuptools python3-wheel"
source="https://github.com/qnx-ports/gyp-next/archive/refs/tags/qnx-v$pkgver/gyp-next-qnx-$pkgver.tar.gz
	fips.patch
	"
builddir="$srcdir/gyp-next-qnx-v$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}



# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=rtosbench
pkgver=1
pkgrel=0
pkgdesc="Benchmark suite for real-time operating system services"
url="https://github.com/gchamp20/RTOSBench"
arch="all"
license="BSD 3-Clause"
options="!check"
source="https://github.com/gchamp20/RTOSBench/archive/refs/heads/master.tar.gz  rtosbench-qnx.patch"
builddir="$srcdir/RTOSBench-master"

build() {
	make \
		mq \
		mq_workload \
		mq_processing \
		mutex \
		mutex_pip \
		mutex_workload \
		mutex_processing \
		round_robin \
		sem \
		sem_processing \
		sem_prio \
		sem_workload \
		jitter
		
		echo "MAKE_EXIT=$?"
}

package() {
install -d "$pkgdir/usr/bin/rtosbench"

# Install the generated benchmark executables.
find example/qnx -type f -perm -111 \
	-exec install -m 755 {} "$pkgdir/usr/bin/rtosbench/" \;
}

sha512sums="

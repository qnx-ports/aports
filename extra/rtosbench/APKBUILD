# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=rtosbench
pkgver=0.0.1_git20240506
_pkgver=29d04a6f2131c38526dc8f55ba0495b358e30339
pkgrel=0
pkgdesc="Benchmark suite for real-time operating system services"
url="https://github.com/gchamp20/RTOSBench"
arch="all"
license="BSD 3-Clause"
options="!check"
source="https://github.com/gchamp20/RTOSBench/archive/$_pkgver.tar.gz
        rtosbench-qnx.patch"
builddir="$srcdir/RTOSBench-$_pkgver"

build() {
	make \
		mq \
		mq_workload \
		mq_processing \
		mutex \
		mutex_pip \
		mutex_workload \
		mutex_processing \
		round_robin \
		sem \
		sem_processing \
		sem_prio \
		sem_workload \
		jitter
		
		echo "MAKE_EXIT=$?"
}

package() {
	install -d "$pkgdir/usr/bin/rtosbench"

	# Install the generated benchmark executables.
	find example/qnx -type f -perm -111 \
	-exec install -m 755 {} "$pkgdir/usr/bin/rtosbench/" \;
}


fc58b0471cb0523d0152dc9375d90e96c2e170c57c650753de480168ea6236584edcf6fc83f82770dcfa83b7de39f6b7492fa9b1eb5709481c97d4773b341e8d  0001-use-system-dependencies-and-build-version.patch
"

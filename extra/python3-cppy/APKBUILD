# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-cppy
pkgver=1.3.1
pkgrel=0
pkgdesc="Collection of C++ headers for writing Python C extensions"
url="https://github.com/nucleic/cppy"
arch="noarch"
license="BSD-3-Clause"
makedepends="python3-gpep517 python3-setuptools python3-setuptools_scm python3-wheel"
subpackages=""
source="https://github.com/nucleic/cppy/archive/$pkgver/python3-cppy-$pkgver.tar.gz"
builddir="$srcdir/cppy-$pkgver"

build() {
    export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 tests/test_getting_include_dir.py
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/cppy*.whl
}

sha512sums="
5f2b9bbb500385dd138aa6eb4eb37c495f36b550554ef8f26c88802a69f5b5118549e010fdb2e526c19a0de1fc988642d7cdec6f357a1cd87edc3bf9a74fcfc9  python3-cppy-1.3.1.tar.gz
"

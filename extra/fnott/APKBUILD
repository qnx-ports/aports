39980eb3a268c6cf7f3547a5aeeacf88e7f2c7019287a1edf7e8657f445233371518adf9a23ff6e5bf775e624a9ba0b0fa61ce8144dec474b4f7f3e7f1b6b11e  input-event-codes.h
45432b757c0ff8efb7227babe7a0a7e9601e5f4d746a32e671064a83c53c072376441b6065ffa34805975cf17ff48cc04aff73cdceecf76b27287699b6dbd78c  fnott.initd
"

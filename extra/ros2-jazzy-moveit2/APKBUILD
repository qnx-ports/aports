prepare() {
        cd "$builddir"
        _apply_qnx_patch() {
                local _dir="$1"
                local _patch="$2"
                git -C "$builddir/$_dir" apply --whitespace=nowarn "$srcdir/$_patch"
        }
        _apply_qnx_patch moveit2-2.12.4 moveit2.patch
}

build() {
        cd "$builddir"
        export CXXFLAGS="${CXXFLAGS//-fstack-clash-protection/}"
        export CFLAGS="${CFLAGS//-fstack-clash-protection/}"
	export COLCON_EXTENSION_BLOCKLIST=colcon_core.event_handler.desktop_notification
        source /opt/ros/jazzy/setup.bash
        colcon build --merge-install \
                --cmake-args \
                        -G Ninja \
                        -DBUILD_TESTING=OFF \
                        -DCMAKE_BUILD_TYPE=Release \
                        -DCMAKE_C_FLAGS="$CFLAGS -fvisibility=default -frtti -DSA_RESTART=0 -DBT_USE_DOUBLE_PRECISION -Wno-error=old-style-cast -Wno-error=inconsistent-missing-override -Wno-error=overloaded-virtual -Wno-error=ignored-optimization-argument -Wno-error=unknown-warning-option -Wno-error=pessimizing-move -Wno-error=braced-scalar-init" \
                        -DCMAKE_CXX_FLAGS="$CXXFLAGS -fvisibility=default -frtti -DSA_RESTART=0 -DBT_USE_DOUBLE_PRECISION -Wno-error=old-style-cast -Wno-error=inconsistent-missing-override -Wno-error=overloaded-virtual -Wno-error=ignored-optimization-argument -Wno-error=unknown-warning-option -Wno-error=pessimizing-move -Wno-error=braced-scalar-init" \
                        -DCMAKE_EXE_LINKER_FLAGS="-lsocket -lfsnotify -lc++ -lc++abi -Wl,-E" \
                        -DCMAKE_SHARED_LINKER_FLAGS="-lsocket -lfsnotify -lc++ -lc++abi -Wl,-E" \
                        -DTRACETOOLS_TRACEPOINTS_EXCLUDED=ON \
                        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
			-DWITH_OPENGL=OFF \
                --packages-skip \
                        moveit_ros_visualization \
                        moveit_setup_framework \
                        moveit_setup_core_plugins \
                        moveit_setup_app_plugins \
                        moveit_setup_controllers \
                        moveit_setup_simulation \
                        moveit_setup_assistant \
			moveit_setup_srdf_plugins
}

package() {
        dest="/opt/ros/jazzy"
        mkdir -p "$pkgdir/$dest"
        for _d in lib share include bin etc opt tools; do
                if [ -d "$builddir/install/$_d" ]; then
                        cp -a "$builddir/install/$_d" "$pkgdir/$dest"
                fi
        done
}

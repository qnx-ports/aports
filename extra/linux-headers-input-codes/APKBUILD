# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=linux-headers-input-codes
pkgdesc="Provides input-event-codes for packages from kernel uapi"
pkgver=7.2.9
pkgrel=0
arch="noarch"
url="https://github.com/torvalds/linux"
vcs_url="https://git.kernel.org/"
license="GPL-2.0 WITH Linux-syscall-note" # see https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/LICENSES/exceptions/Linux-syscall-note
options="!check" # just a header file
source="
https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
input.h
"

builddir="$srcdir/linux-$pkgver"

unpack(){
	default_unpack
    # bring our own input.h since linux adds a bunch of stuff which might not work for us
    cp "$srcdir"/input.h "$builddir"/include/uapi/linux/input.h 
}

build(){
    # static files, nothing to build
    return 0
}

package(){
    for header in linux/input.h linux/input-event-codes.h; do
        install -D -m 644 "$builddir"/include/uapi/$header "$pkgdir"/usr/include/$header
    done
}

sha512sums="

# Alpine-Contributor: Bart Ribbers <bribbers@disroot.org>
# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-pytest-trio
pkgver=0.8.0
pkgrel=0
pkgdesc="pytest plugin for trio"
url="https://github.com/python-trio/pytest-trio"
arch="noarch"
license="MIT OR Apache-2.0"
depends="
	python3
	python3-pytest
	python3-trio
	python3-outcome
	python3-async_generator
"
makedepends="
	python3-setuptools
	python3-gpep517
"
checkdepends="python3-hypothesis"
source="
	https://pypi.python.org/packages/source/p/pytest-trio/pytest-trio-$pkgver.tar.gz
	001-test_hypothesis_interaction_py.patch
	002-plugin_py.patch
"
builddir="$srcdir/pytest-trio-$pkgver"

prepare() {
	default_prepare
	# Defining 'pytest_plugins' in a non-top-level conftest is no longer supported
	if [ -f "$builddir"/pytest_trio/_tests/conftest.py ]; then
		rm "$builddir"/pytest_trio/_tests/conftest.py
	fi
	echo 'pytest_plugins = ["pytester"]' >> "$builddir"/conftest.py
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# A patch to workaround the incompatibility of this version to pytest 8.4
	# https://github.com/python-trio/pytest-trio/issues/151
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}



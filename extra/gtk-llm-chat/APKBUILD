# Maintainer: Cris Sinnott <csinnott@qnx.com>
pkgname=python3-gtk-llm-chat
pkgver=4.0.5
pkgrel=0
pkgdesc="GTK4 / libadwaita LLM chat UI for QNX"
url="https://github.com/icarito/gtk-llm-chat"
arch="noarch"
license="GPL-3.0-or-later"
depends="
    python3
    python3-gobject3
    libadwaita
    "
makedepends="python3-installer"
source="https://files.pythonhosted.org/packages/05/cb/a1098e55004c1087ae1ce7e3b861c64ec1bf99302d47455dcf52c92e2a6f/gtk_llm_chat-$pkgver-py3-none-any.whl
    0001-qnx-welcome-use-adw-window.patch
    0002-qnx-chat-window-size-and-scroll.patch
    "
builddir="$srcdir/gtk_llm_chat-$pkgver"
options="!check"

# LLM backend dependencies (pip-installed separately into a venv):
#   pip install 'llm==0.19' 'openai==1.35.0' 'httpx==0.27.2' 'pydantic<2'
#   pip install extra-openai-models
# See: https://github.com/qnx/codelabs/gtk-llm-chat

prepare() {
    mkdir -p "$builddir"
    cd "$builddir"
    # wheel is a zip; extract manually then let default_prepare apply patches
    unzip -q "$srcdir/gtk_llm_chat-$pkgver-py3-none-any.whl"
    default_prepare
}

package() {
    # Install from the original wheel to get the console_scripts entry-point
    # and dist-info, then overwrite with the patched Python files.
    python3 -m installer -d "$pkgdir" \
        "$srcdir/gtk_llm_chat-$pkgver-py3-none-any.whl"

    local sitepkg
    sitepkg=$(echo "$pkgdir"/usr/lib/python3*/site-packages)

    install -m644 "$builddir/gtk_llm_chat/welcome.py" \
        "$sitepkg/gtk_llm_chat/welcome.py"
    install -m644 "$builddir/gtk_llm_chat/chat_window.py" \
        "$sitepkg/gtk_llm_chat/chat_window.py"
}


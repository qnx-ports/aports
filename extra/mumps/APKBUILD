# Maintainer: Terence Ang <taang@qnx.com>
pkgname=mumps
pkgver=5.9.0
pkgrel=0
pkgdesc="MUltifrontal Massively Parallel sparse direct Solver"
url="https://mumps-solver.org/"
arch="all"
license="CeCILL-C"
depends="
    openblas
    openmp
"
makedepends="
    openblas-dev
    openmp-dev
    flang22
"
subpackages="$pkgname-dev"
source="
    https://deb.debian.org/debian/pool/main/m/mumps/mumps_$pkgver.orig.tar.gz
    Makefile.inc
"
builddir="$srcdir/MUMPS_$pkgver"

prepare() {
    default_prepare

    cp "$srcdir"/Makefile.inc "$builddir"
}

build() {
    make -j"$nproc" allshared
}

check() {
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$PWD/lib"

    cd examples
    tests="c_example c_example_save_restore dsimpletest dsimpletest_save_restore"
    inputs="input_simpletest_cmplx input_simpletest_real"

    for test in $tests; do
        for input in $inputs; do
            printf "%-30s %-30s " "$test" "$input"

            if ./"$test" < ./"$input"; then
                echo "PASSED: $PWD/$test < $PWD/$input"
            else
                echo "FAILED: $PWD/$test < $PWD/$input"
                return 1
            fi
        done
    done
}

package() {
    install -d "$pkgdir/usr/lib"
    install -d "$pkgdir/usr/include/mumps"
    install -d "$pkgdir/usr/include/mumps/mumps_seq"
    install -d "$pkgdir/usr/include/mumps/PORD"

    install -m755 lib/*.so "$pkgdir/usr/lib"
    install -m755 libseq/*.so "$pkgdir/usr/lib"
 
    install -m644 include/*.h "$pkgdir/usr/include/mumps"
    install -m644 libseq/*.h "$pkgdir/usr/include/mumps/mumps_seq"
    install -m644 PORD/include/*.h "$pkgdir/usr/include/mumps/PORD"
}



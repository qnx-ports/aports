# Maintainer: Deep Chordia <dchordia@qnx.com>
pkgname=piper1-gpl
pkgver=1.8.0_p0
pkgrel=0
_espeakng_commit="212928b394a96e8fd2096616bfd54e17845c48f6"
pkgdesc="Fast and local neural text-to-speech engine"
url="https://github.com/OHF-Voice/piper1-gpl/tree/main/docs"
arch="all"
license="GPL-3.0-or-later"
depends="
    libc++
    onnxruntime
    "
depends_dev="
    libc++-dev
    onnxruntime-dev
    "
makedepends="
    $depends_dev
    cmake
    ninja
    python3-dev
    python3-gpep517
    python3-setuptools
    python3-wheel
    python3-scikit-build
    python3-installer
    "
subpackages="$pkgname-dev python3-piper-tts:_python3"
source="
    piper1-gpl-$pkgver.tar.gz::https://github.com/qnx-ports/piper1-gpl/archive/refs/tags/qnx-v$pkgver.tar.gz
    espeak-ng-$_espeakng_commit.tar.gz::https://github.com/espeak-ng/espeak-ng/archive/$_espeakng_commit.tar.gz
    0001-espeak-ng_patch
"
builddir="$srcdir/$pkgname-qnx-v$pkgver"
options="!check" # tests require downloading ~200MB of models

prepare() {
    default_prepare
    (cd "$srcdir"/espeak-ng-$_espeakng_commit && patch ${patch_args:--p1} -i "$srcdir/0001-espeak-ng_patch")
    ln -sf "$srcdir"/espeak-ng-$_espeakng_commit "$builddir"/espeak-ng
    ln -sf "$srcdir"/espeak-ng-$_espeakng_commit "$builddir"/libpiper/espeak-ng
}

build() {
    cmake -B build-cpp -S libpiper -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DPIPER_BUILD_TESTS=OFF \
        -DQNX=1
    cmake --build build-cpp

    CMAKE_ARGS="-DQNX=1" gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

package() {
    DESTDIR="$pkgdir" cmake --install build-cpp

    mkdir -p "$pkgdir"/usr/share/piper
    mv "$pkgdir"/usr/share/espeak-ng-data "$pkgdir"/usr/share/piper/
}

_python3() {
    pkgdesc="Python CLI and runtime library for Piper TTS"
    depends="
        python3
        python3-onnxruntime
        python3-pathvalidate
        "

    python3 -m installer -d "$subpkgdir" \
        "$builddir"/.dist/*.whl
}


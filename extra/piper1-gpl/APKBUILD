1dbdb49441437989811b7bd1177c9c5d5baff229f7214e31e38c40bac7c86d3b94cb10ed5b387e0b81a20b26b4666a91bd62cfad3dcd505343573ffe3fd68b09  espeak-ng-212928b394a96e8fd2096616bfd54e17845c48f6.tar.gz
0076e03e8ff14d45979f8a1cb2048ddee6cedd2a1a605647b3ee123bbedf0785cd3a1bdc4b09b3da5ea8aebd5cacfbfb832a761e123f50258a28e2b6b723c1c8  0001-espeak-ng_patch

+    # QNX: fork() of a large Python process fails with ENOMEM,
+    # so use posix_spawn, which doesn't duplicate the address space.
+    if os.uname().sysname == "QNX":
+        if shell:
+            argv = ["/bin/sh", "-c", cmd if isinstance(cmd, str) else shlex.join(cmd)]
+        else:
+            argv = shlex.split(cmd) if isinstance(cmd, str) else list(cmd)
+        actions = []
+        if not verbose:
+            actions = [
+                (os.POSIX_SPAWN_OPEN, 1, os.devnull, os.O_WRONLY, 0o666),
+                (os.POSIX_SPAWN_DUP2, 1, 2),
+            ]
+        pid = os.posix_spawnp(argv[0], argv, os.environ, file_actions=actions)
+        return os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1]) 
+    else:
+        return call(

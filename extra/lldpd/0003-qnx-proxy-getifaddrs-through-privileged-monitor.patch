+#ifdef HOST_OS_QNX
+/* Wire format for one getifaddrs() entry, covering only what
+ * interfaces-bsd.c's ifbsd_extract()/ifbsd_extract_device() consume.
+ * Used to proxy interface enumeration through the privileged monitor:
+ * on QNX, getifaddrs() needs to reach /dev/socket (QNX's socket
+ * implementation is resource-manager/filesystem backed, unlike
+ * Linux/BSD), which is unreachable from the unprivileged worker once
+ * it has chroot()ed into the (deliberately empty) privsep jail. The
+ * monitor never chroots, so it can call the real getifaddrs() freely
+ * and hand the results down over the existing privsep channel. */
+struct priv_ifaddr {
+	char name[IFNAMSIZ];
+	int flags;
+	sa_family_t family; /* AF_LINK, AF_INET or AF_INET6 */
+	union {
+		struct {
+			u_char type;
+			u_short index;
+			u_char mac[ETHER_ADDR_LEN];
+		} link;
+		struct sockaddr_in in;
+		struct sockaddr_in6 in6;
+	} addr;
+};
+
+/* Proxy for getifaddrs(). Reconstructs a getifaddrs()-compatible list so
+ * ifbsd_extract()/ifbsd_extract_device() can be reused unchanged. */
+int
+priv_getifaddrs(struct ifaddrs **ifap)
+{
+	int count, i;
+	enum priv_cmd cmd = PRIV_GET_IFADDRS;
+	struct ifaddrs *head = NULL, *tail = NULL;
+
+	must_write(PRIV_UNPRIVILEGED, &cmd, sizeof(enum priv_cmd));
+	priv_wait();
+	must_read(PRIV_UNPRIVILEGED, &count, sizeof(int));
+	if (count < 0) {
+		*ifap = NULL;
+		return -1;
+	}
+
+	for (i = 0; i < count; i++) {
+		struct priv_ifaddr entry;
+		struct ifaddrs *ifa;
+
+		must_read(PRIV_UNPRIVILEGED, &entry, sizeof(entry));
+
+		if ((ifa = calloc(1, sizeof(struct ifaddrs))) == NULL)
+			fatal("privsep", NULL);
+		if ((ifa->ifa_name = strdup(entry.name)) == NULL)
+			fatal("privsep", NULL);
+		ifa->ifa_flags = entry.flags;
+
+		if (entry.family == AF_LINK) {
+			struct sockaddr_dl *sdl;
+			if ((sdl = calloc(1, sizeof(struct sockaddr_dl))) == NULL)
+				fatal("privsep", NULL);
+			sdl->sdl_len = sizeof(struct sockaddr_dl);
+			sdl->sdl_family = AF_LINK;
+			sdl->sdl_index = entry.addr.link.index;
+			sdl->sdl_type = entry.addr.link.type;
+			sdl->sdl_nlen = strlen(entry.name);
+			sdl->sdl_alen = ETHER_ADDR_LEN;
+			memcpy(sdl->sdl_data, entry.name, sdl->sdl_nlen);
+			memcpy(sdl->sdl_data + sdl->sdl_nlen, entry.addr.link.mac,
+			    ETHER_ADDR_LEN);
+			ifa->ifa_addr = (struct sockaddr *)sdl;
+		} else if (entry.family == AF_INET) {
+			struct sockaddr_in *sin;
+			if ((sin = malloc(sizeof(struct sockaddr_in))) == NULL)
+				fatal("privsep", NULL);
+			memcpy(sin, &entry.addr.in, sizeof(struct sockaddr_in));
+			ifa->ifa_addr = (struct sockaddr *)sin;
+		} else {
+			struct sockaddr_in6 *sin6;
+			if ((sin6 = malloc(sizeof(struct sockaddr_in6))) == NULL)
+				fatal("privsep", NULL);
+			memcpy(sin6, &entry.addr.in6, sizeof(struct sockaddr_in6));
+			ifa->ifa_addr = (struct sockaddr *)sin6;
+		}
+
+		if (tail) tail->ifa_next = ifa;
+		else head = ifa;
+		tail = ifa;
+	}
+
+	*ifap = head;
+	return 0;
+}
+
+void
+priv_freeifaddrs(struct ifaddrs *ifap)
+{
+	struct ifaddrs *next;
+	while (ifap) {
+		next = ifap->ifa_next;
+		free(ifap->ifa_name);
+		free(ifap->ifa_addr);
+		free(ifap);
+		ifap = next;
+	}
+}
+#endif /* HOST_OS_QNX */

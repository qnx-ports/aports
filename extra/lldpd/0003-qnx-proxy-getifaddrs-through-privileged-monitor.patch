+#ifdef HOST_OS_QNX
 static void
+asroot_get_ifaddrs()
+{
+	struct ifaddrs *ifaddrs = NULL, *ifa;
+	int rc;
+
+	if (getifaddrs(&ifaddrs) < 0) {
+		rc = -1;
+		must_write(PRIV_PRIVILEGED, &rc, sizeof(int));
+		return;
+	}
+
+	rc = 0;
+	for (ifa = ifaddrs; ifa != NULL; ifa = ifa->ifa_next) {
+		if (!ifa->ifa_name || !ifa->ifa_addr) continue;
+		if (ifa->ifa_addr->sa_family != AF_LINK &&
+		    ifa->ifa_addr->sa_family != AF_INET &&
+		    ifa->ifa_addr->sa_family != AF_INET6)
+			continue;
+		rc++;
+	}
+	must_write(PRIV_PRIVILEGED, &rc, sizeof(int));
+
+	for (ifa = ifaddrs; ifa != NULL; ifa = ifa->ifa_next) {
+		struct priv_ifaddr entry;
+		if (!ifa->ifa_name || !ifa->ifa_addr) continue;
+		memset(&entry, 0, sizeof(entry));
+		entry.family = ifa->ifa_addr->sa_family;
+		if (entry.family != AF_LINK && entry.family != AF_INET &&
+		    entry.family != AF_INET6)
+			continue;
+		strlcpy(entry.name, ifa->ifa_name, sizeof(entry.name));
+		entry.flags = ifa->ifa_flags;
+		if (entry.family == AF_LINK) {
+			struct sockaddr_dl *sdl =
+			    ALIGNED_CAST(struct sockaddr_dl *, ifa->ifa_addr);
+			entry.addr.link.type = sdl->sdl_type;
+			entry.addr.link.index = sdl->sdl_index;
+			memcpy(entry.addr.link.mac, LLADDR(sdl), ETHER_ADDR_LEN);
+		} else if (entry.family == AF_INET) {
+			memcpy(&entry.addr.in, ifa->ifa_addr,
+			    sizeof(struct sockaddr_in));
+		} else {
+			memcpy(&entry.addr.in6, ifa->ifa_addr,
+			    sizeof(struct sockaddr_in6));
+		}
+		must_write(PRIV_PRIVILEGED, &entry, sizeof(entry));
+	}
+	freeifaddrs(ifaddrs);
+}
+#endif /* HOST_OS_QNX */

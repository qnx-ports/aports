# Alpine-Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Alpine-Maintainer: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Marcin Sochacki <msochacki@qnx.com>
pkgname=lldpd
pkgver=1.0.22
pkgrel=0
pkgdesc="Implementation of IEEE 802.1ab"
url="https://lldpd.github.io/"
arch="all"
license="ISC"
makedepends="autoconf automake libtool
	libevent-dev libxml2-dev jansson-dev
	perl-dev readline-dev"
checkdepends="check check-dev"
install="$pkgname.post-install"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	"
pkgusers="lldpd"
pkggroups="lldpd"
source="$pkgname-$pkgver.tar.gz::https://github.com/lldpd/lldpd/archive/refs/tags/$pkgver.tar.gz
	lldpd.initd
	0001-qnx-recognize-nto-qnx-and-build-bsd-backend.patch
	0002-qnx-open-ioctl-socket-before-privsep-chroot.patch
	0003-qnx-proxy-getifaddrs-through-privileged-monitor.patch
	0004-qnx-open-route-socket-before-privsep-chroot.patch
	0005-qnx-use-single-dev-bpf-clone-device.patch
	0006-qnx-treat-enoent-as-stale-socket-in-retry-loop.patch
	"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	default_prepare
	echo $pkgver > .dist-version
	"$builddir"/autogen.sh
}

build() {
	export LDFLAGS="$LDFLAGS -lsocket -lregex"
	# QNX's userspace <signal.h> has SA_RESTART commented out ("not supported
	# yet"), so src/daemon/priv.c's two privileged-monitor sigaction structs
	# (SIGALRM/SIGTERM/SIGHUP/SIGINT/SIGQUIT and SIGCHLD) fail to compile
	# with "use of undeclared identifier 'SA_RESTART'" unless something
	# defines it. Forcing it to 0 here (rather than patching priv.c) is safe
	# for those two handlers specifically: that process's own blocking I/O
	# (may_read/must_read/must_write in privsep_io.c) already retries
	# explicitly on EINTR/EAGAIN in a while loop, independent of SA_RESTART.
	export CPPFLAGS="$CPPFLAGS -DSA_RESTART=0"
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--sbindir=/usr/bin \
		--prefix=/usr \
		--localstatedir=/var \
		--sysconfdir=/etc \
		--enable-static=no \
		--enable-min-macro \
		--with-privsep-user=lldpd \
		--with-privsep-group=lldpd \
		--with-privsep-chroot=/var/empty \
		--with-lldpd-ctl-socket=/var/run/$pkgname/$pkgname.socket \
		--with-lldpd-pid-file=/var/run/$pkgname/$pkgname.pid
	make
}

check() {
	make check
}

package() {
	install -d "$pkgdir"/var/empty
	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir/etc/init.d/$pkgname"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	make DESTDIR="$pkgdir" install
}

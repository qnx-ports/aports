# Alpine-Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Alpine-Maintainer: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Marcin Sochacki <msochacki@qnx.com>
pkgname=lldpd
pkgver=1.0.19_p0
pkgrel=0
pkgdesc="Implementation of IEEE 802.1ab"
url="https://lldpd.github.io/"
arch="all"
license="ISC"
makedepends="autoconf automake libtool 
	libevent-dev libxml2-dev jansson-dev
	perl-dev readline-dev"
checkdepends="check check-dev"
install="$pkgname.post-install"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	"
pkgusers="lldpd"
pkggroups="lldpd"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/lldpd/archive/refs/tags/qnx-$pkgver.tar.gz
	lldpd.initd"
builddir="$srcdir/$pkgname-qnx-$pkgver"

prepare() {
	# this should be shipped with the release tarball
	echo $pkgver > .dist-version
	"$builddir"/autogen.sh
	default_prepare
}

build() {

	export LDFLAGS="$LDFLAGS -lsocket -lregex"
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--sbindir=/usr/bin \
		--prefix=/usr \
		--localstatedir=/var \
		--sysconfdir=/etc \
		--enable-static=no \
		--enable-min-macro \
		--with-privsep-user=lldpd \
		--with-privsep-group=lldpd \
		--with-privsep-chroot=/var/empty \
		--with-lldpd-ctl-socket=/run/$pkgname/$pkgname.socket \
		--with-lldpd-pid-file=/run/$pkgname/$pkgname.pid
	make
}

check() {
	make check
}

package() {
	install -d "$pkgdir"/var/empty
	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir/etc/init.d/$pkgname"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	make DESTDIR="$pkgdir" install
}



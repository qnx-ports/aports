# Alpine-Contributor: Aiden Grossman <agrossman154@yahoo.com>
# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-jupyter_core
pkgver=5.9.1
pkgrel=0
pkgdesc="Core Jupyter functionality"
url="https://github.com/jupyter/jupyter_core"
arch="noarch"
license="BSD-3-Clause"
depends="python3-traitlets python3-platformdirs"
makedepends="python3-hatchling python3-gpep517"
checkdepends="python3-pytest"
source="$pkgname-$pkgver.tar.gz::https://github.com/jupyter/jupyter_core/archive/refs/tags/v$pkgver.tar.gz
    qnx-path-tests.patch"
builddir="$srcdir/jupyter_core-$pkgver"

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    pytest \
        --deselect tests/test_command.py::test_not_on_path \
        --deselect tests/test_command.py::test_path_priority \
        --deselect tests/test_paths.py::test_jupyter_path_prefer_env \
        --deselect tests/test_paths.py::test_jupyter_path_user_site \
        --deselect tests/test_paths.py::test_jupyter_path_no_user_site \
        --deselect tests/test_command.py::test_argv0 \
        --deselect tests/test_troubleshoot.py::test_troubleshoot
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/jupyter_core-$pkgver-py3-none-any.whl
}

sha512sums="
52b79630205d320561f6d5e7bf6c3b238fe2e09d4a744075a45f348f2442df7b4d989dd9b9f171b12dfb6071bea731dbd1593a013b9aa8ded5b58a6069f5a68e  python3-jupyter_core-5.9.1.tar.gz
846b5e23504927bfe90637fc8d00dd087ceca14ddd80ef4e45b8d8fa36e091dd11cdc17196ef3854e6df26017bb6fa3189139fe16f72084c79896d6a853d27c5  qnx-path-tests.patch
"

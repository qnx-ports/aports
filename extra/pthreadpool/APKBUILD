8a2ef9b5c3353bbb53be3584bccf5bf0ebda99ff903b55d34a966768e3acfead08d1d981e7428697166e028067c90f31cbcf793a39d07d76c31b2fb51787f74e  b408327ac2a15ec3e43352421954f5b1967701d1.zip
c1fdb43cd730bcf241a5c7e3ebb8601220c2aff930cb7540a023e9ab90879b54a131123b351d836c60ab08fd1d3f4fd8db04b40ba7dfa9ad750c9131721c372e  FXdiv_patch

# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=pthreadpool
pkgver=1.0.0_git20240116
_pkgver=0e6ca13779b57d397a5ba6bfdcaa8a275bc8ea2e
pkgrel=1
pkgdesc="Portable thread pool for C/C++"
url="https://github.com/google/pthreadpool"
arch="all"
license="BSD-2-Clause"
depends=""
makedepends="
    cmake
    ninja
    clang
    libc++-dev
    "
subpackages="$pkgname-dev"
_fxdiv_ver="b408327ac2a15ec3e43352421954f5b1967701d1"
source="${pkgname}-${pkgver}.zip::https://github.com/google/pthreadpool/archive/${_pkgver}.zip
    https://github.com/Maratyszcza/FXdiv/archive/$_fxdiv_ver.zip
    FXdiv_patch
    "
builddir="${srcdir}/pthreadpool-${_pkgver}"
_fxdiv_builddir="${srcdir}/FXdiv-${_fxdiv_ver}"

unpack() {
    # Workaround for busybox bug.
    cd $srcdir
    for u in $source; do
        local s
        if is_remote "$u"; then
            s="$SRCDEST/$(filename_from_uri $u)"
        else
            s="$startdir/$u"
        fi
        case "$s" in
            *.zip)
                msg "Unpacking $s..."
                unzip -n -q "$s";;
        esac
    done
}

prepare() {
    default_prepare

    (cd $_fxdiv_builddir && patch ${patch_args:--p1} -i "$srcdir/FXdiv_patch")
}

build() {
    CC=clang \
    CXX=clang++ \
    cmake3.5 -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_CXX_FLAGS="-Qunused-arguments -w" \
        -DBUILD_SHARED_LIBS=ON \
        -DPTHREADPOOL_BUILD_TESTS=ON \
        -DPTHREADPOOL_BUILD_BENCHMARKS=OFF \
        -DINSTALL_GTEST=OFF \
        -DFXDIV_SOURCE_DIR="$_fxdiv_builddir"
    cmake3.5 --build build
}

check() {
    ctest3.5 --test-dir build
}

package() {
    DESTDIR="$pkgdir" cmake3.5 --install build
}

sha512sums="

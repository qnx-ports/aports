# Alpine-Contributor: Leonardo Arena <rnalrd@alpinelinux.org>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=libuuid
pkgver=2.41.3
pkgrel=0
pkgdesc="DCE compatible Universally Unique Identifier library"
url="https://git.kernel.org/cgit/utils/util-linux/util-linux.git"
arch="all"
license="BSD-3-Clause"
subpackages="
    uuidgen
    $pkgname-static         
    $pkgname-dev            
" 
makedepends="meson bison flex"
builddir="$srcdir/util-linux-$pkgver"
options="!check"

case $pkgver in
	*.*.*) _v=${pkgver%.*};;
	*.*) _v=$pkgver;;
esac
source="
https://www.kernel.org/pub/linux/utils/util-linux/v$_v/util-linux-$pkgver.tar.xz
ttydefaults.h
00-qnx-build.patch
"

prepare() {
	default_prepare

    mkdir -p "$builddir/sys"

    cp "$srcdir/ttydefaults.h" "$builddir/sys/ttydefaults.h"
}

build() {
    export C_INCLUDE_PATH="$C_INCLUDE_PATH:$builddir" 

    echo "$C_INCLUDE_PATH"

    # Inspiration taken from https://cgit.freebsd.org/ports/tree/misc/libuuid since we are not linux, we don't support as much stuff
    meson setup build  \
        --auto-features=disabled \
		-Dallow-32bit-time=true \
		-Dbuild-libuuid=enabled\
		-Ddefault_library=both \
		-Dprogram-tests=false \
        -Dprefix=/usr \
        -Dsbindir=/usr/bin

    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install -C build
}

uuidgen() {
	install_if="$pkgname=$pkgver-r$pkgrel"
    license="GPL-1.0-only"
    pkgdesc="UUID generator from util-linux"
	depends="libuuid"

	local dir; for dir in usr/bin usr/sbin bin sbin; do
		if [ -e "$pkgdir"/$dir/uuidgen ]; then
			amove $dir/uuidgen
			return 0
		fi
	done
	return 1
}




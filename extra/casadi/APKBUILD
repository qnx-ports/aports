# Maintainer: Terence Ang <taang@qnx.com>
pkgname=casadi
pkgver=3.8.2
pkgrel=0
pkgdesc="CasADi is a symbolic framework for numeric optimization implementing automatic differentiation"
url="https://github.com/casadi/casadi"
arch="all"
license="LGPL-3.0-or-later"
depends="
    libc++
    ipopt
    suitesparse
    openblas
    osqp
    mumps
    tinyxml2
    openmp
"
makedepends="
    cmake
    ninja
    swig
    python3-dev
    python3-numpy-dev
    eigen-dev
    libc++-dev
    ipopt-dev
    suitesparse-dev
    openblas-dev
    osqp-static
    osqp-dev
    mumps-dev
    tinyxml2-dev
    openmp-dev
"
checkdepends="
    python3-looseversion
    python3-pytest
"
subpackages="
    $pkgname-utils
    $pkgname-tests
    $pkgname-examples
    python3-$pkgname:py3
    $pkgname-dev
"
source="$pkgname-$pkgver.tar.gz::https://github.com/casadi/casadi/archive/refs/tags/$pkgver.tar.gz"

build() {
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DWITH_PYTHON=ON \
        -DWITH_OCTAVE=OFF \
        -DWITH_MATLAB=OFF \
        -DWITH_IPOPT=ON \
        -DWITH_BUILD_IPOPT=OFF \
        -DWITH_CSPARSE=ON \
        -DWITH_BUILD_CSPARSE=OFF \
        -DWITH_LAPACK=ON \
        -DWITH_OSQP=ON \
	-DWITH_BUILD_OSQP=OFF \
        -DWITH_MUMPS=ON \
        -DWITH_BUILD_MUMPS=OFF \
        -DMUMPS_INCLUDE_DIR="/usr/include/mumps" \
        -DCMAKE_CXX_FLAGS="-I/usr/include/mumps" \
        -DWITH_TINYXML=ON \
        -DWITH_BUILD_TINYXML=OFF \
        -DWITH_OPENCL=ON \
        -DWITH_OPENMP=ON \
        -DWITH_SUNDIALS=OFF \
        -DWITH_SNOPT=OFF \
        -DWITH_DEEPBIND=OFF \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DLIBMAD_TAR_PATH=/dummy/path \
        -DCMAKE_INSTALL_PREFIX=/usr

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

utils() {
    pkgdesc="$pkgname CLI"
    depends="$pkgname=$pkgver-r$pkgrel"
    amove usr/bin/casadi-cli
}

tests() {
    pkgdesc="$pkgname Tests"
    depends="
        $pkgname-dev=$pkgver-r$pkgrel
        opencl-headers
        qnx-opencl
    "
    amove usr/bin/test_linsol
}

examples() {
    pkgdesc="$pkgname Examples"
    depends="$pkgname=$pkgver-r$pkgrel"
    amove usr/bin/*
    amove usr/bin/.cpp_examples_manifest
}

py3() {
    pkgdesc="Python 3 bindings for CasADi"
    depends="python3-numpy $pkgname=$pkgver-r$pkgrel"

    amove usr/lib/python3*
}

check() {
    DESTDIR="$srcdir/test-install" cmake --install build

    py_version=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    export PYTHONPATH="$srcdir/test-install/usr/lib/python$py_version/site-packages"
    export LD_LIBRARY_PATH="$srcdir/test-install/usr/lib"

    cd "$builddir"/test/python
    python3 alltests.py || true
}


sha512sums="
0e0251b4680a403d60b6703e543878bd18afbc3e3cdbde78760de8b802e86093620e7f05636dece9c669170253049a74c6f662806edb08adaa3b2a494661824d  casadi-3.8.2.tar.gz
"

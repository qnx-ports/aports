# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-trio
pkgver=0.35.0
pkgrel=0
pkgdesc="A friendly Python library for async concurrency and I/O"
url="https://trio.readthedocs.io/"
arch="noarch"
license="MIT OR Apache-2.0"
depends="
	python3-attrs
	python3-async_generator
	python3-idna
	python3-cffi
	python3-openssl
	python3-outcome
	python3-sniffio
	python3-sortedcontainers
"
makedepends="
	python3-gpep517
	python3-setuptools
	python3-wheel
"
checkdepends="
	python3-astor
	python3-pytest
	python3-trustme
	python3-yaml
	python3-coverage
"
source="
	https://pypi.python.org/packages/source/t/trio/trio-$pkgver.tar.gz
	001-_init_py.patch
	002-_io_epoll.py.patch 
	003-_generated_io_epoll_py.patch
	004-kqueue_py.patch
	005-_socket_py.patch
	006-_io_kqueue_py.patch
	007-test_fakenet_py.patch
	008-test_socket_py.patch
	009-test_reply_py.patch
	010-test_io_py.patch
	011-test_subprocess.patch
"
builddir="$srcdir/trio-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest \
		--pyargs trio --skip-optional-imports \
		--deselect='.testenv/lib/python3.14/site-packages/trio/_tests/test_repl.py::test_ki_newline_injection' \
		--deselect='.testenv/lib/python3.14/site-packages/trio/_tests/test_repl.py::test_ki_in_repl' \
		--deselect='.testenv/lib/python3.14/site-packages/trio/_tests/test_unix_pipes.py::test_bizarro_OSError_from_receive' \
		-v -m "not redistributors_should_skip"

	# Following tests passed after workarounding _io_epoll.py and resume testing for "qnx" platform
	# - _core/_tests/test_io.py::test_socket_simultaneous_read_write
	# - _core/_tests/test_io.py::test_wait_on_invalid_object
	# - _core/_tests/test_io.py::test_io_manager_kqueue_monitors_statistics
	# - _core/_tests/test_io.py::test_can_survive_unnotified_close
	# - _core/_tests/test_io.py::test_wait_basic
	# - _core/_tests/test_guest_mode.py::test_guest_mode_asyncgens
	# - _tests/test_asyncgen.py::test_asyncgen_basics
	# - _tests/test_fakenet.py::test_recv_methods
	# - _tests/test_fakenet.py::test_nonwindows_functionality
	# - _tests/test_fakenet.py::test_getpeername

	# Following tests passed after workarounding test_subprocess.py
	# with addition of 10 ms sleep or else QNX parent process will fail to
	# kill its child process
	# - _tests/test_subprocess.py::test_signals[open_process]
	# - _tests/test_subprocess.py::test_signals[run_process in nursery]
	# - _tests/test_subprocess.py::test_custom_deliver_cancel
	# - _tests/test_subprocess.py::test_bad_deliver_cancel
	# - _tests/test_subprocess.py::test_warn_on_failed_cancel_terminate
	# - _tests/test_subprocess.py::test_subprocess_pidfd_unnotified

	# When attempting to read a directory as a file using a file descriptor
	# duplicated via os.dup2(), QNX consistently returns ENOSYS (89):
	# 'Function not implemented'.
	# Similarly when os.set_blocking() on same descriptor, same error returns.
	#
	# Reproduction steps:
	# - r, w = os.pipe()
	# - d = os.open("/", os.O_DIRECTORY, 0)
	# - os.dup2(d, r, inheritable=False)
	# - os.close(d)
	# - os.read(r, 10)            # It throws an error in trio's receive_some()
	# - os.set_blocking(r, True)  # It throws again when "async with s, r" is cleaning up
        #                             # afterBrorkenResourceError is called
	#
	# Linux will have no problem when os.set_blocking(r, True) during the clean-up of "async with s, r"
	#
	# Skipped test:
	# - _tests/test_unix_pipes.py::test_bizarro_OSError_from_recieve

	# The following are skipped and need further investigation
	# python3-coverge is needed
	# - _tests/test_repl.py::test_ki_newline_injection
	# - _tests/test_repl.py::test_ki_in_repl
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}



# Maintainer: Terence Ang <taang@qnx.com>
pkgname=qpdunes
pkgver=0.0.1_git20171214
_commit="4f5bdb4ff19a4a2896abe5bfd8fbde5710f34950"
pkgrel=0
pkgdesc="Private development repository for qpDUNES"
url="https://github.com/acados/qpDUNES-dev"
arch="all"
license="LGPL-3.0-only"
depends="libc++"
makedepends="cmake libc++-dev"
subpackages="$pkgname-dev"
source="
    $pkgname-$pkgver.tar.gz::https://github.com/acados/qpDUNES-dev/archive/$_commit.tar.gz
    001-CMakeLists.patch
"
builddir="$srcdir/qpDUNES-dev-$_commit"

build() {
    cmake -B build -S . \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}



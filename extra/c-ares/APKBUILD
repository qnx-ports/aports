# Alpine-Contributor: Carlo Landmeter <clandmeter@alpinelinux.org>
# Alpine-Maintainer: Carlo Landmeter <clandmeter@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=c-ares
pkgver=1.34.6
pkgrel=0
pkgdesc="Asynchronous DNS/names resolver library"
url="https://c-ares.org/"
arch="all"
license="MIT"
depends="libc++ qnx-io-sock"
makedepends="cmake ninja libc++-dev qnx-io-sock-dev"
checkdepends="gtest-dev"
subpackages="
	$pkgname-doc
	$pkgname-dev
	$pkgname-utils
	"
source="https://github.com/c-ares/c-ares/releases/download/v$pkgver/c-ares-$pkgver.tar.gz"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCARES_SHARED=ON \
		-DCARES_STATIC=ON \
		-DCARES_STATIC_PIC=ON \
		-DCARES_BUILD_TESTS="$(want_check && echo ON || echo OFF)" \
		-DCARES_SYMBOL_HIDING=ON \
		-DCARES_THREADS=ON

	cmake --build build
}

check() {
	build/bin/arestest --gtest_filter=-*.Live* || msg "TODO: figure out why socket is chatty on mock test"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

utils() {
	depends="$pkgname"
	amove usr/bin
}

sha512sums="

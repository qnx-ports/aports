# Contributor: Carlo Landmeter <clandmeter@alpinelinux.org>
# Alpine Maintainer: Carlo Landmeter <clandmeter@alpinelinux.org>
# Maintainer: Narayana Murthy <nnarayanamurthy@qnx.com>
pkgname=c-ares
pkgver=1.34.6
pkgrel=0
pkgdesc="Asynchronous DNS/names resolver library"
url="https://c-ares.org/"
arch="all"
license="MIT"
depends="qnx-io-sock"
makedepends="cmake ninja qnx-io-sock-dev"
checkdepends="gtest-dev"
subpackages="
	$pkgname-doc
	$pkgname-dev
	$pkgname-utils
	"
source="https://github.com/c-ares/$pkgname/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz
    add_qnx_support.patch
"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCARES_SHARED=ON \
		-DCARES_STATIC=ON \
		-DCARES_STATIC_PIC=ON \
		-DCARES_BUILD_TESTS="$(want_check && echo ON || echo OFF)" \
		-DCARES_SYMBOL_HIDING=ON \
		-DCARES_THREADS=ON

	cmake --build build
}

check() {
	build/bin/arestest --gtest_filter=-*.Live*
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

utils() {
	depends="$pkgname=$pkgver-r$pkgrel"
	amove usr/bin
}

sha512sums="

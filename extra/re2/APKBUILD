# Alpine-Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Alpine-Maintainer: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=re2
pkgver=2025.11.05
_pkgver=${pkgver//./-}
pkgrel=0
pkgdesc="Efficient, principled regular expression library"
url="https://github.com/google/re2"
arch="all"
license="BSD-3-Clause"
depends="
    abseil-cpp-hash
    abseil-cpp-log-internal-check-op
    abseil-cpp-log-internal-message
    abseil-cpp-raw-hash-set
    abseil-cpp-raw-logging-internal
    abseil-cpp-spinlock-wait
    abseil-cpp-str-format-internal
    abseil-cpp-strings
    abseil-cpp-synchronization
    icu-libs
    "
depends_dev="
    libc++-dev
    abseil-cpp-dev
    icu-dev
    "
makedepends="
    $depends_dev
    cmake
    clang
    ninja
    python3-gpep517
    python3-setuptools
    python3-wheel
    python3-pybind11-dev
    python3-dev
    "
checkdepends="
    benchmark-dev
    gtest-dev
    "
subpackages="$pkgname-dev python3-$pkgname:py3"
provides="libre2=$pkgver-r$pkgrel"
source="$pkgname-$pkgver.tar.gz::https://github.com/google/re2/archive/$_pkgver.tar.gz"
builddir="$srcdir"/$pkgname-$_pkgver

build() {
    export CXX=clang++
    export CXXFLAGS="$CXXFLAGS -O2 -fPIC"
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DRE2_USE_ICU=ON \
        -DRE2_BUILD_TESTING="$(want_check && echo ON || echo OFF)"
    cmake --build build
    # python build
    cd python
    export CPATH=:$builddir
    export LIBRARY_PATH=:$builddir/build
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    # RE2.FloatingPointFullMatchTypes fails due to known strtod issues
    ctest --test-dir build || true
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    cd "$builddir"/python
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

py3() {
    pkgdesc="Python3 wrapper for Google re2"
    depends="python3-pybind11"
    install_if="$pkgname=$pkgver-r$pkgrel python3"

    amove usr/lib/python*
}

sha512sums="
d47f2507500ca7e004db49e30318f8713164cc3b8f28b0bdf5cdd6028985e7da4c9d0133c19fcd8f800bc666b86feb80a5c56e11fa962db72d561fb627272670  re2-2025.11.05.tar.gz
"

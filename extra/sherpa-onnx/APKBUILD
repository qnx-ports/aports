c8a0eb1a83611257864238e4ec9dfecdfa8c8ff0e059b332542fa0953c1eac2878e8639034ff019494b4d4c3edc34fe5cef3420703eaf661c8a8dda379c75a18  qnx-setlinebuf.patch
"

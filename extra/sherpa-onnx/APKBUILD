# Maintainer: Narayana Murthy Naidu <nnarayanamurthy@qnx.com>

pkgname=sherpa-onnx
pkgver=2.0.1
pkgrel=0
pkgdesc="Offline speech recognition and audio processing using ONNX Runtime"
url="https://github.com/k2-fsa/sherpa-onnx"
arch="all"
license="Apache-2.0"

depends="
	libc++
	onnxruntime
	qnx-gcc-libs
	qnx-microkernel
	"

makedepends="
	cmake
	libc++-dev
	ninja
	onnxruntime-dev
	"

subpackages="$pkgname-dev"

source="
	$pkgname-$pkgver.tar.gz::https://github.com/k2-fsa/sherpa-onnx/archive/refs/tags/v$pkgver.tar.gz
	kaldi-native-fbank-1.22.4.tar.gz::https://github.com/csukuangfj/kaldi-native-fbank/archive/refs/tags/v1.22.4.tar.gz
	kissfft-febd4cae.zip::https://github.com/mborgerding/kissfft/archive/febd4caeed32e33ad8b2e0bb5ea77542c40f18ec.zip
	utf8proc-2.12.0.tar.gz::https://github.com/JuliaStrings/utf8proc/archive/refs/tags/v2.12.0.tar.gz
	kaldi-decoder-0.3.0.tar.gz::https://github.com/k2-fsa/kaldi-decoder/archive/refs/tags/v0.3.0.tar.gz
	kaldifst-1.8.0.tar.gz::https://github.com/k2-fsa/kaldifst/archive/refs/tags/v1.8.0.tar.gz
	openfst-1.8.5-2026-07-09.tar.gz::https://github.com/csukuangfj/openfst/archive/refs/tags/v1.8.5-2026-07-09.tar.gz
	simple-sentencepiece-0.7.tar.gz::https://github.com/pkufool/simple-sentencepiece/archive/refs/tags/v0.7.tar.gz
	googletest-1.13.0.tar.gz::https://github.com/google/googletest/archive/refs/tags/v1.13.0.tar.gz
	json-3.12.0.tar.gz::https://github.com/nlohmann/json/archive/refs/tags/v3.12.0.tar.gz  
	eigen-5.0.1.tar.gz::https://gitlab.com/libeigen/eigen/-/archive/5.0.1/eigen-5.0.1.tar.gz
	qnx-setlinebuf.patch
	"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	export CFLAGS="${CFLAGS/-fstack-clash-protection/}"
	export CXXFLAGS="${CXXFLAGS/-fstack-clash-protection/}"

	cmake -S . -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_SKIP_INSTALL_RPATH=ON \
		-DCMAKE_CXX_STANDARD=17 \
		-DCMAKE_CXX_STANDARD_REQUIRED=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DSHERPA_ONNX_USE_PRE_INSTALLED_ONNXRUNTIME_IF_AVAILABLE=ON \
		-DFETCHCONTENT_SOURCE_DIR_KALDI_NATIVE_FBANK="$srcdir/kaldi-native-fbank-1.22.4" \
		-DFETCHCONTENT_SOURCE_DIR_KISSFFT="$srcdir/kissfft-febd4caeed32e33ad8b2e0bb5ea77542c40f18ec" \
		-DFETCHCONTENT_SOURCE_DIR_UTF8PROC="$srcdir/utf8proc-2.12.0" \
		-DFETCHCONTENT_SOURCE_DIR_KALDI_DECODER="$srcdir/kaldi-decoder-0.3.0" \
		-DFETCHCONTENT_SOURCE_DIR_KALDIFST="$srcdir/kaldifst-1.8.0" \
		-DFETCHCONTENT_SOURCE_DIR_OPENFST="$srcdir/openfst-1.8.5-2026-07-09" \
		-DFETCHCONTENT_SOURCE_DIR_EIGEN="$srcdir/eigen-5.0.1" \
		-DFETCHCONTENT_SOURCE_DIR_GOOGLETEST="$srcdir/googletest-1.13.0" \
		-DFETCHCONTENT_SOURCE_DIR_JSON="$srcdir/json-3.12.0" \
		-DFETCHCONTENT_SOURCE_DIR_SIMPLE-SENTENCEPIECE="$srcdir/simple-sentencepiece-0.7" \
		-DSHERPA_ONNX_LINK_LIBSTDCPP_STATICALLY=OFF \
		-DSHERPA_ONNX_ENABLE_C_API=ON \
		-DSHERPA_ONNX_ENABLE_BINARY=OFF \
		-DSHERPA_ONNX_BUILD_C_API_EXAMPLES=OFF \
		-DSHERPA_ONNX_ENABLE_PYTHON=OFF \
		-DSHERPA_ONNX_ENABLE_JNI=OFF \
		-DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF \
		-DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF \
		-DSHERPA_ONNX_ENABLE_TTS=OFF \
		-DSHERPA_ONNX_ENABLE_SPEAKER_DIARIZATION=OFF \
		-DSHERPA_ONNX_ENABLE_GPU=OFF \
		-DSHERPA_ONNX_ENABLE_TESTS=ON \
		-DSHERPA_ONNX_ENABLE_CHECK=OFF

	cmake --build build -j2
}

check() {
	ctest --test-dir build \
		--output-on-failure -j1
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}


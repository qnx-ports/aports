# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=sdl2-compat
pkgver=2.32.74
pkgrel=0
pkgdesc="An SDL2 compatibility layer that uses SDL3 behind the scenes."
url="https://libsdl.org/"
arch="all"
license="Zlib"
depends="sdl3"
makedepends="
    sdl3-dev
    sdl3-static
    qnx-alsa-dev
    qnx-screen-dev
    wayland-dev
    libxkbcommon-dev
    libxkbcommon-static
    clang
    cmake
    ninja"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://www.github.com/libsdl-org/sdl2-compat/archive/refs/tags/release-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-release-$pkgver"

build() {
    export CPPFLAGS="${CPPFLAGS} -D_QNX_SOURCE"
    cmake -B build -G Ninja \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=True \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DSDL2COMPAT_X11=OFF \
        -DSDL2COMPAT_INSTALL=ON \
        -DSDL2COMPAT_STATIC=ON \
        -DSDL2COMPAT_TESTS=ON
    cmake --build build
}

check() {
    # Known issue - Broken strtod conversions.
    cd build && ctest -E "testautomation"
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
af38165d719916b50e093f2847cb13f36d6d02c44e9d8a8fff8f64264f917940238e763f0d61b7fc6ce249cfc3650dcd5561d59d45824e4b36b8a0442ad4a802  sdl2-compat-2.32.74.tar.gz
"

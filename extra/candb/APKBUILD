# Maintainer:Ramya santoshi <rtimmaraju@qnx.com>
pkgname=candb
pkgver=1.0.0
pkgrel=0
pkgdesc="GENIVI CAN database parser library"
url="https://github.com/GENIVI/CANdb"
arch="all"
license="MPL-2.0"
depends="libc++"
makedepends="cmake make git libc++-dev"

source="candb.patch"
builddir="$srcdir/CANdb"

prepare() {
    git clone https://github.com/GENIVI/CANdb.git "$builddir"
    cd "$builddir"
    git submodule update --init --recursive
    patch -p1 < "$srcdir/candb.patch"
}

build() {
    export CXXFLAGS="$CXXFLAGS \
    -Wno-error=unused-command-line-argument \
    -Wno-error=character-conversion \
    -Wno-error=missing-field-initializers \
    -Wno-error=deprecated-literal-operator"

    export CFLAGS="$CFLAGS \
    -Wno-error=unused-command-line-argument \
    -Wno-error=missing-field-initializers \
    -Wno-error=deprecated-literal-operator"
    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=ON \
        -DENABLE_TESTS=ON \
        -DCANDB_BUILD_TESTS=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5

    cmake --build build
}

check() {
    cd "$builddir"/build
    ctest --output-on-failure -j1 --timeout 120 \
        || { echo "Tests failed!"; return 1; }
}

package() {
    cd "$builddir"
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
80ac82d3d35b494202fdaab5b673b11def425c466b706909a3eab7c7b15609735a496368097ec3ea56233ccb5d683ca40a860fa8220316c773a58dbc525517ec  candb.patch
"

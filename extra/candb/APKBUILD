# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=candb
pkgver=1.0.0_git20210625
pkgrel=0
pkgdesc="GENIVI CAN database parser library"
url="https://github.com/GENIVI/CANdb"
arch="all"
license="MPL-2.0"
depends="libc++"
makedepends="cmake libc++-dev"
_commit=150c42a8cdfc0748915f09d2cd0c5a68591263a7
subpackages="$pkgname-dev"
source="
https://github.com/GENIVI/CANdb/archive/${_commit}.tar.gz
candb.patch
https://github.com/USCiLab/cereal/archive/51cbda5f30e56c801c07fe3d3aba5d7fb9e6cca4.tar.gz
https://github.com/yhirose/cpp-peglib/archive/501836a025c944ef1c83797707b545c4e4dc9411.tar.gz
https://github.com/jarro2783/cxxopts/archive/302302b30839505703d37fb82f536c53cf9172fa.tar.gz
https://github.com/google/googletest/archive/e2239ee6043f73722e7aa812a459f54a28552929.tar.gz
https://github.com/gabime/spdlog/archive/100f30043f33277122e0991c83845a2617172ffd.tar.gz
https://github.com/commaai/opendbc/archive/acddb03c357340e4229a453043645ed5f65d1e40.tar.gz
"
builddir="$srcdir/CANdb-$_commit"

prepare() {
    default_prepare
    cd "$builddir"
    mkdir -p 3rdParty/{cereal,cpp-peglib,cxxopts,gtest,spdlog}
    mkdir -p tests/dbc/opendbc
    ln -s "$srcdir"/cereal-*/* 3rdParty/cereal/
    ln -s "$srcdir"/cpp-peglib-*/* 3rdParty/cpp-peglib/
    ln -s "$srcdir"/cxxopts-*/* 3rdParty/cxxopts/
    ln -s "$srcdir"/googletest-*/* 3rdParty/gtest/
    ln -s "$srcdir"/spdlog-*/* 3rdParty/spdlog/
    ln -s "$srcdir"/opendbc-*/* tests/dbc/opendbc/
}

build() {
    cd "$builddir"
  
    export CXXFLAGS="$CXXFLAGS \
        -Wno-error=unused-command-line-argument \
        -Wno-error=character-conversion \
        -Wno-error=missing-field-initializers \
        -Wno-error=deprecated-literal-operator"

    export CFLAGS="$CFLAGS \
        -Wno-error=unused-command-line-argument \
        -Wno-error=missing-field-initializers \
        -Wno-error=deprecated-literal-operator"

    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCANDB_BUILD_TESTS=ON \
        -DBUILD_SHARED_LIBS=ON

    cmake --build build
}

check() {
    cd "$builddir/build"
    ctest --output-on-failure -j1 --timeout 120
}

package() {
    cd "$builddir"

    DESTDIR="$pkgdir" cmake --install build

    install -Dm755 build/src/libCANdb.so \
        "$pkgdir/usr/lib/libCANdb.so"

    install -d "$pkgdir/usr/include/CANdb"

    install -m644 src/*.h src/*.hpp \
        "$pkgdir/usr/include/CANdb/"
}


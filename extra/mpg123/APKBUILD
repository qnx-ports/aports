# Alpine-Contributor: Leo <thinkabit.ukim@gmail.com>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=mpg123
pkgver=1.33.3
pkgrel=1
pkgdesc="Console-based MPEG Audio Player for Layers 1, 2 and 3"
options="libtool"
url="https://www.mpg123.org/"
arch="all"
license="LGPL-2.1-only"
depends="$pkgname-libs=$pkgver-r$pkgrel"
subpackages="$pkgname-libs $pkgname-dev $pkgname-doc"
depends="qnx-alsa qnx-io-sock $pkgname-libs=$pkgver-r$pkgrel"
makedepends="libtool qnx-alsa-dev ncurses-dev clang libc++-dev"
source="https://www.mpg123.org/download/mpg123-$pkgver.tar.bz2
        001-add-missing-headers.patch
        "

build() {
    CC=clang \
    CXX=clang++ \
    CFLAGS="$CFLAGS -Qunused-arguments" \
    CXXFLAGS="$CXXFLAGS -Qunused-arguments" \
    CPPFLAGS="$CPPFLAGS -Qunused-arguments" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --disable-dependency-tracking \
        --with-pic \
        --with-optimization=0 \
        --with-cpu=i386_fpu \
        --with-audio="alsa"
    make
}

check() {
    make check
}

package() {
    # Installation is not parallel friendly and will fail
    # sometimes
    make -j1 DESTDIR="$pkgdir" install
}


# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=librealsense
pkgver=2.58.1
pkgrel=0
pkgdesc="Intel RealSense SDK 2.0"
url="https://github.com/IntelRealSense/librealsense"
arch="all"
license="Apache-2.0"
makedepends="
	cmake
	libusb-dev
	qnx-fs-core-dev
    libc++-dev
    python3-dev
    qnx-fs-gpt-dev
    catch2
    nlohmann-json
    fast-cdr-dev
    glfw-dev
	python3-pybind11-dev
	ca-certificates
"
options="net"
depends="qnx-fs-core libc++ libusb qnx-fs-gpt fast-cdr"
subpackages="$pkgname-dev"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/IntelRealSense/librealsense/archive/refs/tags/v$pkgver.tar.gz
	001_qnx_compatibility.patch
    002_qnx_disable_avx.patch
    003_dependencies.patch
    004_disable_fast-cdr.patch
	005_pybind11.patch
"
builddir="$srcdir/librealsense-$pkgver"

build() {
	CFLAGS=$(echo "$CFLAGS" | sed 's/-fstack-clash-protection//g')
	CXXFLAGS=$(echo "$CXXFLAGS" | sed 's/-fstack-clash-protection//g')

	cmake -B build -S . \
		-DFORCE_RSUSB_BACKEND=ON \
        -DBUILD_PYTHON_BINDINGS=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_UNIT_TESTS=true \
		-DBUILD_EXAMPLES=OFF \
		-DBUILD_GRAPHICAL_EXAMPLES=OFF \
		-DBUILD_TOOLS=OFF \
		-DCMAKE_C_FLAGS="$CFLAGS -DPLATFORM_POSIX" \
        -DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_CXX_FLAGS="$CXXFLAGS -DPLATFORM_POSIX"

	cmake --build build
}

check() {
    cd "$builddir/build/Release" || return 1

    for t in test-rsutils-*; do
        [ -x "$t" ] || continue

        echo "Running $t"
        ./"$t" || echo "FAILED: $t"
    done
}

package() {
	cd "$builddir"
	DESTDIR="$pkgdir" cmake --install build
}


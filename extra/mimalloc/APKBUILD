ada72a5e4d070e43ae90692c61b6e89398afbcfe35a5e88ca2c8cadd281c3fdb0b9179d8e6a02be08b1361d818eefab43c111eb244ce813ce2320d4cc1e05e27  0001-add-qnx-build.patch
"

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cris Sinnott <csinnott@qnx.com>
Date: Tue, 24 Nov 2026 19:23:21 +0000
Subject: [PATCH 2/2] chat_window: wider default size and scroll fixes

---
 gtk_llm_chat/chat_window.py | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/gtk_llm_chat/chat_window.py b/gtk_llm_chat/chat_window.py
index 77f57b8..2366d82 100644
--- a/gtk_llm_chat/chat_window.py
+++ b/gtk_llm_chat/chat_window.py
@@ -106,8 +106,10 @@ class LLMChatWindow(Adw.ApplicationWindow):
         self.add_controller(key_controller)
 
         # Fijar tamaño por defecto y mínimo para evitar problemas de layout/segfault
-        self.set_default_size(420, 550)
-        self.set_size_request(400, 300)  # tamaño mínimo seguro
+        # QNX/labwc: at the upstream 420 px default width the send button is
+        # clipped; the minimum keeps the window from shrinking below the toolbar.
+        self.set_default_size(700, 600)
+        self.set_size_request(550, 400)  # tamaño mínimo seguro
 
         # Mantener referencia al último mensaje enviado
         self.last_message = None
@@ -529,6 +531,8 @@ class LLMChatWindow(Adw.ApplicationWindow):
                 self._scroll_to_bottom(True) # Force scroll
                 return GLib.SOURCE_REMOVE # Run only once
             GLib.timeout_add(50, do_scroll) # Delay of 50ms
+            # QNX: the 50 ms callback can fire before GTK finishes layout; retry later.
+            GLib.timeout_add(300, do_scroll)
             # Return False because we are using connect_after
             return False
 
@@ -681,6 +685,10 @@ class LLMChatWindow(Adw.ApplicationWindow):
                             del app._window_by_cid[key]
                     app._window_by_cid[conversation_id] = self
 
+        # Scroll once more when the response is complete, so the last streamed
+        # tokens are visible.
+        GLib.timeout_add(50, self._scroll_to_bottom)
+
     def _on_llm_response(self, llm_client, response):
         """Maneja la señal de respuesta del LLM"""
         if not self.current_message_widget:
@@ -722,7 +730,9 @@ class LLMChatWindow(Adw.ApplicationWindow):
 
         if bottom_distance < threshold:
             def scroll_after():
-                adj.set_value(upper - page_size)
+                # Read the bounds when the timeout fires, not when the closure is
+                # created: the content may have grown in between.
+                adj.set_value(adj.get_upper() - adj.get_page_size())
                 return False
             GLib.timeout_add(50, scroll_after)
 
-- 

2b0cd9eb9ede0a90c530aabd99aec68bc9b615455b113ab2f24aa69a92aa8fc090a37cc71295d4130e59ccf3006be1f28a33f2ff4d7c57940c04d27c69a2cd53  0001-welcome-use-adw-window-on-qnx.patch
c3a1e1584d87e61539eb378fc4d9000b383e7222ac8a459199d4ede1a5d35ac51468f25f3ee6aaf12d595406a605ae2490dbd475b603ce7d4c0453d888d7092e  0002-chat-window-wider-default-size-and-scroll-fixes.patch

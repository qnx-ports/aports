# Alpine-Contributor: Taner Tas <taner76@gmail.com>
# Alpine-Maintainer: Taner Tas <taner76@gmail.com>
# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=freeimage
_pkgname="FreeImage"
pkgver=3.18.0
pkgrel=0
_qnx_branch="main"
pkgdesc="Open Source library project for developers who would like to support popular graphics image formats."
url="https://freeimage.sourceforge.net/"
arch="all"
license="GPL-2.0-or-later AND FreeImage"
makedepends="cmake ninja libc++-dev qnx-io-sock-dev"
depends="qnx-io-sock"
subpackages="$pkgname-dev"
source="https://github.com/qnx-ports/FreeImage/archive/refs/heads/$_qnx_branch.tar.gz"
builddir="$srcdir/$_pkgname-$_qnx_branch"
options="!check"

prepare() {
	find "$builddir" -type f -exec dos2unix -q -s {} \;
	default_prepare
}

build() {
	case "$CARCH" in
		aarch64) export CFLAGS="$CFLAGS -DPNG_ARM_NEON_OPT=0";;
	esac
	CFLAGS="$CFLAGS -std=gnu89 -fPIC" \
	CXXFLAGS="$CXXFLAGS -std=gnu++14 -fPIC" \
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
d9845d003b4096ac16bac49f5533d415011ce370ea5fde48f04fce223daa5ca034a7251546128e12f85b2f52c4f519d2cb17c623225b095c06e81da562b9c3f3  main.tar.gz
"

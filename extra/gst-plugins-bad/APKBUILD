# Alpine-Maintainer: Krassy Boykinov <kboykinov@teamcentrixx.com>
# Maintainer: Elliott Mazzuca <emazzuca@qnx.com>
pkgname=gst-plugins-bad
pkgver=1.26.8
pkgrel=0
pkgdesc="GStreamer streaming media framework bad plug-ins"
url="https://gstreamer.freedesktop.org/"
arch="all"
license="GPL-2.0-or-later LGPL-2.0-or-later"
options="!check"
depends="
    aom-libs
    cairo
    glib
    gsm
    gst-plugins-base
    gstreamer
    lcms2
    libass
    libbz2
    libc++
    libcrypto3
    libcurl
    libintl
    libssl3
    libSvtAv1Enc
    libwebp
    libwebpmux
    libxml2
    openjpeg
    opus
    orc
    pango
    qnx-hid
    qnx-io-sock
    qnx-vulkan
    wayland
    "
depends_dev="
    gstreamer-dev
    gst-plugins-base-dev
    wayland-dev
"
makedepends="$depends_dev
    aom-dev
    bzip2-dev
    curl-dev
    clang
    glib-dev
    gobject-introspection-dev
    gsm-dev
    gtk3-dev
    lcms2-dev
    libass-dev
    libc++-dev
    libexif-dev
    libwebp-dev
    libxkbcommon-dev
    meson
    openexr-dev
    openjpeg-dev
    openssl-dev>3
    openh264-dev
    opus-dev
    orc-dev
    pango-dev
    svt-av1-dev
    tiff-dev
    vulkan-headers
    wayland-protocols
    qnx-screen-dev
    qnx-vulkan
    "
subpackages="$pkgname-dbg $pkgname-lang $pkgname-dev"
source="https://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-$pkgver.tar.xz
        input.h
    "
ldpath="/usr/lib/gstreamer-1.0"

build() {
    # add the linux/input.h
    mkdir gst-libs/linux
    cp $srcdir/input.h gst-libs/linux

    CC=clang \
    CXX=clang++ \
    LDFLAGS="-lsocket -lz" \
    CFLAGS="$CFLAGS -O2" \
    CXXFLAGS="$CXXFLAGS -O2" \
    CPPFLAGS="$CPPFLAGS -O2" \
    abuild-meson \
        -Db_lto=false \
        -Dpackage-origin="www.qnx.com" \
        -Dpackage-name="GStreamer bad plug-ins (QNX)" \
        -Dintrospection=enabled \
        -Dtests="$(want_check && echo enabled || echo disabled)" \
        -Dopenh264=enabled \
        . output
    meson compile -C output
}

check() {
    meson test -C output --print-errorlogs
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


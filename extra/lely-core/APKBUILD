# Maintainer: Your Name <you@example.com>
pkgname=lely-core
pkgver=3.2.0
pkgrel=0
pkgdesc="Lely core libraries (CANopen stack, IO, utilities)"
url="https://gitlab.com/lely_industries/lely-core"
arch="all"
license="Apache-2.0"

depends=""
makedepends="
    autoconf
    automake
    libtool
    make
    pkgconf
"
CPPFLAGS="$CPPFLAGS -D_POSIX_C_SOURCE=200809 "
subpackages="$pkgname-dev"

source="https://gitlab.com/lely_industries/lely-core/-/archive/v${pkgver}/lely-core-v${pkgver}.tar.gz lely-core.patch "

builddir="$srcdir/lely-core-v$pkgver"

prepare() {
    default_prepare
    cd "$builddir"
    autoreconf -fi
}

build() {
    cd "$builddir"

    export LIBS="-lsocket"

    # Clean + consolidate flags (IMPORTANT)
    export CFLAGS="$(echo $CFLAGS | sed 's/-fstack-clash-protection//g')"
    export CFLAGS="$CFLAGS -Wno-error -Wno-unused-command-line-argument -Wno-error=static-in-inline -Wno-deprecated-declarations -Wno-unused-function"

    export CXXFLAGS="$(echo $CXXFLAGS | sed 's/-fstack-clash-protection//g')"
    export CXXFLAGS="$CXXFLAGS -Wno-error -Wno-unused-command-line-argument -Wno-error=static-in-inline -Wno-deprecated-declarations -Wno-unused-function"
    export CFLAGS="$CFLAGS -Wno-error=missing-field-initializers"
    ./configure \
        --prefix=/usr \
        --disable-static \
         --host=x86_64-pc-nto-qnx  \
         --build=x86_64-pc-nto-qnx \
        --disable-stdio \
        --disable-python \
        --disable-time \
        --disable-compat \
        --enable-ecss-compliance \
        CFLAGS="$CFLAGS" \
        CXXFLAGS="$CXXFLAGS"
 
    make V=1
}

check() {
    cd "$builddir"

    # Run tests and save logs
    make check | tee "$builddir/test.log"
}


package() {
    cd "$builddir"

    # 🔥 CRITICAL: expose all intermediate libs
    export LIBRARY_PATH="$builddir/lib/compat/.libs:$builddir/lib/util/.libs:$builddir/lib/can/.libs"
    export LD_LIBRARY_PATH="$LIBRARY_PATH"

    # (optional but safer)
    export LDFLAGS="-L$builddir/lib/compat/.libs -L$builddir/lib/util/.libs"

    make install DESTDIR="$pkgdir" -j1
}

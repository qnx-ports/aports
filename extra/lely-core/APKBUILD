pkgname=lely-core
pkgver=3.2.0
pkgrel=0
pkgdesc="Lely core libraries (CANopen stack, IO, utilities)"
url="https://gitlab.com/lely_industries/lely-core"
arch="all"
license="Apache-2.0"

depends=""
makedepends="autoconf automake make pkgconf"
CPPFLAGS="$CPPFLAGS -D_POSIX_C_SOURCE=200809 "
subpackages="$pkgname-dev"

source="https://gitlab.com/lely_industries/lely-core/-/archive/v${pkgver}/lely-core-v${pkgver}.tar.gz lely-core.patch
"

builddir="$srcdir/lely-core-v$pkgver"

prepare() {
    default_prepare
    cd "$builddir"
    autoreconf -fi
}

build() {
    cd "$builddir"

    export LIBS="-lsocket"

   # Reset problematic default flags completely
export CFLAGS="-Os \
    -Wno-error=unused-but-set-variable" 
export CXXFLAGS="$CFLAGS"
# Add only safe flags
export CFLAGS="$CFLAGS \
    -Wformat -Wformat-security \
    -Wno-error \
    -Wno-unused-command-line-argument \
    -Wno-error=static-in-inline \
    -Wno-deprecated-declarations \
    -Wno-error=unused-function \
    -Wno-error=missing-field-initializers \
    -Wno-error=deprecated-pragma \
    -Wno-error=instantiation-after-specialization
    -DLELY_HAVE_ITIMERSPEC=1 \
    -DLELY_HAVE_CLOCK_GETTIME=1 \
    -DLELY_HAVE_CLOCKID_T=1 "

export CXXFLAGS="$CFLAGS"

    ./configure \
     --build=$CBUILD \
        --host=$CHOST \
        --with-sysroot=$CBUILDROOT \
        --prefix=/usr \
        --disable-static \
        --enable-shared \
        --disable-fast-install \
        --disable-stdio \
        --disable-python \
        --enable-tests \
        --disable-time \
        ac_cv_type_struct_itimerspec=yes \
        CFLAGS="$CFLAGS" \
        CPPFLAGS="$CPPFLAGS" \
        CXXFLAGS="$CXXFLAGS"

    make V=1
}

check() {
    cd "$builddir"

    # Run tests and save logs
    make check || true
}


package() {

    cd "$builddir"
    export LDFLAGS="$LDFLAGS -L$pkgdir/usr/lib"
    export LIBRARY_PATH="$pkgdir/usr/lib"
    export LDFLAGS="$LDFLAGS -L$pkgdir/usr/local/lib"
    export LD_RUN_PATH="$pkgdir/usr/local/lib"
    export LIBRARY_PATH="$pkgdir/usr/local/lib"
    
    make install DESTDIR="$pkgdir" -j1
}

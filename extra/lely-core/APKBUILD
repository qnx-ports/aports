# Maintainer:Ramya santoshi <rtimmaraju@qnx.com>
pkgname=lely-core
pkgver=3.2.0
pkgrel=0
pkgdesc="Lely core libraries (CANopen stack, IO, utilities)"
url="https://gitlab.com/lely_industries/lely-core"
arch="all"
license="Apache-2.0"

depends="libc++"
makedepends="
    automake
    libtool
    qnx-io-sock-dev
    libc++-dev"

CPPFLAGS="$CPPFLAGS -D_POSIX_C_SOURCE=200809 "
subpackages="$pkgname-dev"

source="
https://gitlab.com/lely_industries/lely-core/-/archive/v${pkgver}/lely-core-v${pkgver}.tar.gz 
lely-core.patch"

builddir="$srcdir/lely-core-v$pkgver"

prepare() {
    default_prepare
    cd "$builddir"
    autoreconf -fi
}

build() {
    export LIBS="-lsocket"
    export CFLAGS="$CFLAGS -Wno-error -Wno-unused-command-line-argument -Wno-error=static-in-inline -Wno-deprecated-declarations -Wno-unused-function -Wno-error=missing-field-initializers"
    export CXXFLAGS="$CXXFLAGS -Wno-error -Wno-unused-command-line-argument -Wno-error=static-in-inline -Wno-deprecated-declarations -Wno-unused-function"
    ./configure \
        --prefix=/usr \
        --disable-static \
        --disable-python \
        --enable-ecss-compliance \
        --disable-doc \
        CFLAGS="$CFLAGS" \
        CPPFLAGS="$CPPFLAGS" \
        CXXFLAGS="$CXXFLAGS"
    make
}

package() {
    make install DESTDIR="$pkgdir" -j1
}
#Tests are disabled during the build to maintain ECSS compliance.
sha512sums="

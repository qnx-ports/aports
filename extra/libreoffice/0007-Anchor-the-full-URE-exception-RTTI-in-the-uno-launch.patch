From bb8d4ce59adde421bb2f0322c21c4936f07f152b Mon Sep 17 00:00:00 2001
From: Arthur Clark <mydevstuff@mail.com>
Date: Sun, 16 Aug 2026 22:43:14 +0000
Subject: [PATCH 07/33] Anchor the full URE exception RTTI in the uno launcher
 for QNX

Extend the QNX exception-RTTI anchor from the three bridgetest types to the
whole udkapi (URE) exception hierarchy (64 types). A small script enumerates
the exception decls from the IDL tree and emits rttianchor.cxx, so the anchor
cannot silently drift as UNO types change.

Also export the anchored type_info with --dynamic-list-cpp-typeinfo. The anchor
defines each weak type_info, but the executable-first loader only preempts a
dlopened component copy when the symbol is in .dynsym, which the retain
attribute alone does not put there; without the flag 46 of the 64 stayed
un-exported. Measured on target: all 64 now export weak, bridgetest stays
green, and two formerly-split types unify to one address across the launcher
and a component.

Change-Id: I9dd0d16eeefde5549c2391b32eed26a8c61c1d8a
---
 cpputools/Executable_uno.mk               |   9 +-
 cpputools/source/unoexe/gen-rttianchor.py |  72 ++++++++++++
 cpputools/source/unoexe/rttianchor.cxx    | 132 +++++++++++++++++++++-
 3 files changed, 208 insertions(+), 5 deletions(-)
 create mode 100755 cpputools/source/unoexe/gen-rttianchor.py

diff --git a/cpputools/Executable_uno.mk b/cpputools/Executable_uno.mk
index bdb2ee532..63c066337 100644
--- a/cpputools/Executable_uno.mk
+++ b/cpputools/Executable_uno.mk
@@ -24,12 +24,17 @@ $(eval $(call gb_Executable_add_exception_objects,uno,\
     cpputools/source/unoexe/unoexe \
 ))
 
-# QNX: anchor UNO exception RTTI in the executable (executable-first loader
-# unifies type_info across dlopened UNO components; see rttianchor.cxx)
+# QNX: anchor UNO exception RTTI in the executable and export it, so the
+# executable-first loader unifies type_info across dlopened UNO components (see
+# rttianchor.cxx). The anchor defines the weak type_info; the linker flag
+# promotes it into .dynsym, which [[gnu::retain]] alone does not.
 ifeq ($(OS),QNX)
 $(eval $(call gb_Executable_add_exception_objects,uno,\
     cpputools/source/unoexe/rttianchor \
 ))
+$(eval $(call gb_Executable_add_ldflags,uno,\
+    -Wl$(COMMA)--dynamic-list-cpp-typeinfo \
+))
 endif
 
 $(eval $(call gb_Executable_add_default_nativeres,uno))
diff --git a/cpputools/source/unoexe/gen-rttianchor.py b/cpputools/source/unoexe/gen-rttianchor.py
new file mode 100755
index 000000000..1b56ac92f
--- /dev/null
+++ b/cpputools/source/unoexe/gen-rttianchor.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+# gen-rttianchor.py: emit rttianchor.cxx anchoring every URE UNO exception
+# type's RTTI in the launcher. Scans the IDL tree for exception decls so the
+# anchor can't silently drift as UNO types change.
+#   Regenerate (from this dir): python3 gen-rttianchor.py > rttianchor.cxx
+#   Add offapi later: python3 gen-rttianchor.py <root>/offapi/com/sun/star
+
+import os
+import re
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+# cpputools/source/unoexe -> source root
+ROOT = os.path.normpath(os.path.join(HERE, "..", "..", ".."))
+
+# top-level IDL exception decls sit at column 0; the leading anchor keeps prose
+# like "exception occurs." inside doc comments from matching
+DECL = re.compile(r"^(?:published\s+)?exception\s+([A-Za-z_]\w*)")
+
+
+def scan(api_css):
+    # api_css: a ".../com/sun/star" directory; yields (fqn, header)
+    base = os.path.normpath(os.path.join(api_css, "..", "..", ".."))
+    out = []
+    for dirpath, _dirs, files in os.walk(api_css):
+        for fn in sorted(files):
+            if not fn.endswith(".idl"):
+                continue
+            path = os.path.join(dirpath, fn)
+            with open(path, encoding="utf-8", errors="replace") as f:
+                for line in f:
+                    m = DECL.match(line)
+                    if m:
+                        rel = os.path.relpath(path, base)  # com/sun/star/<mod>/<Name>.idl
+                        mod = os.path.dirname(rel).replace(os.sep, "::")
+                        out.append((mod + "::" + m.group(1), rel[:-4] + ".hpp"))
+                        break
+    return out
+
+
+def main():
+    roots = sys.argv[1:] or [os.path.join(ROOT, "udkapi", "com", "sun", "star")]
+    seen = {}
+    for r in roots:
+        for fqn, hpp in scan(r):
+            seen[fqn] = hpp
+    items = sorted(seen.items())
+
+    w = sys.stdout.write
+    w("/*\n")
+    w(" * QNX: anchor UNO exception RTTI in the launcher executable. QNX's loader is\n")
+    w(" * executable-first, so a weak type_info defined here preempts each dlopen'd UNO\n")
+    w(" * component's own copy, unifying exception identity across the C++ UNO bridge.\n")
+    w(" *\n")
+    w(" * Generated by gen-rttianchor.py from the udkapi (URE) exception set -- do not\n")
+    w(" * hand-edit. Regenerate: python3 gen-rttianchor.py > rttianchor.cxx\n")
+    w(" */\n\n")
+    w("#include <typeinfo>\n\n")
+    for _fqn, hpp in items:
+        w("#include <%s>\n" % hpp.replace(os.sep, "/"))
+    w("\nnamespace\n{\n")
+    w("// every URE exception type (leaf + base), so each __si chain resolves to\n")
+    w("// executable-local copies; any launcher's Executable_*.mk can reuse this TU\n")
+    w("[[gnu::used, gnu::retain]]\n")
+    w("::std::type_info const * const g_aUnoExceptionRtti[] = {\n")
+    for fqn, _hpp in items:
+        w("    &typeid(::%s),\n" % fqn)
+    w("};\n}\n")
+
+
+if __name__ == "__main__":
+    main()

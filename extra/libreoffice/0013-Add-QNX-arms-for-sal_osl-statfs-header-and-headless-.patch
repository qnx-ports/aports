---
 external/epoxy/Library_epoxy.mk  | 2 +-
 sal/qa/osl/file/osl_File_Const.h | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/external/epoxy/Library_epoxy.mk b/external/epoxy/Library_epoxy.mk
index 2c89f5ad3..704ed62de 100644
--- a/external/epoxy/Library_epoxy.mk
+++ b/external/epoxy/Library_epoxy.mk
@@ -35,7 +35,7 @@ $(eval $(call gb_Library_add_generated_cobjects,epoxy,\
 	UnpackedTarball/epoxy/src/dispatch_wgl \
 	UnpackedTarball/epoxy/src/wgl_generated_dispatch \
 ))
-else ifneq ($(filter iOS MACOSX,$(OS)),)
+else ifneq ($(filter iOS MACOSX QNX,$(OS)),)
 # nothing
 else ifeq ($(OS),ANDROID)
 $(eval $(call gb_Library_add_generated_cobjects,epoxy,\
diff --git a/sal/qa/osl/file/osl_File_Const.h b/sal/qa/osl/file/osl_File_Const.h
index 46f6264dc..217cf4ef6 100644
--- a/sal/qa/osl/file/osl_File_Const.h
+++ b/sal/qa/osl/file/osl_File_Const.h
@@ -87,7 +87,7 @@ const char pBuffer_Blank[]  = "";
 #   include <errno.h>
 #   include <fcntl.h>
 #   include <sys/stat.h>
-#   if !defined(MACOSX) && !defined(IOS) && !defined(__OpenBSD__) && !defined(__FreeBSD__) && !defined(__NetBSD__) && !defined (DRAGONFLY) && !defined(HAIKU)
+#   if !defined(MACOSX) && !defined(IOS) && !defined(__OpenBSD__) && !defined(__FreeBSD__) && !defined(__NetBSD__) && !defined (DRAGONFLY) && !defined(HAIKU) && !defined(QNX)
 #       include <sys/statfs.h>
 #   else
 #       include <sys/param.h>

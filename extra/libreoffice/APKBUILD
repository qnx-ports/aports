# Maintainer: Arthur Clark <mydevstuff@mail.com>
# Structure adapted from the Alpine community/libreoffice recipe:
# Alpine-Contributor: (upstream Alpine aports contributors)
#
# LibreOffice on QNX 8.0 - five-app alpha (Writer, Calc, Math, Draw, Impress).
# Source is pinned to a LibreOffice master commit plus this port's 33-patch series.
# TODO(qnx-ports): confirm pinned-commit vs release-tag policy with the branch-803
#   maintainers before PR. pkgver below encodes the commit-pin as the working convention.
pkgname=libreoffice
pkgver=27.2.0.0_alpha0
pkgrel=0
_commit=fb02e9d1fc6277a4dbd493b8956c599dc5237f62
pkgdesc="LibreOffice office suite - QNX alpha (Writer, Calc, Math, Draw, Impress)"
url="https://www.libreoffice.org"
arch="x86_64"
license="MPL-2.0"
# Tests are impractical on target; do not strip - the port relies on exported UNO
# exception RTTI (--dynamic-list-cpp-typeinfo) and stripping risks the anchors.
options="!check !strip"

# Runtime shared-lib deps (derived from readelf NEEDED over the built instdir,
# resolved to owning packages via apk who-owns; 0 unresolved).
# Per QNX rule: libc/libm/libregex (qnx-microkernel) and libgcc_s (qnx-gcc-libs)
# are base and NOT listed. libc++ and qnx-io-sock ARE listed (matches the depends
# of nss/icu-libs/libxml2/qt6-base). abuild also auto-adds so:* from the ELF scan.
depends="
	qt6-base
	boost-filesystem
	boost-iostreams
	boost-locale
	libc++
	cairo
	libcrypto3
	libssl3
	libexpat
	fontconfig
	icu-libs
	libintl
	libjpeg-turbo
	lcms2
	lcms2-plugins
	nspr
	nss
	libpng
	libxml2
	zlib-ng
	qnx-io-sock
	"

# Build tools perl/python3/clang/make/etc. are QNX base (/system/bin, build-base).
# -dev names verified present in the repo (apk search -e). The system_* -dev libs
# match config_host.mk's SYSTEM_* set (expat, libxml2, libxslt, boost, cairo,
# freetype, icu, lcms2, libjpeg-turbo, libpng, nss, openssl, zlib) - built against,
# not bundled. libxslt-dev is required by --with-system-libxslt at configure time.
# perl-archive-zip: configure requires Perl Archive::Zip (rewrite_zip_timestamps.pl).
# patch: gbuild passes GNU-long --fuzz=0 to every external patch; QNX base toybox
# patch rejects it, so real GNU patch is required.
# SEQUENCING(qnx-ports): perl-archive-zip and patch are separate aports pending in
# extra/ (branch 803); this recipe's makedepends resolve once those land.
makedepends="
	qt6-base-dev
	boost-dev
	cairo-dev
	fontconfig-dev
	freetype-dev
	icu-dev
	libjpeg-turbo-dev
	lcms2-dev
	libpng-dev
	libxml2-dev
	libxslt-dev
	nss-dev
	nspr-dev
	openssl-dev
	zlib-ng-dev
	expat-dev
	gettext-dev
	gperf
	flex
	bison
	perl-archive-zip
	patch
	"

# Alpha ships as a single package. Per-app subpackage splitting is a later refinement.
subpackages=""

# Core source = a byte-stable pristine snapshot of LibreOffice core at $_commit,
# hosted as a GitHub RELEASE ASSET (a fixed uploaded file). A github .../archive/<ref>
# auto-tarball is byte-UNSTABLE across re-generation and would break the checksum, so
# it is NOT used. The pristine tarball + this dir's 0001-0033 patches reproduce the
# port tree exactly (verified: tree == qnx-port HEAD). The ::rename keeps the local
# filename stable regardless of the release URL.
#
# The snapshot (352037459 bytes) was produced by
#   `git archive --format=tar --prefix=core-$_commit/ $_commit | gzip -9n`
# and uploaded as the release asset below; its sha512 matches the pinned sum (the
# downloaded asset was re-hashed byte-for-byte: sha512 == the sha512sums line,
# sha256 375a4e11c0218024134c1e7bfafaad93da4b7acba6f3972040ae8f6a5d449c02).
_addsrcurl="https://dev-www.libreoffice.org/src"


builddir="$srcdir/core-$_commit"

prepare() {
	default_prepare

	# LibreOffice consumes externals from external/tarballs; stage the pinned set there.
	mkdir -p "$builddir"/external/tarballs
	local f
	for f in $source; do
		case "$f" in
		*argon2*|*curl-*|*dragonbox*|*libepoxy*|*fast_float*|*frozen*|*graphite2*|\
		*harfbuzz*|*liblangtag*|*language-subtag*|*liborcus*|*tiff-*|*libwebp*|\
		*md4c*|*mdds*|*raptor2*|*rasqal*|*redland*|*xmlsec1*|*zstd*|*zxcvbn*|*zxing*)
			cp "$srcdir"/"${f##*/}" "$builddir"/external/tarballs/ 2>/dev/null || true
			;;
		esac
	done

	# The gnu-cp shim adapts QNX toybox cp to the GNU long-opts gbuild uses (no GNU
	# coreutils on QNX; distro-config hardcodes --with-gnu-cp). Stage it for the build.
	# GNU patch comes from the packaged `patch` makedepend (/usr/bin/patch), not a shim.
	mkdir -p "$builddir"/.qnxtools
	install -m755 "$srcdir"/gnucp "$builddir"/.qnxtools/gnucp
}

build() {
	cd "$builddir"

	export SHELL=/bin/bash
	# autogen.input is not tracked; create it. --with-distro pulls the QNX arm set from
	# distro-configs/LibreOfficeQNX.conf. That config points --with-gnu-cp at a
	# machine-specific path, so override it (last-wins) to the staged shim.
	# WATCH-ITEM: fix the hardcoded path in distro-configs/LibreOfficeQNX.conf upstream.
	cat > autogen.input <<-EOF
		--with-distro=LibreOfficeQNX
		--with-gnu-cp=$builddir/.qnxtools/gnucp
	EOF

	./autogen.sh

	# One make invocation. Guest RAM policy noted for a memory-constrained builder:
	# -j2 during the Library_sd link, -j4 elsewhere. GNUPATCH = the packaged GNU patch
	# (toybox patch rejects gbuild's GNU-long --fuzz=0; on merged /usr this shadows it).
	make GNUPATCH=/usr/bin/patch ${JOBS:+-j${JOBS}}
}

package() {
	cd "$builddir"

	# The proven QNX artifact is the dev-install tree instdir/. Relocate it under the
	# package prefix (the QNX loader ignores $ORIGIN, so the launcher sets an absolute
	# LD_LIBRARY_PATH rather than relying on RPATH-relative discovery).
	local dest="$pkgdir"/usr/lib/libreoffice
	mkdir -p "$dest"
	cp -a instdir/. "$dest"/

	install -Dm755 "$srcdir"/soffice.qnx "$pkgdir"/usr/bin/libreoffice

	# WATCH-ITEM: the runtime loads UNO components from services/office.rdb via the
	# fundamentalrc "services/*" glob. Confirm the installed rdb filename matches that
	# glob (the build may install it as services/services.rdb).
	if [ ! -e "$dest"/program/services/office.rdb ] \
	   && [ ! -e "$dest"/program/services/services.rdb ]; then
		error "no services rdb under program/services - registration glob will miss"
		return 1
	fi
}


diff --git a/libreofficekit/qa/qnxrendergate/rendergate.cxx b/libreofficekit/qa/qnxrendergate/rendergate.cxx
new file mode 100644
index 000000000..4f060afa1
--- /dev/null
+++ b/libreofficekit/qa/qnxrendergate/rendergate.cxx
@@ -0,0 +1,109 @@
+// QNX LOK render-regression gate.
+//
+// Loads fixed documents through LibreOfficeKit, renders a 256x256 tile of each,
+// and checks the non-white pixel count against a per-document band: the floor
+// proves real content rendered (a blank tile is all-white -> 0 non-white), the
+// ceiling rejects an all-black/garbage tile. A malformed input is carried as a
+// negative control that must fail to render, so the gate discriminates rather
+// than rubber-stamps. rc=0 iff every case meets its expectation.
+//
+// build: see build.sh (must link the UNO exception RTTI anchor with
+//        -Wl,--dynamic-list-cpp-typeinfo; on the QNX executable-first loader an
+//        unanchored host gets an empty documentLoad).
+// run:   env SAL_USE_VCLPLUGIN=svp LD_LIBRARY_PATH=<inst>/program \
+//        ./rendergate <inst>/program <data-dir>
+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <LibreOfficeKit/LibreOfficeKit.hxx>
+
+namespace {
+
+struct Case
+{
+    const char* name;   // label
+    const char* file;   // input file name within the data dir
+    long lo, hi;        // accepted non-white band (ignored when expectFail)
+    bool expectFail;    // negative control: must NOT produce a valid tile
+};
+
+long countNonWhite(const std::vector<unsigned char>& buf)
+{
+    long n = 0;
+    for (size_t i = 0; i + 3 < buf.size(); i += 4)
+        if (buf[i] != 0xff || buf[i + 1] != 0xff || buf[i + 2] != 0xff)
+            ++n;
+    return n;
+}
+
+// non-white pixel count of a 256x256 tile, or -1 if load/render failed
+long renderOne(lok::Office* office, const char* url)
+{
+    lok::Document* doc = office->documentLoad(url);
+    if (!doc)
+        return -1;
+    doc->initializeForRendering("{}");
+    long w = 0, h = 0;
+    doc->getDocumentSize(&w, &h);
+    std::vector<unsigned char> buf(256 * 256 * 4);
+    doc->paintTile(buf.data(), 256, 256, 0, 0, (w > 0 ? w : 15000), (h > 0 ? h : 15000));
+    long nw = countNonWhite(buf);
+    delete doc;
+    return nw;
+}
+
+} // namespace
+
+int main(int argc, char** argv)
+{
+    if (argc < 3)
+    {
+        std::fprintf(stderr, "usage: %s <install/program> <data-dir>\n", argv[0]);
+        return 2;
+    }
+    const char* install = argv[1];
+    const char* datadir = argv[2];
+
+    // Bands are set around the measured known-good counts with margin; the aim
+    // is blank<->real discrimination, not an exact match.
+    const Case cases[] = {
+        { "hello.docx", "hello.docx", 3000, 9000, false },
+        { "clean.odt",  "clean.odt",  1000, 9000, false },
+        { "bad.odt",    "bad.odt",    0,    0,    true  }, // malformed zip -> empty load
+    };
+
+    lok::Office* office = lok::lok_cpp_init(install, nullptr);
+    if (!office)
+    {
+        std::fprintf(stderr, "GATE FAIL: lok_cpp_init returned null\n");
+        return 3;
+    }
+
+    int failures = 0;
+    for (const Case& c : cases)
+    {
+        char url[1024];
+        std::snprintf(url, sizeof url, "file://%s/%s", datadir, c.file);
+        long nw = renderOne(office, url);
+        if (c.expectFail)
+        {
+            bool tripped = (nw <= 0); // -1 (no load) or 0 (blank) both count
+            std::printf("[%-11s] non-white=%-6ld expect=FAIL -> %s\n",
+                        c.name, nw, tripped ? "ok" : "UNEXPECTED-PASS");
+            if (!tripped)
+                ++failures;
+        }
+        else
+        {
+            bool pass = (nw >= c.lo) && (nw <= c.hi);
+            std::printf("[%-11s] non-white=%-6ld band=[%ld,%ld] -> %s\n",
+                        c.name, nw, c.lo, c.hi, pass ? "PASS" : "FAIL");
+            if (!pass)
+                ++failures;
+        }
+    }
+
+    std::printf("%s: %d failure(s)\n", failures ? "GATE FAIL" : "GATE PASS", failures);
+    return failures ? 1 : 0;
+}
diff --git a/libreofficekit/qa/qnxrendergate/run.sh b/libreofficekit/qa/qnxrendergate/run.sh
new file mode 100755
index 000000000..89844ee46
--- /dev/null
+++ b/libreofficekit/qa/qnxrendergate/run.sh
@@ -0,0 +1,6 @@
+#!/bin/sh
+# Run the QNX LOK render-regression gate against the delivered install.
+C=${CORE:-/data/home/qnxuser/core-qnx}
+here=$(cd "$(dirname "$0")" && pwd)
+exec env SAL_USE_VCLPLUGIN=svp LD_LIBRARY_PATH="$C/instdir/program" \
+    "$here/rendergate" "$C/instdir/program" "$here/data"

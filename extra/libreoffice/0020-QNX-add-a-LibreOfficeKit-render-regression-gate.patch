+QNX LibreOfficeKit render-regression gate.
+
+  sh build.sh && sh run.sh      # rc=0 = pass
+
+Renders a 256x256 tile of each data/ document through LibreOfficeKit and checks
+the non-white pixel count against a per-document band: the floor rejects a blank
+tile, the ceiling rejects a garbage one. data/bad.odt is a negative control that
+must fail to render. Substitutes the upstream tiledrendering/smoketest tests,
+which are unusable here (disabled/bit-rotted, and a whole-office build).
diff --git a/libreofficekit/qa/qnxrendergate/build.sh b/libreofficekit/qa/qnxrendergate/build.sh
new file mode 100755
index 000000000..2af27b1c4
--- /dev/null
+++ b/libreofficekit/qa/qnxrendergate/build.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Build the QNX LOK render-regression gate native-on-QDD (clang++, libc++abi.so.1).
+set -e
+C=${CORE:-/data/home/qnxuser/core-qnx}
+here=$(cd "$(dirname "$0")" && pwd)
+UDK="$C/workdir/UnoApiHeadersTarget/udkapi/normal"
+OFF="$C/workdir/UnoApiHeadersTarget/offapi/normal"
+
+# UNO exception RTTI anchor (241 types), reused from the committed source. The
+# QNX executable-first loader needs it in the host exe or documentLoad is empty.
+clang++ -std=c++20 -DLIBO_INTERNAL_ONLY -DQNX -DUNIX -DUNX -D_PTHREADS \
+    -D_FILE_OFFSET_BITS=64 -DCPPU_ENV=gcc3 \
+    -I"$C/include" -I"$C/config_host" -I"$UDK" -I"$OFF" \
+    -c "$C/cpputools/source/unoexe/rttianchor.cxx" -o "$here/rttianchor.o"
+
+clang++ -std=c++20 -DLIBO_INTERNAL_ONLY \
+    -I"$C/include" -I"$C/config_host" \
+    "$here/rendergate.cxx" "$here/rttianchor.o" \
+    -Wl,--dynamic-list-cpp-typeinfo \
+    -L"$C/instdir/program" -l:libuno_sal.so.3 \
+    -o "$here/rendergate"
+echo "built: $here/rendergate"

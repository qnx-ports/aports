diff --git a/cpputools/source/unoexe/rttianchor_host.cxx b/cpputools/source/unoexe/rttianchor_host.cxx
new file mode 100644
index 000000000..2bf8477b8
--- /dev/null
+++ b/cpputools/source/unoexe/rttianchor_host.cxx
@@ -0,0 +1,7 @@
+/*
+ * QNX: second anchor TU so a test host (e.g. cppunittester) can carry the UNO
+ * exception RTTI anchor as well. gbuild forbids linking one object into two
+ * targets (fdo#47246), and uno.bin already owns rttianchor.cxx, so this thin
+ * wrapper reuses the generated set rather than duplicating it.
+ */
+#include "rttianchor.cxx"
diff --git a/sal/Executable_cppunittester.mk b/sal/Executable_cppunittester.mk
index 6c52197b2..2f239cdda 100644
--- a/sal/Executable_cppunittester.mk
+++ b/sal/Executable_cppunittester.mk
@@ -42,4 +42,21 @@ $(eval $(call gb_Executable_add_ldflags,cppunittester,\
 
 endif
 
+# QNX: anchor UNO exception RTTI in this test host and export it, so the
+# executable-first loader unifies type_info across the dlopened UNO components
+# under test (see cpputools/source/unoexe/rttianchor.cxx). Same mechanism as
+# Executable_uno.mk; needed for LibreOfficeKit tests that load office documents.
+ifeq ($(OS),QNX)
+$(eval $(call gb_Executable_use_api,cppunittester,\
+    udkapi \
+    offapi \
+))
+$(eval $(call gb_Executable_add_exception_objects,cppunittester,\
+    cpputools/source/unoexe/rttianchor_host \
+))
+$(eval $(call gb_Executable_add_ldflags,cppunittester,\
+    -Wl$(COMMA)--dynamic-list-cpp-typeinfo \
+))
+endif
+

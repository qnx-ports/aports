From 84b3e98282de03177d2ac03893f160f1f3802e10 Mon Sep 17 00:00:00 2001
From: Arthur Clark <mydevstuff@mail.com>
Date: Wed, 19 Aug 2026 16:03:06 +0000
Subject: [PATCH 17/33] Anchor the offapi exception RTTI in the QNX test host

Extend the UNO exception RTTI anchor from udkapi (URE, 64 types) to udkapi +
offapi (241 types) and link it into the cppunittester test host, so QNXs

Change-Id: Ia58ae5155b3d9ae673fedb586835d86d88d10071
---
 cpputools/Executable_uno.mk                 |   3 +
 cpputools/source/unoexe/gen-rttianchor.py   |  21 +-
 cpputools/source/unoexe/rttianchor.cxx      | 361 +++++++++++++++++++-
 cpputools/source/unoexe/rttianchor_host.cxx |   7 +
 sal/Executable_cppunittester.mk             |  17 +
 5 files changed, 398 insertions(+), 11 deletions(-)
 create mode 100644 cpputools/source/unoexe/rttianchor_host.cxx

diff --git a/cpputools/Executable_uno.mk b/cpputools/Executable_uno.mk
index 63c066337..ca3ce09a5 100644
--- a/cpputools/Executable_uno.mk
+++ b/cpputools/Executable_uno.mk
@@ -29,6 +29,9 @@ $(eval $(call gb_Executable_add_exception_objects,uno,\
 # rttianchor.cxx). The anchor defines the weak type_info; the linker flag
 # promotes it into .dynsym, which [[gnu::retain]] alone does not.
 ifeq ($(OS),QNX)
+$(eval $(call gb_Executable_use_api,uno,\
+    offapi \
+))
 $(eval $(call gb_Executable_add_exception_objects,uno,\
     cpputools/source/unoexe/rttianchor \
 ))
diff --git a/cpputools/source/unoexe/gen-rttianchor.py b/cpputools/source/unoexe/gen-rttianchor.py
index 1b56ac92f..9f109ca8c 100755
--- a/cpputools/source/unoexe/gen-rttianchor.py
+++ b/cpputools/source/unoexe/gen-rttianchor.py
@@ -1,9 +1,10 @@
 #!/usr/bin/env python3
-# gen-rttianchor.py: emit rttianchor.cxx anchoring every URE UNO exception
-# type's RTTI in the launcher. Scans the IDL tree for exception decls so the
-# anchor can't silently drift as UNO types change.
+# gen-rttianchor.py: emit rttianchor.cxx anchoring every UNO exception type's
+# RTTI in the host. Scans the IDL tree for exception decls so the anchor can't
+# silently drift as UNO types change. Default set is udkapi (URE) + offapi
+# (office), covering the exceptions caught across the C++ UNO bridge.
 #   Regenerate (from this dir): python3 gen-rttianchor.py > rttianchor.cxx
-#   Add offapi later: python3 gen-rttianchor.py <root>/offapi/com/sun/star
+#   Restrict to given roots: python3 gen-rttianchor.py <root>/com/sun/star ...
 
 import os
 import re
@@ -39,7 +40,10 @@ def scan(api_css):
 
 
 def main():
-    roots = sys.argv[1:] or [os.path.join(ROOT, "udkapi", "com", "sun", "star")]
+    roots = sys.argv[1:] or [
+        os.path.join(ROOT, "udkapi", "com", "sun", "star"),
+        os.path.join(ROOT, "offapi", "com", "sun", "star"),
+    ]
     seen = {}
     for r in roots:
         for fqn, hpp in scan(r):
@@ -52,14 +56,15 @@ def main():
     w(" * executable-first, so a weak type_info defined here preempts each dlopen'd UNO\n")
     w(" * component's own copy, unifying exception identity across the C++ UNO bridge.\n")
     w(" *\n")
-    w(" * Generated by gen-rttianchor.py from the udkapi (URE) exception set -- do not\n")
-    w(" * hand-edit. Regenerate: python3 gen-rttianchor.py > rttianchor.cxx\n")
+    w(" * Generated by gen-rttianchor.py from the udkapi (URE) + offapi (office)\n")
+    w(" * exception set -- do not hand-edit. Regenerate: python3 gen-rttianchor.py >\n")
+    w(" * rttianchor.cxx\n")
     w(" */\n\n")
     w("#include <typeinfo>\n\n")
     for _fqn, hpp in items:
         w("#include <%s>\n" % hpp.replace(os.sep, "/"))
     w("\nnamespace\n{\n")
-    w("// every URE exception type (leaf + base), so each __si chain resolves to\n")
+    w("// every UNO exception type (udkapi + offapi; leaf + base), so each __si chain resolves to\n")
     w("// executable-local copies; any launcher's Executable_*.mk can reuse this TU\n")
     w("[[gnu::used, gnu::retain]]\n")
     w("::std::type_info const * const g_aUnoExceptionRtti[] = {\n")

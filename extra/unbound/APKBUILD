4f33a7be8380ef6af16e62e5db36720b3c923f85ad4f51e98e1da8ecb2d02fa2343e1c30e94a04ae7f4f7d2a16cc4ecf04d7530760ac3763d75c6484755470c4  00-qnx-build.patch
"

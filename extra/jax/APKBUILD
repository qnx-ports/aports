    abuild-meson
    meson-bash-completion
    meson
    ninja
    "
checkdepends="
    python3-pytest
    python3-pytest-xdist
    "
subpackages="
    python3-jax:py3
    python3-jaxlib:py3
    "
_python3_jax_depends="python3-jaxlib"
_python3_jaxlib_depends="libc++"
source="$pkgname-$pkgver.tar.gz::https://github.com/jax-ml/$pkgname/archive/refs/tags/$pkgname-v$pkgver.tar.gz
    python_BUILD.bazel
    python_defs.bzl
    python_WORKSPACE
    python_qnx_BUILD.bazel
    python_qnx_WORKSPACE
    qnx.patch
    "
builddir="$srcdir/$pkgname-$pkgname-v$pkgver"
options="!check" # We don't have any of the checkdepends yet.

prepare() {
    default_prepare

    # Remove the old repository cache
    rm -rf $(bazel info repository_cache)

    # Remove the old bazel cache
    bazel clean --expunge

    # Create the toolchain to register our local python.
    mkdir $builddir/python
    cp -L $srcdir/python_BUILD.bazel $builddir/python/BUILD.bazel
    cp -L $srcdir/python_defs.bzl $builddir/python/defs.bzl
    cp -L $srcdir/python_WORKSPACE $builddir/python/WORKSPACE
    # And now... We need a lot of local paths for system files to exist here.
    mkdir $builddir/python_qnx
    cp -L $srcdir/python_qnx_BUILD.bazel $builddir/python_qnx/BUILD.bazel
    cp -L $srcdir/python_qnx_WORKSPACE $builddir/python_qnx/WORKSPACE
    ln -s /usr/bin $builddir/python_qnx/bin
    mkdir $builddir/python_qnx/include
    ln -s /usr/include/python3.14 $builddir/python_qnx/include/python3.14
    mkdir $builddir/python_qnx/lib
    ln -s /usr/lib/python3.14 $builddir/python_qnx/lib/python3.14
    ln -s /usr/lib/libpython3.so $builddir/python_qnx/lib/libpython3.so
    ln -s /usr/lib/libpython3.14.so $builddir/python_qnx/lib/libpython3.14.so
    ln -s /usr/share $builddir/python_qnx/share
    ln -s $builddir/python_qnx/bin/python3 $builddir/python_qnx/python
}

build() {
    if [[ $CARCH == "x86_64" ]]; then
        _extra_bazel_args="--define build_with_mkl=true --define build_with_openmp=true"
    elif [[ $CARCH == "aarch64" ]]; then
        # mkl calls out to Arm - ComputeLibrary, which we ported, but pulls in xbyak_aarch64 (with oneDNN v3.2.1) which needs some work.
        # _extra_bazel_args="--define build_with_mkl_aarch64=true --define tensorflow_mkldnn_contraction_kernel=0 --define build_with_openmp=true"
        _extra_bazel_args="--define build_with_mkl=false --define enable_mkl=false --define tensorflow_mkldnn_contraction_kernel=0"
    else
        die "$CARCH not supported"
    fi

    export LLVM_PATH=/usr/include/llvm
    # Without BAZEL_CXXOPTS, -std=c++14 is automatically added to the compile
    # command, which causes problems when jax tries to compile llvm from source.
    export BAZEL_CXXOPTS=-std=c++17

    # Setuptools with bazel6 has a known bug which we need to work-around.
    # For bazel6, the fetch command is vastly inferior to the build command.
    bazel \
        --host_jvm_args=-Djavax.net.ssl.trustStore=/usr/lib/jvm/java-25-openjdk/lib/security/cacerts \
        run \
        //jaxlib/tools:build_wheel \
        --copt="-DEIGEN_DONT_VECTORIZE=1" \
        --copt="-DFARMHASH_LITTLE_ENDIAN=1" \
        --copt="-D_STRUCT_IOVEC=1" \
        --copt="-Wno-c++11-narrowing" \
        --copt="-Wno-invalid-specialization" \
        --linkopt="-lcares" \
        --repo_env=HERMETIC_PYTHON_VERSION=3.14 \
        --repo_env=TF_NEED_CUDA=0 \
        --@xla//xla/python:enable_gpu=False \
        --extra_toolchains=@python_qnx//:qnx_py_toolchain \
        --extra_toolchains=@python_qnx//:qnx_py_toolchain2 \
        --extra_toolchains=@python_qnx//:qnx_py_cc_toolchain \
        --subcommands --verbose_failures \
        ${_extra_bazel_args} \
        -- \
        --output_path="$builddir/.dist" \
        --jaxlib_git_hash="$_commit" \
        --cpu="$CARCH" || true
    sed -i "s|files(__name__).joinpath('Lorem ipsum.txt').read_text(encoding='utf-8')|''|" $(bazel info output_base)/external/pypi__setuptools/setuptools/_vendor/jaraco/text/__init__.py
    sed -i "s|files(__name__).joinpath('Lorem ipsum.txt').read_text(encoding='utf-8')|''|" $(bazel info output_base)/external/pypi_setuptools/site-packages/setuptools/_vendor/jaraco/text/__init__.py

    bazel \
        --host_jvm_args=-Djavax.net.ssl.trustStore=/usr/lib/jvm/java-25-openjdk/lib/security/cacerts \
        run \
        //jaxlib/tools:build_wheel \
        --copt="-DEIGEN_DONT_VECTORIZE=1" \
        --copt="-DFARMHASH_LITTLE_ENDIAN=1" \
        --copt="-D_STRUCT_IOVEC=1" \
        --copt="-Wno-c++11-narrowing" \
        --copt="-Wno-invalid-specialization" \
        --linkopt="-lcares" \
        --repo_env=HERMETIC_PYTHON_VERSION=3.14 \
        --repo_env=TF_NEED_CUDA=0 \
        --@xla//xla/python:enable_gpu=False \
        --extra_toolchains=@python_qnx//:qnx_py_toolchain \
        --extra_toolchains=@python_qnx//:qnx_py_toolchain2 \
        --extra_toolchains=@python_qnx//:qnx_py_cc_toolchain \
        --subcommands --verbose_failures \
        ${_extra_bazel_args} \
        -- \
        --output_path="$builddir/.dist" \
        --jaxlib_git_hash="$_commit" \
        --cpu="$CARCH"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    for f in $(ls .dist/*.whl); do
        .testenv/bin/python3 -m installer $f
    done

    # Module name exists under $builddir
    mkdir test
    cd test
    ../.testenv/bin/python3 -m pytest ..
}

package() {
    for f in $(ls .dist/*.whl); do
        python3 -m installer -d "$pkgdir" $f
    done
}

py3() {
    pkgdesc="Python3 wrapper for $subpkgname"
    depends="python3 $(getvar "_${subpkgname/-/_}_depends")"

    amove usr/lib/python3.14/site-packages/"${subpkgname/python3-/}"
    # amove the egginfo file as well
    amove usr/lib/python3.14/site-packages/"${subpkgname/python3-/}"-*
}

# Print value of the specified variable, or the default if empty or not defined.
# From https://github.com/alpinelinux/aports/blob/3d4f2edabc7cca3a16b88a2d3795f584ae40aff5/main/nginx/APKBUILD
getvar() {
	eval "printf '%s\n' \"\${$1:-$2}\""
}


pkgname=jax
pkgver=0.4.30
pkgrel=0
_commit=f4158ace933482844c145a6b919bf5dc86e084ba
pkgdesc="High performance array computation and program transformation"
url="https://docs.jax.dev"
arch="all"
license="Apache-2.0"
depends="
    c-ares
    python3-absl-py
    python3-filelock
    python3-numpy
    python3-opt-einsum
    python3-scipy
    python3-flatbuffers
    python3-matplotlib
    python3-ml-dtypes
    qnx-fd-notify
    "
makedepends="
    bazel6
    cython
    c-ares-dev
    libc++-dev
    python3-build
    python3-dev
    python3-installer
    python3-gpep517
    python3-numpy-dev
    python3-packaging
    python3-pip
    python3-pyproject-metadata
    python3-setuptools
    python3-wheel
    python3-zstandard
    qnx-fd-notify-dev
    sqlite-dev
    sqlite-libs
    zlib-ng-dev
    xz-dev
    readline-dev
    libffi-dev
    expat-dev
    bzip2-dev
    libbz2

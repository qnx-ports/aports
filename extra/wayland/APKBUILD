#Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=wayland
pkgver=1.26.0
pkgrel=0
pkgdesc="A computer display server protocol"
url="https://wayland.freedesktop.org"
arch="all"
license="MIT"
depends_dev="
    libxml2
    libffi-dev
    expat-dev
    libxml2-dev
    "
depends="
    expat
    libffi
    libxml2
    libexpat
    qnx-io-sock
    qnx-fd-notify
    qnx-memstream
    qnx-libslog2    
"
makedepends="
    $depends_dev
    qnx-io-sock-dev
    qnx-fd-notify-dev
    qnx-memstream-dev
    qnx-libslog2-dev
    pkgconf-dev
    pkgconf
    meson
    ninja
    clang
    libc++-dev
    "
subpackages="
    $pkgname-dev
    "
source="https://gitlab.freedesktop.org/wayland/wayland/-/archive/$pkgver/wayland-$pkgver.tar.gz
0001-fix-missing-symbols-and-headers.patch
0002-fix-non-supported-tests.patch
"

build() {
    CXX="clang++" \
    meson \
        setup build \
        -Dprefix=/usr \
	-Dc_link_args=-Wl,-lepoll,-leventfd,-ltimerfd,-lsignalfd,-lmemstream,-lsocket,-lslog2 \
        -Ddocumentation=false

    ninja -C build
}

dev() {
    default_dev

    # QNX mesa only loads wayland if its explictly being used
    # since it can't know the so name we have to keep the unversioned so
    mv "$subpkgdir"/usr/lib/libwayland-server.so "$pkgdir"/usr/lib
    mv "$subpkgdir"/usr/lib/libwayland-client.so "$pkgdir"/usr/lib
}

check() {
    XDG_RUNTIME_DIR="$(mktemp -d)" \
    meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}



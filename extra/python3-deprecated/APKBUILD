# Alpine-Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-deprecated
pkgver=1.3.1
pkgrel=0
pkgdesc="Python decorator to deprecate old python classes, functions or methods"
url="https://github.com/tantale/deprecated"
arch="noarch"
license="MIT"
depends="python3-wrapt"
makedepends="python3-setuptools python3-gpep517 python3-installer python3-wheel"
checkdepends="python3-pytest python3-pytest-cov"
source="$pkgname-$pkgver.tar.gz::https://github.com/tantale/deprecated/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/deprecated-$pkgver"

prepare() {
    default_prepare
    sed -i 's/pkg_resources.parse_version/packaging.version.parse/g' tests/test.py
    sed -i 's/pkg_resources/packaging.version/g' tests/test.py
}

build() {
    #python3 setup.py build
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pytest --cov=deprecated --cov-report=html
}

package() {
    python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
e3db8ef4d5f4ea29749b03215d1ffa9774bc22b6cbbc9678f440999a5089a16cddc548569d89a8b2650e0343dfbfdf2c31cfca425872a0a62059f6a91537b1eb  python3-deprecated-1.3.1.tar.gz
"

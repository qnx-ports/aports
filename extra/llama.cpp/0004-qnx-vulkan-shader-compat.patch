QNX Vulkan compatibility patches for the self-hosted APK build.
---
--- a/ggml/src/ggml-vulkan/CMakeLists.txt
+++ b/ggml/src/ggml-vulkan/CMakeLists.txt
@@ -31,6 +31,19 @@
 #  TEST_SHADER_FILE - Path to the test shader file
 #  RESULT_VARIABLE - Name of the variable to set (ON/OFF) based on test result
 function(test_shader_extension_support EXTENSION_NAME TEST_SHADER_FILE RESULT_VARIABLE)
+    if (CMAKE_SYSTEM_NAME MATCHES "QNX" AND
+            (EXTENSION_NAME STREQUAL "GL_KHR_cooperative_matrix" OR
+             EXTENSION_NAME STREQUAL "GL_NV_cooperative_matrix2"))
+        # glslc on QNX passes the cooperative matrix capability probe but produces
+        # empty output when compiling the actual shaders. This is a glslc bug with
+        # no known workaround. Disabling avoids a silently broken build.
+        # Trade-off: GPU cooperative matrix acceleration is unavailable on QNX
+        # until the glslc bug is fixed upstream.
+        message(STATUS "${EXTENSION_NAME} disabled on QNX: glslc bug produces empty output for cooperative matrix shaders")
+        set(${RESULT_VARIABLE} OFF PARENT_SCOPE)
+        return()
+    endif()
+
     execute_process(
         COMMAND ${Vulkan_GLSLC_EXECUTABLE} -o - -fshader-stage=compute --target-env=vulkan1.3 "${TEST_SHADER_FILE}"
         OUTPUT_VARIABLE glslc_output
@@ -175,6 +188,14 @@
 
     file(GLOB _ggml_vk_shader_files CONFIGURE_DEPENDS "${_ggml_vk_input_dir}/*.comp")
 
+    if (CMAKE_SYSTEM_NAME MATCHES "QNX")
+        # The four cooperative matrix .comp files (flash_attn_cm1/2, mul_mm_cm1/2)
+        # are still discovered by the glob above even though the extensions are
+        # disabled. Remove them so CMake does not generate build targets for
+        # shaders that glslc cannot compile on QNX.
+        list(FILTER _ggml_vk_shader_files EXCLUDE REGEX ".*/(flash_attn_cm[12]|mul_mm_cm[12])\\.comp$")
+    endif()
+
     # Because external projects do not provide source-level tracking,
     # the vulkan-shaders-gen sources need to be explicitly added to
     # ensure that changes will cascade into shader re-generation.
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -5885,7 +5885,15 @@
     vk::ApplicationInfo app_info{ "ggml-vulkan", 1, nullptr, 0, api_version };
 
     const std::vector<vk::ExtensionProperties> instance_extensions = vk::enumerateInstanceExtensionProperties();
+#if defined(__QNX__)
+    // VK_EXT_layer_settings lets applications configure Vulkan validation layers
+    // at instance creation. The C++ wrapper types for this extension are absent
+    // from QNX 8.0 Vulkan-Hpp headers, so the non-QNX code below cannot compile.
+    // The extension is optional: Vulkan works correctly without it.
+    const bool layer_settings = false;
+#else
     const bool layer_settings = ggml_vk_instance_layer_settings_available();
+#endif
 #ifdef __APPLE__
     const bool portability_enumeration_ext = ggml_vk_instance_portability_enumeration_ext_available(instance_extensions);
 #endif
@@ -5907,6 +5915,13 @@
     if (debug_utils_ext) {
         extensions.push_back("VK_EXT_debug_utils");
     }
+#if defined(__QNX__)
+    // The VK_EXT_layer_settings wrapper types are absent from QNX Vulkan-Hpp
+    // headers, so LayerSettingsCreateInfoEXT cannot be used as a pNext chain.
+    // Use the base constructor; no layer configuration is lost since
+    // layer_settings is false and validation layers use environment variables.
+    vk::InstanceCreateInfo instance_create_info(vk::InstanceCreateFlags{}, &app_info, layers, extensions);
+#else
     VkBool32 enable_best_practice = layer_settings;
     std::vector<vk::LayerSettingEXT> settings = {
         {
@@ -5919,6 +5934,7 @@
     };
     vk::LayerSettingsCreateInfoEXT layer_setting_info(settings);
     vk::InstanceCreateInfo instance_create_info(vk::InstanceCreateFlags{}, &app_info, layers, extensions, &layer_setting_info);
+#endif
 #ifdef __APPLE__
     if (portability_enumeration_ext) {
         instance_create_info.flags |= vk::InstanceCreateFlagBits::eEnumeratePortabilityKHR;
--- a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
@@ -316,8 +316,16 @@
 
 compile_count_guard acquire_compile_slot() {
     // wait until fewer than N compiles are in progress.
-    // 16 is an arbitrary limit, the goal is to avoid "failed to create pipe" errors.
+    // N caps the number of concurrent glslc child processes launched by this process.
+#ifdef __QNX__
+    // glslc on QNX silently exits 0 with no output when multiple shader compilations
+    // run concurrently inside one vulkan-shaders-gen process. Serialize glslc
+    // children to reduce that failure mode. Build-time only; no runtime impact.
+    uint32_t N = 1;
+#else
+    // Cap at 16 to avoid exhausting pipe file descriptors under high parallelism.
     uint32_t N = std::max(1u, std::min(16u, std::thread::hardware_concurrency()));
+#endif
     std::unique_lock<std::mutex> guard(compile_count_mutex);
     compile_count_cond.wait(guard, [N] { return compile_count < N; });
     compile_count++;
@@ -336,9 +344,15 @@
     // disable spirv-opt for coopmat shaders for https://github.com/ggml-org/llama.cpp/issues/10734
     // disable spirv-opt for bf16 shaders for https://github.com/ggml-org/llama.cpp/issues/15344
     // disable spirv-opt for rope shaders for https://github.com/ggml-org/llama.cpp/issues/16860
+#ifndef __QNX__
+    // SPIRV-Tools optimization (-O) produces SPIR-V that fails Vulkan validation
+    // on QNX with VUID-StandaloneSpirv-None-10684.
+    // Trade-off: Vulkan shaders on QNX run unoptimized vs other platforms
+    // until the issue is resolved.
     if (!coopmat && name.find("bf16") == std::string::npos && name.find("rope") == std::string::npos) {
         cmd.push_back("-O");
     }
+#endif
 
     if (dep_file) {
         cmd.push_back("-MD");
@@ -371,14 +385,53 @@
         // }
         // std::cout << std::endl;
 
-        execute_command(cmd, stdout_str, stderr_str);
+        // glslc on QNX intermittently exits 0 with empty stderr and no output file.
+        // The failure is not deterministic: the same command succeeds on a subsequent
+        // attempt. Retry up to 3 times before treating empty output as fatal.
+        // Exceptions thrown here propagate through the std::future; c.get() below
+        // makes any persistent failure stop the build with a visible error.
+        std::string spv;
+#ifdef __QNX__
+        constexpr int max_attempts = 3;
+#else
+        constexpr int max_attempts = 1;
+#endif
+        for (int attempt = 1; attempt <= max_attempts; ++attempt) {
+            stdout_str.clear();
+            stderr_str.clear();
+            execute_command(cmd, stdout_str, stderr_str);
+            if (!stderr_str.empty()) {
+                break;
+            }
+            spv = read_binary_file(out_path, true);
+            if (!spv.empty()) {
+                break;
+            }
+#ifdef __QNX__
+            if (attempt != max_attempts) {
+                std::cerr << "glslc produced empty output for " << name << ", retrying" << std::endl;
+            }
+#endif
+        }
         if (!stderr_str.empty()) {
             std::cerr << "cannot compile " << name << "\n\n";
             for (const auto& part : cmd) {
                 std::cerr << part << " ";
             }
             std::cerr << "\n\n" << stderr_str << std::endl;
-            return;
+            // The original `return` abandoned the promise silently; c.wait() at the
+            // call site then completed normally as if compilation succeeded, producing
+            // a broken install with no diagnostic. throw stores the error in the
+            // std::future so c.get() below can surface it as a fatal build failure.
+            throw std::runtime_error("glslc failed for " + name);
+        }
+
+        if (spv.empty()) {
+            // glslc's silent failure mode on QNX: exit 0, no stderr, no output file.
+            // Invisible to the stderr-only check above; without this a missing shader
+            // produces a broken package with no error message. Same future propagation
+            // as above; c.get() makes it a fatal build failure.
+            throw std::runtime_error("glslc did not produce shader output for " + name + ": " + out_path);
         }
 
         if (dep_file) {
@@ -397,6 +450,10 @@
         shader_fnames.push_back(std::make_pair(name, out_path));
     } catch (const std::exception& e) {
         std::cerr << "Error executing command for " << name << ": " << e.what() << std::endl;
+        // Log then re-throw. This catch exists to print the error; without re-throw
+        // it absorbs the exception entirely, the future completes as if nothing failed,
+        // and c.get() below sees a successful result despite the broken shader output.
+        throw;
     }
 }
 
@@ -1026,7 +1083,11 @@
     string_to_spv("topk_moe_f32", "topk_moe.comp", {});
 
     for (auto &c : compiles) {
-        c.wait();
+        // c.wait() is designed to discard stored exceptions; it only blocks until
+        // completion. c.get() re-throws them. Using c.wait() here would silently
+        // swallow every throw in string_to_spv_func regardless of what failed,
+        // and the build would continue producing a broken package with no error.
+        c.get();
     }
 }
 

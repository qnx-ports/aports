QNX platform compatibility for the self-hosted APK build.

- QNX provides PATH_MAX through <limits.h>, not <sys/syslimits.h>.
- QNX has HOME/XDG_CACHE_HOME and can use the Unix cache directory path.
- QNX sysconf(_SC_PHYS_PAGES) does not return physical memory; query the
  memory manager (_MEM_INFO) for total and available physical memory.
- QNX CMake reports CMAKE_SYSTEM_PROCESSOR as "unknown" in this environment;
  use the compiler target triplet so ggml selects its x86 CPU backend.
- QNX keeps socket APIs such as bind() in libsocket, so llama-server must link
  socket explicitly.
---
diff --git a/common/arg.cpp b/common/arg.cpp
index c21598e..398c9cc 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -44,6 +44,8 @@
 #   endif
 #elif defined(_AIX)
 #include <sys/limits.h>
+#elif defined(__QNX__)
+#include <limits.h>
 #else
 #include <sys/syslimits.h>
 #endif
diff --git a/common/common.cpp b/common/common.cpp
index 793b8fe..e8f8950 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -950,7 +950,7 @@ std::string fs_get_cache_directory() {
         cache_directory = std::getenv("LLAMA_CACHE");
     } else {
 #if defined(__linux__) || defined(__FreeBSD__) || defined(_AIX) || \
-        defined(__OpenBSD__) || defined(__NetBSD__)
+        defined(__OpenBSD__) || defined(__NetBSD__) || defined(__QNX__)
         if (std::getenv("XDG_CACHE_HOME")) {
             cache_directory = std::getenv("XDG_CACHE_HOME");
         } else if (std::getenv("HOME")) {

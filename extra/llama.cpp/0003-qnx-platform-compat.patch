index d6d47b2..1290ae0 100644
--- a/common/download.cpp
+++ b/common/download.cpp
@@ -32,6 +32,8 @@
 #   endif
 #elif defined(_AIX)
 #include <sys/limits.h>
+#elif defined(__QNX__)
+#include <limits.h>
 #else
 #include <sys/syslimits.h>
 #endif
diff --git a/ggml/cmake/common.cmake b/ggml/cmake/common.cmake
index cb66388..77ecc51 100644
--- a/ggml/cmake/common.cmake
+++ b/ggml/cmake/common.cmake
@@ -36,6 +36,16 @@ function(ggml_get_system_arch)
             (NOT CMAKE_OSX_ARCHITECTURES AND NOT CMAKE_GENERATOR_PLATFORM_LWR AND
             CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|i686|AMD64|amd64)$"))
         set(GGML_SYSTEM_ARCH "x86" PARENT_SCOPE)
+    elseif (CMAKE_SYSTEM_NAME MATCHES "QNX")
+        execute_process(
+            COMMAND ${CMAKE_C_COMPILER} -dumpmachine
+            OUTPUT_VARIABLE GGML_QNX_COMPILER_TARGET
+            OUTPUT_STRIP_TRAILING_WHITESPACE
+            ERROR_QUIET
+        )
+        if (GGML_QNX_COMPILER_TARGET MATCHES "^(x86_64|i686|AMD64|amd64)-.*-qnx")
+            set(GGML_SYSTEM_ARCH "x86" PARENT_SCOPE)
+        endif()
     elseif (${CMAKE_SYSTEM_PROCESSOR} MATCHES "ppc|power")
         set(GGML_SYSTEM_ARCH "PowerPC" PARENT_SCOPE)
     elseif (${CMAKE_SYSTEM_PROCESSOR} MATCHES "loongarch64")
diff --git a/ggml/src/ggml-cpu/ggml-cpu.cpp b/ggml/src/ggml-cpu/ggml-cpu.cpp
index 128883b..d46b8b3 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.cpp
+++ b/ggml/src/ggml-cpu/ggml-cpu.cpp
@@ -37,6 +37,12 @@
 #    include <sys/types.h>
 #endif
 
+#if defined(__QNX__)
+#    include <sys/memmsg.h>
+#    include <sys/mman.h>
+#    include <sys/neutrino.h>
+#endif
+
 // ggml-backend interface
 
 std::vector<ggml_backend_buffer_type_t> & ggml_backend_cpu_get_extra_buffer_types() {
@@ -369,6 +375,22 @@ static void ggml_backend_cpu_device_get_memory(ggml_backend_dev_t dev, size_t *
     GlobalMemoryStatusEx(&status);
     *total = status.ullTotalPhys;
     *free = status.ullAvailPhys;
+#elif defined(__QNX__)
+    // QNX does not return a value through sysconf(_SC_PHYS_PAGES); query the
+    // memory manager (_MEM_INFO) for total and available physical memory.
+    *total = 0;
+    *free = 0;
+    {
+        mem_info_t msg;
+        msg.i.type = _MEM_INFO;
+        msg.i.zero = 0;
+        msg.i.flags = 0;
+        msg.i.fd = NOFD;
+        if (MsgSend(MEMMGR_COID, &msg.i, sizeof(msg.i), &msg.o, sizeof(msg.o)) == 0) {
+            *total = (size_t) msg.o.info.__posix_tmi_total;
+            *free  = (size_t) msg.o.info.posix_tmi_length;
+        }
+    }
 #else
     long pages = sysconf(_SC_PHYS_PAGES);
     long page_size = sysconf(_SC_PAGE_SIZE);

# Maintainer:Ramya santoshi <rtimmaraju@qnx.com>
pkgname=fastdds
pkgver=2.14.4
pkgrel=0
pkgdesc="eProsima Fast DDS with bundled foonathan"
url="https://github.com/eProsima/Fast-DDS"
arch="all"
license="Apache-2.0"

makedepends="
    build-base
    cmake
    ninja
    fast-cdr-dev
    foonathan_memory
    foonathan_memory_vendor
    openssl-dev
    qnx-fs-notify-dev
    tinyxml2-dev
    qnx-fs-core-dev
    gtest-dev
    qnx-io-sock-dev
    libc++-dev
"   
depends="libc++"

source="
    fastdds-$pkgver.tar.gz::https://github.com/eProsima/Fast-DDS/archive/refs/tags/v$pkgver.tar.gz
    qnx.patch
    fastdds-disable-shm-tests.patch
    https://github.com/chriskohlhoff/asio/archive/asio-1-29-0.tar.gz
    asio_fix.diff
"

builddir="$srcdir/Fast-DDS-$pkgver"

prepare() {
    default_prepare
    cd "$srcdir/asio-asio-1-29-0"
    patch -p1 < "$srcdir/asio_fix.diff"
    cp -r asio/include/* "$builddir/thirdparty/asio/"
}

build() {
    cmake -B build \
        -S "$builddir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=ON \
        -DQNX=TRUE \
        -DFASTDDS_USE_FILE_WATCH=OFF \
        -DFASTDDS_PERSISTENCE=OFF \
        -DEPROSIMA_BUILD_TESTS=ON \
        -DSECURITY=OFF \
        -DCMAKE_CXX_FLAGS="-I$builddir/thirdparty/asio -I/usr/include" \
        -DCMAKE_EXE_LINKER_FLAGS="-L/usr/lib -lsocket -lfsnotify -lgtest" 
    cmake --build build
}

check() {
    cd "$builddir/build"

    export LD_LIBRARY_PATH=/usr/lib:$LD_LIBRARY_PATH

    CTEST_TEST_TIMEOUT=30 ctest --output-on-failure -j1 || true
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}


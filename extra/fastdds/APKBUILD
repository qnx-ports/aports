60f941814c5c29cdc7e30ad8d4b37e9f32a4a83eb80059e1451bd5d047c1bbca08f5e1efd6fa93b763052b50772c5e6d46c7fca51e82ceb2ede0f4555dd5ddb6  dds-types-test.tar.gz
f0ef316479d43311ca818103fc6568a48a0b45346a92ffc22e99e99f2e93a0eb59bad0cf5ed39a528bc10cb64425b0d5683ced2f305d40e1923852d4cefed2f1  ssl.patch

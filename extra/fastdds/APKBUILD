# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=fast-dds
pkgver=2.14.4
pkgrel=0
pkgdesc="eProsima Fast DDS with bundled foonathan"
url="https://github.com/eProsima/Fast-DDS"
arch="all"
license="Apache-2.0"
subpackages="$pkgname-dev  $pkgname-tests $pkgname-tools"
makedepends="
    build-base
    cmake
    ninja
    fast-cdr-dev
    foonathan_memory
    foonathan_memory-dev
    foonathan_memory_vendor
    openssl-dev
    qnx-fs-notify-dev
    tinyxml2-dev
    qnx-fs-core-dev
    gtest-dev
    qnx-io-sock-dev
    libc++-dev
    qnx-fs-gpt-dev
"   
depends="libc++ fast-cdr foonathan_memory openssl foonathan_memory_vendor qnx-fs-notify  qnx-fs-gpt"
source="
    fast-dds-$pkgver.tar.gz::https://github.com/qnx-ports/Fast-DDS/archive/refs/heads/qnx_v2.14.4.tar.gz
    qnx.patch
    fast-dds-asiofix.diff
    fast-dds-disable-shm-tests.patch
    https://github.com/chriskohlhoff/asio/archive/asio-1-29-0.tar.gz
    asio_fix.diff
"
builddir="$srcdir/Fast-DDS-qnx_v$pkgver"
options="!check"
prepare() {
    default_prepare
    cd "$builddir"
    patch -p1 < "$srcdir/fast-dds-asiofix.diff"
    cd "$srcdir/asio-asio-1-29-0"
    patch -p1 < "$srcdir/asio_fix.diff"
    mkdir -p "$builddir/thirdparty/asio/include"
    cp -r asio/include/* "$builddir/thirdparty/asio/include"
}

build() {
    cmake -B build \
        -S "$builddir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=ON \
        -DQNX=TRUE \
        -DFASTDDS_USE_FILE_WATCH=OFF \
        -DFASTDDS_PERSISTENCE=OFF \
        -DEPROSIMA_BUILD_TESTS=ON \
        -DSECURITY=OFF \
        -DCMAKE_CXX_FLAGS="-I$builddir/thirdparty/asio -I/usr/include" \
        -DCMAKE_EXE_LINKER_FLAGS="-L/usr/lib -lsocket -lfsnotify -lgtest" 
    cmake --build build
}


check() {
    cd "$builddir/build"
    export LD_LIBRARY_PATH=/usr/lib:$LD_LIBRARY_PATH
    ctest --output-on-failure -j1 --timeout 30 || true
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}


dev() {
    default_dev
    amove usr/share/fastrtps/cmake
}

tests() {
    amove usr/bin/Fast-DDS_test
}

tools() {
    amove usr/bin/fastdds
    amove usr/bin/fast-discovery-server*
    amove usr/bin/ros-discovery
    amove usr/tools
}


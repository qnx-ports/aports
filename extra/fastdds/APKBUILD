# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=fast-dds
pkgver=3.6.2
pkgrel=0
pkgdesc="eProsima Fast DDS with bundled foonathan"
url="https://github.com/eProsima/Fast-DDS"
arch="all"
license="Apache-2.0"
subpackages="$pkgname-dev  $pkgname-tests $pkgname-tools"
makedepends="
    build-base
    cmake
    ninja
    fast-cdr-dev
    foonathan_memory
    foonathan_memory-dev
    foonathan_memory_vendor
    openssl-dev
    qnx-fs-notify-dev
    tinyxml2-dev
    qnx-fs-core-dev
    gtest-dev
    qnx-io-sock-dev
    libc++-dev
    qnx-fs-gpt-dev
    asio-dev
    gtest-dev
"   
depends="libc++ fast-cdr foonathan_memory openssl foonathan_memory_vendor qnx-fs-notify  qnx-fs-gpt"
options="!check"
source="
    fast-dds-$pkgver.tar.gz::https://github.com/eProsima/Fast-DDS/archive/refs/tags/v$pkgver.tar.gz
    dds-types-test.tar.gz::https://github.com/eProsima/dds-types-test/archive/c245fe0fee4a0227e4b904fc7fc7248e2c03b1af.tar.gz
    ssl.patch 
"

prepare() {
    default_prepare

    mkdir -p "$builddir/thirdparty/dds-types-test"

    tar -xzf "$srcdir/dds-types-test.tar.gz" \
        --strip-components=1 \
        -C "$builddir/thirdparty/dds-types-test"
}

builddir="$srcdir/Fast-DDS-$pkgver"

build() {
    export CFLAGS="${CFLAGS//-fstack-clash-protection/}"
    export CXXFLAGS="${CXXFLAGS//-fstack-clash-protection/}"
    cmake -B build \
        -S "$builddir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DQNX=TRUE \
        -DFASTDDS_USE_FILE_WATCH=OFF \
        -DFASTDDS_PERSISTENCE=OFF \
        -DEPROSIMA_BUILD_TESTS=ON \
        -DSECURITY=OFF \
        -DIS_THIRDPARTY_BOOST_OK=FALSE \
        -DCMAKE_CXX_FLAGS="$CXXFLAGS -DSA_RESTART=0 -Wno-error=array-bounds -Wno-error=parentheses-equality" \
        -DCMAKE_EXE_LINKER_FLAGS="-L/usr/lib -lsocket -lfsnotify " 
    cmake --build build
}

check() {
    cd "$builddir/build"
    export LD_LIBRARY_PATH=/usr/lib:$LD_LIBRARY_PATH
    ctest --output-on-failure -j1 --timeout 30 || true
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}


dev() {
    default_dev
    
}

tests() {
    amove usr/bin/Fast-DDS_test
}

tools() {
    amove usr/bin/fastdds
    amove usr/bin/fast-discovery-server*
    amove usr/bin/ros-discovery
    amove usr/tools
}


# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=snappy
pkgver=1.2.2
pkgrel=0
pkgdesc="Fast compression/decompression library"
url="https://github.com/google/snappy"
arch="all"
license="BSD-3-Clause"
depends="libc++"
makedepends="cmake libc++-dev gtest-dev gmock"
subpackages="$pkgname-dbg $pkgname-static $pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/google/snappy/archive/refs/tags/$pkgver.tar.gz
	snappy-1.2.2-qnx.patch
	"
build() {
   cmake -B build  \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=/usr/lib \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_STATIC_LIBS=ON \
		-DSNAPPY_BUILD_BENCHMARKS=OFF \
		-DSNAPPY_BUILD_TESTS=ON  \
        -DCMAKE_CXX_STANDARD=17

    cmake --build build
}

check() {
    cd "$builddir/build"
    ctest --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	local file; for file in AUTHORS CONTRIBUTING.md COPYING NEWS README.md \
		format_description.txt framing_format.txt; do
		install -m644 -D $file "$pkgdir"/usr/share/doc/$pkgname/$file
	done
}


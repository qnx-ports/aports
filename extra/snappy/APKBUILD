e147bc5aeb8fd7aa6eda0400b05805d7425a8b8a59e8634d62136658325fea1800e3c2900bbab3c5d4266a5c1fedad8700ded9cc71932125b2dd0a66fa0a0118  snappy-1.2.2-qnx.patch
"

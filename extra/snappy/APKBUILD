a6f90ef0494795a390e1d193a0c8b182011f2e30f9805c5fff69fdc58e1ec92015617ecad8090c38740cf99f6998f920fd2c0a9b099db1c38769bdab3babdca8  snappy-1.2.2-qnx.patch
"

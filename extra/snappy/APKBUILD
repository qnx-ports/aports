a29d3f98452bf6ed66c7d5dd3919accda0c8cbd033cb85f51bb59caaa54c348e80cb0a074aabd93707df71f25bef10e215c827f9ac4b591046de4ac43801a12e  snappy-1.2.2-cmake.patch
"

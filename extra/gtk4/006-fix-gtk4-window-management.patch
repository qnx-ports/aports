+
+static gboolean
+gdk_qnxscreen_toplevel_maximize (GdkToplevel *toplevel)
+{
+  GdkSurface *surface = GDK_SURFACE (toplevel);
+  GdkDisplay *display = gdk_surface_get_display (surface);
+  GdkMonitor *monitor = gdk_display_get_monitor_at_surface (display, surface);
+  GdkRectangle geom;
+  
+  gdk_monitor_get_geometry (monitor, &geom);
+  gdk_qnxscreen_surface_move_resize (surface, FALSE, 0, 0, geom.width, geom.height);
+  
+  GDK_SURFACE(surface)->state |= GDK_TOPLEVEL_STATE_MAXIMIZED;
+  g_object_notify (G_OBJECT (surface), "state");
+  
+  return TRUE;
+}
+
+static gboolean
+gdk_qnxscreen_toplevel_unmaximize (GdkToplevel *toplevel)
+{
+  GdkSurface *surface = GDK_SURFACE (toplevel);
+  
+  gdk_qnxscreen_surface_move_resize (surface, FALSE, -1, -1, 1024, 650);
+  
+  GDK_SURFACE(surface)->state &= ~GDK_TOPLEVEL_STATE_MAXIMIZED;
+  g_object_notify (G_OBJECT (surface), "state");
+  
+  return TRUE;
 }
 

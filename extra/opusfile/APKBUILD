# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=opusfile
pkgver=0.12
pkgrel=0
pkgdesc="High-level API for decoding and seeking within .opus files"
url="https://www.opus-codec.org/"
arch="all"
license="BSD-3-Clause"
depends="automake libcrypto3 libogg libssl3 opus"
depends_dev="openssl-dev>3"
makedepends="$depends_dev libogg-dev opus-dev"
subpackages="$pkgname-dev $pkgname-doc"
source="https://downloads.xiph.org/releases/opus/opusfile-$pkgver.tar.gz
    $pkgname-CVE-2022-47021-1.patch::https://github.com/xiph/opusfile/commit/0a4cd796df5b030cb866f3f4a5e41a4b92caddf5.patch
    c89.patch
    "

prepare() {
    default_prepare
    update_config_sub
    (cd "$builddir" && autoreconf)
}

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --localstatedir=/var \
        --disable-static
    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
}


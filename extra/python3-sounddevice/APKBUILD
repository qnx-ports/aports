# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-sounddevice
_pkgname=python-sounddevice
pkgver=0.5.0
pkgrel=0
pkgdesc="Python bindings for the PortAudio library"
url="https://python-sounddevice.readthedocs.io"
arch="all"
license="MIT"
depends="
    python3-cffi
    python3-numpy
    portaudio
    "
makedepends="
    python3-dev
    python3-gpep517
    python3-setuptools
    python3-setuptools_scm
    python3-wheel
    portaudio-dev
    "
source="$pkgname-$pkgver.tar.gz::https://github.com/spatialaudio/$_pkgname/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl

    .testenv/bin/python3 -m sounddevice
    .testenv/bin/python3 -c "import sounddevice as sd; print(sd._libname)"
    .testenv/bin/python3 -c "import sounddevice as sd; print(sd.get_portaudio_version())"
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="
a06966244f0ff54def3ad53839c553523a1e342609af84b8f8d4c0f3ed787f225035f80cf614e521d3642a0bf3e68f7e2924837a7b24d1dcc7d13d4ddac6a4a3  python3-sounddevice-0.5.0.tar.gz
"

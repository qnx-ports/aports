d9753c2c16daaa37fe03d6f97cc5e50d583d85112e26cfe035d11d9eee5ecff5ca8c6726e6056cb58a086b620b4f10c50ba16f85e87bf7e2097bcf337acaaf20  0001-add-qnx-build.patch
"

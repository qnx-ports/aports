#!/usr/bin/openrc-run
description="DHCP Client Daemon"

command="/usr/bin/dhcpcd"
command_args="-q -B ${command_args:-}"
command_background="true"
pidfile="/run/dhcpcd/pid"

depend() {
    need io-sock
    provide net
}

start_pre() {
    # so openrc can look for the pidfile without complaining
    checkpath -d /run/dhcpcd
}

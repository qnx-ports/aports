# Alpine-Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Contributoer: jscaffidi <jscaffidi@qnx.com>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=dhcpcd
pkgver=10.2.4_p1
pkgrel=0
pkgdesc="RFC2131 compliant DHCP client"
url="https://roy.marples.name/projects/dhcpcd"
arch="all"
license="BSD-2-Clause"
depends="qnx-io-sock"
makedepends="qnx-io-sock-dev"
install="$pkgname.post-install"
subpackages="$pkgname-doc $pkgname-openrc"
source="https://github.com/qnx-ports/dhcpcd/archive/refs/tags/qnx-v$pkgver.tar.gz
    dhcpcd.initd
	"
builddir="$srcdir/$pkgname-qnx-v$pkgver"

build() {
	echo $HOST $BUILD
	CFLAGS="$CFLAGS -DBSD" \
	./configure \
		--sbindir=/usr/bin \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--libexecdir=/usr/lib/$pkgname \
		--dbdir=/var/lib/$pkgname \
		--rundir=/run/dhcpcd \
		--runstatedir=/run/dhcpcd \
		--disable-static \
		--enable-ipv6 \
		--enable-privsep \
		--enable-seccomp \
		--without-dev \
		--without-udev
	make
}

check() {
	make test
}

package() {
	BINMODE=0755 make DESTDIR="$pkgdir" install
	install -Dm755 "$srcdir"/dhcpcd.initd \
		"$pkgdir"/etc/init.d/dhcpcd

}



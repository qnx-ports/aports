# Contributor: Felix Lionardo <flionardo@qnx.com>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=xfce4-panel
pkgver=4.21.0
pkgrel=2
pkgdesc="Panel for the Xfce desktop environment"
url="https://xfce.org/"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
subpackages="$pkgname-dev libxfce4panel:libs $pkgname-lang"
depends="gtk3 garcon libxfce4ui libxfce4util libxfce4windowing gtk-layer-shell exo libxfce4panel"
depends_dev="xfconf-dev gtk-layer-shell-dev libxfce4ui-dev" 
makedepends="$depends_dev
    exo-dev
    garcon-dev
    gobject-introspection-dev
    gtk3-dev
    gtk-layer-shell-dev
    libxfce4ui-dev
    libxfce4util-dev
    libxfce4windowing-dev
    meson
    ninja
    pango-dev
    "
source="https://archive.xfce.org/src/xfce/xfce4-panel/${pkgver%.*}/xfce4-panel-$pkgver.tar.xz
0001-Fix-shutdown-and-restart.patch
0002-prevent-multiple-dialogs.patch
"

build() {
    CFLAGS="$CFLAGS -Qunused-arguments"
    CXXFLAGS="$CXXFLAGS -Qunused-arguments"
    abuild-meson \
        . build
    ninja -C build
}

check() {
    meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}



+    "//upb:base": "protobuf::libupb",
+    "//upb:descriptor_upb_proto_reflection": "protobuf::libupb",
+    "//upb:descriptor_upb_proto": "protobuf::libupb",
+    "//upb:json": "protobuf::libupb",
+    "//upb:mem": "protobuf::libupb",
+    "//upb:message_compare": "protobuf::libupb",
+    "//upb:message_copy": "protobuf::libupb",
+    "//upb:message": "protobuf::libupb",
+    "//upb:port": "protobuf::libupb",
+    "//upb:reflection": "protobuf::libupb",
+    "//upb:text": "protobuf::libupb",
+    "//upb:wire": "protobuf::libupb",
+    "//upb:generated_code_support__only_for_generated_code_do_not_use__i_give_permission_to_break_me": "protobuf::libupb",
+    "//upb:generated_reflection_support__only_for_generated_code_do_not_use__i_give_permission_to_break_me": "protobuf::libupb",

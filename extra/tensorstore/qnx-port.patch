+# QNX port: CMake's $<LINK_LIBRARY:WHOLE_ARCHIVE,...> generator expression (used throughout
+# bazel_to_cmake's generated build_rules.cmake for targets that need all their static archive's
+# object files pulled in, e.g. for static-initializer-based driver/codec registration) requires
+# CMake to know how to implement "WHOLE_ARCHIVE" for the current compiler/platform via the
+# CMAKE_<LANG>_LINK_LIBRARY_USING_WHOLE_ARCHIVE variable. QNX isn't in CMake's built-in rule
+# database for this (as of CMake's version here), even though the actual linker in use (GNU ld,
+# confirmed via /usr/bin/ld) supports --whole-archive/--no-whole-archive exactly like it does on
+# Linux. Defining these two variables is the standard, documented way to add a new platform to
+# this mechanism (see CMake docs for LINK_LIBRARY generator expressions).
+foreach(_lang C CXX)
+  set(CMAKE_${_lang}_LINK_LIBRARY_USING_WHOLE_ARCHIVE
+      "LINKER:--whole-archive" "<LINK_ITEM>" "LINKER:--no-whole-archive")
+  set(CMAKE_${_lang}_LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED TRUE)
+endforeach()

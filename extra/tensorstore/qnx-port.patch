diff --git a/tensorstore/internal/os/file_util_posix.cc b/tensorstore/internal/os/file_util_posix.cc
index ccbc905..4e05a6c 100644
--- a/tensorstore/internal/os/file_util_posix.cc
+++ b/tensorstore/internal/os/file_util_posix.cc
@@ -437,25 +437,33 @@
       size = file_size - offset;
     }
     if (size == 0) {
       return MemoryRegion(nullptr, 0, UnmapFilePosix);
     }
   }
 
   void* address = ::mmap(nullptr, size, PROT_READ, MAP_PRIVATE, fd, offset);
   if (address == MAP_FAILED) {
     return std::move(tspan).EndWithStatus(
         StatusFromOsError(errno, "Failed to mmap"));
   }
+  // QNX port: no BSD/Linux-derived madvise()/MADV_WILLNEED; QNX implements
+  // the POSIX-standard posix_madvise()/POSIX_MADV_WILLNEED instead (same
+  // signature, same readahead-hint semantics, return value already
+  // intentionally ignored here on other platforms too).
+#ifdef __QNX__
+  ::posix_madvise(address, size, POSIX_MADV_WILLNEED);
+#else
   ::madvise(address, size, MADV_WILLNEED);
+#endif
 
   mmap_count.Increment();
   mmap_bytes.IncrementBy(size);
   mmap_active.Increment();
   return MemoryRegion(static_cast<char*>(address), size, UnmapFilePosix);
 #else
   return absl::UnimplementedError("::mmap not supported");
 #endif
 }
 

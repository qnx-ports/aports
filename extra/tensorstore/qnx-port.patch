+# PROTOBUF_CMAKE_MAPPING redirect added to third_party/com_google_protobuf/workspace.bzl (that
+# redirect only covers targets resolved through the normal cmake_target_mapping lookup, which
+# this code path bypasses). Since TENSORSTORE_USE_SYSTEM_PROTOBUF=ON skips ever generating real
+# targets under these names, pre-define them here as INTERFACE libraries pointing at the same
+# system protobuf install everything else already resolves to. See project_tensorstore_qnx.md.
+if(TENSORSTORE_USE_SYSTEM_PROTOBUF)
+  foreach(_wkt IN ITEMS any api duration empty field_mask source_context struct timestamp type wrappers descriptor)
+    if(NOT TARGET protobuf_${_wkt}_proto)
+      add_library(protobuf_${_wkt}_proto INTERFACE)
+      target_include_directories(protobuf_${_wkt}_proto INTERFACE /usr/include)
+    endif()
+  endforeach()

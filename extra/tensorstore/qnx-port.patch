 absl::Status FsyncDirectory(FileDescriptor fd) {
   LoggedTraceSpan tspan(__func__, detail_logging.Level(1), {{"fd", fd}});
 
   PotentiallyBlockingRegion region;
   if (::fsync(fd) == 0) {
+    return absl::OkStatus();
+  }
+  // QNX port: fsync() on a directory file descriptor is implementation-
+  // defined by POSIX, and this filesystem returns EINVAL rather than
+  // supporting it. This call exists to durably flush a new file's directory
+  // entry as an extra crash-consistency guarantee -- the file's own content
+  // is fsynced separately elsewhere, so treating "not supported" as success
+  // here preserves correctness for normal operation, just without that one
+  // additional guarantee on platforms/filesystems that don't support it.
+  if (errno == EINVAL) {
     return absl::OkStatus();
   }
   auto status = StatusFromOsError(errno, "Failed to fsync directory");
   return std::move(tspan).EndWithStatus(std::move(status));
 }
 

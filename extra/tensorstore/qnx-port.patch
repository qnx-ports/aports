+    add_executable(protobuf::upb_generator_protoc-gen-upb IMPORTED)
+    set_target_properties(protobuf::upb_generator_protoc-gen-upb PROPERTIES IMPORTED_LOCATION "${_qnx_protoc_gen_upb}")
+  endif()
+  if(NOT TARGET protobuf::upb_generator_protoc-gen-upb_minitable_stage1)
+    add_executable(protobuf::upb_generator_protoc-gen-upb_minitable_stage1 IMPORTED)
+    set_target_properties(protobuf::upb_generator_protoc-gen-upb_minitable_stage1 PROPERTIES IMPORTED_LOCATION "${_qnx_protoc_gen_upb}")
+  endif()
+  if(NOT TARGET protobuf::upb_generator_protoc-gen-upbdefs)
+    add_executable(protobuf::upb_generator_protoc-gen-upbdefs IMPORTED)

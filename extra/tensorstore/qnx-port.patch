+  # by IMPORTED-executable target name, which also never gets defined under
+  # TENSORSTORE_USE_SYSTEM_PROTOBUF=ON. Real binaries exist system-wide (apk protobuf package).
+  # No separate "minitable_stage1" binary ships -- minitable generation is folded into the same
+  # protoc-gen-upb binary in this protobuf version (31.1), so it's pointed at the same binary.
+  find_program(_qnx_protoc_gen_upb protoc-gen-upb REQUIRED)
+  find_program(_qnx_protoc_gen_upbdefs protoc-gen-upbdefs REQUIRED)

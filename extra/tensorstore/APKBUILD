# Maintainer: Cris Sinnott <csinnott@qnx.com>
pkgname=tensorstore
pkgver=0.1.74
pkgrel=0
pkgdesc="Library for reading/writing large multi-dimensional arrays (QNX-scoped: OCDBT+zarr3 C++ core only, no Python bindings)"
url="https://github.com/google/tensorstore"
arch="all"
license="Apache-2.0"
makedepends="
	cmake ninja python3 nasm
	abseil-cpp-dev protobuf-dev openssl-dev zlib-dev zstd-dev lz4-dev
	re2-dev benchmark-dev c-ares-dev
	blake3-dev riegeli snappy-dev c-blosc-dev
	grpc-dev grpc-cpp grpc-plugins
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/google/tensorstore/archive/refs/tags/v$pkgver.tar.gz
	qnx-port.patch
	qnx_smoke_test.cc
	Findriegeli.cmake
	Findhalf.cmake
	Re2Config.cmake
	half-2.1.0.zip::https://sourceforge.net/projects/half/files/half/2.1.0/half-2.1.0.zip/download
	half-detail_raise.patch.txt
	nlohmann-json-3.11.3.tar.gz::https://github.com/nlohmann/json/archive/refs/tags/v3.11.3.tar.gz
	"
builddir="$srcdir/$pkgname-$pkgver"

# See qnx-port.patch (applied automatically by default_prepare) for the full
# set of QNX/CMake portability fixes and their rationale -- summary:
#  - CMakeLists.txt: WHOLE_ARCHIVE link-library support registered for QNX
#    (CMake has no built-in rule for it here, even though the real linker,
#    GNU ld, supports --whole-archive exactly like on Linux); pre-defined
#    protobuf well-known-type/upb INTERFACE targets and IMPORTED protoc
#    plugin executables that TENSORSTORE_USE_SYSTEM_PROTOBUF's code path
#    never generates on its own; a --target list replacing the tool's
#    default eager "scan everything in included packages" (which pulls in
#    AVIF/AOM/S3/GCS/n5 etc. via top-level alias targets even when their
#    packages are excluded) with real Bazel-style lazy dependency-driven
#    analysis, scoped to exactly what OCDBT+zarr3+local-file-kvstore needs;
#    a bundled functional smoke test (qnx_smoke_test.cc) and install()
#    rules for the resulting libraries (bazel_to_cmake's own generated
#    build emits none at all -- confirmed empty cmake_install.cmake -- since
#    upstream's real consumption path is the Python extension, out of scope
#    here, see below).
#  - python/tensorstore/BUILD, tensorstore/driver/BUILD: a scoped
#    all_drivers_qnx_scoped target dropping image/{avif,jpeg,png,tiff,webp,
#    bmp}, n5, zarr(v2), neuroglancer_precomputed -- none needed by
#    zarr3+ocdbt, all pulling in dependency chains never ported here.
#  - tensorstore/internal/os/file_util_posix.cc: two real QNX portability
#    fixes -- madvise()/MADV_WILLNEED has no QNX equivalent (POSIX's own
#    posix_madvise()/POSIX_MADV_WILLNEED is used instead, same semantics);
#    fsync() on a directory fd returns EINVAL on this filesystem rather than
#    succeeding (POSIX explicitly leaves this implementation-defined --
#    treated as success, same pattern SQLite uses for filesystems without
#    directory-fsync support).
#  - third_party/blake3/workspace.bzl: target-name fix, BLAKE3::BLAKE3 (this
#    tool's auto-derived guess) -> BLAKE3::blake3 (what the real qnx-ports
#    blake3 package actually exports).
#  - third_party/com_github_grpc_grpc/workspace.bzl: enables the system-grpc
#    code path (grpc++_test/gRPC::grpc_test_util is the only reason it was
#    off, and that's test-only code never in this build's --target scope)
#    plus two more internal-only target-name redirects
#    (grpc++_codegen_proto, grpc_security_base) that bazel_to_cmake's own
#    codegen module needs regardless of system-package usage.
#  - third_party/com_google_protobuf/workspace.bzl: extends
#    PROTOBUF_CMAKE_MAPPING to actually redirect well-known-type and upb
#    targets to the system protobuf install when
#    TENSORSTORE_USE_SYSTEM_PROTOBUF=ON -- the existing scaffolding for this
#    was wired up for the FetchContent-vendored path only, contradicting
#    this file's own comment that they're "available via
#    protobuf::libprotobuf" under system-package mode.
#  - third_party/com_google_riegeli/workspace.bzl: riegeli has no official
#    CMake support upstream, so this maps every fine-grained riegeli bazel
#    target OCDBT/zarr3 reference to one riegeli::riegeli target (see
#    cmake-modules/Findriegeli.cmake below).
#
# boringssl is NOT vendored or stubbed: tensorstore's own
# third_party/com_google_boringssl/workspace.bzl already declares
# cmake_name = "OpenSSL" with a system_build_file that links plain
# -lcrypto/-lssl -- TENSORSTORE_USE_SYSTEM_OPENSSL=ON (below) already
# redirects every @com_google_boringssl reference (including OCDBT's two
# RAND_bytes() call sites) straight to the real openssl-dev already
# depended on for TLS elsewhere in this build. No shim needed.
#
# cmake-modules/{Findriegeli,Findhalf}.cmake: neither riegeli (our own
# from-scratch scoped build, see extra/riegeli) nor half (a raw
# single-header library with no build system at all) export real CMake
# Config files, so TENSORSTORE_USE_SYSTEM_RIEGELI/HALF need a hand-written
# Find module. blake3 does NOT need one -- its real upstream CMake install
# already provides blake3-config.cmake, found automatically once
# find_package(BLAKE3) falls through Module mode (no FindBLAKE3.cmake
# shipped here) to Config mode.
#
# cmake-modules/Re2Config.cmake: tensorstore's declared cmake_name = "Re2"
# makes find_package(Re2 CONFIG) look for Re2Config.cmake/re2-config.cmake,
# but the real re2-dev package ships usr/lib/cmake/re2/re2Config.cmake
# (lowercase, no hyphen) -- neither expected filename matches on a
# case-sensitive filesystem. This is a one-line redirect to the real file,
# a naming-convention mismatch, not a QNX bug.
#
# half-2.1.0.zip + half-detail_raise.patch: half is pinned to the exact
# version (2.1.0, not the current 2.2.0) and exact patch
# (third_party/net_sourceforge_half/patches/detail_raise.patch, fetched
# verbatim from tensorstore's own repo) tensorstore's own workspace.bzl
# declares -- fixes an ambiguous unqualified raise() call colliding with
# libc's global raise() from <csignal>, a real portability fix upstream
# itself carries, not QNX-specific.
#
# nlohmann-json-3.11.3.tar.gz: tensorstore pins nlohmann-json 3.11.3, but
# system nlohmann-json-dev ships 3.12.0, which has a breaking internal API
# change (json_sax_dom_parser gained a second template parameter,
# InputAdapter gained a required get_elements method) that breaks
# tensorstore/internal/riegeli/json_input.cc. Built+installed to a private
# vendor prefix that's searched before the system path, so the same
# TENSORSTORE_USE_SYSTEM_NLOHMANN_JSON=ON flag resolves to the pinned
# version instead of system 3.12.0.

prepare() {
	default_prepare
	install -Dm644 "$srcdir"/qnx_smoke_test.cc "$builddir"/qnx_smoke_test.cc
	mkdir -p "$srcdir"/cmake-modules-dest
	install -Dm644 "$srcdir"/Findriegeli.cmake "$srcdir"/cmake-modules-dest/Findriegeli.cmake
	# Lowercase filename required: find_package(half) is a case-sensitive
	# search on cmake_name = "half" (tensorstore's own declared name, not
	# a "conventional" capitalization) -- Findhalf.cmake, not FindHalf.cmake.
	install -Dm644 "$srcdir"/Findhalf.cmake "$srcdir"/cmake-modules-dest/Findhalf.cmake
	install -Dm644 "$srcdir"/Re2Config.cmake "$srcdir"/cmake-modules-dest/lib/cmake/Re2/Re2Config.cmake

	# Vendor half.hpp (patched) into the private prefix.
	local vp="$srcdir"/qnx-vendor-prefix
	mkdir -p "$vp"/include
	cd "$srcdir"
	unzip -oq half-2.1.0.zip include/half.hpp
	patch -p1 < "$srcdir"/half-detail_raise.patch.txt
	install -Dm644 include/half.hpp "$vp"/include/half.hpp

	# Vendor nlohmann-json 3.11.3 (header-only, has a real CMake install)
	# into the same private prefix.
	cmake -B "$srcdir"/nlohmann-json-build -S "$srcdir"/json-3.11.3 \
		-DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$vp" \
		-DJSON_BuildTests=OFF -G Ninja
	cmake --build "$srcdir"/nlohmann-json-build
	cmake --install "$srcdir"/nlohmann-json-build
}

build() {
	local vp="$srcdir"/qnx-vendor-prefix
	cmake -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_MODULE_PATH="$srcdir/cmake-modules-dest" \
		-DCMAKE_PREFIX_PATH="$vp;$srcdir/cmake-modules-dest" \
		-DTENSORSTORE_USE_SYSTEM_PROTOBUF=ON \
		-DTENSORSTORE_USE_SYSTEM_ABSL=ON \
		-DTENSORSTORE_USE_SYSTEM_ZLIB=ON \
		-DTENSORSTORE_USE_SYSTEM_ZSTD=ON \
		-DTENSORSTORE_USE_SYSTEM_LZ4=ON \
		-DTENSORSTORE_USE_SYSTEM_OPENSSL=ON \
		-DTENSORSTORE_USE_SYSTEM_BLOSC=ON \
		-DTENSORSTORE_USE_SYSTEM_BLAKE3=ON \
		-DTENSORSTORE_USE_SYSTEM_RIEGELI=ON \
		-DTENSORSTORE_USE_SYSTEM_NLOHMANN_JSON=ON \
		-DTENSORSTORE_USE_SYSTEM_GRPC=ON \
		-DTENSORSTORE_USE_SYSTEM_C_ARES=ON \
		-DTENSORSTORE_USE_SYSTEM_RE2=ON \
		-DTENSORSTORE_USE_SYSTEM_BENCHMARK=ON \
		-DTENSORSTORE_USE_SYSTEM_HALF=ON \
		-G Ninja
	cmake --build build
}

check() {
	local status=0 start end dur
	# qnx_smoke_test writes ./qnx_smoke_test_storage/ relative to CWD --
	# run from a scratch dir under $builddir so a re-run doesn't trip over
	# stale OCDBT manifest state from a previous attempt.
	rm -rf "$builddir"/qnx-check-run && mkdir -p "$builddir"/qnx-check-run
	start=$(date +%s)
	( cd "$builddir"/qnx-check-run && "$builddir"/build/bin/qnx_smoke_test ) || status=1
	end=$(date +%s)
	dur=$((end - start))

	mkdir -p "$startdir"/output-junit
	local failure=""
	[ "$status" -ne 0 ] && failure='<failure message="qnx_smoke_test assertion failed">see build log above</failure>'
	cat > "$startdir"/output-junit/tensorstore.xml <<-EOF
	<?xml version="1.0" encoding="UTF-8"?>
	<testsuites tests="1" failures="$status" name="tensorstore">
	  <testsuite name="qnx_smoke_test" tests="1" failures="$status">
	    <testcase name="zarr3_ocdbt_write_reopen_read" classname="qnx_smoke_test" time="$dur">$failure</testcase>
	  </testsuite>
	</testsuites>
	EOF

	[ "$status" -eq 0 ]
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}


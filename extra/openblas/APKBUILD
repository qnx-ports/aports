# Alpine-Contributor: Isaac Dunham <ibid.ag@gmail.com>
# Alpine-Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Deep Chordia <dchordia@blackberry.com>
pkgname=openblas
pkgver=0.3.31
pkgrel=0
pkgdesc="OpenBLAS is an optimized BLAS library based on GotoBLAS2 1.13 BSD version."
url="http://www.openmathlib.org/OpenBLAS/"
arch="all"
license="BSD-3-Clause"
depends_dev="
    flang-dev
    openmp-dev
    "
makedepends="
    $depends_dev
    cmake
    ninja
    clang
    flang
    openmp
    libc++-dev
"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/OpenMathLib/OpenBLAS/archive/refs/tags/v$pkgver.tar.gz
        0001-add-qnx-build.patch
        "
builddir="$srcdir/OpenBLAS-$pkgver"

build() {
  CC=clang \
  CXX=clang++ \
  CFLAGS="-Wno-unused" \
  LDFLAGS="-lgcc_s" \
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_DATADIR=/usr/lib \
    -DCMAKE_Fortran_COMPILER=flang \
    -DOpenMP_Fortran_LIB_NAMES=omp \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=ON \
    -DUSE_OPENMP=ON \
    -DCPP_THREAD_SAFETY_TEST=ON \
    -DUSE_TLS=ON \
    -DQNX=ON
  cmake --build build
}

check() {
  ctest --test-dir build -j1
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}


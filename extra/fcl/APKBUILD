# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=fcl
pkgver=0.7.0
pkgrel=0
pkgdesc="Flexible Collision Library"
url="https://github.com/flexible-collision-library/fcl"
arch="all"
license="BSD-3-Clause"
source="$pkgname-$pkgver.tar.gz::https://github.com/flexible-collision-library/fcl/archive/refs/tags/$pkgver.tar.gz
0001-Use-target_compile_features-to-specify-the-C-11-requ.patch
0002-Add-missing-cassert-include-in-fcl-common-types.h-62.patch
"

builddir="$srcdir/$pkgname-$pkgver"
depends="libccd octomap libc++"
depends_dev="eigen-dev libccd-dev octomap-dev libc++-dev"
makedepends="
	$depends_dev
	cmake
	ninja
"

subpackages="$pkgname-dev"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_TESTING=ON \
		-DFCL_WITH_OCTOMAP=ON
	cmake --build build
}

check() {
	# Some tests are disabled due to floating point precision issues on QNX.
	ctest3.5 --test-dir build -E 'test_fcl_capsule_capsule|test_fcl_shape_mesh_consistency|test_fcl_signed_distance|test_fcl_octomap_collision|test_gjk_libccd-inl_epa|test_gjk_libccd-inl_gjk_doSimplex2|test_gjk_libccd-inl_signed_distance'
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}


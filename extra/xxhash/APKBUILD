# Maintainer: Terence Ang <taang@qnx.com>
pkgname=xxhash
pkgver=0.8.3
pkgrel=1
pkgdesc="Extremely fast non-cryptographic hash algorithm"
url="https://cyan4973.github.io/xxHash/"
arch="all"
license="BSD-2-Clause"
subpackages="$pkgname-dev $pkgname-doc lib$pkgname:libs"
source="$pkgname-$pkgver.tar.gz::https://github.com/Cyan4973/xxHash/archive/v$pkgver.tar.gz fix-qnx.patch"
builddir="$srcdir/xxHash-$pkgver"

build() {
    export CFLAGS="$CFLAGS -DXXH_FORCE_MEMORY_ACCESS=1 -O2"
    make
}

package() {
    make DESTDIR="$pkgdir" PREFIX=/usr install
    rm -rf "$pkgdir"/usr/lib/libxxhash.a
}


+#include "config.h"
+#include "MemoryPressureMonitor.h"
+
+#if OS(QNX)
+
+#include "WebProcessPool.h"
+#include <mutex>
+#include <stdio.h>
+#include <string.h>
+#include <wtf/Threading.h>
+
+namespace WebKit {
+
+static const Seconds s_minPollingInterval { 1_s };
+static const Seconds s_maxPollingInterval { 5_s };
+static const double s_minUsedMemoryPercentageForPolling = 50;
+static const double s_maxUsedMemoryPercentageForPolling = 85;
+static const int s_memoryPresurePercentageThreshold = 90;
+static const int s_memoryPresurePercentageThresholdCritical = 95;
+
+// Reads page_count and pages_free from /proc/vm/stats.
+// Format per line: key=0xHEX (human_readable)
+// %li handles the 0x prefix correctly via scanf's auto-base detection.
+static int systemMemoryUsedAsPercentage()
+{
+    FILE* vmStats = fopen("/proc/vm/stats", "r");
+    if (!vmStats)
+        return -1;
+
+    size_t pageCount = 0;
+    size_t pagesFree = 0;
+    char key[64];
+
+    while (!feof(vmStats)) {
+        unsigned long value = 0;
+        if (fscanf(vmStats, "%63[^=]=%li%*[^\n]\n", key, &value) == 2) {
+            if (!strcmp(key, "page_count"))
+                pageCount = (size_t)value;
+            else if (!strcmp(key, "pages_free"))
+                pagesFree = (size_t)value;
+        }
+        if (pageCount && pagesFree)
+            break;
+    }
+    fclose(vmStats);
+
+    if (!pageCount || pagesFree > pageCount)
+        return -1;
+
+    int usedPercentage = (int)(((pageCount - pagesFree) * 100) / pageCount);
+    LOG(MemoryPressure, "MemoryPressureMonitor: pageCount=%zu pagesFree=%zu used=%d%%",
+        pageCount, pagesFree, usedPercentage);
+    return usedPercentage;
+}
+
+static inline Seconds pollIntervalForUsedMemoryPercentage(int usedPercentage)
+{
+    if (usedPercentage < s_minUsedMemoryPercentageForPolling)
+        return s_maxPollingInterval;
+    if (usedPercentage >= s_maxUsedMemoryPercentageForPolling)
+        return s_minPollingInterval;
+    return s_minPollingInterval + (s_maxPollingInterval - s_minPollingInterval) *
+        ((s_maxUsedMemoryPercentageForPolling - usedPercentage) /
+         (s_maxUsedMemoryPercentageForPolling - s_minUsedMemoryPercentageForPolling));
+}
+
+MemoryPressureMonitor& MemoryPressureMonitor::singleton()
+{
+    static NeverDestroyed<MemoryPressureMonitor> memoryMonitor;
+    return memoryMonitor;
+}
+
+void MemoryPressureMonitor::start()
+{
+    if (m_started)
+        return;
+    m_started = true;
+
+    Thread::create("MemoryPressureMonitor"_s, [] {
+        Seconds pollInterval = s_maxPollingInterval;
+        while (true) {
+            sleep(pollInterval);
+            int usedPercentage = systemMemoryUsedAsPercentage();
+            if (usedPercentage == -1) {
+                WTFLogAlways("MemoryPressureMonitor: failed to read /proc/vm/stats");
+                pollInterval = s_maxPollingInterval;
+                continue;
+            }
+            if (usedPercentage >= s_memoryPresurePercentageThreshold) {
+                bool isCritical = (usedPercentage >= s_memoryPresurePercentageThresholdCritical);
+                RunLoop::mainSingleton().dispatch([isCritical] {
+                    for (auto& processPool : WebProcessPool::allProcessPools())
+                        processPool->sendMemoryPressureEvent(isCritical);
+                });
+            }
+            pollInterval = pollIntervalForUsedMemoryPercentage(usedPercentage);
+        }
+    })->detach();
+}
+
+bool MemoryPressureMonitor::s_disabled = false;
+
+bool MemoryPressureMonitor::disabled()
+{
+    static std::once_flag flag;
+    std::call_once(flag, []() {
+        auto envvar = getenv("WEBKIT_DISABLE_MEMORY_PRESSURE_MONITOR");
+        s_disabled = envvar && !strcmp(envvar, "1");
+    });
+    return s_disabled;
+}
+
+} // namespace WebKit
+
+#endif // OS(QNX)

build() {
    export CC=clang
    export CXX=clang++
    export AR=llvm-ar
    export NM=llvm-nm
    export RANLIB=llvm-ranlib

    # Manually specify linker flags
    export LDFLAGS="-lsocket"
    
    # QNX names madvise differently
    _madv_defs="-DMADV_DISCARD_NP=POSIX_MADV_DISCARD_NP \
                -DMADV_DONTNEED=POSIX_MADV_DONTNEED \
                -DMADV_NORMAL=POSIX_MADV_NORMAL \
                -DMADV_RANDOM=POSIX_MADV_RANDOM \
                -DMADV_SEQUENTIAL=POSIX_MADV_SEQUENTIAL \
                -DMADV_WILLNEED=POSIX_MADV_WILLNEED \
                -Dmadvise=posix_madvise"
    
    _dbg_flags="-ggdb"

    # Do not build with debug symbols
    export CFLAGS="$CFLAGS $_madv_defs $_dbg_flags"
    export CXXFLAGS="$CXXFLAGS $_madv_defs $_dbg_flags"

    # supress some warnings
    _no_warns="-U_FORTIFY_SOURCE \
               -Wno-character-conversion \
               -Wno-unnecessary-virtual-specifier \
               -Wno-int-to-void-pointer-cast"

    _ext_flags="-DDEFAULT_THREAD_STACK_SIZE_IN_KB=1024 \
                -DFIXED_EXECUTABLE_MEMORY_POOL_SIZE_IN_MB=64"

    export CFALGS="$CFLAGS $_no_warns $_ext_flags"
    export CXXFLAGS="$CXXFLAGS $_no_warns $_ext_flags"

    _gtk_options="-DUSE_GTK4=OFF
        -DUSE_LIBBACKTRACE=OFF
        -DENABLE_GAMEPAD=OFF
        -DUSE_GBM=ON
        -DUSE_FLITE=OFF
        -DENABLE_QUARTZ_TARGET=OFF
        -DUSE_LIBBACKTRACE=OFF
        -DENABLE_X11_TARGET=OFF
        -DUSE_SYSPROF_CAPTURE=OFF
        "

    _jit="-DENABLE_JIT=ON
        -DENABLE_WEBASSEMBLY=ON
        -DENABLE_C_LOOP=OFF
        "

    _libcxx="-DUSE_CXX_STDLIB_ASSERTIONS=OFF"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DPORT=GTK \
        -DCMAKE_SKIP_RPATH=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DENABLE_DOCUMENTATION=OFF \
        -DENABLE_JOURNALD_LOG=OFF \
        -DENABLE_MINIBROWSER=ON \
        -DENABLE_SAMPLING_PROFILER=OFF \
        -DENABLE_SPELLCHECK=ON \
        -DENABLE_SPEECH_SYNTHESIS=OFF \
        -DENABLE_WEBGL=ON \
        -DUSE_SYSTEM_MALLOC=ON \
        $_gtk_options \
        $_jit \
        $_libcxx

    ninja -C build -j$(nproc)
}

check() {
    ninja -C build check
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    mv "$pkgdir"/usr/bin/WebKitWebDriver "$pkgdir"/usr/bin/WebKitWebDriver-4.1
}


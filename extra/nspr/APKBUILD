# Apline-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=nspr
pkgver=4.38.2
pkgrel=0
pkgdesc="Netscape Portable Runtime"
url="https://www.mozilla.org/projects/nspr/"
arch="all"
license="MPL-2.0"
depends="qnx-io-sock"
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends="autoconf automake qnx-io-sock-dev"
subpackages="$pkgname-dev"
source="https://github.com/qnx-ports/nspr/archive/refs/tags/qnx-v$pkgver.tar.gz
	"
options="!check"
_nspr_dir="$pkgname-qnx-v$pkgver"
prepare() {
	mkdir "$srcdir/$pkgname-$pkgver"
	mv "$_nspr_dir" "$builddir"/nspr
	mkdir "$builddir"/build "$builddir"/inst
	default_prepare
	cp "$sharedir"/config.sub "$builddir/nspr/build/autoconf/config.sub"
}

build() {
	cd "$builddir"/build
	CFLAGS="$CFLAGS -D_PR_POLL_AVAILABLE -D_PR_HAVE_OFF64_T -D_PR_INET6 -D_PR_HAVE_INET_NTOP -D_PR_HAVE_GETHOSTBYNAME2 -D_PR_HAVE_GETADDRINFO -D_PR_INET6_PROBE -DHAVE_SOCKLEN_T -Wincompatible-function-pointer-types" \
	../nspr/configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--disable-debug \
		--enable-optimize \
		--enable-ipv6 \
		--enable-64bit \
		$conf
	make CC="${CC:-gcc}" CXX="${CXX:-g++}"
}

package() {
	cd "$builddir"/build
	make DESTDIR="$pkgdir" install

	cd "$pkgdir"/usr/lib
	rm -f -- *.a

	cd "$builddir"/build/config
	install -Dm755 nspr-config "$pkgdir"/usr/bin/nspr-config
	install -Dm644 nspr.pc "$pkgdir"/usr/lib/pkgconfig/nspr.pc
	rm -rf "$pkgdir"/usr/bin/prerr.properties \
		"$pkgdir"/usr/bin/compile-et.pl \
		"$pkgdir"/usr/share/aclocal/nspr.m4 \
		"$pkgdir"/usr/include/nspr/md
}


sha512sums="
4bb0c9704ecd391a4fbdcaf296331e2c90746f5d8ff8a723c23b399903fd6c49cf8033b8d88432ea901d73dd042906b93d4479ce358f4ab82b3c10cb9767dac5  qnx-v4.38.2.tar.gz
"

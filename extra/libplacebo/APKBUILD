# Alpine-Contributor: Leo <thinkabit.ukim@gmail.com>
# Alpine-Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=libplacebo
pkgver=7.360.1
pkgrel=0
# rc testing
_pkgver=${pkgver/_/-}
pkgdesc="Reusable library for GPU-accelerated video/image rendering"
url="https://code.videolan.org/videolan/libplacebo"
arch="all"
license="LGPL-2.1-or-later"
depends="
    glslang-libs
    lcms2 
    shaderc 
    qnx-vulkan
    libc++
"
depends_dev="
    libc++-dev
	glslang-dev
	lcms2-dev
	shaderc-dev
	spirv-tools-dev
    vulkan-headers
"
makedepends="
    $depends_dev
	glslang-static
	meson
    python3-glad
    qnx-vulkan
	"
subpackages="$pkgname-dev $pkgname-dbg"
source="https://code.videolan.org/videolan/libplacebo/-/archive/v$_pkgver/libplacebo-v$_pkgver.tar.gz
  disable-failing-tests.patch
"
builddir="$srcdir/libplacebo-v$_pkgver"

build() {
	CFLAGS="$CFLAGS -O2" \
	CXXFLAGS="$CXXFLAGS -O2" \
	abuild-meson \
		-Db_lto=false \
		-Dbackend_max_links=4 \
		-Ddemos=false \
		-Ddovi=disabled \
		-Dglslang=enabled \
		-Dlcms=enabled \
		-Dlibdovi=disabled \
		-Dshaderc=enabled \
		-Dtests="$(want_check && echo true || echo false)" \
		-Dvulkan=enabled \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}




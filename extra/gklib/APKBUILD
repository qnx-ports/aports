# Maintainer: Harshini Yarasi <hyarasi@qnx.com>
pkgname=gklib  
pkgver=0_git20230327
_commit=8bd6bad750b2b0d90800c632cf18e8ee93ad72d7
pkgrel=0  
pkgdesc="A library of various helper routines and implementations of data structures"  
url="https://github.com/KarypisLab/GKlib"  
arch="all"  
license="Apache-2.0"  
makedepends="build-base cmake"  
subpackages="$pkgname-dev"  
source="
$pkgname-$_commit.tar.gz::https://github.com/KarypisLab/GKlib/archive/$_commit.tar.gz
fix-xopen-source.patch
"
builddir="$srcdir/GKlib-$_commit"

build() {
	local cmake_opts=

	case "$CARCH" in
		aarch64)
			cmake_opts="-DNO_X86=ON"
			;;
	esac
	
	cmake -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON \
		$cmake_opts \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5
	cmake --build build
}
check() {
	cd "$builddir"/build/test
    ./gksort
    ./strings
    ./gkuniq 10 2 
}

package() {
    DESTDIR="$pkgdir" cmake --install build  
} 


# Alpine-Contributor: Henrik Riomar <henrik.riomar@gmail.com>
# Alpine-Maintainer: Michał Polański <michal@polanski.me>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=swaybg
pkgver=1.2.2
pkgrel=0
pkgdesc="Wallpaper daemon for Wayland"
url="https://swaywm.org/"
license="MIT"
arch="all"
depends="cairo gdk-pixbuf glib wayland"
makedepends="
	cairo-dev
	gdk-pixbuf-dev
	libxkbcommon-dev
	meson
	ninja
	scdoc
	wayland-dev
	wayland-protocols
	"
subpackages="$pkgname-doc $pkgname-openrc"
source="https://github.com/swaywm/swaybg/archive/v$pkgver/swaybg-$pkgver.tar.gz
	swaybg.initd
	"
options="!check" # no test suite

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm755 "$srcdir"/swaybg.initd "$pkgdir"/etc/user/init.d/swaybg
}



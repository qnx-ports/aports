# Alpine-Contributor: Peter Bui <pnutzh4x0r@gmail.com>
# Alpine-Contributor: Fabian Affolter <fabian@affolter-engineering.ch>
# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=python3-flake8
pkgver=7.3.0
pkgrel=0
pkgdesc="Modular source code checker"
url="https://github.com/PyCQA/flake8"
arch="noarch"
license="MIT"
depends="
	python3-pyflakes
	python3-pycodestyle
	python3-mccabe
	"
makedepends="
	python3-gpep517
	python3-setuptools
	python3-wheel
	"
checkdepends="
	python3-pytest
	"
source="https://github.com/PyCQA/flake8/archive/refs/tags/$pkgver/python3-flake8-$pkgver.tar.gz"
builddir="$srcdir/flake8-$pkgver"
options="net"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages testenv
	testenv/bin/python3 setup.py install
	testenv/bin/python3 -m pytest -v
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
46e843fc6c3fae0e3b2cd5de09af4131ccdd2c0d7b09fe4942203d065e8625a0f95a3e6cbb89cc94bdb2925c1bd87ec8ba56211a9d695045fb64de91056236d8  python3-flake8-7.3.0.tar.gz
"



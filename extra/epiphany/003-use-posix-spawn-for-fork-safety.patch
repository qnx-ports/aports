+/**
+ * qnx_safe_launch_uri:
+ * Fork-safe application launcher for QNX using posix_spawn().
+ */
+static gboolean
+qnx_safe_launch_uri (const char *uri,
+                     GAppInfo   *app_info,
+                     GError    **error)
+{
+  const char *commandline;
+  char *cmd_expanded = NULL;
+  char **argv = NULL;
+  char *executable_path = NULL;
+  pid_t pid;
+  int status;
+  posix_spawn_file_actions_t actions;
+  gboolean result = FALSE;
+  char *placeholder;
+
+  g_return_val_if_fail (uri != NULL, FALSE);
+  g_return_val_if_fail (G_IS_APP_INFO (app_info), FALSE);
+
+  if (!app_info || !G_IS_APP_INFO (app_info)) {
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                 "No application handler available");
+    return FALSE;
+  }
+
+  g_debug ("[QNX] qnx_safe_launch_uri called for URI: %s", uri);
+
+  commandline = g_app_info_get_commandline (app_info);
+  if (!commandline) {
+    g_warning ("[QNX] No command line available for application");
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                 "No command line available");
+    return FALSE;
+  }
+
+  g_debug ("[QNX] Command line: %s", commandline);
+
+  /* Expand command with URI (handle %f, %u, %F, %U) */
+  cmd_expanded = g_strdup (commandline);
+  
+  if ((placeholder = strstr (cmd_expanded, "%f")) != NULL ||
+      (placeholder = strstr (cmd_expanded, "%F")) != NULL ||
+      (placeholder = strstr (cmd_expanded, "%u")) != NULL ||
+      (placeholder = strstr (cmd_expanded, "%U")) != NULL) {
+    GString *new_cmd = g_string_new ("");
+    g_string_append_len (new_cmd, cmd_expanded, placeholder - cmd_expanded);
+    g_string_append (new_cmd, uri);
+    g_string_append (new_cmd, placeholder + 2);
+    g_free (cmd_expanded);
+    cmd_expanded = g_string_free (new_cmd, FALSE);
+  } else {
+    char *tmp = g_strdup_printf ("%s %s", cmd_expanded, uri);
+    g_free (cmd_expanded);
+    cmd_expanded = tmp;
+  }
+
+  g_debug ("[QNX] Expanded command: %s", cmd_expanded);
+
+  /* Parse into argv */
+  if (!g_shell_parse_argv (cmd_expanded, NULL, &argv, error)) {
+    g_warning ("[QNX] Failed to parse command: %s", 
+               error && *error ? (*error)->message : "unknown");
+    g_free (cmd_expanded);
+    return FALSE;
+  }
+  g_free (cmd_expanded);
+
+  g_debug ("[QNX] Parsed argv[0]: %s", argv[0]);
+
+  /* Resolve executable path if it's not absolute */
+  if (!g_path_is_absolute (argv[0])) {
+    executable_path = g_find_program_in_path (argv[0]);
+    if (!executable_path) {
+      g_warning ("[QNX] Could not find '%s' in PATH", argv[0]);
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                   "Could not find '%s' in PATH", argv[0]);
+      g_strfreev (argv);
+      return FALSE;
+    }
+    g_debug ("[QNX] Resolved executable path: %s", executable_path);
+  } else {
+    executable_path = g_strdup (argv[0]);
+  }
+
+  /* Verify executable exists and is executable */
+  if (!g_file_test (executable_path, G_FILE_TEST_IS_EXECUTABLE)) {
+    g_warning ("[QNX] '%s' is not executable or does not exist", executable_path);
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                 "'%s' is not executable or does not exist", executable_path);
+    g_free (executable_path);
+    g_strfreev (argv);
+    return FALSE;
+  }
+
+  /* Initialize posix_spawn file actions */
+  if (posix_spawn_file_actions_init (&actions) != 0) {
+    g_warning ("[QNX] posix_spawn_file_actions_init failed: %s", g_strerror (errno));
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                 "spawn init failed: %s", g_strerror (errno));
+    g_free (executable_path);
+    g_strfreev (argv);
+    return FALSE;
+  }
+
+  /* Redirect stdout/stderr to /dev/null */
+  posix_spawn_file_actions_addopen (&actions, STDOUT_FILENO,
+                                    "/dev/null", O_WRONLY, 0);
+  posix_spawn_file_actions_addopen (&actions, STDERR_FILENO,
+                                    "/dev/null", O_WRONLY, 0);
+
+  g_debug ("[QNX] Calling posix_spawn for: %s", executable_path);
+
+  /* Spawn the process */
+  status = posix_spawn (&pid, executable_path, &actions, NULL, argv, environ);
+
+  posix_spawn_file_actions_destroy (&actions);
+
+  if (status == 0) {
+    g_debug ("[QNX] posix_spawn succeeded, PID: %d", pid);
+    result = TRUE;
+  } else {
+    g_warning ("[QNX] posix_spawn failed: %s", g_strerror (status));
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                 "spawn failed: %s", g_strerror (status));
+    result = FALSE;
+  }
+
+  g_free (executable_path);
+  g_strfreev (argv);
+  return result;
+}
+#endif /* __QNX__ */
+

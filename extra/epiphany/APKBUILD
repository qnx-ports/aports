pkgname=epiphany
pkgver=43.1 # Looking at gtk4 build very soon
pkgrel=3
pkgdesc="A simple, clean, beautiful view of the web"
url="https://wiki.gnome.org/Apps/Web"
arch="all"
license="GPL-3.0-or-later"
depends="
    desktop-file-utils
    icu-libs
    gcr
    gsettings-desktop-schemas
    gtk3
    json-glib
    libarchive
    libdazzle
    libhandy
    libnotify
    libportal
    libportal-gtk3
    libsecret
    libsoup3
    libxml2
    nettle
    sqlite-libs
    webkit2gtk-4.1
    "
makedepends="
    desktop-file-utils
    gcr-dev
    gsettings-desktop-schemas-dev
    gtk3-dev
    icu-dev
    iso-codes-dev
    itstool
    json-glib-dev
    libarchive-dev
    libdazzle-dev
    libhandy-dev
    liblocale-shim-dev
    libnotify-dev
    libportal-dev
    libsecret-dev
    libsoup3-dev
    libxml2-dev
    meson
    nettle-dev
    sqlite-dev
    webkit2gtk-4.1-dev
    clang
    libc++-dev
    qnx-screen-dev
    "

subpackages="$pkgname-lang $pkgname-doc $pkgname-dbg"
source="
    https://download.gnome.org/sources/epiphany/${pkgver%.*}/epiphany-$pkgver.tar.xz
    001-fix-missing-function-getrandom.patch
    002-fix-navigation-button-timeout-crash.patch
    003-use-posix-spawn-for-fork-safety.patch
"
options="!strip !check"

build() {
    CC=clang \
    CXX=clang++ \
    CFLAGS="$CFLAGS -Qunused-arguments -ggdb" \
    CXXFLAGS="$CXXFLAGS -Qunused-arguments -ggdb" \
    abuild-meson \
        --buildtype=release \
        -Db_lto=false \
        -Dc_link_args='-lm -lsocket -llocale' \
    . output
    meson compile -C output
}

check() {
    # https://gitlab.gnome.org/GNOME/epiphany/issues/829
    env PATH="$PATH:$builddir/output/src" xvfb-run meson test --no-rebuild --print-errorlogs -C output
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


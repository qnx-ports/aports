# Maintainer: Terence Ang <taang@qnx.com>
pkgver=0.2.1
pkgname=tera_renderer
pkgrel=0
pkgdesc="Tera-based renderer for acados templated code"
url="https://github.com/acados/tera_renderer"
arch="all"
license="NOASSERTION"
source="
    $pkgname-$pkgver.tar.gz::https://github.com/acados/tera_renderer/archive/refs/tags/v$pkgver.tar.gz
    001-cargo-toml.patch
    002-random.patch
"
makedepends="
    qnx-fs-notify-dev
    qnx-io-sock-dev
    cargo
    rust
"

prepare() {
    default_prepare
    if [ ! -f Cargo.lock ]; then
        cargo generate-lockfile
    fi
}

build() {
    CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=4 \
    cargo build --verbose --release --locked
}

package() {
    install -Dm755 target/release/t_renderer "$pkgdir"/usr/bin/t_renderer
}



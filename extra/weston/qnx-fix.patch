diff --git a/libweston/backend-qnx-screen/meson.build b/libweston/backend-qnx-screen/meson.build
new file mode 100644
index 00000000..fca9845a
--- /dev/null
+++ b/libweston/backend-qnx-screen/meson.build
@@ -0,0 +1,54 @@
+
+if not get_option('backend-qnx-screen')
+	subdir_done()
+endif
+
+config_h.set('BUILD_QNX_SCREEN_COMPOSITOR', '1')
+
+srcs_screen = [
+	'qnx-screen.c',
+        'qnx-screen-event-monitor.c',
+        'qnx-screen-event-monitor.h',
+        presentation_time_protocol_c,
+        presentation_time_server_protocol_h,
+]
+
+#dep_screen_xcb = dependency('xcb', version: '>= 1.8', required: false)
+#if not dep_x11_xcb.found()
+#	error('screen-backend requires xcb >= 1.8 which was not found. Or, you can use \'-Dbackend-screen=false\'.')
+#endif
+
+deps_screen = [
+        dependency('wayland-client'),
+	dep_egl, # optional
+	dep_libweston_private,
+	dep_lib_cairo_shared,
+	dep_pixman,
+]
+
+foreach name : [ 'screen' ]
+	d = cc.find_library(name, required: false)
+	if not d.found()
+		error('qnx-screen-backend requires @0@ which was not found. Or, you can use \'-Dbackend-qnx-screen=false\'.'.format(name))
+	endif
+	deps_screen += d
+endforeach
+
+#dep_xcb_xkb = dependency('xcb-xkb', version: '>= 1.9', required: false)
+#if dep_xcb_xkb.found()
+#	deps_x11 += dep_xcb_xkb
+#	config_h.set('HAVE_XCB_XKB', '1')
+#endif
+
+plugin_screen = shared_library(
+	'qnx-screen-backend',
+	srcs_screen,
+	include_directories: common_inc,
+	dependencies: deps_screen,
+	name_prefix: '',
+	install: true,
+	install_dir: dir_module_libweston
+)
+env_modmap += 'qnx-screen-backend.so=@0@;'.format(plugin_screen.full_path())
+
+install_headers(backend_qnx_screen_h, subdir: dir_include_libweston_install)

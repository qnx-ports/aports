# Alpine-Contributor: Leo <thinkabit.ukim@gmail.com>
# Alpine-Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
# Maintainer: Elliott Mazzuca <emazzuca@qnx.com>
pkgname=glslang
pkgver=1.4.321.0
pkgrel=0
pkgdesc="Khronos reference front-end for GLSL, ESSL, and sample SPIR-V generator"
url="https://github.com/KhronosGroup/glslang"
arch="all"
license="BSD-3-Clause AND BSD-2-Clause AND MIT AND Apache-2.0 AND GPL-3.0-or-later"
depends="$pkgname-libs=$pkgver-r$pkgrel libc++"
depends_dev="$pkgname=$pkgver-r$pkgrel"
# Without this, QNX abuild warns that glslang-libs is missing libc++ and
# spirv-tools shared-object dependencies. Keep them explicit until dependency
# tracing infers this runtime closure correctly.
depends_libs="libc++ spirv-tools"
makedepends="cmake ninja python3 bison spirv-tools-dev"
checkdepends="bash gtest-dev"
subpackages="$pkgname-static $pkgname-libs $pkgname-dev"
# The main tools intentionally link against libraries split into glslang-libs.
# The exact-version glslang-libs dependency above owns that relationship; these
# masks avoid false internal subpackage soname warnings from abuild.
somask="
	libSPVRemapper.so.15
	libglslang-default-resource-limits.so.15
	libglslang.so.15
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/KhronosGroup/glslang/archive/refs/tags/vulkan-sdk-$pkgver.tar.gz"
builddir="$srcdir/glslang-vulkan-sdk-$pkgver"

build() {
	# QNX clang treats Alpine's -fstack-clash-protection as unused. Preserve
	# Alpine's flags and ask clang not to fail on target-irrelevant arguments.
	export CFLAGS="$CFLAGS -Qunused-arguments"
	export CXXFLAGS="$CXXFLAGS -Qunused-arguments"
	cmake -B build-shared -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DBUILD_EXTERNAL=OFF \
		-DBUILD_SHARED_LIBS=ON \
		-DALLOW_EXTERNAL_SPIRV_TOOLS=YES \
		-DGLSLANG_TESTS="$(want_check && echo ON || echo OFF)"
	cmake --build build-shared

	cmake -B build-static -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DBUILD_EXTERNAL=OFF \
		-DBUILD_SHARED_LIBS=OFF \
		-DALLOW_EXTERNAL_SPIRV_TOOLS=YES \
		-DGLSLANG_TESTS="$(want_check && echo ON || echo OFF)"
	cmake --build build-static
}

check() {
	msg "Testing shared version of glslang"
	ctest --test-dir build-shared

	msg "Testing static version of glslang"
	ctest --test-dir build-static
}

package() {
	# installing static first lets shared overwrite the executables so they
	# themselves are not statically linking the library
	DESTDIR="$pkgdir" cmake --install build-static
	DESTDIR="$pkgdir" cmake --install build-shared
}

sha512sums="

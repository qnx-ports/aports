9ed26bca2b7b743d5ed6378fcc108461d5e3d14f45f005e5d622eea5b5f3f6a31360d728af6be7a90fb207e63797be064ee37871ab6b9c3b23412932d71376d1  001-qnx-fix-linking.patch
"

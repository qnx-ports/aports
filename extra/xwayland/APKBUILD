# Alpine-Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=xwayland
pkgver=24.1.9
pkgrel=0
pkgdesc="Compact xserver to run under wayland for compatibility"
url="https://www.x.org/wiki"
arch="all"
license="MIT"
# options="!check" # requires piglit, which has no stable releases
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc"
depends="xorg-server-common xkbcomp libdecor libxfont2 libxshmfence wayland libmd libxcvt libxau pixman"
depends_dev="
	dbus-dev
	font-util-dev
	libepoxy-dev
	libmd-dev 
	libxcvt-dev
	libxfont2-dev
    freetype-dev
	libxkbfile-dev
    libfontenc-dev
    libxshmfence-dev
    libx11-dev
	pixman-dev
	wayland-dev
	wayland-protocols
	xorgproto
	xtrans
    qnx-fd-notify-dev
	qnx-libdrm-dev
    qnx-io-sock-dev
	"
makedepends="
	$depends_dev
	meson
	"
source="
https://xorg.freedesktop.org/archive/individual/xserver/xwayland-$pkgver.tar.xz
qnx-build.patch
glamor_fix.patch
input.h
"

prepare() {
    default_prepare
    mkdir -p "$builddir"/include/linux/
    cp "$srcdir"/input.h "$builddir"/include/linux/input.h

}

build() {
	abuild-meson \
        -Dc_args="-DSA_RESTART=0 -I/usr/include/libdrm" \
        -Dc_link_args="-lsocket -leventfd" \
		-Db_lto=false \
		-Dipv6=true \
		-Dxvfb=false \
		-Dxdmcp=false \
		-Dxcsecurity=true \
		-Ddri3=true \
        -Dglx=false \
        -Dsecure-rpc=false \
		-Dglamor=true \
		-Dsha1=libmd \
		-Dxkb_dir=/usr/share/X11/xkb \
		-Dxkb_output_dir=/var/lib/xkb \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# Part of xorg-server-doc
	rm -f "$pkgdir"/usr/share/man/man1/Xserver.1

	# Part of xorg-server-common
	rm -f "$pkgdir"/usr/lib/xorg/protocol.txt
}



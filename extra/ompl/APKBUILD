# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=ompl
pkgver=1.7.0
pkgrel=0
pkgdesc="The Open Motion Planning Library"
url="https://ompl.kavrakilab.org"
arch="all"
license="BSD-3-Clause"
subpackages="$pkgname-dev $pkgname-doc"
depends="boost"
makedepends="
  cmake
  ninja
  boost-dev
  eigen-dev
"
source="$pkgname-$pkgver.tar.gz::https://github.com/ompl/ompl/archive/refs/tags/$pkgver.tar.gz
0001-remove-boost.system-as-a-dependency.-unused-1306.patch
0002-remove-boost.filesystem-as-a-dependency-and-use-std-.patch
"
builddir="$srcdir/$pkgname-$pkgver"

build() {
      cd "$builddir"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DOMPL_BUILD_TESTS=ON \
    -DOMPL_BUILD_DEMOS=OFF \
    -DOMPL_BUILD_PYBINDINGS=OFF \
    -DOMPL_BUILD_PYTESTS=OFF

  cmake --build build
}

package() {
  cd "$builddir"
  DESTDIR="$pkgdir" cmake --install build
}

check(){
  ctest --test-dir build --output-on-failure
}


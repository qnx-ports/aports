b3fc8aa80095542c9420e8a9bbf2257e407528b5cd491b5605fe2528cd7977167355f07ed1bed18c6f262e690aa361c3211a749989d6369c19c06d027e94202f  0001-remove-boost.system-as-a-dependency.-unused-1306.patch
b3f61b81765ee89ed058cfe21bce80a5ec77b9d59948d104a73953b874b063887bec0f88b9d8f4253fe77a8996b42f3a068affa8b372aa54ec52594aab4e95b6  0002-remove-boost.filesystem-as-a-dependency-and-use-std-.patch
"

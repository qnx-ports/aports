# Maintainer:Ramya santoshi <rtimmaraju@qnx.com>
pkgname=dlt-daemon
pkgver=3.0.0
pkgrel=0
pkgdesc="Diagnostic Log and Trace (DLT) daemon"
url="https://github.com/COVESA/dlt-daemon"
arch="all"
license="MPL-2.0"
makedepends="cmake make libc++-dev zlib-dev qnx-io-sock-dev qnx-libjson-dev  qnx-libslog2-dev qnx-slogger2-dev"
depends="libc++ qnx-io-sock qnx-libjson qnx-slogger2"
source="dlt-daemon-${pkgver}.tar.gz::https://github.com/qnx-ports/dlt-daemon/archive/refs/heads/qnx-v3.0.0.tar.gz
        dlt-daemon-3.0-qnx-clang.patch 
        gtest-1.13.0.tar.gz::https://github.com/google/googletest/archive/refs/tags/v1.13.0.tar.gz"
builddir="$srcdir/dlt-daemon-qnx-v3.0.0"
subpackages="$pkgname-dev"

build() {
    export CXXFLAGS="$CXXFLAGS \
    -Qunused-arguments \
    -Wno-error=missing-designated-field-initializers \
    -Wno-error=uninitialized-const-pointer \
    -Wno-error=vla-cxx-extension \
    -Wno-error=unused-but-set-variable \
    -Wno-error=unused-result"
    export CFLAGS="$CFLAGS -Qunused-arguments"

    # ---------------------------------------------------------
    # Build GoogleTest 1.13.0 privately for DLT unit tests
    # ---------------------------------------------------------

    gtest_src="$srcdir/googletest-1.13.0"
    gtest_build="$builddir/third_party/gtest/build"
    gtest_install="$builddir/third_party/gtest/install"
    export PKG_CONFIG_PATH="$gtest_install/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
    cmake -S "$gtest_src" \
        -B "$gtest_build" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$gtest_install" \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -Dgtest_build_tests=OFF \
        -DBUILD_GMOCK=OFF
    
    cmake --build "$gtest_build"
    cmake --install "$gtest_build"
    cat build/CMakeCache.txt

    cmake -B build -S "$builddir" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWITH_DLT_QNX_SYSTEM=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DWITH_DLT_UNIT_TESTS=ON \
        -DWITH_DLT_CXX11_EXT=ON \
        -DCMAKE_PREFIX_PATH="$gtest_install" \
        -DGTest_DIR="$gtest_install/lib/cmake/GTest" \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5

    echo "===== DLT CMake cache ====="

    cat build/CMakeCache.txt
    
    cmake --build build

    
}

check() {
    GTEST_FILTER='-t_dlt_get_log_state.normal:t_dlt_daemon_logstorage_setup_internal_storage.normal' \
        ctest --test-dir build/tests --output-on-failure -j1 \
        -E 'gtest_dlt_daemon_offline_log|logstorage_filepath|logstorage_multi_file|logstorage_one_file|logstorage_fsync|logstorage_max_cache_size|disable_network'
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}


# Maintainer:Ramya santoshi <rtimmaraju@qnx.com>
pkgname=dlt-daemon
pkgver=2.18.10
pkgrel=0
pkgdesc="Diagnostic Log and Trace (DLT) daemon"
url="https://github.com/COVESA/dlt-daemon"
arch="all"
license="MPL-2.0"

makedepends="cmake make "

source="dlt-daemon-${pkgver}.tar.gz::https://github.com/COVESA/dlt-daemon/archive/refs/tags/v${pkgver}.tar.gz  dlt-daemon.patch"

builddir="$srcdir/dlt-daemon-$pkgver"

build() {
    export CFLAGS="${CFLAGS/-fstack-clash-protection/}"
    export CXXFLAGS="${CXXFLAGS/-fstack-clash-protection/}"
    cmake -B build -S "$builddir" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWITH_SYSTEMD=OFF \
        -DWITH_DOC=OFF \
        -DWITH_MAN=OFF \
        -DWITH_DBUS=OFF \
        -DWITH_OFFLINE_LOGSTORAGE=OFF \
        -DWITH_DLT_QNX_SYSTEM=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
} 


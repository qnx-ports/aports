# Alpine-Contributor: Adam Jensen <adam@acj.sh>
# Alpine-Maintainer: Adam Jensen <adam@acj.sh>
# Maintainer: Karol Frackiewicz <kfrackiewicz@qnx.com>
pkgname=cereal
pkgver=1.3.2
pkgrel=0
pkgdesc="Header-only C++11 serialization library"
url="https://uscilab.github.io/cereal/"
arch="noarch"
license="BSD-3-Clause"
depends=""
makedepends="
    cmake
    boost-dev
    libc++-dev
"
subpackages=""
provides="$pkgname-dev=$pkgver"
source="
    $pkgname-$pkgver.tar.gz::https://github.com/USCiLab/cereal/archive/v$pkgver.tar.gz
    0001-compare-floats-using-doctest-approx.patch
"

build() {
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTS=ON \
        -DBUILD_SANDBOX=OFF \
        -DSKIP_PORTABILITY_TEST=ON \
        -DSKIP_PERFORMANCE_COMPARISON=ON \
        -DWITH_WERROR=OFF \
        -DCLANG_USE_LIBCPP=ON \
        -DCMAKE_CXX_FLAGS=" \
            -Wno-unused-command-line-argument \
            -Wno-missing-template-arg-list-after-template-kw \
            -Wno-deprecated-copy \
            -Wno-error=deprecated-copy \
            -Wno-unused-variable \
            -Wno-c++11-narrowing-const-reference \
        " \
        -Wno-dev

    cmake --build build
}

check() {
    cmake --build build --target test
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}


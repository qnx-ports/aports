pkgname=cereal
pkgver=1.3.2
pkgrel=0
pkgdesc="Header-only C++11 serialization library"
url="https://uscilab.github.io/cereal/"
arch="noarch"
license="BSD-3-Clause"

depends=""
makedepends="cmake"
options="!check" # avoid building/running upstream unit tests

source="${pkgname}-${pkgver}.tar.gz::https://github.com/USCiLab/cereal/archive/v${pkgver}.tar.gz"

build() {
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DJUST_INSTALL_CEREAL=ON \

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="

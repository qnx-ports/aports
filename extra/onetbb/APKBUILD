# Alpine-Contributor: David Huffman <storedbox@outlook.com>
# Alpine-Maintainer: Leon Marz <main@lmarz.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=onetbb
pkgver=2022.3.0
_pkgver=$pkgver-rc1
pkgrel=0
pkgdesc="oneAPI Threading Building Blocks"
url="https://github.com/uxlfoundation/oneTBB"
arch="all"
license="GPL-2.0-only"
depends="libc++"
depends_dev=""
makedepends="
    $depends_dev
    cmake
    clang
    libucontext-dev
    ninja
    swig
    libc++-dev
    "
#subpackages="$pkgname-dbg py3-tbb:_py3 $pkgname-dev $pkgname-doc"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc"
source="tbb-$_pkgver.tar.gz::https://github.com/qnx-ports/oneTBB/archive/qnx-v$_pkgver.tar.gz
    tbb.pc
    tbbmalloc.pc
    tbbmalloc_proxy.pc
    "
builddir="$srcdir/oneTBB-qnx-v$_pkgver"
# a dozen+ tests hang forever with no timeout
#options="!check"

provides="libtbb=$pkgver-r$pkgrel"
replaces="libtbb"

prepare() {
    default_prepare

    sed -e "s@#define MALLOC_UNIXLIKE_OVERLOAD_ENABLED __linux__@@"  \
        -i src/tbbmalloc_proxy/proxy.h

    sed -i "s|@@VERSION@@|$pkgver|" -i "$srcdir"/*.pc
}

build() {
    if [[ $CARCH == "x86_64" ]]; then
        _arch_flags="-mrtm -mwaitpkg"
    fi

    CFLAGS="$CFLAGS -O2 -DNDEBUG $_arch_flags" \
    CXXFLAGS="$CXXFLAGS -U_FORTIFY_SOURCE -O2 -DNDEBUG $_arch_flags" \
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_ASM_COMPILER=clang \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DTBB4PY_BUILD=OFF \
        -DTBB_STRICT=OFF \
        -DTBB_TEST="$(want_check && echo ON || echo OFF)"
    cmake --build build
}

check() {
    ctest --test-dir build || true
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    install -Dm0644 "$srcdir"/*.pc -t "$pkgdir"/usr/lib/pkgconfig
}

dev() {
    default_dev
    provides="libtbb-dev=$pkgver-r$pkgrel"
    replaces="libtbb-dev"
}

doc() {
    default_doc
    provides="libtbb-doc=$pkgver-r$pkgrel"
    replaces="libtbb-doc"
}

#_py3() {
#    pkgdesc="$pkgdesc (python bindings)"
#    amove usr/lib/python3.*
#}


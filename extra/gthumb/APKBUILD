# Maintainer: Roberto Speranza <rsperanza@qnx.com>
pkgname=gthumb
pkgver=3.12.8.2
pkgrel=1
pkgdesc="Image viewer and browser from GNOME"
url="https://gitlab.gnome.org/GNOME/gthumb"
arch="all"
license="GPL-2.0-or-later"
depends="
    cairo
    cairo-gobject
    exiv2-libs
    gdk-pixbuf
    glib
    gst-plugins-base
    gstreamer
    gtk3
    hicolor-icon-theme
    lcms2
    libc++
    libintl
    libjpeg-turbo
    libjxl
    libpng
    libwebp
    libwebpdemux
    pango
    tiff
    zlib-ng
    libheif
    "
makedepends="
    bison
    exiv2-dev
    flex
    gsettings-desktop-schemas-dev
    gstreamer-dev
    gst-plugins-base-dev
    gtk3-dev
    itstool
    json-glib-dev
    lcms2-dev
    libjpeg-turbo-dev
    libjpeg-turbo-utils
    libheif-dev
    libjxl-dev
    libpng-dev
    libsecret-dev
    libsoup-dev
    meson
    webkit2gtk-4.1-dev
    "
subpackages="
    $pkgname-dev
    $pkgname-doc
    $pkgname-lang
    "
options="!check"
source="https://gitlab.gnome.org/GNOME/gthumb/-/archive/$pkgver/gthumb-$pkgver.tar.gz
        001-fix-time_t-type.patch
        002-fix-xopen-source.patch
        "

build() {
    CC=clang \
    CXX=clang++ \
    abuild-meson \
        -Dwarn-deprecated=false \
        -Dclutter=false \
        -Dgstreamer=true \
        -Dlibchamplain=false \
        -Dlcms2=true \
        -Dcolord=true \
        -Dlibtiff=true \
        -Dlibwebp=true \
        -Dlibjxl=true \
        -Dlibheif=true \
        -Dlibraw=false \
        -Dlibrsvg=false \
        -Dlibbrasero=false \
        . output
    meson compile -C output
}

check() {
    meson test --print-errorlogs -C output \
      || msg "glib-utils tests failed due to abort"
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=python3-flake8-docstrings
pkgver=1.7.0
pkgrel=0
pkgdesc="Integration of pydocstyle and flake8 for combined linting and reporting "
options="!check" # No testsuite
url="https://github.com/PyCQA/flake8-docstrings"
arch="noarch"
license="MIT"
depends="python3-flake8"
makedepends="python3-hatchling python3-gpep517 python3-setuptools"
source="flake8-docstrings-$pkgver.tar.gz::https://github.com/PyCQA/flake8-docstrings/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir"/flake8-docstrings-$pkgver

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	gpep517 install-wheel --destdir "$pkgdir" \
		.dist/*.whl
}



sha512sums="

# Maintainer: Harshini Yarasi <hyarasi@qnx.com>
pkgname=boringssl

pkgver="0.20260327.0"
pkgrel=0
pkgdesc="BoringSSL cryptographic library"
url="https://boringssl.googlesource.com/boringssl"
arch="all"
license="Apache-2.0"
makedepends="cmake ninja perl libc++-dev qnx-io-sock-dev"
depends="
libc++
qnx-gcc-libs
qnx-io-sock
qnx-microkernel
"
subpackages="$pkgname-dev"

source="$pkgname-${pkgver}.tar.gz::https://boringssl.googlesource.com/boringssl/+archive/refs/tags/${pkgver}.tar.gz
qnx-getentropy.patch
qnx-benchmark.patch"

builddir="$srcdir"

build(){
    cmake -GNinja -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_C_FLAGS="-Wno-error " \
        -DCMAKE_CXX_FLAGS="-Wno-error " \
        -DCMAKE_EXE_LINKER_FLAGS="-lsocket"  
      
    ninja -C build  
}

check() {
	local test

	for test in \
		"$builddir/build/urandom_test" \
		"$builddir/build/crypto_test" \
		"$builddir/build/decrepit_test" \
		"$builddir/build/ssl_test" \
		"$builddir/build/pki_test"
	do
		echo ">>> Running $(basename "$test")"
		LD_LIBRARY_PATH="$builddir/build${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
			"$test"
	done
}

package(){
	DESTDIR="$pkgdir" ninja -C build install
}

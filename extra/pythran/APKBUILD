# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=pythran
pkgver=0.18.1
pkgrel=0
pkgdesc="Ahead of Time compiler for numeric kernels"
url="https://github.com/serge-sans-paille/pythran"
arch="noarch"
license="BSD-3-Clause"
depends="
    python3-beniget
    python3-gast
    python3-numpy
    python3-ply
    python3
    "
makedepends="python3-gpep517 python3-setuptools python3-dev python3-wheel"
checkdepends="python3-pytest"
source="$pkgname-$pkgver.tar.gz::https://github.com/serge-sans-paille/pythran/archive/refs/tags/$pkgver.tar.gz"
options="!check" # tests loop forever

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pytest
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="
15650627b9396b49401067c3a7c161d1569f89f29a08243aa85659023e42ce028633915c51c8c5188a5599c201eb30aa2721d64ba766b2a252203469bc6e2ab1  pythran-0.18.1.tar.gz
"

a64e949eacd2255aa12ba154bc19ff99d397d2c06ce9258a14c162d16292cd71f8493737d774862472da8a72d24b686c6b2fe87c37bb89bb08b4cb07c18f2485  001-fix-qnx-mixed-kernel-test.patch
"

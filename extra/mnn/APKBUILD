# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=mnn
pkgver=3.6.0
pkgrel=0
pkgdesc="Lightweight neural network inference engine"
url="https://github.com/alibaba/MNN"
arch="all"
license="Apache-2.0"
depends="libc++"
makedepends="
    cmake
    ninja
    libc++-dev
    "
source="$pkgname-$pkgver.tar.gz::https://github.com/alibaba/MNN/archive/refs/tags/$pkgver.tar.gz
    001-fix-qnx-mixed-kernel-test.patch"
builddir="$srcdir/MNN-$pkgver"
subpackages="$pkgname-dev"
build() {
    cmake -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DMNN_BUILD_SHARED_LIBS=ON \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DMNN_BUILD_TOOLS=OFF \
        -DMNN_BUILD_CONVERTER=OFF \
        -DMNN_BUILD_TEST=ON \
        -DMNN_BUILD_DEMO=OFF \
        -DMNN_OPENCL=OFF \
        -DMNN_VULKAN=OFF \
        -DMNN_CUDA=OFF
        
    cmake --build build
}

check() {
    cd "$builddir/build"
    ./run_test.out
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}


# Maintainer: Narayana Murthy <nnarayanamurthy@qnx.com>
pkgname=pcaudiolib
pkgver=1.3
pkgrel=0
pkgdesc="C API to different audio devices"
url="https://github.com/espeak-ng/pcaudiolib"
arch="all"
license="GPL-3.0-or-later"
depends=""
makedepends="autoconf automake libtool pkgconf"
subpackages="$pkgname-dev"
options="!check"   # no test suite upstream
source="$pkgname-$pkgver.tar.gz::https://github.com/espeak-ng/pcaudiolib/archive/refs/tags/$pkgver.tar.gz"

builddir="$srcdir/$pkgname-$pkgver"

prepare() {
    default_prepare
    ./autogen.sh
}

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --localstatedir=/var \
        --without-alsa \
        --without-pulseaudio \
        --without-coreaudio \
        --with-qsa
    make
}

package() {
    make DESTDIR="$pkgdir" install
}

sha512sums="
2a56123805bf738dcbcf7804a28b20740f76803ba1c25acc3e5a1aec9b6b3b9e8ebb8c5b90337977d118fb71ca28ec7356e47a6848b9ef6250a45e916d7f86d4  pcaudiolib-1.3.tar.gz
"
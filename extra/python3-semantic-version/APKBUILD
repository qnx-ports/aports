# Alpine-Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Alpine-Maintainer: Kevin Daudt <kdaudt@alpinelinux.org>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-semantic-version
pkgver=2.10.0
pkgrel=0
pkgdesc="A library implementing the 'SemVer' scheme"
url="https://github.com/rbarrois/python-semanticversion"
arch="noarch"
license="BSD-2-Clause"
depends="python3"
makedepends="python3-gpep517 python3-setuptools"
source="$pkgname-$pkgver.tar.gz::https://github.com/rbarrois/python-semanticversion/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/python-semanticversion-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}


sha512sums="

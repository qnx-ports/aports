# Alpine-Maintainer: Hoang Nguyen <folliekazetani@protonmail.com>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=mpvpaper
pkgver=1.9
pkgrel=0
pkgdesc="Video wallpaper setter for wlroots based compositors using mpv"
url="https://github.com/GhostNaN/mpvpaper"
arch="all"
license="GPL-3.0-or-later"
options="!check" # no test suite
depends="mpv qnx-fd-notify"
makedepends="
	meson
	ninja
	mpv-dev
	wayland-dev
	wayland-protocols
	qnx-screen-dev
    qnx-fd-notify-dev
	"
subpackages="$pkgname-doc $pkgname-dbg"
source="$pkgname-$pkgver.tar.gz::https://github.com/GhostNaN/mpvpaper/archive/refs/tags/$pkgver.tar.gz
  disable-egl-success-errors.patch
  qnx-fixes.patch
"

build() {
    LDFLAGS="$LDFLAGS -leventfd" \
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 mpvpaper.man "$pkgdir"/usr/share/man/man1/mpvpaper.1
}


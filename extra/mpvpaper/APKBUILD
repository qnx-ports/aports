d2ef8999c22c5bc83b933fd186d946b14eee5c5b49d50ee6bc234551cca02c8b9cf378b67f192c81d6713b49cecfedb9e9d1bb32f081c67c18dd0c009d1446bd  disable-egl-success-errors.patch

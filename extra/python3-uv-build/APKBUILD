# Alpine-Contributor: Will Sinatra <wpsinatra@gmail.com>
# Alpine-Maintainer: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-uv-build
pkgver=0.13.9
pkgrel=0
pkgdesc="An extremely fast Python build backend written in Rust"
url="https://github.com/astral-sh/uv"
arch="all"
license="MIT or Apache-2.0"
depends="python3"
makedepends="python3-gpep517 python3-wheel python3-installer python3-maturin cargo qnx-io-sock-dev"
checkdepends="python3-pytest"
source="https://files.pythonhosted.org/packages/source/u/uv-build/uv_build-$pkgver.tar.gz
	001-cargo_toml.patch
	config.toml
	"
builddir="$srcdir/uv_build-$pkgver"

prepare() {
	patch -p1 -i "$srcdir"/001-cargo_toml.patch

	cargo update \
		-p libc \
		-p signal-hook-registry \
		-p socket2 \
		-p rustix \
		-p cap-primitives \
		-p errno \
		-p tokio \
		-p mio 

	cargo vendor vendor
	mkdir .cargo
	cp "$srcdir"/config.toml .cargo
}

build() {
	export CARGO_PROFILE_RELEASE_LTO=off

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -c "import uv_build; print('uv_build imported successfully')"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}



# Maintainer: Leo Shen <yishen@qnx.com>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Alpine-Contributor: Sergei Lukin <sergej.lukin@gmail.com>
pkgname=libevent
pkgver=2.1.12
_pkgver=$pkgver-stable
pkgrel=1
pkgdesc="An event notification library"
url="https://libevent.org/"
arch="all"
license="BSD-3-Clause"
depends_dev="python3"
depends="libssl3 libcrypto3 qnx-io-sock qnx-fd-notify"
makedepends="$depends_dev openssl-dev>3 qnx-io-sock-dev qnx-fd-notify-dev"
subpackages="$pkgname-static $pkgname-dev"
source="https://github.com/libevent/libevent/releases/download/release-$_pkgver/libevent-$_pkgver.tar.gz
    fix-qnx.patch
"
builddir="$srcdir/$pkgname-$_pkgver"


prepare() {
    default_prepare
    update_config_sub

    sed -i '1s|^#!/usr/bin/env python$|#!/usr/bin/python3|' event_rpcgen.py
    # help provides tracing work out correctly
    sed -i -e "s/@VERSION@/$pkgver-r$pkgrel/" *.pc.in
}

build() {
    CFLAGS="$CFLAGS -ltimerfd -leventfd"
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-libevent-regress
    make
}

check() {
    make -j1 check
}

package() {
    make -j1 DESTDIR=$pkgdir install
}

dev() {
    replaces="libevent"
    default_dev
    mv "$pkgdir"/usr/bin "$subpkgdir"/usr/
}

static() {
    depends=""
    pkgdesc="$pkgdesc (static libraries)"
    mkdir -p "$subpkgdir"/usr/lib
    mv "$pkgdir"/usr/lib/*.a "$subpkgdir"/usr/lib
}




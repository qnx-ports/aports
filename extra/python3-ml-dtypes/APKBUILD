# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-ml-dtypes
_pkgname=ml_dtypes
pkgver=0.5.4
pkgrel=0
pkgdesc="Standalone NumPy dtype extensions for machine learning"
url="https://github.com/jax-ml/ml_dtypes"
arch="all"
license="Apache-2.0"
depends="
    libc++
    python3-numpy
    "
makedepends="
    eigen-dev
    libc++-dev
    python3-dev
    python3-gpep517
    python3-numpy-dev
    python3-setuptools
    python3-wheel
    "
checkdepends="
    python3-absl-py
    python3-pytest
    python3-pytest-xdist
    "
source="$pkgname-$pkgver.tar.gz::https://github.com/jax-ml/$_pkgname/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
    CPPFLAGS="$CPPFLAGS -I/usr/include/eigen3" \
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl


    # ml_dtypes lives in $builddir without the compiled dynload module. We
    # need to execute pytest somewhere else or it will be found first.
    mkdir test
    cd test
    # testFInfo_float8_e8m0fnu overflows when interpreting a large value as int.
    $builddir/.testenv/bin/python3 -m pytest $builddir -k "not testFInfo_float8_e8m0fnu"
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="
585641b2d4d9ff7b134310ac38484989d85efd3f303cc99fa71b2b693c710f435d4245bb64239b79f823da647e71f477be89d3141fa6aeb775262ea13a4f1bf7  python3-ml-dtypes-0.5.4.tar.gz
"

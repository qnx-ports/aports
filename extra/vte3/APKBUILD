# Alpine-Contributor: Rasmus Thomsen <oss@cogitri.dev> 
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=vte3
pkgver=0.82.2
pkgrel=1
pkgdesc="Virtual Terminal Emulator library"
url="https://gitlab.gnome.org/GNOME/vte"
arch="all"
license="LGPL-2.0-or-later"
subpackages="$pkgname-app $pkgname-dbg $pkgname-dev $pkgname-lang"
depends="adwaita-fonts gtk3 icu-libs simdutf lz4-libs gnutls"
depends_dev="gtk3-dev pango-dev"
makedepends="
    bash
    fast_float
    fmt-dev
    gnutls-dev
    gobject-introspection-dev
    gperf
    gtk3-dev
    icu-dev
    libxml2-utils
    lz4-dev
    meson
    ncurses-dev
    pango-dev
    pcre2-dev
    simdutf-dev
    vala
    libc++-dev
    clang
    "
source="https://gitlab.gnome.org/GNOME/vte/-/archive/$pkgver/vte-$pkgver.tar.gz
    fix-W_EXITCODE.patch
    0002-disable-TIOCPKT-on-QNX.patch
    0003-replace-fdwalk.patch
    0004-disable-TIOCSCTTY-on-QNX.patch
    fix-compile-on-libc++.patch
    "

builddir="$srcdir/vte-$pkgver"

build() {
    CC="clang" \
    CXX="clang++" \
    abuild-meson \
        -Dgtk4=false \
        -Ddocs=false \
        -D_systemd=false \
        -Dc_link_args="-Wl,-z,execstack" \
        -Dcpp_link_args="-Wl,-z,execstack" \
        . output
    meson compile -C output
}

check() {
    meson test --print-errorlogs -C output
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

app() {
    pkgdesc="$pkgdesc (apps)"

    amove usr/bin
    amove usr/share/xdg-terminals
    amove usr/share/applications
}



# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=ceres-solver
pkgver=2.2.0
pkgrel=1
pkgdesc="C++ library for large-scale nonlinear least squares problems"
url="http://ceres-solver.org"
arch="all"
license="BSD-3-Clause"
subpackages="$pkgname-dev"
depends="
  suitesparse
  suitesparse-graphblas
  glog
  eigen
  libc++
"
depends_dev="
  suitesparse-dev
  glog-dev
  eigen-dev
"
makedepends="
  $depends_dev
  cmake
  ninja
  libc++-dev
  gtest-dev
"

source="$pkgname-$pkgver.tar.gz::https://github.com/ceres-solver/ceres-solver/archive/refs/tags/$pkgver.tar.gz
eigen-fix.patch"
builddir="$srcdir/ceres-solver-$pkgver"

# Disable tests on aarch64 because of llvm bug
case "$CARCH" in
	aarch64) options="$options !check" ;;
esac

build() {
    cd "$builddir"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=ON \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_BENCHMARKS=OFF \
        -DSUITESPARSE=ON \
        -DLAPACK=OFF \
        -DUSE_CUDA=OFF \
        -DEIGENSPARSE=ON

    cmake --build build
}

check() {
    ctest --test-dir build -j1 --output-on-failure
}

package() {
    cd "$builddir"
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="

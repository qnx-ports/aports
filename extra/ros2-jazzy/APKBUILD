prepare() {
    cd "$builddir"
    mkdir -p src

    _apply_qnx_patch() {
        local _dir="$1"
            local _patch="$2"
            git -C "$builddir/$_dir" apply --whitespace=nowarn "$srcdir/$_patch"
    }

    _apply_qnx_patch src/cyclonedds cyclonedds.patch
    _apply_qnx_patch src/class_loader class_loader.patch 
    _apply_qnx_patch src/resource_retriever libcurl_vendor.patch
    _apply_qnx_patch src/rcutils rcutils.patch
    _apply_qnx_patch src/rcl rcl.patch
    _apply_qnx_patch src/rclcpp rclcpp.patch
    _apply_qnx_patch src/rosidl_typesupport rosidl_typesupport.patch
}

build() {
	cd "$builddir"
	export CXXFLAGS="${CXXFLAGS//-fstack-clash-protection/}"
	export CFLAGS="${CFLAGS//-fstack-clash-protection/}"
	export LDFLAGS="-lsocket -lfsnotify -lc++ -lc++abi -Wl,-E"
	export CMAKE_COMMAND=/usr/bin/cmake3.5
	colcon build --merge-install \
		--cmake-args \
			-G Ninja \
			-DBUILD_TESTING=OFF \
			-DCMAKE_BUILD_TYPE=Release \
			-DCMAKE_C_FLAGS="$CFLAGS -fvisibility=default -frtti -DSA_RESTART=0 -Wno-error=deprecated-literal-operator -Wno-error=old-style-cast" \
			-DCMAKE_CXX_FLAGS="$CXXFLAGS -fvisibility=default -frtti -DSA_RESTART=0 -Wno-error=deprecated-literal-operator -Wno-error=old-style-cast" \
			-DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" \
			-DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS" \
			-DTRACETOOLS_TRACEPOINTS_EXCLUDED=ON \
		--packages-skip-by-dep qt_gui rttest lttngpy rviz2 my-test-package \
			rviz_ogre_vendor rviz_assimp_vendor tf2_bullet \
		--packages-skip qt_gui mimick_vendor rttest lttngpy intra_process_demo \
			turtlesim image_tools rviz2 my-test-package rviz_ogre_vendor \
			rviz_assimp_vendor tf2_bullet
}

package() {
        dest="/opt/ros/jazzy"
        mkdir -p "$pkgdir"/$dest
        cp -a "$builddir"/install/. "$pkgdir"/$dest

        # Remove files we don't want in our final package
        for _f in  COLCON_IGNORE .colcon_install_layout _local_setup_util_ps1.py local_setup.ps1 setup.ps1; do
            [[ -f "$pkgdir"/$dest/$_f ]] && rm "$pkgdir"/$dest/$_f
        done
}


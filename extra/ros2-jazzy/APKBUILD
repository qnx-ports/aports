unpack() {
    mkdir -p "$builddir"/src
    cd "$builddir"
    find "$srcdir" -name "*.tar.gz" -print0 | while IFS= read -r -d '' tar_f; do
        # Extract to not have the version in the name
        file_name=$(basename "$tar_f")
        file_prefix=$(echo "$file_name" | sed 's/\.tar.gz//' )
        mkdir -p src/"$file_prefix"
        tar -xf "$tar_f" --strip-component=1 -C src/"$file_prefix"
    done
    
}


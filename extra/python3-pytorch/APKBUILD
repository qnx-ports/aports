prepare() {
    default_prepare

    rm -rf third_party/FP16 && mv "$srcdir"/FP16-$_FP16_commit third_party/FP16
    rm -rf third_party/FXdiv && mv "$srcdir"/FXdiv-$_FXdiv_commit third_party/FXdiv
    rm -rf third_party/NVTX && mv "$srcdir"/NVTX-$_NVTX_commit third_party/NVTX
    rm -rf third_party/XNNPACK && mv "$srcdir"/XNNPACK-$_XNNPACK_commit third_party/XNNPACK
    rm -rf third_party/cutlass && mv "$srcdir"/cutlass-$_cutlass_commit third_party/cutlass
    rm -rf third_party/fbgemm && mv "$srcdir"/FBGEMM-$_fbgemm_commit third_party/fbgemm
    rm -rf third_party/fmt && mv "$srcdir"/fmt-$_fmt_commit third_party/fmt
    rm -rf third_party/googletest && mv "$srcdir"/googletest-$_googletest_commit third_party/googletest
    rm -rf third_party/kineto && mv "$srcdir"/kineto-$_kineto_commit third_party/kineto
    rm -rf third_party/nlohmann && mv "$srcdir"/json-$_nlohmann_commit third_party/nlohmann
    rm -rf third_party/pocketfft && mv "$srcdir"/pocketfft-$_pocketfft_commit third_party/pocketfft
    rm -rf third_party/psimd && mv "$srcdir"/psimd-$_psimd_commit third_party/psimd
    rm -rf third_party/sleef && mv "$srcdir"/sleef-$_sleef_commit third_party/sleef
    rm -rf third_party/mimalloc && mv "$srcdir"/mimalloc-$_mimalloc_commit third_party/mimalloc
    rm -rf third_party/kleidiai && mv "$srcdir"/kleidiai-$_kleidiai_commit third_party/kleidiai
    rm -rf third_party/flatbuffers && mv "$srcdir"/flatbuffers-$_flatbuffers_version third_party/flatbuffers

    rm -rf third_party/fbgemm/external/asmjit && mv "$srcdir"/asmjit-$_asmjit_commit third_party/fbgemm/external/asmjit
    rm -rf third_party/fbgemm/external/cutlass && mv "$srcdir"/cutlass-$_cutlass_jwfromm_commit third_party/fbgemm/external/cutlass
    rm -rf third_party/fbgemm/external/json && mv "$srcdir"/json-$_nlohmann_json_commit third_party/fbgemm/external/json
    rm -rf third_party/fbgemm/external/googletest && cp -r third_party/googletest third_party/fbgemm/external/googletest

    rm -rf third_party/kineto/libkineto/third_party/dynolog && mv "$srcdir"/dynolog-$_dynolog_commit third_party/kineto/libkineto/third_party/dynolog
    rm -rf third_party/kineto/libkineto/third_party/fmt && mv "$srcdir"/fmt-$_fmt_kineto_commit third_party/kineto/libkineto/third_party/fmt
    rm -rf third_party/kineto/libkineto/third_party/googletest && cp -r third_party/googletest third_party/kineto/libkineto/third_party/googletest
}

build() {
    export CXXFLAGS="$CXXFLAGS \
        -Wno-error=unused-command-line-argument -Wno-unused-command-line-argument \
        -Wno-error=nontrivial-memcall -Wno-nontrivial-memcall \
        -Wno-error=vla-cxx-extension -Wno-vla-cxx-extension \
        -Wno-error=character-conversion -Wno-character-conversion\
        -Wno-error=missing-field-initializers -Wno-missing-field-initializers\
        -Wno-error=thread-safety-analysis -Wno-thread-safety-analysis\
        -Wno-error=unknown-warning-option -Wno-unknown-warning-option \
        -Wno-error=c2y-extensions -Wno-c2y-extensions \
        -DEIGEN_DONT_VECTORIZE"

    export CMAKE_BUILD_TYPE=Release
    export CMAKE_POLICY_VERSION_MINIMUM=3.5
    export CMAKE_SYSTEM_NAME=QNX
    export USE_ROCM=OFF
    export USE_CUDA=OFF
    export USE_MAGMA=OFF
    export USE_XPU=OFF
    export USE_ITT=OFF
    export USE_NNPACK=OFF
    export BUILD_CUSTOM_PROTOBUF=OFF
    export USE_DISTRIBUTED=OFF
    export USE_MKLDNN=OFF
    export USE_NNPACK=OFF
    export USE_QNNPACK=OFF
    export USE_SYSTEM_XNNPACK=OFF
    export USE_SYSTEM_ONNX=ON
    export USE_SYSTEM_PYBIND11=ON
    export USE_GFLAGS=ON
    export USE_BLAS=ON
    export USE_SYSTEM_CPUINFO=ON
    export USE_SYSTEM_PTHREADPOOL=ON
    export USE_SYSTEM_BENCHMARK=ON
    export BUILD_MOBILE_TEST=OFF
    export BUILD_BINARY=OFF
    export TRACING_BASED=OFF
    export BUILD_PYTHON=ON
    export BUILD_TEST=ON
    export CMAKE_LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED=TRUE

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    # Core math engine (pure C++) tests
    _test_exclude="vec_test_all_types_DEFAULT|vec_test_all_types_AVX512|vec_test_all_types_AVX2|StorageUtils_test|inline_container_test"
    ctest --test-dir build -E $_test_exclude -j1

    # Python bindings communication and usage with C++ internals tests
    python3 -m venv --clear --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pip install "hypothesis<6.80.0"
    .testenv/bin/python3 -m pip install expecttest pytest-rerunfailures pytest-flakefinder pytest-xdist sympy fsspec
    PYTORCH_NUM_PYTEST_RERUNS=0 .testenv/bin/python3 test/run_test.py --keep-going
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}


# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=libpaper
pkgver=2.2.7
pkgrel=0
pkgdesc="Library for handling paper characteristics"
url="https://github.com/rrthomas/libpaper/"
arch="all"
license="LGPL-2.1-or-later OR MIT"
makedepends="help2man"
checkdepends="bash"
subpackages="$pkgname-dev $pkgname-doc"
source="https://github.com/rrthomas/libpaper/releases/download/v$pkgver/libpaper-$pkgver.tar.gz"
options="!check" # really broken

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-static
	make
}

check() {
	cd tests
	./run-test
}

package() {
	make DESTDIR="$pkgdir" install
}


sha512sums="

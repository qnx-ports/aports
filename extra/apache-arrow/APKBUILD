# Maintainer: Ramya Santoshi Timmaraju <rtimmaraju@qnx.com>

pkgname=apache-arrow
pkgver=25.0.0
pkgrel=0
pkgdesc="Apache Arrow C++ core library"
url="https://arrow.apache.org/"
arch="aarch64 x86_64"
license="Apache-2.0"
source="
    apache-arrow-$pkgver.tar.gz::https://github.com/rtimmaraju/arrow/archive/refs/heads/apache_arrow_test.tar.gz"
builddir="$srcdir/arrow-apache_arrow_test/cpp"
depends="libc++"
makedepends="
    cmake
    ninja
    libc++-dev
    ca-certificates
    qnx-io-sock-dev"
subpackages="$pkgname-dev"

case "$(uname -m)" in
    x86_64)
        ARROW_CPU_FLAG=x86
        ;;
    aarch64)
        ARROW_CPU_FLAG=aarch64
        ;;
    *)
        ARROW_CPU_FLAG=$(uname -m)
        ;;
esac
options="net"
build() {

    (
    cd "$builddir"
    patch -p2 < "$startdir/arrow-cmakelists-qnx.patch"
    )
    cmake \
        -S "$builddir" \
        -B "$builddir/build" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_CXX_STANDARD=20 \
        -DARROW_BUILD_SHARED=ON \
        -DARROW_BUILD_STATIC=OFF \
        -DARROW_CPU_FLAG=${ARROW_CPU_FLAG} \
        -DARROW_BUILD_TESTS=ON \
        -DARROW_BUILD_BENCHMARKS=OFF \
        -DARROW_BUILD_EXAMPLES=OFF \
        -DARROW_COMPUTE=OFF \
        -DARROW_CSV=OFF \
        -DARROW_IPC=OFF \
        -DARROW_JSON=OFF \
        -DARROW_PARQUET=OFF \
        -DARROW_DATASET=OFF \
        -DARROW_FLIGHT=OFF \
        -DARROW_GANDIVA=OFF \
        -DARROW_PYTHON=OFF \
        -DARROW_SIMD_LEVEL=NONE \
        -DARROW_RUNTIME_SIMD_LEVEL=NONE \
        
    (
    cd "$builddir/build"

    patch -p3 < "$startdir/apache-arrow-qnx.patch"
    patch -p3 < "$startdir/boost-process-qnx.patch"

    echo "===== Boost.Process cmd.cpp after patch ====="
    grep -A8 -B5 \
        "cmd(boost::process::v2::pid_type" \
        _deps/boost-src/libs/process/src/ext/cmd.cpp
        (
    
    ninja -v _deps/boost-build/libs/process/CMakeFiles/boost_process.dir/src/ext/cmd.cpp.o
)
)

    cmake --build "$builddir/build"
}
check() {
    cd "$builddir/build"
    ctest --output-on-failure || true
}
package() {
    DESTDIR="$pkgdir" \
        cmake --install "$builddir/build"
}
sha512sums="
20b0092abd1b2c0754ebd60aa91e9adab3688c9918d6a4ef6893733951a03155e316442e90dd733d03b7874976144b9e0be0c8ccd822341283b5f890f1427463  apache-arrow-25.0.0.tar.gz
"

# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-openssl
# version needs to be compatible with python3-cryptography
pkgver=26.4.0
pkgrel=0
pkgdesc="Python3 wrapper module around the OpenSSL library"
url="https://github.com/pyca/pyopenssl"
arch="noarch"
license="Apache-2.0"
depends="
	python3
	python3-cryptography
	python3-typing-extensions
"
makedepends="
	python3-gpep517
	python3-setuptools
	python3-wheel
"
checkdepends="
	python3-pretend
	python3-pytest-rerunfailures
	python3-pytest-xdist
"
source="https://files.pythonhosted.org/packages/source/p/pyOpenSSL/pyopenssl-$pkgver.tar.gz"
builddir="$srcdir/pyopenssl-$pkgver"

build(){
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -n auto
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}


sha512sums="
6e7a05575b3089e231cfe65664d2ed8c03306983873ed3f75c16fa08950b6b1ecced04d17b8f343665b58d5ba677b48de6f36ff65b1af7f188cdfa38cbef902b  pyopenssl-26.4.0.tar.gz
"

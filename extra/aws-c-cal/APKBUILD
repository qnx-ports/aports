# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>"
# Maintainer: Deep Chordia <dchordia@blackberry.com>
pkgname=aws-c-cal
pkgver=0.9.13
pkgrel=0
pkgdesc="Aws Crypto Abstraction Layer: Cross-Platform, C99 wrapper for cryptography primitives."
url="https://github.com/awslabs/aws-c-cal"
arch="all"
license="Apache-2.0"
makedepends="
    cmake
    ninja
    aws-c-common-dev
    openssl-dev
    "
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/awslabs/aws-c-cal/archive/refs/tags/v$pkgver.tar.gz"

build() {
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_DATADIR=/usr/lib \
    -DBUILD_SHARED_LIBS=ON
  cmake --build build
}

check() {
  ctest --test-dir build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}

sha512sums="

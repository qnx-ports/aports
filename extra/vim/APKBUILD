pkgname=vim
pkgver=9.2.1001
pkgrel=2
_luaver=5.4
pkgdesc="Improved vi-style text editor"
url="https://www.vim.org/"
arch="all"
license="Vim"
depends="ncurses qnx-io-sock gtk3 libxt"
makedepends="ncurses-dev qnx-io-sock-dev gtk3-dev libxt-dev libx11-dev"
subpackages="
    $pkgname-doc
    ${pkgname}diff:${pkgname}diff:noarch
    $pkgname-tutor:tutor:noarch
    $pkgname-common:common:noarch
    xxd
    gvim
    "
source="$pkgname-$pkgver.tar.gz::https://github.com/vim/vim/archive/refs/tags/v$pkgver.tar.gz
    res2junit.py"

prepare() {
    # Read vimrc from /etc/vim
    echo '#define SYS_VIMRC_FILE "/etc/vim/vimrc"' >> src/feature.h
    default_prepare
}

build() {
    export CFLAGS="$CFLAGS -O2"
    export vim_cv_toupper_broken=yes
    export vim_cv_terminfo=yes
    export vim_cv_tgetent=zero
    export vim_cv_getcwd_broken=no
    export vim_cv_stat_ignores_slash=yes
    export vim_cv_memmove_handles_overlap=yes
    export vim_cv_uname_output="QNX"
    export ac_cv_c_compiler_gnu=no

    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --enable-luainterp=dynamic \
        --enable-perlinterp=dynamic \
        --enable-python3interp=dynamic \
        --enable-rubyinterp=dynamic \
        --enable-tclinterp=dynamic \
        --with-x \
        --disable-nls \
        --enable-acl \
        --enable-multibyte \
        --enable-gui=gtk3 \
        --disable-gtktest \
        --with-lua-prefix=/usr/lua$_luaver \
        --with-compiledby="QNX" \
        --with-tlib="ncurses"
    make
}

check() {
    # Terminal-mode tests only; test_gui*.vim are automatically skipped
    # when no GUI is available (they use CheckCanRunGui → Skipped throw).
    # Run from src/testdir where VIMPROG=../vim resolves correctly.
    # -k keeps make going past individual test crashes so all 317 test files
    # attempt to run; without it make stops at the first Vim crash, leaving
    # ~50 test files silently unexecuted.
    # Expected QNX-specific failures (~90-100 of 317):
    #   - test_signals: SIGUSR1/SIGWINCH handling differs on QNX
    #   - test_terminal, test_terminal3, test_channel: job/pty control
    #   - test_reltime, test_search: timer precision (1-4x slower on QNX)
    #   - test_autocmd, test_mapping, test_normal, etc.: feedkeys() / input
    #     simulation interacts with QNX terminal handling
    cd "$builddir/src/testdir"
    make -k nongui || true

    # Convert per-file .res results to JUnit XML.
    # make creates a .res file for every test file that completes (pass or
    # skip); absence means the test file itself crashed or timed out.
    python3 "$srcdir/res2junit.py" "$PWD" "$srcdir/junit.xml"
}

package() {
    depends="vim-common=$pkgver-r$pkgrel xxd=$pkgver-r$pkgrel"

    make -j1 DESTDIR="$pkgdir" install

    # make install does not create gvim symlink on QNX
    if [ ! -f "$pkgdir/usr/bin/gvim" ]; then
        ln -s vim "$pkgdir/usr/bin/gvim"
    fi

    install -Dm644 runtime/doc/uganda.txt \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

gvim() {
    pkgdesc="GTK3 GUI for vim"
    depends="vim=$pkgver-r$pkgrel"
    provides="cmd:gvim"
    replaces="vim"

    amove usr/bin/gvim
    for b in evim eview gview gvimdiff rgvim rgview; do
        [ -f "$pkgdir/usr/bin/$b" ] && amove usr/bin/$b || true
    done
    [ -d "$pkgdir/usr/share/applications" ] && amove usr/share/applications || true
    [ -d "$pkgdir/usr/share/pixmaps" ] && amove usr/share/pixmaps || true
}

common() {
    replaces="vim gvim"
    amove usr/share/vim
}

vimdiff() {
    pkgdesc="view file diffs in vim"
    depends="diffutils vim=$pkgver-r$pkgrel"
    replaces="vim gvim"
    provides="cmd:vimdiff=$pkgver-r$pkgrel"

    amove usr/bin/vimdiff
}

tutor() {
    pkgdesc="vim tutor and tutor files"
    depends="vim=$pkgver-r$pkgrel"
    replaces="gvim vim"

    amove usr/bin/vimtutor
    amove usr/share/vim/vim*/tutor
}

xxd() {
    pkgdesc="tool to make (or reverse) a hex dump"
    depends=""
    replaces="gvim vim"

    amove usr/bin/xxd
}


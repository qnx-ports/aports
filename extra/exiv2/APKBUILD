# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Roberto Speranza <rsperanza@qnx.com>
pkgname=exiv2
pkgver=0.28.7
pkgrel=2
pkgdesc="Exif and Iptc metadata manipulation library and tools."
url="https://exiv2.org/"
arch="all"
license="GPL-2.0-or-later"
depends_dev="brotli-dev expat-dev inih-dev inih-inireader-dev zlib-dev"
makedepends="$depends_dev
    cmake
    ninja
    clang
    libc++-dev
    qnx-io-sock-dev
    "
depends="
    libc++
    $pkgname-libs=$pkgver-r$pkgrel
    "
checkdepends="gtest-dev python3"
subpackages="$pkgname-dev $pkgname-doc $pkgname-libs"
source="https://github.com/Exiv2/exiv2/archive/refs/tags/v$pkgver/exiv2-v$pkgver.tar.gz
        001-add-futil-support-for-qnx.patch
        002-remove-fortify-source.patch
        003-add-socket-linker-flags.patch
        "

prepare() {
    default_prepare
    sed -i 's| -fcf-protection||g' cmake/compilerFlags.cmake
}

build() {
    CC=clang \
    CXX=clang++ \
    cmake -B build -G Ninja \
        -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS -lsocket" \
        -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS -lsocket" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DEXIV2_BUILD_SAMPLES=OFF \
        -DEXIV2_ENABLE_BMFF=ON \
        -DEXIV2_ENABLE_WEBREADY=ON \
        -DEXIV2_ENABLE_BROTLI=ON \
        -DEXIV2_ENABLE_INIH=ON \
        -DEXIV2_BUILD_UNIT_TESTS="$(want_check && echo ON || echo OFF)"
    ninja -C build
}

check() {
    ctest --test-dir build || \
    msg "Exif.CanonSi.MeasuredEV2 failed due to rounding error" || \
    msg "Exif.Image.DocumentName  failed due to rounding error"
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}

libs() {
    default_libs
    depends="
        brotli
        inih-inireader
        libc++
        libexpat
        zlib-ng
        qnx-io-sock
        "
}


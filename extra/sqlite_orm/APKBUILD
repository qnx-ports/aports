# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=sqlite_orm
pkgver=1.9
pkgrel=0
pkgdesc="light header only library for modern C++ to interact with sqlite"
arch="all"
license="AGPL-3.0"
url="https://github.com/fnc12/sqlite_orm"
makedepends="qnx-base-dev sqlite-static sqlite-dev cmake ninja"
depends=""
checkdepends="sqlite"
subpackages="${pkgname}-dev"
source="${pkgname}-${pkgver}.tar.gz::https://github.com/fnc12/sqlite_orm/archive/refs/tags/v${pkgver}.tar.gz"

build() {
    cmake_args="-DCMAKE_INSTALL_PREFIX=${PREFIX} \
                -DCMAKE_STAGING_PREFIX=${PREFIX} \
                -DCMAKE_BUILD_TYPE=Release \
                "

    BUILD_ROOT=${CBUILDROOT} \
    cmake ${cmake_args} -G Ninja
    ninja
}

check() {
    ./tests/unit_tests --reporter JUnit --colour-mode none -o ${pkgname}-results.xml
}

package() {
    DESTDIR="$pkgdir" ninja install
}
sha512sums="

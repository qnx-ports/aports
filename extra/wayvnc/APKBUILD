# Alpine-Contributor: Michał Polański <michal@polanski.me>
# Alpine-Maintainer: Michał Polański <michal@polanski.me>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=wayvnc
pkgver=0.10.0
pkgrel=0
pkgdesc="A VNC server for wlroots-based Wayland compositors"
url="https://github.com/any1/wayvnc"
license="ISC"
arch="all"
depends="
	jansson
	libuv
	libxkbcommon
	neatvnc
	wayland
    aml
    qnx-io-sock
"
makedepends="
	jansson-dev
	libuv-dev
	libxkbcommon-dev
	meson
	neatvnc-dev
	scdoc
	wayland-dev
    aml-dev
    linux-headers-input-codes
    qnx-io-sock-dev
	"
subpackages="$pkgname-dbg $pkgname-doc"
source="https://github.com/any1/wayvnc/archive/v$pkgver/wayvnc-$pkgver.tar.gz
	phosh.patch
    add-global-config-fallback.patch
    config
	"
options="!check"

build() {
    export CFLAGS="$CFLAGS -DMAX=max -DMIN=min"
    export LDFLAGS="$LDFLAGS -lsocket"
	abuild-meson --buildtype=debug -Dtests=false . output
	meson compile -C output
}

check() {
	 meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

    install -D "$srcdir/config" -m644 "$pkgdir"/etc/wayvnc/config
}



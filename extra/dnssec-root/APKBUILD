pkgname=dnssec-root
pkgver=20260205
pkgrel=0
# There are no releases or tags. This is just a tool to generate a keyfile
_commit=179765e80ebde71594b0e14cc6d6a506d911699a
pkgdesc="The DNSSEC root key(s)"
url="https://www.iana.org/dnssec/"
arch="noarch"
license="LicenseRef-scancode-public-domain"
makedepends="python3 openssl"
source="$pkgname-$pkgver.tar.gz::https://github.com/iana-org/get-trust-anchor/archive/$_commit.tar.gz
  trusted-key.key
	"
options="!check" # No tests
builddir="$srcdir/get-trust-anchor-$_commit"

# To update the package, you will need to run 
# - `rm trusted-key.key`
# - create an empty file `touch trusted-key.key`
# - then `abuild checksum` so you can 
# - run `abuild snapshot` to generate a new `trusted-key.key` file
# - You can then regenerate the checksums with `abuild checksum` (again) and then you can package again.

# If you're just building the package, you can package it as is, we will keep the generated key in our aports repo, just as alpine does
# This snapshot function is non-reproducible

snapshot() {
	unpack
	cd "$builddir"
	python3 "$builddir"/get_trust_anchor.py
	sort -k 6 ksk-as-dnskey.txt* > "$startdir"/trusted-key.key
	abump "$pkgname-$(date "+%Y%m%d")"
}

package() {
	install -Dm644 "$srcdir"/trusted-key.key \
		"$pkgdir"/usr/share/$pkgname/trusted-key.key
}

sha512sums="

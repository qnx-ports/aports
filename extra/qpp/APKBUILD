# Maintainer: Terence Ang <taang@qnx.com>
pkgname="qpp"
pkgver=1.1.0
pkgrel=0
_commit_id="f7f9329002546f5be91001e74b0f3b77dc86a313"
qpp_name="qnx-posix-publish-subscribe"
pkgdesc="QNX POSIX PubSub Service"
_dbg_pkgdesc="debug symbols and binaries"
_static_pkgdesc="static libraries"
_libs_pkgdesc="shared libraries"
_samples_pkgdesc="samples"
_utils_pkgdesc="utilities"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
depends="qnx-libjson"
makedepends="
    qnx-io-sock-dev
    qnx-libslog2-dev
    qnx-slogger2-dev
    qnx-libjson-dev
"
options="!strip !check"
subpackages="
    $pkgname-dbg:dbg
    $pkgname-utils:utils
    $pkgname-samples:samples
"
source="
    $qpp_name-$_commit_id.tar.gz::https://github.com/qnx/qnx-posix-publish-subscribe/archive/$_commit_id.tar.gz
    common_qpp.mk
    libqpp.mk
    libplayback.mk
    playback.mk
    qpp.mk
    samples.mk
    signal_framework.mk
    json.c.patch
"
builddir="$srcdir/$qpp_name-$_commit_id"

build() {
    cd "$builddir"

    cp -p "$srcdir"/*.mk .

    make -f libplayback.mk
    make -f libqpp.mk
    make -f samples.mk
    make -f playback.mk
    make -f signal_framework.mk
    make -f qpp.mk
}

package() {
    cd "$builddir"
    export DESTDIR="$pkgdir"
    make -f samples.mk install
    make -f playback.mk install
    make -f signal_framework.mk install
    make -f qpp.mk install
}

dbg() {
    pkgdesc="$subpkgname $_dbg_pkgdesc"
    depends="
        $pkgname=$pkgver-r$pkgrel
        $pkgname-utils=$pkgver-r$pkgrel
        $pkgname-samples=$pkgver-r$pkgrel
    "
    amove usr/bin/*.sym
}

utils() {
    pkgdesc="$subpkgname $_utils_pkgdesc"
    depends="$pkgname=$pkgver-r$pkgrel"

    amove usr/bin/echo-actuator
    amove usr/bin/playback-connector
    amove usr/bin/playback-recorder
    amove usr/bin/playback-tool

    amove etc/signal_framework/playback-recorder.json
    amove etc/signal_framework/playback-connector.json
    amove etc/signal_framework/sample-playback.jsonl
}

samples() {
    pkgdesc="$subpkgname $_samples_pkgdesc"
    depends="$pkgname=$pkgver-r$pkgrel"

    amove usr/bin/sample-message-publisher
    amove usr/bin/sample-message-subscriber
    amove usr/bin/sample-signal-consumer
    amove usr/bin/sample-signal-publisher
}


# Alpine-Maintainer: Krassy Boykinov <kboykinov@teamcentrixx.com>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=gst-plugins-base
pkgver=1.26.8
pkgrel=2
pkgdesc="GStreamer streaming media framework base plug-ins"
url="https://gstreamer.freedesktop.org"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.0-or-later"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc $pkgname-lang"
depends="gstreamer
        glib
        qnx-egl
        qnx-gles
        libintl
        orc
        opus
        libtheora
        libvorbis
        libpng
        wayland
        graphene
        pango
        libjpeg-turbo
        qnx-alsa
        "
depends_dev="wayland-dev gstreamer-dev orc-dev"
makedepends="
    $depends_dev
    iso-codes-dev
    expat-dev
    glib-dev
    gobject-introspection-dev
    graphene-dev
    gtk3-dev
    libogg-dev
    libtheora-dev
    libvorbis-dev
    meson
    opus-dev
    orc-compiler
    perl
    qnx-alsa-dev
    gles-headers
    egl-headers
    clang
    libc++-dev
    "
source="https://gstreamer.freedesktop.org/src/gst-plugins-base/gst-plugins-base-$pkgver.tar.xz
        001-duplicated-symbols-in-libc.patch
        002-fix-old-error-handler-signature.patch
        003-remove-alsa-midi.patch
        "
ldpath="/usr/lib/gstreamer-1.0"

options="!check"

build() {
    CC=clang \
    CXX=clang++ \
    CFLAGS="$CFLAGS -O2 -DNDEBUG" \
    CXXFLAGS="$CXXFLAGS -O2 -DNDEBUG" \
    CPPFLAGS="$CPPFLAGS -O2 -DNDEBUG -Wno-error=incompatible-function-pointer-types" \
    abuild-meson \
        -Db_lto=false \
        -Dalsa=enabled \
        -Dc_link_args="-Wl,-lsocket,-lm" \
        -Dintrospection=enabled \
        -Dpackage-origin="www.qnx.com" \
        -Dpackage-name="GStreamer base plug-ins (QNX)" \
        -Dtests="$(want_check && echo enabled || echo disabled)" \
        . output
    meson compile -C output
}

check() {
    # most failures cause by XDG_RUNTIME_DIR missing
    LD_LIBRARY_PATH="$builddir/output/gst-libs/gst/gl:$LD_LIBRARY_PATH"
    meson test --print-errorlogs -C output || true
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


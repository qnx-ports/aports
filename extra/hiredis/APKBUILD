# Alpine-Contributor: Eivind Uggedal <eu@eju.no>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=hiredis
pkgver=1.3.0
pkgrel=0
pkgdesc="Minimalistic C client library for Redis"
url="https://github.com/redis/hiredis"
arch="all"
license="BSD-3-Clause"
depends="libcrypto3 libssl3 qnx-io-sock"
makedepends="openssl-dev>3 qnx-io-sock-dev"
subpackages="$pkgname-ssl $pkgname-dev"
source="$pkgname-$pkgver-99.tar.gz::https://github.com/redis/hiredis/archive/v$pkgver.tar.gz"
options="!check" # We don't have a redis port, so we can't test

build() {
    export CFLAGS="$CFLAGS -Qunused-arguments"
	make USE_SSL=1 PREFIX=/usr DEBUG="$CFLAGS" LDFLAGS="$LDFLAGS -lsocket"
}

package() {
	make USE_SSL=1 PREFIX="$pkgdir"/usr install
}

ssl() {
	amove usr/lib/libhiredis_ssl.so*
}

sha512sums="
e6e9f7e617bf1d03bdf64a80e74ed24816b6c71607b976757a9962ae02a3b65be7006d84fd353dd5a63c8d0ef1ed385c3b73851b4a119c5ed48f3f86437cf250  hiredis-1.3.0-99.tar.gz
"



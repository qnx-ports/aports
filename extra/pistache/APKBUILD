pkgname=pistache
pkgver=0.4.26
pkgrel=0
pkgdesc="A high-performance REST toolkit written in C++"
url="https://pistacheio.github.io/pistache/"
arch="all"
license="MIT"
makedepends="clang libc++-dev meson libevent libevent-dev rapidjson-dev qnx-io-sock-dev"
subpackages="$pkgname-dev"
pkgusers="pistache"
pkggroups="pistache"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/pistache/archive/refs/tags/qnx-v$pkgver-1.tar.gz
pkgconf_version_string.patch
"
builddir="$srcdir/$pkgname-qnx-v$pkgver-1"

build() {
    LDFLAGS="-lm -lregex -lsocket -lgcc_s"
    abuild-meson . output
    meson compile -C output
}

package() {
  DESTDIR="$pkgdir" meson install --no-rebuild -C output
  echo "done"
}




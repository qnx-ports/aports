# Alpine-Maintainer: Peter Shkenev <santurysim@gmail.com>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-cffi
_pkgname=cffi
pkgver=2.0.0
pkgrel=0
pkgdesc="Foreign function interface for calling C code from Python3"
url="https://cffi.readthedocs.io/"
arch="all"
license="MIT"
depends="python3-cparser libffi qnx-io-sock"
makedepends="
    libffi-dev
    python3-dev
    python3-gpep517
    python3-setuptools
    python3-wheel
    qnx-io-sock-dev
    "
checkdepends="python3-pytest"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
    CFLAGS="$CFLAGS -fPIC" \
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl

    PYTHONPATH="$(echo "$builddir"/build/lib.linux-*)" \
    .testenv/bin/python3 -m pytest -v \
        --disable-pytest-warnings src/c/
    # Skipping /testing here because they python-ctypes backend doesn't work
    # python3-cffi uses its custom libffi backend by default, so we don't
    # need to worry.
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="
a8bf705e626f6b5858cc20e9044a23fd653d155e2a2d4cb59f1eed00ef13ebd92d5a2f07738c66b361cb24d863786d4379dcd9c176250b546fbd45758e51d4f4  cffi-2.0.0.tar.gz
"

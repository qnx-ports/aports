pkgname=raylib
pkgver=5.5
pkgrel=0
pkgdesc="A simple and easy-to-use library to enjoy videogames programming"
url="https://github.com/raysan5/raylib"
arch="x86_64"
license="Zlib"
source="
$pkgname-$pkgver.tar.gz::https://github.com/raysan5/raylib/archive/refs/tags/$pkgver.tar.gz
00-libraryconfigurations.patch
01-raylib_opengl_interop.patch
"

makedepends="
        cmake
        ninja
        qnx-fd-notify-dev
        libxkbcommon-dev
        wayland-dev
"

depends="
        gles-headers
        qnx-gles
        glfw
        libxkbcommon
        wayland
        qnx-fd-notify
"

prepare() {
    default_prepare
}


build() {
    cmake \
        -DUSE_EXTERNAL_GLFW=ON \
        -DGLFW_BUILD_X11=OFF \
        -DGLFW_BUILD_WAYLAND=ON \
        -DCMAKE_BUILD_TYPE="Release" \
        -DPLATFORM="Desktop" \
        -DCMAKE_C_FLAGS="-DMA_USE_STDINT" \
        -Dglfw3_DIR="/usr/lib/cmake/glfw3" \
        -DBUILD_SHARED_LIBS=ON \
        -G Ninja \
        -S .

        ninja -C .
}

check() {
        #ctest
        # There are no builtin tests and this depends on GUI
        default_check
}

package() {
        DESTDIR="$pkgdir" cmake --install . --prefix "/usr"
}


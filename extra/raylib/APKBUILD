# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=raylib
pkgver=6.0
pkgrel=1
pkgdesc="A simple and easy-to-use library to enjoy videogames programming"
url="https://github.com/raysan5/raylib"
arch="all"
license="Zlib"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/raysan5/raylib/archive/refs/tags/$pkgver.tar.gz"

depends_dev="glfw-dev"
makedepends="$depends_dev
    cmake ninja 
    qnx-fd-notify-dev 
    libxkbcommon-dev wayland-dev libc++-dev glfw-dev glfw-dev egl-headers gles-headers
    "

depends="
        qnx-gles qnx-egl qnx-fd-notify
        glfw libxkbcommon wayland libc++
"
options="!check" # no test suite, test binaries are demos

prepare() {
    default_prepare
}


build() {
    # ignore the warning about PLATFORM_DESKTOP_GLFW being defined twice, we need
    # to define it earlier than it gets defined in the project 
    cmake -G Ninja -B build \
        -DUSE_EXTERNAL_GLFW=ON \
        -DGLFW_BUILD_X11=OFF \
        -DGLFW_BUILD_WAYLAND=ON \
        -DCMAKE_BUILD_TYPE="Release" \
        -DPLATFORM="Desktop" \
        -DCMAKE_C_FLAGS="$CFLAGS -DMA_USE_STDINT -DPLATFORM_DESKTOP_GLFW " \
        -Dglfw3_DIR="/usr/lib/cmake/glfw3" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON
        
    cmake --build build
}

check() {
        ctest
}

package() {
        DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
dfdb2578859e28d424b6f318669579ab2361c35c4d45e0fee5a80b4c1d7d487a0e084ec2bafffad149b3dd96d34d092586fc3d30c8de6a211b0a2a038a959c07  raylib-6.0.tar.gz
"

# Alpine-Contributor: Nick Black <dankamongmen@gmail.com>
# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=nlohmann-json
pkgver=3.12.0
pkgrel=0
pkgdesc="JSON for Modern C++"
url="https://github.com/nlohmann/json"
arch="noarch"
license="MIT"
makedepends="cmake ninja libc++-dev"
source="https://github.com/nlohmann/json/archive/v$pkgver/nlohmann-json-$pkgver.tar.gz"
options="net" # Required for downloading test data
builddir="$srcdir/json-$pkgver"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DJSON_MultipleHeaders=ON \
		-DJSON_BuildTests_INIT=OFF \
		-DJSON_BuildTests=ON
	cmake --build build
}

check() {
	cd build
	ctest -E "cmake_fetch_content(|2)_(configure|build)" || true
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}


sha512sums="

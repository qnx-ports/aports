# Alpine-Maintainer: Carlo Landmeter <clandmeter@alpinelinux.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-pybind11
_pkgname=pybind11
pkgver=3.0.1
pkgrel=0
pkgdesc="Seamless operability between C++11 and Python"
url="https://github.com/pybind/pybind11"
arch="noarch"
license="MPL-2.0"
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends="
    boost-dev
    cmake
    clang
    python3-gpep517
    python3-scikit-build-core
    python3-setuptools
    python3-wheel
    python3-dev
    ninja
    python3-pytest
    "
checkdepends="
    python3-pytest
    "
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/pybind/pybind11/archive/v$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
    # fails with lto due to fortify-headers
    export CXXFLAGS="$CXXFLAGS -U_FORTIFY_SOURCE"

    CC=clang CXX=clang++ \
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DPYTHON_EXECUTABLE=/usr/bin/python3 \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DUSE_PYTHON_INCLUDE_DIR=FALSE \
        -DDOWNLOAD_CATCH=ON \
        -DPYBIND11_TEST="$(want_check && echo ON || echo OFF)" \
        -DPYBIND11_PYTEST_ARGS='-k not test_cross_module_exception_translator'
    cmake --build build

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    # No integrated ctest for running tests yet, use cmake targets
    # https://github.com/pybind/pybind11/issues/5095
    cmake --build build --target pytest
    cmake --build build --target cpptest
    cmake --build build --target test_cmake_build
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl

    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
c17e6d6a78c38e760864b390ac2aa7df6a94ca53acb2e8be71f0d63d611b738fa20a16946c98a93fbfcad56cb0346ebf247bbe41c6f5171c6ce68397b1e5c4db  python3-pybind11-3.0.1.tar.gz
"

# AUR-Contributor: Karol Babioch <karol@babioch.de>
# AUR-Contributor: Oleg Rakhmanov <oleg [at] archlinuxarm [dot] org>
# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname='unixbench'
pkgver=6.0.1
pkgrel=0
pkgdesc='UnixBench is a simple benchmark whose purpose is to provide a  basic indicator of the performance of a Unix-like system.'
url="https://github.com/kdlucas/byte-unixbench"
arch="all"
license="GPL-2.0"
makedepends="libc++-dev"
depends="perl libc++"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/kdlucas/byte-unixbench/archive/refs/tags/v$pkgver.tar.gz
        unixbench-qnx.patch 
        no-make.patch 
        ubench"
builddir="$srcdir/byte-unixbench-$pkgver/UnixBench"
options="!check" # no tests, the package is system benchmarks

build() {
	make
}

package() {

    install -dm775 "$pkgdir"/usr/bin/unixbench
    cp -a {pgms,testdir} "$pkgdir"/usr/bin/unixbench
    install -Dm755 Run ${pkgdir}/usr/bin/unixbench/Run
    install -Dm755 ${srcdir}/ubench ${pkgdir}/usr/bin/ubench
    install -Dm644 ../LICENSE.txt ${pkgdir}/usr/share/licenses/unixbench/LICENSE.txt
}


# Alpine-Contributor: Michał Polański <michal@polanski.me>
# Alpine-Maintainer: Michał Polański <michal@polanski.me>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=libdecor
pkgver=0.2.4
pkgrel=0
pkgdesc="Client-side decorations library for Wayland clients"
url="https://gitlab.freedesktop.org/libdecor/libdecor"
license="MIT"
arch="all"
depends="
	dbus
	gtk3
	qnx-hid
	wayland
"
makedepends="
	meson
	cairo-dev
	dbus-dev
    gtk3-dev
	pango-dev
	wayland-dev
	wayland-protocols
	"
subpackages="$pkgname-dev"
source="
https://gitlab.freedesktop.org/libdecor/libdecor/-/archive/$pkgver/libdecor-$pkgver.tar.gz
input.h
"
options="!check" # no test suite

prepare() {
    default_prepare
    mkdir linux
    cp "$srcdir"/input.h linux
}

build() {
	abuild-meson \
		-Ddemo=false \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}




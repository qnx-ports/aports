# Maintainer:Ramya santoshi <rtimmaraju@qnx.com>
pkgname=g3log
pkgver=2.6
pkgrel=0
pkgdesc="Asynchronous crash-safe logging library for C++"
url="https://github.com/KjellKod/g3log"
arch="all"
license="Unlicense"
depends="libc++"
makedepends="cmake  libc++-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/KjellKod/g3log/archive/refs/tags/2.6.tar.gz g3log-2.6_qnx.patch"
builddir="$srcdir/g3log-$pkgver"
subpackages="$pkgname-dev"

build() {
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DINSTALL_GTEST=OFF \
        -DG3_SHARED_LIB=ON 
        
    cmake --build build
}

check() {
    cd "$builddir"/build
    ctest --output-on-failure -j1
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="

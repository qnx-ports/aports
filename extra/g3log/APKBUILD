5997247f3d3d7cce162641a4dc4338632c17eee8c5120c1c17f3832b495740a5c9d1ab7a689ab12f875459d2a4ffe5aba74b6bdc757fca1aecf8d9ca6349c3d3  g3log-2.6_qnx.patch
"

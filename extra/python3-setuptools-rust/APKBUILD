# Alpine-Contributor: Aiden Grossman <agrossman154@yahoo.com>
# Alpine-Contributor: Celeste <cielesti@protonmail.com>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-setuptools-rust
pkgver=1.13.0
pkgrel=0
pkgdesc="Setuptools plugin for rust support"
url="https://github.com/PyO3/setuptools-rust"
arch="noarch"
license="MIT"
depends="
	cargo
	python3-semantic-version
	python3-setuptools
	"
makedepends="
	python3-gpep517
	python3-setuptools_scm
	python3-wheel
	"
checkdepends="
	libffi-dev
	python3-pytest
	python3-dev
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/PyO3/setuptools-rust/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/setuptools-rust-$pkgver"
options="net"

export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
export CARGO_BUILD_TARGET=x86_64-pc-qnx

prepare() {
	default_prepare

	# This test relies on behavior that may be glibc-specific
	mv -v examples/hello-world/noxfile.py \
		examples/hello-world/noxfile.py.disabled
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest tests/ setuptools_rust/
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}


sha512sums="
254c03686ddfde62f694e607f60a744cf4e06aaf8b9752b52918f86b69025327d8f827d6e8c0a762fffcfec5ab6592ded3825198c4074bd7758421dca82fe180  python3-setuptools-rust-1.13.0.tar.gz
"

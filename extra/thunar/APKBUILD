# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=thunar
pkgver=4.21.2
pkgrel=2
pkgdesc="File manager for Xfce"
url="https://docs.xfce.org/xfce/thunar/start"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.0-only"
depends="desktop-file-utils exo libintl gtk3 libxfce4ui xfce4-panel"
depends_dev="exo-dev gettext-dev xfce4-dev-tools"
makedepends="
    $depends_dev
    glib-dev
    gobject-introspection-dev
    gtk3-dev
    libxfce4ui-dev
    pcre2-dev
    xfce4-panel-dev
    "
subpackages="$pkgname-dev $pkgname-lang"
source="https://archive.xfce.org/src/xfce/thunar/${pkgver%.*}/thunar-$pkgver.tar.xz
        001-reomve-unused-x-headers.patch
    "

build() {
    meson setup build \
        --prefix=/usr \
        -Db_lto=false \
        -Dgtk-doc=false
    meson compile -C build
}

check() {
    meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
    rm -rf "$pkgdir"/usr/lib/systemd
}


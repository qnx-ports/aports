07473ae8d0ce58b3b9c7a19ac1ca70e3893aaa5ee273f6e6a1924038ebab8a731b2b516a5b8ef870e31256a0e5d6a3fc301fcaee5074f1b0d8c4012c133f3cc4  add_qnx_support.patch
"

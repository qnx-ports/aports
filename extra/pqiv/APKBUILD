pkgname=pqiv
pkgver=2.13.2
pkgrel=3
pkgdesc="powerful image viewer with minimal UI"
url="http://www.pberndt.com/Programme/Linux/pqiv/index.html"
arch="all"
license="GPL-3.0-only"
depends="gtk3 libwebp ffmpeg-libavcodec ffmpeg-libavformat ffmpeg-libswscale"
makedepends="autoconf gtk3-dev libwebp-dev ffmpeg-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/phillipberndt/pqiv/archive/$pkgver.tar.gz
remove-avclose.patch"
options="!check" # no testsuites

build() {
    CC="clang"
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --localstatedir=/var
    make
}

package() {
    make DESTDIR="$pkgdir" install
}


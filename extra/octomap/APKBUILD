# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=octomap
pkgver=1.9.8
pkgrel=0
pkgdesc="An Efficient Probabilistic 3D Mapping Framework Based on Octrees"
url="https://github.com/OctoMap/octomap"
arch="aarch64 x86_64"
license="BSD-3-Clause"
source="$pkgname-$pkgver.tar.gz::https://github.com/OctoMap/octomap/archive/refs/tags/v$pkgver.tar.gz
0001-Fix-test-dependencies-in-CMakeLists-374.patch"

builddir="$srcdir/$pkgname-$pkgver"
depends="libc++"
makedepends="
	libc++-dev
	cmake
	ninja
"

subpackages="$pkgname-dev"

build() {
	cmake3.5 -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_TESTING=ON \
		-DOCTOVIS_QT5=OFF
	cmake3.5 --build build
}

check() {
	# test_color_tree fails on aarch64
	# https://github.com/OctoMap/octomap/issues/168
	case "$CARCH" in
	aarch64)
		ctest3.5 --test-dir build -E test_color_tree
		;;
	*)
		ctest3.5 --test-dir build
		;;
	esac
}

package() {
	DESTDIR="$pkgdir" cmake3.5 --install build
}

sha512sums="

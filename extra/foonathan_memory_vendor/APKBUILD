# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=foonathan_memory_vendor
pkgver=1.3.1
pkgrel=0
pkgdesc="eProsima foonathan memory vendor package"
url="https://github.com/eProsima/foonathan_memory_vendor"
arch="all"
license=" Apache-2.0"
depends="foonathan_memory  libc++"
makedepends="cmake ninja git libc++-dev foonathan_memory-dev"

source="foonathan_memory_vendor-$pkgver.tar.gz::https://github.com/eProsima/foonathan_memory_vendor/archive/refs/tags/v$pkgver.tar.gz"

builddir="$srcdir/foonathan_memory_vendor-$pkgver"

build() {
    export CFLAGS="${CFLAGS//-fstack-clash-protection/}"
    export CXXFLAGS="${CXXFLAGS//-fstack-clash-protection/}"
     
   cmake -S "$builddir" -B "$builddir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_CXX_STANDARD=17 \
        -DCMAKE_CXX_STANDARD_REQUIRED=ON \
        -DCMAKE_CXX_EXTENSIONS=ON \
        -DFOONATHAN_MEMORY_FORCE_VENDORED_BUILD=OFF
        
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install "$builddir/build"
}
sha512sums="
e44e4a19b176979973e1f4e7868c35f18c8a77eea64ed7090a781ef5a39c32c4716178706587202187fedeefd81bcc1f934eaeb022874544bffdf1cd87e33da9  foonathan_memory_vendor-1.3.1.tar.gz
"
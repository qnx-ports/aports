pkgname=rpi-thermal
pkgver=0.1
_commit="4ba4fdc40c683acbbdf4409dc251aed1d52cfe89"
pkgrel=2
pkgdesc="Thermal resource manager for Raspberry Pi 4 and 5."
arch="aarch64"
license="LicenseRef-QDL-Non-Commercial"
depends="qnx-secpol rpi-mailbox"
makedepends="qnx-io-sock-dev qnx-secpol-dev clang rpi-mailbox-dev qnx-i2c"
options="!check"
url="https://gitlab.com/qnx/projects/rpi-mailbox"
subpackages="$pkgname-dbg $pkgname-openrc"
source="https://gitlab.com/qnx/projects/rpi-thermal/-/archive/$_commit/rpi-thermal-$_commit.tar.gz
  rpi-thermal.initd
"
builddir="$srcdir/rpi-thermal-$_commit"

prepare() {
    default_prepare
}

build() {
    #TODO: add use information
    clang -I./public ./rpi_thermal.c -o rpi_thermal -lsecpol -ggdb -O2
}

package() {
    install -m 0755 -d "$pkgdir"/usr/bin

    cp "$builddir"/rpi_thermal "$pkgdir"/usr/bin
    install -Dm755 "$srcdir"/rpi-thermal.initd "$pkgdir"/etc/init.d/rpi-thermal
}


# Contributor: Drake Arconis <lightdrake@gmail.com>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=jsoncpp
pkgver=1.8.4
pkgrel=0
pkgdesc="A C++ library for interacting with JSON."
url="https://github.com/open-source-parsers/jsoncpp"
arch="all"
license="MIT"
#options="!check"
makedepends="cmake doxygen graphviz python3 ninja libc++-dev"
depends="libc++"
subpackages="
    $pkgname-doc
    $pkgname-static
    $pkgname-dev
"
source="$pkgname-$pkgver.tar.gz::https://github.com/open-source-parsers/$pkgname/archive/refs/tags/$pkgver.tar.gz"

builddir="$srcdir/$pkgname-$pkgver"

prepare() {
    default_prepare

    sed -i \
        -e 's/CMAKE_MINIMUM_REQUIRED(VERSION [0-9.]*)/CMAKE_MINIMUM_REQUIRED(VERSION 3.5)/' \
        -e 's/-Werror=conversion//g' \
        "$builddir/CMakeLists.txt"

    mkdir -p "$builddir/build"
}

build() {
    cd "$builddir"

    python3 doxybuild.py --with-dot

    cd build
    cmake .. \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_STATIC_LIBS=ON \
        -DJSONCPP_WITH_CMAKE_PACKAGE=ON

    ninja
}

check() {
    cd "$builddir/build"
    #ninja test jsoncpp_test jsoncpp_readerwriter_tests

    ./src/test_lib_json/jsoncpp_test

    # Skip the test as EXP=4.1 and ACT=4.100000000000001
    rm "$builddir/test/data/test_comment_02.json"

    cd src/jsontestrunner
    python3 \
        "$builddir/src/jsontestrunner/../../test/runjsontests.py" \
        "$builddir/build/src/jsontestrunner/jsontestrunner_exe" \
        "$builddir/test/data"
}

package() {
    cd "$builddir"

    DESTDIR="$pkgdir" ninja -C build install

    mkdir -p "$pkgdir/usr/share/doc/$pkgname/html"

    cp -a "dist/doxygen/jsoncpp-api-html-$pkgver" \
        "$pkgdir/usr/share/doc/$pkgname/html"
}

sha512sums="
f70361a3263dd8b9441374a9a409462be1426c0d6587c865171a80448ab73b3f69de2b4d70d2f0c541764e1e6cccc727dd53178347901f625ec6fb54fb94f4f1  jsoncpp-1.8.4.tar.gz
"

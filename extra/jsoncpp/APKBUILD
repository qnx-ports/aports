# Maintainer: Terence Ang <taang@qnx.com>
pkgname=jsoncpp
pkgver=1.8.4
pkgrel=0
pkgdesc="A C++ library for interacting with JSON."
url="https://github.com/open-source-parsers/jsoncpp"
arch="all"
license="MIT"
options="!check"
makedepends="meson libc++-dev"
subpackages="$pkgname-static $pkgname-dev"
source="${pkgname}-${pkgver}.tar.gz::https://github.com/open-source-parsers/jsoncpp/archive/refs/tags/${pkgver}.tar.gz"
builddir=${srcdir}/${pkgname}-${pkgver}

build() {
    # Avoid "expected unqualified-id" error due to mis-understanding "version" file as a C++ header
    if [ -f version ]; then
        mv version version.txt
    fi

    meson_args="--default-library=both \
                --buildtype=release \
                --prefix="${PREFIX}" \
                "

    meson setup ${meson_args} build
    ninja -C build
}

package() {
    DESTDIR=${pkgdir} ninja -C ${builddir}/build install
}


sha512sums="
f70361a3263dd8b9441374a9a409462be1426c0d6587c865171a80448ab73b3f69de2b4d70d2f0c541764e1e6cccc727dd53178347901f625ec6fb54fb94f4f1  jsoncpp-1.8.4.tar.gz
"

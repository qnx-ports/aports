# Alpine-Contributor: Andrea Scarpino <andrea@archlinux.org>
# Alpine-Contributor: Jonahtan Schaeffer <joschaeffer@gmail.com>
# Alpine-Contributor: Drake Arconis <lightdrake@gmail.com>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=jsoncpp
pkgver=1.8.4
pkgrel=0
pkgdesc="A C++ library for interacting with JSON."
url="https://github.com/open-source-parsers/jsoncpp"
arch="all"
license="MIT"
makedepends="cmake doxygen graphviz python3 ninja libc++-dev"
depends="libc++"
subpackages="
    $pkgname-doc
    $pkgname-static
    $pkgname-dbg
    $pkgname-dev
"
source="
    $pkgname-$pkgver.tar.gz::https://github.com/open-source-parsers/$pkgname/archive/refs/tags/$pkgver.tar.gz
    001-fix-CMakeLists.patch
"

builddir="$srcdir/$pkgname-$pkgver"

prepare() {
    default_prepare

    mkdir -p "$builddir/build"
}

build() {
    cd "$builddir"

    python3 doxybuild.py --with-dot

    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_STATIC_LIBS=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DJSONCPP_WITH_CMAKE_PACKAGE=ON

    cmake --build build
}

check() {
    cd "$builddir/build"

    ./src/test_lib_json/jsoncpp_test

    # Skip the test as EXP=4.1 and ACT=4.100000000000001
    rm "$builddir/test/data/test_comment_02.json"

    python3 \
        "$builddir/src/jsontestrunner/../../test/runjsontests.py" \
        "$builddir/build/src/jsontestrunner/jsontestrunner_exe" \
        "$builddir/test/data"
}

package() {
    cd "$builddir"

    DESTDIR="$pkgdir" ninja -C build install

    mkdir -p "$pkgdir/usr/share/doc/$pkgname/html"

    cp -a "dist/doxygen/jsoncpp-api-html-$pkgver" \
        "$pkgdir/usr/share/doc/$pkgname/html"

    mv "$pkgdir/usr/lib/libjsoncpp_static.a" "$pkgdir/usr/lib/libjsoncpp.a"
}

sha512sums="

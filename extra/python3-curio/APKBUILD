# Alpine-Contributor: Bart Ribbers <bribbers@disroot.org>
# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-curio
pkgver=1.6
pkgrel=0
pkgdesc="Curio is a coroutine-based library for concurrent systems programming"
url="https://github.com/dabeaz/curio"
arch="noarch"
license="BSD-3-Clause"
depends="python3"
makedepends="
    python3-setuptools
    "
# Disabled because we don't have sphinx which is a test dependency used to build docs.
checkdepends="python3-pytest python3-sphinx"
source="
    https://pypi.python.org/packages/source/c/curio/curio-$pkgver.tar.gz
    363_add-support-py312.patch
    "
builddir="$srcdir/curio-$pkgver"
options="!check"

build() {
    python3 setup.py build
}

check() {
    # https://github.com/dabeaz/curio/issues/368
    PYTHONPATH="$PWD/build/lib" pytest -m "not internet" -k "not test_cpu"
}

package() {
    python3 setup.py install --skip-build --root="$pkgdir"
}

sha512sums="

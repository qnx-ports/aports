7d5bc4aef72d1c3522fda7ed64d780ce54968f86e48f2f57626e3bf13c51a4d29c34c24d97d7a43dac73e1f5b20114dbba3efe42b15bc8c9a897db4d9f22ce89  363_add-support-py312.patch
"

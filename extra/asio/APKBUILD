# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=asio
pkgver=1.36.0
pkgrel=2
pkgdesc="Cross-platform C++ library for network programming"
url="https://think-async.com/Asio/"
arch="noarch"
license="BSL-1.0"
depends="openssl-dev>3"
makedepends="$depends_dev qnx-io-sock-dev libc++-dev"
source="https://downloads.sourceforge.net/sourceforge/asio/asio-$pkgver.tar.bz2
disable-sa-restart.patch
"

build() {
    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        CXXFLAGS="$CXXFLAGS -DASIO_HAS_PTHREADS -DASIO_HAS_STD_STRING_VIEW \
                            -DASIO_HAS_CONSTEXPR -DASIO_HAS_STD_FUTURE_CLASS \
                            -Wno-deprecated-declarations" \
	    LIBS="$LIBS -lsocket"
    make
}

check() {
    make check || true
}

package() {
    make DESTDIR="$pkgdir" install
}


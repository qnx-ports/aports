# Maintainer: jscaffidi <jcaffidi@qnx.com>
pkgname=python3-colcon-common-extensions
pkgver=20260406
pkgrel=0
pkgdesc=" Meta package aggregating colcon-core and common extensions "
url="https://github.com/colcon/colcon-common-extensions"
arch="noarch"
license="Apache-2.0"
builddir="$srcdir/colcon-common-extensions"
_basedepends="python3 python3-empy python3-distlib python3-setuptools python3-packaging python3-tomli"
depends="$_basedepends "

makedepends="python3-setuptools python3-distlib"
checkdepends="python3-yaml python3-catkin-pkg python3-argcomplete python3-pytest-cov python3-pytest-repeat python3-pytest-rerunfailures python3-pytest-runner"
options="!check" # Skipping tests since they need a bunch of dependencies we don't have ported atm

# Typically you'd use something like vcstool to get the sources, but there is
# no way of using abuilds checksum validation with it, so we need to get and
# unpack the sources ourselves as vcstool would do...
declare -A extensions
# We don't have python-argcomplete ported
# extensions['colcon-argcomplete']='0.3.3'
extensions['colcon-bash']='0.5.0'
extensions['colcon-cd']='0.2.1'
extensions['colcon-cmake']='0.2.29'
extensions['colcon-core']='0.20.1'
extensions['colcon-defaults']='0.2.9'
extensions['colcon-devtools']='0.3.0'
extensions['colcon-library-path']='0.2.1'
extensions['colcon-metadata']='0.2.5'
extensions['colcon-mixin']='0.2.3'
extensions['colcon-notification']='0.3.1'
extensions['colcon-output']='0.2.14'
extensions['colcon-package-information']='0.4.1'
extensions['colcon-package-selection']='0.2.10'
extensions['colcon-parallel-executor']='0.4.0'
extensions['colcon-pkg-config']='0.1.0'
extensions['colcon-powershell']='0.5.0'
extensions['colcon-python-setup-py']='0.2.9'
extensions['colcon-recursive-crawl']='0.2.3'
extensions['colcon-ros']='0.5.0'
extensions['colcon-test-result']='0.3.8'
extensions['colcon-zsh']='0.5.0'

for extension in "${!extensions[@]}"; do
    source+="$extension.tar.gz::https://github.com/colcon/$extension/archive/refs/tags/${extensions[$extension]}.tar.gz "
    subpackages+="python3-$extension:_package_extension "
    depends+="python3-$extension "
done

unpack(){
    mkdir -p "$builddir"/src
    for extension in "${!extensions[@]}"; do
        mkdir -p "$builddir"/src/$extension
        tar -xf "$srcdir"/$extension.tar.gz --strip-components=1 -C "$builddir"/src/$extension
    done
}

build(){
    cd "$builddir"
    ./src/colcon-core/bin/colcon build --paths src/*
}

package(){
    for extension in "${!extensions[@]}"; do
        mkdir -p "$pkgdir"
        (cd "$builddir"/install/ && find "$extension" -type f -exec install -Dm 755 "{}" "$pkgdir/{}" \;)
    done
}

_package_extension(){
    local extension=$(echo $subpkgname | sed 's/python3-//')
    if [  "$extension" != "colcon-core" ]; then 
        depends="$_basedepends python3-colcon-core"
    else
        depends="$_basedepends"
    fi

    pkgver=${extensions[$extension]}

    mkdir -p "$subpkgdir"/usr
    mv "$pkgdir"/$extension/* "$subpkgdir"/usr/
    rmdir "$pkgdir"/$extension
}

check() {
    ./src/colcon-core/bin/colcon test --paths src/*
}


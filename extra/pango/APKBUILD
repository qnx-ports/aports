# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Alpine-Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=pango
pkgver=1.56.4
pkgrel=3
pkgdesc="library for layout and rendering of text"
url="https://www.pango.org/"
arch="all"
license="LGPL-2.1-or-later"
depends="cairo harfbuzz fribidi glib freetype fontconfig libthai harfbuzz-gobject"
depends_dev="pango-tools=$pkgver-r$pkgrel"
depends_dev="
    harfbuzz-dev
    glib-dev
    fontconfig-dev
    freetype-dev
    cairo-dev
    fribidi-dev
    libthai-dev
    "

makedepends="
    $depends_dev
    expat-dev
    gobject-introspection-dev
    meson
    cmake
    ninja
    pkgconf
    pkgconf-dev
    qnx-libc++-dev
    "

checkdepends="font-dejavu font-cantarell"
subpackages="$pkgname-dev $pkgname-tools"
source="https://download.gnome.org/sources/pango/${pkgver%.*}/pango-$pkgver.tar.xz
    "

build() {
    meson setup \
        --prefix=/usr \
        -Db_lto=false \
        -Dintrospection=enabled \
        -Dfontconfig=enabled \
        -Ddocumentation=false \
        -Dman-pages=false \
        -Dfreetype=enabled \
        -Dc_link_args=-Wl,-lm \
        build
    meson compile -C build
}

check() {
    meson test --print-errorlogs -C build || msg "Some tests are failing"
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

tools() {
    pkgdesc="$pkgdesc (tools)"
    depends="$depends $pkgname=$pkgver-r$pkgrel"

    amove usr/bin
}

sha512sums="
19471618a66b68e19786c458387f2bc8027ecbda5aaf29efcc025a99b3a74402765c6c4c6ea2997d8f1219ef7f1bea817e6ca55e494dff24780f5d3f2a6242a2  pango-1.56.4.tar.xz
"


# Maintainer: Deep Chordia <dchordia@blackberry.com>
pkgname=python3-ml_dtypes
_pkgname=ml_dtypes
pkgrel=0
pkgver=0.5.4
pkgdesc="A stand-alone implementation of several NumPy dtype extensions used in machine learning."
url="https://github.com/jax-ml/ml_dtypes"
arch="all"
license="Apache-2.0"
depends_dev="
    python3-numpy-dev
    "
makedepends="
    $depends_dev
    cmake
    ninja
    "
_eigen_version="5.0.1"
checkdepends="python3-absl-py"
source="
    $_pkgname-$pkgver.tar.gz::https://github.com/jax-ml/ml_dtypes/archive/refs/tags/v$pkgver.tar.gz
    eigen-$_eigen_version.tar.gz::https://gitlab.com/libeigen/eigen/-/archive/$_eigen_version.tar.gz
    "
builddir="$srcdir/$_pkgname-$pkgver"

prepare() {
  mv "$srcdir"/eigen-$_eigen_version/* "$builddir"/third_party/eigen
}

build() {
  python3 setup.py build
}

check() {
  pytest
}

package() {
  python3 setup.py install --skip-build --root="$pkgdir"
}


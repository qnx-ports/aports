# Alpine Maintainer: Laurent Bercot <ska-devel@skarnet.org>
# Maintainer: abdulahmoda <abahmoda@qnx.com>
pkgname=skalibs
# NOTE: If you're upgrading to a new version that fixes some security
# vulnerability in the APIs used by utmps (mainly timed ipcs),
# rebuild the following aports:
# - busybox
# - mingetty
# - openssh
# - util-linux
pkgver=2.14.5.1
pkgrel=0
pkgdesc="Set of general-purpose C programming libraries for skarnet.org software."
url="https://skarnet.org/software/skalibs/"
arch="all"
license="ISC"
options="!check"  # No test suite.
makedepends="qnx-io-sock-dev"
subpackages="$pkgname-static $pkgname-libs $pkgname-dev $pkgname-doc"
source="https://github.com/qnx-ports/skalibs/archive/refs/tags/qnx-v2.14.5.1.tar.gz"
build_dir="$srcdir/skalibs-qnx-v$pkgver"

build() {
	cd "$build_dir"
	./configure \
		CFLAGS="$CFLAGS -Qunused-arguments -DSA_RESTART=0" \
		CXX_FLAGS="$CXX_FLAGS -Qunused-arguments" \
		--prefix=/usr \
		--enable-pkgconfig \
		--with-sysdep-devurandom=yes \
		--with-sysdep-posixspawnearlyreturn=no \
		--with-sysdep-procselfexe=none
	make
}

package() {
	cd "$build_dir"
	make DESTDIR="$pkgdir" install
	install -D -m 0644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
	mkdir -p "$pkgdir/usr/share/doc"
	cp -a doc "$pkgdir/usr/share/doc/$pkgname"
}

dev() {
	default_dev
	amove usr/lib/skalibs/sysdeps
}

sha512sums="
94aaa7e28243446869f7675ff733f0921753f03544065ac6d4999a6cb218ec18ef0d783713fdff193d4cd4913b851078d4ffc739fe4a8e5d2f3873f4d1b3c1e2  qnx-v2.14.5.1.tar.gz
"

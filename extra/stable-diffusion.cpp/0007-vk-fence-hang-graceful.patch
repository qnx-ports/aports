+// Like VK_CHECK but throws std::runtime_error instead of calling exit(1).
+// Used in GPU fence-wait paths so a driver hang (VK_TIMEOUT from
+// waitForFences with UINT64_MAX, seen on NVK/QNX) propagates as a C++
+// exception rather than killing the process.  ggml_backend_vk_graph_compute
+// catches it and returns GGML_STATUS_FAILED; ggml_extend.hpp turns that into
+// std::nullopt; sd-server returns an HTTP error to the client instead of
+// dropping the connection.
+#define VK_CHECK_THROW(err, msg)                                              \
+    do {                                                                       \
+        vk::Result _r = (err);                                                \
+        if (_r != vk::Result::eSuccess) {                                     \
+            char _buf[256];                                                    \
+            snprintf(_buf, sizeof(_buf), "ggml_vulkan: %s error %s",          \
+                     #err, to_string(_r).c_str());                            \
+            fprintf(stderr, "%s at %s:%d\n", _buf, __FILE__, __LINE__);       \
+            throw std::runtime_error(_buf);                                   \
+        }                                                                     \
+    } while (0)
+
 #ifdef GGML_VULKAN_DEBUG
 #define VK_LOG_DEBUG(msg) std::cerr << msg << std::endl

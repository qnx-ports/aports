# Maintainer: Cris Sinnott <csinnott@qnx.com>
pkgname=stable-diffusion.cpp
pkgver=0_git20260602
pkgrel=3
_sdcommit=1649238c80a8ca20fd832c37bda991c240c7927a
_ggmltag=qnx-0.14.0-r1
# ggml is built from the qnx-ports/ggml tag above (QNX Vulkan and CPU
# fixes) and kept private to this package in /usr/lib/stable-diffusion.cpp,
# leaving the system paths free for a future ggml package.
# All CPU variants are built as loadable modules; ggml loads the best one
# for the CPU at run time.
pkgdesc="Stable Diffusion in pure C/C++ (Vulkan GPU + CPU backend)"
url="https://github.com/leejet/stable-diffusion.cpp"
arch="aarch64 x86_64"
license="MIT"
# abuild does not detect qnx-vulkan (needed by the Vulkan backend module).
depends="libc++ qnx-io-sock qnx-vulkan"
makedepends="cmake ninja clang libc++-dev qnx-microkernel-dev qnx-io-sock-dev shaderc-dev glslang-dev spirv-tools-dev vulkan-headers"
subpackages="$pkgname-dev $pkgname-dbg"
source="
	stable-diffusion.cpp-$_sdcommit.tar.gz::https://github.com/qnx-ports/stable-diffusion.cpp/archive/$_sdcommit.tar.gz
	ggml-$_ggmltag.tar.gz::https://github.com/qnx-ports/ggml/archive/refs/tags/$_ggmltag.tar.gz
	"
builddir="$srcdir/stable-diffusion.cpp-$_sdcommit"
_privlib="/usr/lib/$pkgname"

prepare() {
	rm -rf "$builddir/ggml"
	mv "$srcdir/ggml-$_ggmltag" "$builddir/ggml"
}

build() {
	rm -rf build
	# The CPU variants, not the build host, decide the instruction set.
	cmake -B build -G Ninja \
		-DCMAKE_C_COMPILER=clang \
		-DCMAKE_CXX_COMPILER=clang++ \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DSD_VULKAN=ON \
		-DSD_BUILD_SHARED_LIBS=ON \
		-DSD_BUILD_SHARED_GGML_LIB=ON \
		-DGGML_BACKEND_DL=ON \
		-DGGML_BACKEND_DIR="$_privlib" \
		-DCMAKE_INSTALL_RPATH="$_privlib" \
		-DGGML_CPU_ALL_VARIANTS=ON \
		-DGGML_NATIVE=OFF \
		-DGGML_LLAMAFILE=ON \
		-DGGML_OPENMP=OFF \
		-DGGML_BUILD_TESTS=ON
	# Parallel shader generation corrupts the shader header: build it first.
	cmake --build build --target ggml-vulkan -j1
	cmake --build build
}

check() {
	# CPU backend only: Vulkan hangs on QEMU guests and aborts on the Pi 5.
	# Installed modules in $_privlib would shadow the build tree, so skip.
	if ls "$_privlib"/libggml-*.so >/dev/null 2>&1; then
		warning "skipping test-backend-ops: $_privlib has installed ggml modules that would shadow the build tree"
		return 0
	fi

	local t="$builddir/check-cpu"
	rm -rf "$t"
	mkdir -p "$t"
	cp -P build/bin/test-backend-ops build/bin/libggml-cpu-*.so \
		build/bin/libggml.so* build/bin/libggml-base.so* "$t"/

	local log="$builddir/check-cpu.log"
	(cd "$t" && LD_LIBRARY_PATH="$t" ./test-backend-ops test -b CPU) > "$log" 2>&1 || {
		tail -n 40 "$log"
		return 1
	}
	grep -E "load_backend|Backend [0-9]+/|tests passed" "$log"
	if grep -q "failed to load" "$log"; then
		error "a CPU variant module failed to load"
		return 1
	fi
	if ! grep -q "loaded CPU backend from $t/" "$log"; then
		error "test-backend-ops did not load the CPU backend from the build tree"
		return 1
	fi
}

package() {
	DESTDIR="$pkgdir" cmake --build build --target install

	# Keep ggml private: libraries next to the modules, no ggml dev files.
	mv "$pkgdir"/usr/lib/libggml*.so.* "$pkgdir/$_privlib"/
	rm -f "$pkgdir"/usr/lib/libggml*.so
	rm -rf "$pkgdir"/usr/lib/cmake/ggml
	rmdir "$pkgdir"/usr/lib/cmake 2>/dev/null || true
	rm -f "$pkgdir"/usr/include/ggml*.h "$pkgdir"/usr/include/gguf.h

	local stray
	stray=$(cd "$pkgdir" && find usr/lib usr/include -maxdepth 1 \( -name '*ggml*' -o -name 'gguf*' \))
	if [ -n "$stray" ]; then
		error "ggml files outside $_privlib: $stray"
		return 1
	fi
}


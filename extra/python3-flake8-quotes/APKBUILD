# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=python3-flake8-quotes
pkgver=3.4.0
pkgrel=0
pkgdesc="Flake8 extension for checking quotes in python "
options="!check" # No testsuite
url="https://github.com/zheller/flake8-quotes"
arch="noarch"
license="MIT"
depends="python3-flake8"
makedepends="python3-hatchling python3-gpep517 python3-setuptools"
source="flake8-quotes-$pkgver.tar.gz::https://github.com/zheller/flake8-quotes/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir"/flake8-quotes-$pkgver

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	gpep517 install-wheel --destdir "$pkgdir" \
		.dist/*.whl
}

sha512sums="
7b85f1fd9da5e060e152a4905d0152c6db8fc8ccc9597bad36fa587c37bb921dabfb6d1477b2f3999b72bcc91bd32ff9af93f4be4191531c3a8ef419fd18af49  flake8-quotes-3.4.0.tar.gz
"

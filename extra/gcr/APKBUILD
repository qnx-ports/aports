# Maintainer: Yongxin Dai <yodai@qnx.com>
pkgname=gcr
pkgver=3.41.2
pkgrel=1
pkgdesc="library for bits of crypto UI and parsing"
url="https://gitlab.gnome.org/GNOME/gcr/-/tree/gcr-3-41"
arch="all"
license="LGPL-2.0-or-later"
depends="$pkgname-base=$pkgver-r$pkgrel gtk3 glib"
depends_dev="gtk3-dev p11-kit-dev"
makedepends="
    glib-dev
    gobject-introspection-dev
    gtk3-dev
    libgcrypt-dev
    libsecret-dev
    libxslt
    meson
    openssh
    p11-kit-dev
    vala
    "
subpackages="
    $pkgname-dev
    $pkgname-lang
    $pkgname-base
    "
source="https://download.gnome.org/sources/gcr/${pkgver%.*}/gcr-$pkgver.tar.xz
    fix-64-bit-time_t-32-bit.patch
    set-_XOPEN_SOURCE-a-vlaue-and-link-libsocket.patch
    define-HAVE_TIMEGM.patch
    "

build() {
    abuild-meson \
        -Db_lto=false \
        -Dgtk_doc=false \
        -Dgpg_path=/usr/bin/gpg2 \
        -Dsystemd=disabled \
        -Dgtk_doc=false \
        -Dc_args='-D_QNX_SOURCE' \
        -Dc_args='-lsocket' \
        --libexecdir=/usr/lib \
        output
    meson compile ${JOBS:+-j ${JOBS}} -C output
}

check() {
    # 8/47 gcr:egg / secmem                  FAIL            0.16s   killed by signal 6 SIGABRT
    # 14/47 gcr:gck / attributes             FAIL            0.16s   killed by signal 6 SIGABRT
    # 23/47 gcr:gcr-ssh-agent / process      FAIL            0.17s   killed by signal 6 SIGABRT
    # 24/47 gcr:gcr-ssh-agent / service      FAIL            0.18s   killed by signal 11 SIGSEGV
    # 37/47 gcr:gcr-base / secure-memory     FAIL            0.16s   killed by signal 6 SIGABRT
    # 42/47 gcr:gcr-base / gnupg-collection  FAIL            0.11s   killed by signal 6 SIGABRT
    # 44/47 gcr:gcr-base / system-prompt     FAIL            0.06s   killed by signal 5 SIGTRAP
    # 47/47 gcr:gcr-base / gnupg-process     TIMEOUT        30.08s   killed by signal 15 SIGTERM
    meson test --no-rebuild --print-errorlogs -C output || true
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

base() {
    pkgdesc="$pkgdesc (base libraries)"
    depends="glib
            gtk3
            libgcrypt
            libsecret
            libxslt
            p11-kit"

    amove usr/lib
}


# Maintainer: Deep Chordia <dchordia@blackberry.com>
pkgname=pytorch
pkgver=2.3.1
pkgrel=0
pkgdesc="Tensors and Dynamic neural networks in Python with strong GPU acceleration"
url="https://pytorch.org/"
arch="all"
license="BSD-3-Clause"
depends="
    libc++
    cpuinfo
    pthreadpool
    gflags
    openblas
    opencv
    "
depends_dev="
    libc++-dev
    cpuinfo-dev
    pthreadpool-dev
    gflags-dev
    openblas-dev
    opencv-dev
    "
makedepends="
    $depends_dev
    cmake
    ninja
    python3-yaml
    python3-typing-extensions
    python3-six
    "
subpackages="
    $pkgname-dev
    $pkgname-tests:tests
    "
source="
    $pkgname-$pkgver.tar.gz::https://github.com/pytorch/pytorch/releases/download/v$pkgver/pytorch-v$pkgver.tar.gz
    0001-XNNPACK-qnx-build_patch
    0002-protobuf-qnx-build_patch
    0003-kineto-qnx-build_patch
    0004-fbgemm-qnx-build_patch
    0005-foxi-qnx-build_patch
    0006-add-qnx-build.patch
"
builddir="$srcdir/$pkgname-v$pkgver"

prepare() {
    (cd $builddir/third_party/XNNPACK && patch ${patch_args:--p1} -i "$srcdir"/0001-XNNPACK-qnx-build_patch)
    (cd $builddir/third_party/protobuf && patch ${patch_args:--p1} -i "$srcdir"/0002-protobuf-qnx-build_patch)
    (cd $builddir/third_party/kineto && patch ${patch_args:--p1} -i "$srcdir"/0003-kineto-qnx-build_patch)
    (cd $builddir/third_party/fbgemm && patch ${patch_args:--p1} -i "$srcdir"/0004-fbgemm-qnx-build_patch)
    (cd $builddir/third_party/foxi && patch ${patch_args:--p1} -i "$srcdir"/0005-foxi-qnx-build_patch)
    default_prepare
}

build() {

    _pytorch_build_args=(
        "-DUSE_ROCM=OFF"
        "-DUSE_CUDA=OFF"
        "-DUSE_MAGMA=OFF"
        "-DUSE_METAL=OFF"
        "-DUSE_ITT=OFF"
        "-DUSE_DISTRIBUTED=OFF"
        "-DUSE_MKLDNN=OFF"
        "-DUSE_OPENMP=ON"
        "-DUSE_NNPACK=OFF"
        "-DUSE_QNNPACK=OFF"
        "-DUSE_SYSTEM_XNNPACK=OFF"
        "-DUSE_GFLAGS=ON"
        "-DUSE_OPENCV=ON"
        "-DUSE_BLAS=ON"
        "-DUSE_SYSTEM_CPUINFO=ON"
        "-DUSE_SYSTEM_PTHREADPOOL=ON"
        "-DBUILD_MOBILE_TEST=OFF"
        "-DBUILD_BINARY=OFF"
        "-DTRACING_BASED=OFF"
        "-DBUILD_PYTHON=OFF"
        "-DBUILD_TEST=ON"
        "-DXNNPACK_ENABLE_ASSEMBLY=ON"
        "-DBUILD_CUSTOM_PROTOBUF=ON"
        "-DBUILD_CAFFE2=ON"
    )

    export CXXFLAGS="$CXXFLAGS \
        -Wno-error=unused-command-line-argument -Wno-unused-command-line-argument \
        -Wno-error=nontrivial-memcall -Wno-nontrivial-memcall \
        -Wno-error=vla-cxx-extension -Wno-vla-cxx-extension \
        -Wno-error=character-conversion -Wno-character-conversion\
        -Wno-error=missing-field-initializers -Wno-missing-field-initializers\
        -Wno-error=thread-safety-analysis -Wno-thread-safety-analysis\
        -Wno-error=unknown-warning-option \
        -DEIGEN_DONT_VECTORIZE"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_DATADIR=/usr/lib \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DQNX=1 \
        "${_pytorch_build_args[@]}"
    cmake --build build --verbose
}

check() {
    _test_exclude="vec_test_all_types_AVX512|vec_test_all_types_AVX2|module_test|plan_executor_test|"
    _test_exclude+="inline_container_test|bound_shape_inference_test|math_kernel_test|native_test|cpuid_test"
    ctest --test-dir build -E $_test_exclude -j1
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    rm "$pkgdir"/usr/bin/protoc*
    rm -r "$pkgdir"/usr/include/pybind11
}

tests() {
    pkgdesc="Test suite for $pkgname"
    depends="$pkgname=$pkgver-r$pkgrel"

    amove usr/bin/test_*
    amove usr/bin/tutorial_tensorexpr
    amove usr/test/*
}


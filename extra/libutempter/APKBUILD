# Alpine Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Alpine Maintainer: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: abdulahmoda <abahmoda@qnx.com>
pkgname=libutempter
pkgver=1.2.3
_pkgver=$pkgver-alt1
pkgrel=0
pkgdesc="Library interface to record user sessions in utmp/wtmp files"
url="http://freecode.com/projects/libutempter"
arch="all"
license="LGPL-2.1-or-later"
makedepends=""
subpackages="$pkgname-dev $pkgname-doc"
options="suid !check"
pkggroups="utmp"
source="https://github.com/abdulahmoda/libutempter/archive/refs/heads/qnx-v1.2.3.tar.gz"
builddir="$srcdir/$pkgname-qnx-v$pkgver/$pkgname"

build() {
	cd $builddir
	make CFLAGS="$CFLAGS -I/usr/include/utmps -DQNX=ON" LDLIBS="-Wl,--no-as-needed -lskarnet -Wl,--as-needed"
}

package() {
	make DESTDIR="$pkgdir" install
	chown root:$pkggroups "$pkgdir/usr/lib/utempter/utempter"
	chmod 2755 "$pkgdir/usr/lib/utempter/utempter"
}

sha512sums="
f304ea3ec244544434716f6e849056a8f5560d714b1fb7370de6990cdcdf986881b80e15dfdad032f7d6daff5fc38843c6ff892897ab62b0810ce8aced088242  qnx-v1.2.3.tar.gz
"

--- mujoco-mujoco_ver_3.10.0_orig/src/user/user_mesh.cc
+++ mujoco-mujoco_ver_3.10.0/src/user/user_mesh.cc
@@ -18,6 +18,14 @@
 #include <climits>
 #include <cmath>
 #include <csetjmp>
+
+#if defined(__QNX__)
+// libc++'s <csetjmp> undefines the setjmp macro on QNX (it only
+// re-exposes ::longjmp), but QNX libc exports _setjmp/sigsetjmp, not a
+// plain setjmp symbol, so unqualified setjmp() calls below fail to link.
+// Restore the standard setjmp->sigsetjmp redirect locally.
+#define setjmp(buf) sigsetjmp(buf, 1)
+#endif
 #include <cstddef>
 #include <cstdio>
 #include <cstring>

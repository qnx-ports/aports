# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=mujoco
pkgver=3.10.0
pkgrel=0
pkgdesc="MuJoCo physics engine"
url="https://github.com/google-deepmind/mujoco"
arch="all"
license="Apache-2.0"
depends="miniz libc++"
makedepends="
    cmake
    ninja
    eigen-dev
    tinyxml2-dev
    miniz-dev
	libc++-dev
	ca-certificates
"
options="!lto"
options="net"
subpackages="
    $pkgname-dev
    $pkgname-models:models
"
source="
    mujoco-$pkgver.tar.gz::https://github.com/rtimmaraju/mujoco/archive/refs/heads/mujoco_ver_3.10.0.tar.gz
    benchmark-disable-qnx.patch
    001-fix-qnx-setjmp-link-error.patch
    002-increase-gtest-discovery-timeout.patch
"
builddir="$srcdir/mujoco-mujoco_ver_3.10.0"

build() {
	cmake -B build \
		-G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON \
		-DMUJOCO_BUILD_TESTS=ON \
		-DMUJOCO_BUILD_EXAMPLES=OFF \
		-DMUJOCO_BUILD_SIMULATE=OFF \
		-DMUJOCO_BUILD_PYTHON=OFF \
        -DCMAKE_C_STANDARD=99 \
		-DMUMOCO_DEPENDENCIES=OFF \
		-DMUJOCO_WITH_USD=OFF \
		-DCMAKE_CXX_FLAGS="${CXXFLAGS} -Wno-error=unused-command-line-argument" \
        -DCMAKE_C_FLAGS="${CFLAGS} -Wno-error=unused-command-line-argument" \
		-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
		-DBENCHMARK_ENABLE_TESTING=OFF

	cmake --build build
}

check() {
    cd "$builddir/build"
    ctest --output-on-failure || true
}

models() {
    amove usr/share/mujoco/model
}

package() {
	
	DESTDIR="$pkgdir" cmake --install build
}


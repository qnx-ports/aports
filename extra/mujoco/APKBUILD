# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>
pkgname=mujoco
pkgver=3.10.0
pkgrel=0
pkgdesc="MuJoCo physics engine"
url="https://github.com/google-deepmind/mujoco"
arch="all"
license="Apache-2.0"
depends="miniz libc++"
makedepends="
    cmake
    ninja
    eigen-dev
    tinyxml2-dev
    miniz-dev
	libc++-dev
	ca-certificates
"
options="!lto net"
subpackages="
    $pkgname-dev
    $pkgname-models:models
"
source="$pkgname-$pkgver.tar.gz::https://github.com/google-deepmind/mujoco/archive/$pkgver.tar.gz
    004-mujoco-qnx.patch
    003-disable-benchmark-qnx.patch
    001-fix-qnx-setjmp-link-error.patch
    002-increase-gtest-discovery-timeout.patch
"
builddir="$srcdir/${pkgname}-$pkgver"

build() {
	cmake -B build \
		-G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON \
		-DMUJOCO_BUILD_TESTS=ON \
		-DMUJOCO_BUILD_EXAMPLES=OFF \
		-DMUJOCO_BUILD_SIMULATE=OFF \
		-DMUJOCO_WITH_USD=OFF \
		-DCMAKE_CXX_FLAGS="${CXXFLAGS} -Wno-error=unused-command-line-argument" \
        -DCMAKE_C_FLAGS="${CFLAGS} -Wno-error=unused-command-line-argument" \
		-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
		-DBENCHMARK_ENABLE_TESTING=OFF

	cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure -j1 \
        -E 'KeyframeTest\.(CheckValues|ResetDataKeyframe)|UserUtilTest\.StringToVectorError|XMLReaderTest\.(LargeTextureTest|LargeTextureAddressTest|ParseFrame)|AllModels/WriteReadCompareTest\.WriteReadCompare/(flag_xml_4|bunny_shell_xml_218|quadratic_xml_235)'
}

models() {
    amove usr/share/mujoco/model
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}


# Maintainer: Harshini Yarasi <hyarasi@qnx.com>
pkgname=clapack
pkgver=3.2.1
pkgrel=0
pkgdesc="ANSI C translation of LAPACK"
url="https://www.netlib.org/clapack/"
arch="all"
license="BSD-3-Clause"
makedepends="build-base"
source="clapack-$pkgver.tgz::https://www.netlib.org/clapack/clapack.tgz
        fix-xberla.patch
        "
builddir="$srcdir/CLAPACK-$pkgver"

prepare() {
	default_prepare
	cd "$builddir"
	cp make.inc.example make.inc

	# Disable warnings
	sed -i 's/CFLAGS = -O3/CFLAGS = -O3 -w/' make.inc

	# FIX: add missing include to tstiee.c
	sed -i '/#include "blaswrap.h"/a #include <string.h>' INSTALL/tstiee.c
}

build() {
	cd "$builddir"
	
	# Force flags for sub-makes that ignore make.inc
	export CFLAGS="-O3 -w -Wno-implicit-function-declaration"
	
	make f2clib
	make blaslib
	make lapacklib
}
check()
{
build
}

package() {
    cd "$builddir"

	mkdir -p "$pkgdir/usr/lib"
	mkdir -p "$pkgdir/usr/include"

	cp blas_*.a "$pkgdir/usr/lib/"
	cp lapack_*.a "$pkgdir/usr/lib/"
	cp F2CLIBS/libf2c.a "$pkgdir/usr/lib/"

	cp -r INCLUDE/*.h "$pkgdir/usr/include/"
}

# Maintainer: Harshini Yarasi <hyarasi@qnx.com>
pkgname=clapack
pkgver=3.2.1
pkgrel=0
pkgdesc="ANSI C translation of LAPACK"
url="https://www.netlib.org/clapack/"
arch="all"
license="BSD-3-Clause"
makedepends="build-base"
options="!check"
source="clapack-$pkgver.tgz::https://www.netlib.org/clapack/clapack.tgz
		fix-make-inc-plat.patch
        fix-xberla.patch
        fix-tstiee-stringh.patch
        "
builddir="$srcdir/CLAPACK-$pkgver"

prepare() {
	default_prepare
	cp "$builddir/make.inc.example" "$builddir/make.inc"
}

build() {
	cd "$builddir"
	
	# Force flags for sub-makes that ignore make.inc
	export CFLAGS="$CFLAGS -w -Wno-implicit-function-declaration"
	
	make f2clib
	make blaslib
	make lapacklib
	make tmglib
}
package() {
	install -Dm644 "$builddir/libblas.a" \
		"$pkgdir/usr/lib/libblas.a"
	install -Dm644 "$builddir/liblapack.a" \
		"$pkgdir/usr/lib/liblapack.a"
	install -Dm644 "$builddir/libtmglib.a" \
		"$pkgdir/usr/lib/libtmglib.a"
	install -Dm644 "$builddir/F2CLIBS/libf2c.a" \
		"$pkgdir/usr/lib/libf2c.a"
	install -Dm644 "$builddir/INCLUDE/"*.h \
		-t "$pkgdir/usr/include/"
}

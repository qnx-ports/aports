# Alpine-Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=sdl3
_pkgname=SDL
pkgver=3.4.18
pkgrel=0
pkgdesc="Simple Directmedia Layer"
url="https://libsdl.org/"
arch="all"
license="Zlib"
depends="
     qnx-alsa
     qnx-screen
     qnx-egl
     qnx-gles
     wayland
     libxkbcommon"
makedepends="
     qnx-alsa-dev
     qnx-screen-dev
     egl-headers
     gles-headers
     wayland-dev
     wayland-protocols
     libxkbcommon-static
     libxkbcommon-dev
     autoconf
     clang
     cmake
     ninja"
subpackages="$pkgname-dev $pkgname-dbg $pkgname-doc"
_git_rev=0
source="$pkgname-$pkgver-r$_git_rev.tar.gz::https://www.github.com/qnx-ports/$_pkgname/archive/refs/tags/qnx-release-$pkgver-r$_git_rev.tar.gz"
builddir="$srcdir/$_pkgname-qnx-release-$pkgver-r$_git_rev"

build() {
    export CPPFLAGS="${CPPFLAGS} -D_QNX_SOURCE -Wno-error=incompatible-function-pointer-types"
    cmake -B build -G Ninja \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_ASM_COMPILER=clang \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DSDL_SHARED=ON \
        -DSDL_STATIC=ON \
        -DSDL_X11=0 \
        -DSDL_WAYLAND=1 \
        -DSDL_VIDEO=1 \
        -DSDL_AUDIO=1 \
        -DSDL_JOYSTICK=1 \
        -DSDL_TESTS=1
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

check() {
    local skip=""
    if [[ $CARCH == "aarch64" ]]; then
        # Flaky on build machines.
        skip="testatomic|"
    fi
    # Disable SDL_strtod() failures
    ctest --test-dir build -E "(${skip}testautomation|testautomation-no-simd)"
}

dev() {
    default_dev
    provides="$pkgname-static=$pkgver-r$pkgrel"
}

sha512sums="
fc08eeb95a69908a8092f98bb214db372374a0e95bde8d3c568696d1aa9d29def14304c75aac63a5be5404d8107a06db2faa99be6922c94bd79bc15575b74fda  sdl3-3.4.18-r0.tar.gz
"

pkgname=rpi-gpio
pkgver=0.1
_commit="880d66fe20a3111e32a86eb8339e79bc43abbf36"
pkgrel=0
pkgdesc="GPIO Resource manager for RPI4/5"
arch="aarch64"
license="LicenseRef-QDL-Non-Commercial"
depends="qnx-secpol"
makedepends="qnx-secpol-dev qnx-security-dev qnx-screen-dev python3-dev"
options="!check"
url="https://gitlab.com/qnx/projects/rpi-gpio"
subpackages="$pkgname-dbg $pkgname-dev"
source="https://gitlab.com/qnx/projects/rpi-gpio/-/archive/$_commit/rpi-gpio-$_commit.tar.gz"
builddir="$srcdir/rpi-gpio-$_commit"

prepare() {
    default_prepare
}

build() {
    cmake . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}


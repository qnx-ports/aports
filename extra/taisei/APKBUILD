# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=taisei
pkgver=1.4.6
pkgrel=0
pkgdesc="Free Touhou Project fangame"
url="https://github.com/taisei-project/taisei"
arch="all"
license="MIT AND CC-BY-4.0 AND LicenseRef-scancode-public-domain"
depends="$pkgname-data cglm freetype libcrypto3 libc++ libogg libpng libunibreak
    libwebp libwebpdecoder opus opusfile sdl3 spirv-cross spirv-tools zlib zstd
    zstd-libs"
makedepends="meson cglm-dev freetype-dev libc++-dev libogg-dev libpng-dev
    libunibreak-dev libwebp-dev shaderc spirv-cross-dev spirv-tools-dev
    openssl-dev opus-dev opusfile-dev sdl3-dev zlib-dev zstd-dev"
subpackages="$pkgname-doc $pkgname-data::noarch"
source="$pkgname-$pkgver.tar.gz::https://github.com/taisei-project/taisei/archive/refs/tags/v$pkgver.tar.gz
    https://github.com/taisei-project/basis_universal/archive/380ef9389b38ec42506d5728dd05e94ac2f3c301.tar.gz
    https://github.com/taisei-project/SDL_GameControllerDB/archive/7988b5e84c31616200ee2ffd2347386c6b3165a8.tar.gz
    https://github.com/taisei-project/koishi/archive/f899ac2f96051ffbc6cf9aa250f52832f0dfef9b.tar.gz
    fix-gles.patch"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
    default_prepare

    mv "$srcdir"/basis_universal-380ef9389b38ec42506d5728dd05e94ac2f3c301/* \
        "$builddir"/external/basis_universal
    mv "$srcdir"/SDL_GameControllerDB-7988b5e84c31616200ee2ffd2347386c6b3165a8/* \
        "$builddir"/external/gamecontrollerdb
    mv "$srcdir"/koishi-f899ac2f96051ffbc6cf9aa250f52832f0dfef9b/* \
        "$builddir"/external/koishi
}

build() {
    meson setup build \
        --buildtype=release \
        -Dprefix=/usr \
        -Db_lto=false \
        -Dr_gles30=enabled
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

check() {
    meson test --print-errorlogs -C build
}

data() {
    pkgdesc="Data files for taisei"

    # Runs after doc
    amove usr/share
}


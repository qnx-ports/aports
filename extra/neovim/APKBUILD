# lua5.1-mpack
# msgpack-c-dev
# need to fix nvim test info with lutjit ffi cdef
options="net !check"
subpackages="$pkgname-doc"
source="https://github.com/neovim/neovim/archive/v$pkgver/neovim-$pkgver.tar.gz
        qnx-endian.patch
        qnx-forkpty.patch
       	qnx-remove-util.patch
	qnx-define.patch
	nodoc.txt

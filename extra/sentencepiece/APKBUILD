179bab163ffab00ff8d1462aab29b51d99d4b1d4e1a10f4d88113ae3201ea064912cbbaf98a966dbde4294ab39e6dabc76dc7a6c7895631ca8306681700ce158  qnx-no-endian_h.patch
"

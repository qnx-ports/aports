pkgname=s2n-tls
pkgver=1.5.25
pkgrel=0
pkgdesc="An implementation of the TLS/SSL protocols"
url="https://aws.github.io/s2n-tls/usage-guide/"
arch="all"
license="Apache-2.0"
depends="qnx-io-sock"
depends_dev="openssl-dev"
makedepends="
    $depends_dev
    cmake
    ninja
"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/aws/s2n-tls/archive/refs/tags/v$pkgver.tar.gz
        0001-add-qnx-build.patch
        "

build() {
  CFLAGS="-Wno-unused-command-line-argument -DMAX=max -DMIN=min" \
  cmake -B build -G Ninja \
    -DCMAKE_SHARED_LINKER_FLAGS="-lsocket" \
    -DCMAKE_EXE_LINKER_FLAGS="-lsocket" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_DATADIR=/usr/lib \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  test_exclude="s2n_override_openssl_random_test|s2n_self_talk_broken_pipe_test"
  ctest --test-dir build -E $test_exclude
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}


# Maintainer: Deep Chordia <dchordia@qnx.com>
pkgname=s2n-tls
pkgver=1.6.4
pkgrel=0
pkgdesc="An implementation of the TLS/SSL protocols"
url="https://aws.github.io/s2n-tls/usage-guide/"
arch="all"
license="Apache-2.0"
depends_dev="openssl-dev qnx-io-sock-dev"
makedepends="
    $depends_dev
    cmake
    ninja
"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/aws/s2n-tls/archive/refs/tags/v$pkgver.tar.gz
        0001-add-qnx-build.patch
        "

build() {
  export CFLAGS="$CFLAGS  -Wno-unused-command-line-argument -DMAX=max -DMIN=min"
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_DATADIR=/usr/lib \
    -DCMAKE_C_STANDARD_LIBRARIES="-lsocket" \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  _test_exclude="s2n_client_hello_test"
  ctest --test-dir build -E $_test_exclude
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}


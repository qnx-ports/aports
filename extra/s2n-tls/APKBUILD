b8870d5f39ce9299de782da518391cab5b1ff964407bbc23eb5676a6f6dae0d6fe31d04fbe217123d0c3554b6e9cebbde7350d74ec35e408d03c5a385f76a993  0001-add-qnx-build.patch
"

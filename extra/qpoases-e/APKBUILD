# Maintainer: Terence Ang <taang@qnx.com>
pkgname=qpoases-e
pkgver=3.1_git20250918
_commit="125e94fa638f00350608871fc165789b1d1762f1"
pkgrel=0
pkgdesc="Unofficial fork of qpOASES (C version) with acados changes"
url="https://github.com/acados/qpOASES"
arch="all"
license="LGPL-2.1-only"
makedepends="cmake"
subpackages="$pkgname-dev"
source="
    $pkgname-$_commit.tar.gz::https://github.com/acados/qpOASES/archive/$_commit.tar.gz
    001-CMakelists_txt.patch
    002-QProblems_c.patch
"
builddir="$srcdir/qpOASES-$_commit"

build() {
    cmake -B build -S . \
	-DBUILD_SHARED_LIBS=ON \
        -DCMAKE_INSTALL_PREFIX=/usr

    cmake --build build -j"$npoc"

    make -C examples
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

check() {
    ./bin/example1
    ./bin/example1b
    ./bin/exampleLP
}


source="$pkgname-$_pkgver.tar.gz::https://github.com/Azure/azure-iot-sdk-c/archive/$_pkgver.tar.gz
        $pkgname-$_pkgver-azure_c_shared_utility.tar.gz::https://github.com/Azure/azure-c-shared-utility/archive/$_azure_c_shared_utility_commit.tar.gz
        $pkgname-$_pkgver-azure_umqtt_c.tar.gz::https://github.com/Azure/azure-umqtt-c/archive/$_umqtt_commit.tar.gz
        $pkgname-$_pkgver-azure_uamqp_c.tar.gz::https://github.com/Azure/azure-uamqp-c/archive/$_uamqp_commit.tar.gz
        $pkgname-$_pkgver-parson.tar.gz::https://github.com/kgabis/parson/archive/$_parson_commit.tar.gz
        $pkgname-$_pkgver-uhttp.tar.gz::https://github.com/Azure/azure-uhttp-c/archive/$_uhttp_commit.tar.gz
        $pkgname-$_pkgver-riot.tar.gz::https://github.com/Microsoft/RIoT/archive/$_RIOT_commit.tar.gz
        $pkgname-$_pkgver-utpm.tar.gz::https://github.com/Azure/azure-utpm-c/archive/$_utpm_commit.tar.gz
        $pkgname-$_pkgver-macro_utils_c.tar.gz::https://github.com/Azure/macro-utils-c/archive/$_azure_macro_utils_c_commit.tar.gz
        $pkgname-$_pkgver-umock_c.tar.gz::https://github.com/Azure/umock-c/archive/$_umock_c_commit.tar.gz
        $pkgname-$_pkgver-c_testrunnerswitcher.tar.gz::https://github.com/Azure/c-testrunnerswitcher/archive/$_azure_c_testrunnerswitcher_commit.tar.gz
        $pkgname-$_pkgver-ctest.tar.gz::https://github.com/Azure/azure-ctest/archive/$_azure_ctest_commit.tar.gz
        0001-c-utility-qnx_patch
        0002-azure-iot-qnx.patch
        "
builddir="$srcdir/$pkgname-$_pkgver"

prepare() {
  (cd "$srcdir"/azure-c-shared-utility-$_azure_c_shared_utility_commit && patch ${patch_args:--p1} -i "$srcdir"/0001-c-utility-qnx_patch)

  mv "$srcdir"/azure-c-shared-utility-$_azure_c_shared_utility_commit/* "$builddir"/c-utility
  mv "$srcdir"/azure-umqtt-c-$_umqtt_commit/* "$builddir"/umqtt/
  mv "$srcdir"/azure-uamqp-c-$_uamqp_commit/* "$builddir"/uamqp/
  mv "$srcdir"/parson-$_parson_commit/* "$builddir"/deps/parson/
  mv "$srcdir"/azure-uhttp-c-$_uhttp_commit/* "$builddir"/deps/uhttp/
  mv "$srcdir"/RIoT-$_RIOT_commit/* "$builddir"/provisioning_client/deps/RIoT/
  mv "$srcdir"/azure-utpm-c-$_utpm_commit/* "$builddir"/provisioning_client/deps/utpm/
  mv "$srcdir"/macro-utils-c-$_azure_macro_utils_c_commit/* "$builddir"/deps/azure-macro-utils-c/
  mv "$srcdir"/umock-c-$_umock_c_commit/* "$builddir"/deps/umock-c/
  mv "$srcdir"/c-testrunnerswitcher-$_azure_c_testrunnerswitcher_commit/* "$builddir"/deps/azure-c-testrunnerswitcher/
  mv "$srcdir"/ctest-$_azure_ctest_commit/* "$builddir"/deps/azure-ctest/

  default_prepare
}

build() {
  CFLAGS="-Wno-unused-command-line-argument" \
  CXXFLAGS="-Wno-unused-command-line-argument" \
  LDFLAGS="-lz" \
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_DATADIR=/usr/lib \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=ON \
    -Duse_default_uuid=ON \
    -Dskip_samples=ON \
    -Drun_unittests=ON \
    -DQNX=1
  cmake --build build -j2
}

check() {
  ctest --test-dir build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}


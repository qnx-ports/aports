url="https://github.com/Azure/azure-iot-sdk-c"
arch="all"
license="MIT"
options="!check"
depends="libcurl"
depends_dev="libc++-dev curl-dev"
makedepends="
    $depends_dev
    cmake
    ninja
"
subpackages="$pkgname-dev"

# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=glfw
pkgver=3.4
pkgrel=1
pkgdesc="A multi-platform library for OpenGL, OpenGL ES, Vulkan, window and input"
url="https://github.com/glfw/glfw"
arch="all"
license="Zlib"
source="
$pkgname-$pkgver.tar.gz::https://github.com/glfw/glfw/archive/refs/tags/$pkgver.tar.gz
00-cmake.patch
01-egl_context.patch
input.h
"
subpackages="$pkgname-dbg $pkgname-dev"
makedepends="cmake ninja qnx-fd-notify-dev libxkbcommon-dev wayland-dev"
depends="libxkbcommon wayland qnx-fd-notify qnx-hid"


prepare() {
    default_prepare

	mkdir -p src/linux
	cp "$srcdir"/input.h src/linux
	ln -sf input.h src/linux/input-event-codes.h
}


build() {
    cmake -G Ninja -B build \
        -DGLFW_BUILD_X11=OFF \
        -DGLFW_BUILD_WAYLAND=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=MinSizeRel \
        -DGLFW_INSTALL=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DGLFW_BUILD_TESTS=OFF \
        -DGLFW_BUILD_EXAMPLES=OFF
        

    cmake --build build
}

check() {
	default_check
}

package() {
	DESTDIR="$pkgdir" cmake --install build 
}


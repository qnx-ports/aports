pkgname=godot
pkgver=4.4.1
pkgrel=1
pkgdesc="Multi-platform 2D and 3D game engine"
url="https://godotengine.org"
license="MIT"
# Only armv7 and x86_64 are tested, give other architectures a try
# build system is completely broken and refuses to detect anything correctly
arch="all"
makedepends="
    brotli-dev
    freetype-dev
    graphite-dev
    harfbuzz-dev
    icu-dev
    libogg-dev
    libpng-dev
    libtheora-dev
    libvorbis-dev
    libdecor-dev
    pcre2-dev
    zstd-dev
    zlib-dev
    opus-dev
    libwebp-dev
    clang
    qnx-screen-dev
    qnx-alsa-dev
    qnx-libslog2-dev
    gles-headers
    egl-headers
    libc++-dev
    scons
    python3-dev
    wayland-dev
    dbus-dev
    wayland-dev
    libxkbcommon-dev
    "
depends="
    brotli
    dbus
    freetype
    fontconfig
    graphite
    harfbuzz
    icu-libs
    libogg
    libpng
    libtheora
    libvorbis
    libdecor
    pcre2
    zstd
    zlib
    opus
    libwebp
    qnx-alsa
    ca-certificates-bundle
    wayland
"
subpackages="$pkgname-doc $pkgname-templates"
source="https://github.com/qnx-ports/godot-QNX/archive/refs/tags/qnx-$pkgver-r$pkgrel.tar.gz"
builddir="$startdir/src/godot-QNX-qnx-$pkgver-r$pkgrel"
_sconsflags="
    module_camera_enabled=false
    builtin_brotli=false
    builtin_freetype=false
    builtin_graphite=false
    builtin_harfbuzz=false
    builtin_libogg=false
    builtin_libtheora=false
    builtin_libpng=false
    builtin_libvorbis=false
    builtin_libwebp=false
    builtin_opus=false
    builtin_pcre2=false
    builtin_zlib=false
    builtin_zstd=false
    engine_update_check=false
    execinfo=false
    lto=none
    production=true
    system_certs_path=/etc/ssl/cert.pem
    use_sowrap=false
    speechd=false
    use_static_cpp=false
    alsa=true
    use_llvm=true
    tests=yes
    "

case "$CARCH" in
x86_64)
    _arch=x86_64
    ;;
aarch64)
    _arch=arm64
    # only builds on x86_64
    _sconsflags="$_sconsflags module_denoise_enabled=false"
    ;;
esac

build() {
    # Copy custom input.h to compatibility location
    if [ -f "$startdir/input-event-codes.h" ]; then
        cp "$startdir/input-event-codes.h" "$builddir/platform/linuxbsd/wayland/input-event-codes.h"
        echo "Copied input-event-codes.h to QNX compatibility directory"
    else
        echo "ERROR: input-event-codes.h not found in $startdir"
        return 1
    fi
    export BUILD_NAME="qnx_self_hosted"
    for _platform in linuxbsd qnx; do
        case "$_platform" in
        linuxbsd)
            _targets="editor template_debug template_release"
            _extra="x11=no wayland=yes"
            ;;
        qnx)
            _targets="template_debug template_release"
            _extra="x11=no wayland=no"
            ;;
        esac
        for target in $_targets; do
            scons -j"$(nproc)" \
                platform="$_platform" \
                target="$target" \
                arch="$CARCH" \
                CC=clang \
                CXX=clang++ \
                $_sconsflags \
                $_extra
        done
    done
}

check() {
    ./bin/godot.linuxbsd.editor.${_arch}.llvm --test --test-case-exclude="[JSON] Serialization,[String] Number to string,*[IP] resolve_hostname*"
}

package() {
    pkgdesc="$pkgdesc (GUI editor)"
    install -Dm644 misc/dist/linux/org.godotengine.Godot.desktop \
        -t "$pkgdir"/usr/share/applications/
    install -Dm644 misc/dist/linux/org.godotengine.Godot.appdata.xml \
        -t "$pkgdir"/usr/share/metainfo/
    install -Dm644 icon.png "$pkgdir"/usr/share/icons/hicolor/256x256/apps/godot.png
    install -Dm644 icon.svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/godot.svg
    install -Dm644 misc/dist/linux/godot.6 -t "$pkgdir"/usr/share/man/man6/
    install -Dm755 bin/godot.*linuxbsd.editor.* "$pkgdir"/usr/bin/godot
    install -Dm755 bin/godot.*qnx.template_release.* "$pkgdir"/usr/bin/godot-template-release-qnxscreen
    install -Dm755 bin/godot.*qnx.template_debug.* "$pkgdir"/usr/bin/godot-template-debug-qnxscreen
    install -Dm755 bin/godot.*linuxbsd.template_release.* "$pkgdir"/usr/bin/godot-template-release-wayland
    install -Dm755 bin/godot.*linuxbsd.template_debug.* "$pkgdir"/usr/bin/godot-template-debug-wayland
}

templates() {
    pkgdesc="$pkgdesc (templates)"
    depends="
        dbus
        fontconfig
        glib
        harfbuzz-icu
        libbz2
        libc++
        libdecor
        libiconv
        libintl
        libpcre2-32
        libsharpyuv
        libxkbcommon
        qnx-alsa
        qnx-egl
        qnx-gcc-libs
        qnx-gles
        qnx-io-sock
        qnx-libslog2
        qnx-screen
        wayland
        zlib-ng
        zstd-libs
        "
    amove usr/bin/*template*
}


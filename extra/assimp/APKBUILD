# Alpine-Contributor: Russ Webber <russ@rw.id.au>
# Alpine-Maintainer: Russ Webber <russ@rw.id.au>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=assimp
pkgver=6.0.2
pkgrel=0
pkgdesc="Open Asset Import Library imports and exports 3D model formats"
url="https://www.assimp.org/"
arch="all"
license="BSD-3-Clause"
depends="libc++ zlib-ng $pkgname-libs=$pkgver-r$pkgrel"
makedepends="
    cmake
    ninja
    zlib-ng-dev
    libc++-dev
    "
subpackages="$pkgname-dev $pkgname-libs"
source="https://github.com/assimp/assimp/archive/v$pkgver/assimp-v$pkgver.tar.gz"

build() {
     # Clang does not support fortify source on QNX
    _extra_flags="-U_FORTIFY_SOURCE -D_LARGEFILE64_SOURCE=1"
    _warn="-Wno-character-conversion"

    export CC=clang
    export CXX=clang++
    export CFLAGS="$_extra_flags $_warn"
    export CXXFLAGS="$_extra_flags $_warn"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=MinSizeRel \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=True \
        -DASSIMP_IGNORE_GIT_HASH=ON \
        -DASSIMP_BUILD_ASSIMP_TOOLS=ON \
        -DASSIMP_BUILD_TESTS="$(want_check && echo ON || echo OFF)" \
        -DASSIMP_WARNINGS_AS_ERRORS=OFF \
        -DASSIMP_BUILD_MINIZIP=True  # use vendored fork of minizip
    cmake --build build
}

libs() {
    default_libs
    depends="libc++ zlib-ng"
}

check() {
    ./build/bin/unit
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
dc9637b183a1ab4c87d3548b1cacf4278fc5d30ffa4ca35436f94723c20b916932791e8e2c2f0d2a63786078457e61a42fb7aac8462551172f7f5bd2582ad9a9  assimp-v6.0.2.tar.gz
"

# Maintainer: Narayana Murthy Naidu <nnarayanamurthy@qnx.com>

pkgname=urdfdom-headers
pkgver=3.0.1
pkgrel=0
pkgdesc="Headers for URDF parsers"
url="https://github.com/ros/urdfdom_headers"
arch="noarch"
license="BSD-3-Clause"
options="!check" # Upstream does not provide a test suite

makedepends="
	cmake
	libc++-dev
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/ros/urdfdom_headers/archive/refs/tags/$pkgver.tar.gz
	qnx-strtodouble.patch
	"
builddir="$srcdir/urdfdom_headers-$pkgver"

build() {
	cmake -S . -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_DATAROOTDIR=share
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="

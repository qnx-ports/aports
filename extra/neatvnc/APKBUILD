# Alpine-Contributor: Michał Polański <michal@polanski.me>
# Alpine-Maintainer: Michał Polański <michal@polanski.me>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=neatvnc
pkgver=1.0.0
pkgrel=0
pkgdesc="A liberally licensed VNC server library with a clean interface"
url="https://github.com/any1/neatvnc"
license="ISC"
arch="all"
options="!check" # no test suite
depends="
	aml
	ffmpeg
	libjpeg-turbo
	libuv
	qnx-screen
	qnx-libdrm
	pixman
	zlib
"
depends_dev="
	aml-dev
	ffmpeg-dev
	libjpeg-turbo-dev
	libuv-dev
	qnx-screen-dev
	qnx-libdrm-dev
	pixman-dev
	zlib-dev
"
makedepends="
    $depends_dev
	meson
	"
subpackages="$pkgname-dbg $pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/any1/neatvnc/archive/v$pkgver.tar.gz
  qnx-IOV_MAX.patch
"

build() {
    export CFLAGS="$CFLAGS -DMIN=min -DMAX=max"
    export LDFLAGS="$LDFLAGS -lsocket"
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}




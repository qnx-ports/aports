# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=gdb
pkgver=14.2
pkgrel=1
pkgdesc="The GNU Debugger"
url="https://www.gnu.org/software/gdb/"
arch="all"
license="GPL-3.0-or-later AND LGPL-3.0-or-later"
depends="!qnx-gdb
    gmp
    libc++
    libexpat
    mpfr
    ncurses
    qnx-io-sock
    readline
    xz-libs
    zlib-ng
    zstd-libs
"
makedepends="
    autoconf
    automake
    flex
    bison
    diffutils
    texinfo
    expat-dev
    gmp-dev
    libtool
    mpfr-dev
    ncurses-dev
    perl
    python3-dev
    readline-dev
    texinfo
    xz-dev
    zlib-dev
    zstd-dev
    qnx-io-sock-dev
    libc++-dev
    "
options="!check"
subpackages="$pkgname-dbg $pkgname-doc"
source="https://ftp.gnu.org/gnu/gdb/gdb-$pkgver.tar.xz
        0001-qnx-gdb-changes.patch
	0002-qnx-fix-registers.patch
    "

build() {
    _common_flags="-D__QNXTARGET__ -ggdb -O2 -Qunused-arguments"

    export CC="clang"
    export CXX="clang++"
    export CFLAGS="$CFLAGS $_common_flags -std=gnu11"
    export CXXFLAGS="$CXXFLAGS $_common_flags -std=gnu++17"

    ./configure  \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        \
        --with-pic \
        --with-lzma \
        --with-mpfr=/usr \
        --with-python=/usr/bin/python3 \
        --with-expat=yes \
        --with-system-zlib \
        --with-system-readline \
        \
        --enable-gdbmi \
        --enable-plugins \
        --enable-fix-cortex-a53-843419 \
        --enable-fix-cortex-a53-835769 \
        \
        --disable-nls \
        --disable-werror \
        --disable-binutils \
        --disable-gas \
        --disable-gold \
        --disable-gprof \
        --disable-ld

    make
}

package() {
    make DESTDIR="$pkgdir" install

    # resolve conflict with binutils-doc
    rm -f "$pkgdir"/usr/share/info/bfd.info
    rm -f "$pkgdir"/usr/share/info/ctf-spec.info
    rm -f "$pkgdir"/usr/share/info/dir

    # those are provided by binutils
    rm -rf "$pkgdir"/usr/include
    rm -rf "$pkgdir"/usr/lib

    # resolve conflict with binutils-doc
    rm "$pkgdir"/usr/share/info/sframe-spec.info
}


# Alpine-Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=xtensor
pkgver=0.25.0
pkgrel=0
pkgdesc="C++ tensors with broadcasting and lazy computing"
url="https://github.com/xtensor-stack/xtensor"
arch="noarch"
license="BSD-3-Clause"
depends="xtl"
makedepends="cmake ninja doctest-dev nlohmann-json libc++-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/xtensor-stack/xtensor/archive/refs/tags/$pkgver.tar.gz"
options="!check"
build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DBUILD_TESTS="OFF"
	cmake --build build
}

check() {
	cd build
	ctest
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}



sha512sums="

# Alpine-Contributor: Łukasz Jendrysik 
# Alpine-Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net> 
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: J. Scaffidi <jscaffidi@qnx.com>
pkgname=chrony
pkgver=4.8
pkgrel=2
pkgdesc="Advanced NTP client and server"
url="https://gitlab.com/chrony/chrony/"
arch="all"
license="GPL-2.0-or-later"
pkgusers="$pkgname"
pkggroups="$pkgname"
tag="$pkgver"
install="$pkgname.pre-install $pkgname.pre-upgrade $pkgname.post-install"
builddir="$srcdir"/$pkgname
#TODO add docs subpkg when we get an asciidoctor port
subpackages="$pkgname-openrc $pkgname-dbg"
depends="qnx-io-sock nettle gnutls"
makedepends="bison make clang qnx-io-sock-dev nettle-dev gnutls-dev"
source="
$pkgname-$pkgver.tar.gz::https://gitlab.com/chrony/chrony/-/archive/$tag/chrony-$tag.tar.gz?ref_type=tags
00-build-patches.patch
01-sys-c.patch
02-sysincl.patch
03-tests.patch
04-getsockname-fix.patch
05-client-socket.patch
sys_qnx.c
sys_qnx.h
adjtime_qnx.h
chrony.conf
chronyd.confd
chronyd.initd
"


unpack() {
    default_unpack
    # Makes tests pass because QNX saddr_un.sun_path contains absolute paths, and when it gets capped at 104 chars, doesn't nul-terminate it so it breaks a bunch of stuff yay
    # This makes the path shorter by removing the long commit sha. This might bite us later if we have a build system with a long path.
    mv "$srcdir/$pkgname-$tag" "$srcdir/$pkgname"
}

prepare() {
    default_prepare
    cp $srcdir/sys_qnx.c $srcdir/sys_qnx.h $srcdir/adjtime_qnx.h .
}

build() {
    export CC=clang
    export CFLAGS=" -Wno-deprecated-non-prototype"
    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc/$pkgname \
        --chronyrundir=/run/$pkgname \
        --with-pidfile=/run/$pkgname/chronyd.pid \
        --with-user=$pkgname \
        --enable-ntp-signd
    make 
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install

    install -dm2750 -g wheel "$pkgdir"/var/log/chrony
    install -Dm755 "$srcdir"/chronyd.initd "$pkgdir"/etc/init.d/chronyd
    install -Dm644 "$srcdir"/chronyd.confd "$pkgdir"/etc/conf.d/chronyd

    mkdir -p "$pkgdir"/var/lib/chrony \
        "$pkgdir"/etc/chrony

    install -m644 "$srcdir"/chrony.conf "$pkgdir"/etc/chrony/chrony.conf
}


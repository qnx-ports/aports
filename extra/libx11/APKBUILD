# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=libx11
pkgver=1.8.13
pkgrel=0
pkgdesc="X11 client-side library"
url="https://xorg.freedesktop.org/"
arch="all"
license="X11"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc $pkgname-dbg"
depends="qnx-io-sock libxcb"
depends_dev="libxcb-dev xtrans xorgproto"
makedepends="$depends_dev xorgproto util-macros xmlto qnx-io-sock-dev"
source="https://www.x.org/releases/individual/lib/libX11-$pkgver.tar.xz"
builddir="$srcdir"/libX11-$pkgver

build() {
	RAWCPP="/usr/bin/clang-cpp" \
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-xf86bigfont
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}

sha512sums="
4c4a098eaff09a51309f3f322bc435ccd022c8f753974eb2650b60e42b737077ca0fde0df82b53f4ba8ed2388bbc8cb59ba66cc9946ae2b5907d7d1a9580e03d  libX11-1.8.13.tar.xz
"


adb37e609a794b2c06e15fcb0edb4c4fa4eb89e39bd2c81bb45010cfdaf46711035dc8ab3fd274231c6132eb91cd8b4247a3637ef0a2ce5f1e73452f6b38b6f8  add_qnx_support.patch
"

# Maintainer: Vratislav Podzimek <vratislav.podzimek@nothern.tech>
pkgname=mender
pkgver=5.2.0
pkgrel=0
pkgdesc="Mender client"
url="https://mender.io"
arch="all"
license="Apache-2.0"
depends="
    boost
    libarchive
    libc++
    libcrypto3
    libssl3
    qnx-gcc-libs
    qnx-io-sock
"
makedepends="cmake make pkgconf gtest-dev boost-dev libarchive-dev openssl-dev qnx-io-sock-dev"
subpackages=""
source="
    https://github.com/mendersoftware/mender/releases/download/$pkgver/$pkgname-$pkgver.tar.gz
    0001-single-junit-xml.patch
    0002-allow-skipping-network-based-test.patch
"
builddir="$srcdir/$pkgname-$pkgver"

build() {
    CXXFLAGS="-Wno-unused-command-line-argument -DSA_RESTART=0" cmake . \
      -DCMAKE_GENERATOR="Unix Makefiles" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DMENDER_VERSION="$pkgver" \
      -DMENDER_DOWNLOAD_GTEST=OFF \
      -DMENDER_USE_DBUS=OFF -DMENDER_EMBED_MENDER_AUTH=ON -DMENDER_USE_LMDB=OFF \
      -DMENDER_TEST_SKIP_ASYNC_FIFO_OPENER_TESTS=ON -DMENDER_TEST_SKIP_NOFILE_BASED_TESTS=ON -DMENDER_TEST_SKIP_NETWORK_BASED_TESTS=ON \
      -DMENDER_TEST_RUN_SEQUENTIALLY=ON
    make
}

check() {
    make check
}

package() {
    DESTDIR="$pkgdir" cmake --install . --prefix=/usr
    DESTDIR="$pkgdir" cmake --install . --prefix=/ --component mender-conf
    DESTDIR="$pkgdir" cmake --install . --prefix=/ --component mender-state-dir
    DESTDIR="$pkgdir" cmake --install . --prefix=/ --component mender-device-type
}


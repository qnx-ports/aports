pkgname=patchelf
pkgver=0.19.3
pkgrel=0
pkgdesc="Small utility to modify the dynamic linker and RPATH of ELF executables"
url="https://nixos.org/patchelf.html"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	libc++-dev
	qnx-microkernel-dev
	qnx-io-sock-dev
"
subpackages="$pkgname-doc $pkgname-zsh-completion"
source="$pkgname-$pkgver-2.tar.gz::https://github.com/NixOS/patchelf/releases/download/$pkgver/patchelf-$pkgver.tar.gz
	001-elf_h.patch
	"

build() {
	./configure \
		--prefix=/usr
	make
}

check() {
	# Following tests fail, which may be due to modifying file,
	# investigation to be done
	# - plain-run.sh
	# - shrink-rpath.sh
	# - set-interpreter-long.sh
	# - set-rpath.sh
	# - add-rpath.sh
	# - no-rpath.sh
	# - big-dynstr.sh
	# - set-rpath-library.sh
	# - output-flag.sh
	# - grow-file.sh
	# - replace-add-needed.sh
	# - build-resolution-cache.sh
	# - build-resolution-cache-symtab.sh
	# - repeated-updates.sh
	# - rename-dynamic-symbols.sh
	# - set-interpreter-same.sh
	# - property-rewrite.sh

	make -C tests -j1 check || true
}

package() {
	make DESTDIR="$pkgdir" install
}



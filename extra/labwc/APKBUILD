# Contributor: Patrycja Rosa <alpine@ptrcnull.me>
# Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
pkgname=labwc
pkgver=0.20.1
pkgrel=0
pkgdesc="Wayland stacking compositor"
url="https://github.com/labwc/labwc"
arch="all"
license="GPL-2.0-only"
depends="wlroots glib cairo libxml2 pango libsfdo"
makedepends="
	cairo-dev
	glib-dev
	libxml2-dev
	meson
	pango-dev
	scdoc
	wayland-protocols
	wlroots0.20-dev
	libsfdo-dev
	qnx-fd-notify-dev
	"
subpackages="$pkgname-doc $pkgname-lang"
source="https://github.com/labwc/labwc/archive/$pkgver/labwc-$pkgver.tar.gz
	remove-aports-git-version.patch
	input-event-codes.h
	qnx-fix.patch
	"

prepare() {
	default_prepare
	mkdir -p "$builddir"/linux
	ln -s ""$srcdir/"input-event-codes.h" "$builddir/linux/input-event-codes.h"
}

build() {
	abuild-meson . output -Dman-pages=enabled -Dc_link_args="-ltimerfd -lsignalfd"
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}



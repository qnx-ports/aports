a04aeb27309c6482ce06c81237ea50e3111fa944401da11f66b8c7a8fee3b51e6af0f13fb06fc6196d5bdbf29a39d36ab46f5cdc7cdd6b4a64ac9cb8763f20fa  use-any-simdjson-version.patch
"

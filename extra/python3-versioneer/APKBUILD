# Alpine-Contributor: Bart Ribbers <bribbers@disroot.org>
# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Deep Chordia <dchordia@qnx.com>
pkgname=python3-versioneer
pkgver=0.29
pkgrel=0
pkgdesc="Version-string management for VCS-controlled trees"
url="https://github.com/python-versioneer/python-versioneer"
arch="noarch"
license="Unlicense"
depends="python3"
makedepends="
    python3-setuptools
    python3-dev
    python3-gpep517
    "
checkdepends="python3-pytest"
source="
    $pkgname-$pkgver.tar.gz::https://github.com/python-versioneer/python-versioneer/archive/refs/tags/$pkgver.tar.gz
    0001-add-qnx-build.patch
    "
builddir="$srcdir/python-versioneer-$pkgver"

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    cp "$builddir/build/lib/versioneer.py" .
    python3 -m venv --clear --without-pip --system-site-packages .testenv
	  .testenv/bin/python3 -m installer .dist/*.whl
	  .testenv/bin/python3 -m pytest -k "not case_mixin and not test_pyproject" --ignore=test/git/test_invocations.py # omitted ones are problem causing tests
}

package() {
    python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="

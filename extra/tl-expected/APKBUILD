# Alpine-Contributor: Leo <thinkabit.ukim@gmail.com>
# Alpine-Maintainer: qaqland <qaq@qaq.land>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=tl-expected
pkgver=1.3.1
_catch2_v2_ver=2.13.10
pkgrel=1
pkgdesc="C++11/14/17 std::expected with functional-style extensions"
url="https://tl.tartanllama.xyz/"
arch="noarch"
license="CC0-1.0"
depends="libc++"
makedepends="cmake ninja libc++-dev"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/TartanLlama/expected/archive/refs/tags/v$pkgver.tar.gz
	catch2-$_catch2_v2_ver.tar.gz::https://github.com/catchorg/Catch2/archive/refs/tags/v$_catch2_v2_ver.tar.gz
"
builddir="$srcdir/expected-$pkgver"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DFETCHCONTENT_SOURCE_DIR_CATCH2="$srcdir/Catch2-$_catch2_v2_ver" \
		-DEXPECTED_BUILD_TESTS=ON

	cmake --build build
}

check() {
	"$builddir"/build/tl-expected-tests --success
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	mkdir -p "$pkgdir"/usr/lib
	mv "$pkgdir"/usr/share/cmake "$pkgdir"/usr/lib
}



sha512sums="

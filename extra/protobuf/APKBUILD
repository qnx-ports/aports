# Alpine-Contributor: Sheila Aman <sheila@vulpine.house>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Elliott Mazzuca <emazzuca@qnx.com>
pkgname=protobuf
pkgver=31.1
pkgrel=0
pkgdesc="Library for extensible, efficient structure packing"
url="https://github.com/protocolbuffers/protobuf"
arch="all" # binary splits are arch-specific; top-level metapackage overrides to noarch in package()
license="BSD-3-Clause"
# QNX abuild records Abseil .needs-so entries but does not resolve them to APK
# package dependencies. The explicit >= floor below prevents older Abseil
# installs, but it is not a soname guarantee; rebuild protobuf and bump this
# floor when Abseil upgrades.
_abseil_ver=20250814.1
depends="
	protoc=$pkgver-r$pkgrel
	libprotoc=$pkgver-r$pkgrel
	libprotobuf=$pkgver-r$pkgrel
	libprotobuf-lite=$pkgver-r$pkgrel
	"
# protoc is part of the protobuf development interface: downstream CMake
# consumers may use the exported protobuf::protoc target with these headers.
# This package builds protoc from source; no installed protoc is used by Ninja.
depends_dev="
	abseil-cpp-dev>=$_abseil_ver
	protoc=$pkgver-r$pkgrel
	zlib-dev
	"
makedepends="
	$depends_dev
	cmake
	ninja
	qnx-io-sock-dev
	"
checkdepends="gtest-dev"
subpackages="
	$pkgname-dev::all
	$pkgname-vim::noarch
	protoc::all
	libprotoc::all
	libprotobuf::all
	libprotobuf-lite::all
	libutf8-range:_utf8_range:all
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/protocolbuffers/protobuf/archive/refs/tags/v$pkgver.tar.gz
	soversion.patch
	fix-tests.patch
	0001-qnx-fix-protoc-abs-path.patch
	0002-qnx-fix-protobuf-absl-log-header.patch
	"

build() {
	export CFLAGS="$CFLAGS -DNDEBUG -O2"
	export CXXFLAGS="$CXXFLAGS -DNDEBUG -O2 -Wno-deprecated-declarations"
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_EXE_LINKER_FLAGS="-lsocket" \
		-Dprotobuf_BUILD_TESTS="$(want_check && echo ON || echo OFF)" \
		-Dprotobuf_BUILD_LIBPROTOC=ON \
		-Dprotobuf_ALLOW_CCACHE=ON
	cmake --build build
}

check() {
	# TextFormatTest.PrintFloatPrecision and PrintFieldsInIndexOrder fail due to
	# QNX libc printf producing different IEEE 754 rounding from glibc in edge
	# cases. Same float precision root cause as the Abseil charconv exclusions.
	export GTEST_FILTER='-TextFormatTest.PrintFloatPrecision:TextFormatTest.PrintFieldsInIndexOrder'
	ctest --test-dir "$builddir"/build
}

package() {
	# The top-level package only depends on the binary splits after libutf8-range
	# is moved out below. Mark just this metapackage noarch; binary/dev splits
	# stay arch-specific through their explicit :all subpackage annotations.
	pkgarch="noarch"

	DESTDIR="$pkgdir" cmake --install build

	sed -i \
		-e "/Requires:/s|;| |g" \
		-e "/Requires:/s|::|_|g" \
		"$pkgdir"/usr/lib/pkgconfig/protobuf.pc

	install -Dm644 editors/proto.vim \
		"$pkgdir"/usr/share/vim/vimfiles/syntax/proto.vim
}

vim() {
	pkgdesc="Vim syntax for $pkgname"
	depends=""
	install_if="$pkgname=$pkgver-r$pkgrel vim"

	amove usr/share/vim/vimfiles/syntax/proto.vim
}

# libutf8-range is a protobuf-internal split built from this same source
# tarball. Keep protobuf split dependencies tied to $pkgver-r$pkgrel so the
# internal library moves in lockstep with protobuf package revisions.
libprotoc() {
	depends="abseil-cpp>=$_abseil_ver libc++ libprotobuf=$pkgver-r$pkgrel libutf8-range=$pkgver-r$pkgrel"
	pkgdesc="Runtime library for Protocol Buffer compiler"

	amove usr/lib/libprotoc.so.*
}

protoc() {
	depends="abseil-cpp>=$_abseil_ver libc++ libprotoc=$pkgver-r$pkgrel libprotobuf=$pkgver-r$pkgrel libutf8-range=$pkgver-r$pkgrel qnx-io-sock"
	pkgdesc="Protocol buffer compiler binary and library"

	amove usr/bin/protoc*
}

libprotobuf() {
	depends="abseil-cpp>=$_abseil_ver libc++ libutf8-range=$pkgver-r$pkgrel zlib-ng"  # zlib-ng provides libz.so on QNX
	pkgdesc="Runtime library for C++ users of protocol buffers"

	amove usr/lib/libprotobuf.so.*
}

lite() {
	depends="abseil-cpp>=$_abseil_ver libc++ libutf8-range=$pkgver-r$pkgrel"
	pkgdesc="Runtime library for C++ users with 'lite runtime' setting of protocol buffers"

	amove usr/lib/libprotobuf-lite.so.*
}

_utf8_range() {
	depends=""
	pkgdesc="UTF-8 range library used by protobuf"

	amove usr/lib/libutf8_range.so.*
	amove usr/lib/libutf8_validity.so.*
}


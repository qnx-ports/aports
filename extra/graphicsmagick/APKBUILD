f352efbbd8cca4a77d5e8bfd53df1dd70bf7c8343d09e5fa7fd4a168544fd862301dfe0cf6d7ebd718ef93f21bba40ceaa75ab032972aaaaaff9fb21e21fc4e0  0001-qnx-fix.patch
"

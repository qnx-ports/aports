builddir="$srcdir/ros2-control"
depends="ros2-jazzy python3-filelock python3-numpy fmt"
makedepends="
        ros2-jazzy
        boost-dev
        asio-dev
        tinyxml2-dev
        eigen-dev
        qnx-fs-notify-dev
        qnx-fs-core-dev
        qnx-fs-gpt-dev
        liblocale-shim-dev
        python3-dev
        python3-pip
        python3-numpy
        python3-numpy-dev
        python3-jinja2
        python3-typeguard
        cmake
        ninja
        fmt-dev
        curl-dev
        tl-expected
"

unpack() {
    mkdir -p "$builddir"/src
    cd "$builddir"
    find "$srcdir" -name "*.tar.gz" -print0 | while IFS= read -r -d '' tar_f; do
        # Extract to not have the version in the name
        file_name=$(basename "$tar_f")
        file_prefix=$(echo "$file_name" | sed 's/\.tar.gz//' )
        mkdir -p src/"$file_prefix"
        tar -xf "$tar_f" --strip-component=1 -C src/"$file_prefix"
    done
    
}

prepare() {
        cd "$builddir"
        _apply_qnx_patch() {
                local _dir="$1"
                local _patch="$2"
                git -C "$builddir/$_dir" apply --whitespace=nowarn "$srcdir/$_patch"
        }
        _apply_qnx_patch ./src/realtime_tools realtime_tools.patch
        _apply_qnx_patch ./src/ros2_control_demos ros_control_demo_remove_rviz.patch
}

build() {
        cd "$builddir"
        COLCON_CURRENT_PREFIX="/opt/ros/jazzy/" source /opt/ros/jazzy/local_setup.sh
        colcon build --merge-install \
                --cmake-args \
                        -G Ninja \
                        -DBUILD_TESTING=OFF \
                        -DCMAKE_BUILD_TYPE=Release \
                        -DCMAKE_C_FLAGS="-Qunused-arguments -DSA_RESTART=0 -ggdb --no-warnings" \
                        -DCMAKE_CXX_FLAGS="-Qunused-arguments -DSA_RESTART=0 -ggdb --no-warnings" \
                        -DCMAKE_EXE_LINKER_FLAGS="-lsocket -lfsnotify -lc++ -lc++abi -Wl,-E" \
                        -DCMAKE_SHARED_LINKER_FLAGS="-lsocket -lfsnotify -lc++ -lc++abi -Wl,-E" \
                        -DTRACETOOLS_TRACEPOINTS_EXCLUDED=ON \
                        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
                        --packages-skip kinematics_interface_pinocchio generate_parameter_module_example
}

package() {
        dest="/opt/ros/jazzy"
        mkdir -p "$pkgdir"/$dest
        cp -a "$builddir"/install/. "$pkgdir"/$dest

        # Remove files we don't want in our final package
        for _f in  COLCON_IGNORE .colcon_install_layout _local_setup_util_ps1.py local_setup.ps1 setup.ps1 _local_setup_util_sh.py local_setup.bash local_setup.bash local_setup.sh local_setup.zsh setup.bash setup.sh setup.zsh; do
            [[ -f "$pkgdir"/$dest/$_f ]] && rm "$pkgdir"/$dest/$_f
        done
}


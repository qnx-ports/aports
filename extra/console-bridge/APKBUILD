# Alpine-Maintainer: Russ Webber <russ@rw.id.au>
# Maintainer: Narayana Murthy Naidu <nnarayanamurthy@qnx.com>
pkgname=console-bridge
pkgver=1.0.2
pkgrel=0
pkgdesc="Lightweight logging bridge for C++ applications"
url="https://github.com/ros/console_bridge"
arch="all"
license="BSD-3-Clause"
depends="libc++"
makedepends="
	cmake
	libc++-dev
"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/ros/console_bridge/archive/refs/tags/$pkgver.tar.gz
	cmake-install-dir.patch
	no-downloads.patch
	"
builddir="$srcdir/console_bridge-$pkgver"

build() {
	cmake -B build -S . \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_TESTING=ON

	cmake --build build
}

check() {
	ctest --test-dir build --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}


# Alpine-Contributor: omni <omni+alpine@hack.org>
# Alpine-Maintainer: messense <messense@icloud.com>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=maturin
pkgver=1.14.1
pkgrel=0
pkgdesc="Build and publish crates with pyo3, rust-cpython and cffi bindings"
url="https://github.com/PyO3/maturin"
arch="all"
license="Apache-2.0 OR MIT"
makedepends="
	bzip2-dev
	cargo
	rust
	dbus-dev
	openssl-dev
	python3-gpep517
	python3-setuptools
	python3-setuptools-rust
	python3-wheel
	qnx-io-sock-dev
	"
checkdepends="
	cargo-nextest
	libffi-dev
	patchelf
	python3-cffi
	python3-virtualenv
	python3-dev
	"
subpackages="
	python3-$pkgname:py3:noarch
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/PyO3/maturin/archive/refs/tags/v$pkgver.tar.gz
	001-mod_rs.patch
	002-platform_tag_rs.patch
	003-ring_rs.patch
	005-rustix_rs.patch
	004-getrandom_rs.patch
	006-filetime_rs.patch
	007-target_lexicon_rs.patch
	008-memmap2_rs.patch
	009-platform_info_rs.patch
	010-errno_rs.patch
	011-cargo_toml.patch
	config.toml
	"
options="!check net"

prepare() {
	cargo update -p rustix --precise 1.1.5
	cargo update -p libc --precise 0.2.189

	mkdir -p .cargo
	cp "$srcdir"/config.toml .cargo

	patch -p1 -i "$srcdir"/011-cargo_toml.patch

	cargo vendor vendor

	patch -p1 -i "$srcdir"/001-mod_rs.patch
	patch -p1 -i "$srcdir"/002-platform_tag_rs.patch
	patch -p1 -i "$srcdir"/005-rustix_rs.patch
	patch -p1 -i "$srcdir"/004-getrandom_rs.patch
	patch -p1 -i "$srcdir"/003-ring_rs.patch
	patch -p1 -i "$srcdir"/006-filetime_rs.patch
	patch -p1 -i "$srcdir"/007-target_lexicon_rs.patch
	patch -p1 -i "$srcdir"/008-memmap2_rs.patch
	patch -p1 -i "$srcdir"/009-platform_info_rs.patch
	patch -p1 -i "$srcdir"/010-errno_rs.patch

	# Update the checksum of each .cargo-checksum.json
	list="
	    vendor/rustix
	    vendor/getrandom
	    vendor/getrandom-0.2.17
	    vendor/ring
	    vendor/filetime
	    vendor/target-lexicon
	    vendor/memmap2
	    vendor/platform-info
	    vendor/errno
	"

	for root in $list; do
	    ROOT="$root" python3 - <<'PY'
import hashlib
import json
import os
from pathlib import Path

root = Path(os.environ["ROOT"])
checksum_file = root / ".cargo-checksum.json"

data = json.loads(checksum_file.read_text())

for file in data["files"]:
    path = root / file
    if path.is_file():
        data["files"][file] = hashlib.sha256(path.read_bytes()).hexdigest()

checksum_file.write_text(json.dumps(data, separators=(",", ":")) + "\n")
print(f"Updated: {root}")
PY
	done

	cargo fetch
}

build() {
	export _features="--features=native-tls,password-storage,rustls,cli-completion,scaffolding,upload,sbom"

	export OPENSSL_NO_VENDOR=1
	export MATURIN_SETUP_ARGS="
		--no-default-features
		$_features
	"
	export CARGO_PROFILE_RELEASE_LTO=false
	export RUSTFLAGS="-L native=/usr/lib"

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	./target/release/maturin completions bash > $pkgname.bash
	./target/release/maturin completions fish > $pkgname.fish
	./target/release/maturin completions zsh > $pkgname.zsh
}

check() {
	export OPENSSL_NO_VENDOR=1

	cargo nextest run \
	  --frozen \
	  --no-default-features "$_features" \
	  --no-fail-fast \
	  -E "$_test_filter"
}

package() {
	install -Dm644 $pkgname.bash "$pkgdir"/usr/share/bash-completion/completions/$pkgname
	install -Dm644 $pkgname.fish "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
	install -Dm644 $pkgname.zsh "$pkgdir"/usr/share/zsh/site-functions/_$pkgname

	python3 -m installer -d "$pkgdir" \
		.dist/maturin*.whl
}

py3() {
	pkgdesc="$pkgdesc (python module)"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove usr/lib/python3*
}



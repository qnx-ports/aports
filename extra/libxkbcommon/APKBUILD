pkgname=libxkbcommon
pkgver=1.8.0
pkgrel=3
pkgdesc="keyboard handling library"
url="https://xkbcommon.org/"
arch="all"
#options="!check"
license="MIT AND MIT-open-group AND HPND AND HPND-sell-variant AND LicenseRef-digital-equipment-corporation"
depends="xkeyboard-config libx11 qnx-io-sock libxml2"
depends_dev="$pkgname=$pkgver-r$pkgrel libx11-dev"
makedepends="
    bison
    libxml2-dev
    meson
    ninja 
    pkgconf
    pkgconf-dev
    wayland-dev
    wayland-protocols
    xkeyboard-config-dev
    qnx-io-sock-dev
    "
subpackages="
    $pkgname-static
    $pkgname-doc
    $pkgname-dev
    xkbcli
    xkbcli-bash-completion
    "
source="https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-$pkgver.tar.gz
    0001-fix-null-handling.patch
    0002-sync-test-data.patch
    0004-Do-not-sync-locale.patch
    0005-fix-more-null-string.patch
    "
builddir="$srcdir/libxkbcommon-xkbcommon-$pkgver"

build() {
    abuild-meson  \
        -Dc_link_args="-Wl,-lm" \
        -Denable-wayland=true \
        -Denable-docs=false \
        -Denable-x11=false \
        -Ddefault_library=both \
        -Ddefault-rules=hidut \
	build

    meson compile -C build
}

check() {
    chmod +x ./test/data/sync.sh
    ./test/data/sync.sh

    LD_LIBRARY_PATH="$builddir/build":$LD_LIBRARY_PATH \
    meson test --print-errorlogs -C build || msg "Linux evdev related tests fail as expected"
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

xkbcli() {
    pkgdesc="xkb command-line tool with interactive debugger"
    depends="$pkgname=$pkgver-r$pkgrel wayland"

    amove usr/bin/xkbcli
    amove usr/lib/xkbcommon/xkbcli*
}

xkbcli_doc() {
    # ... and run default_doc here to let abuild process man pages
    default_doc
    pkgdesc="xkb command-line tool with interactive debugger (documentation)"
    install_if="docs xkbcli=$pkgver-r$pkgrel"
}

bashcomp() {
    default_bashcomp

    pkgdesc="Bash completions for xkbcli"
    install_if="xkbcli=$pkgver-r$pkgrel bash-completion"
}




 #define JACK_SEMAPHORE_KEY 0x282929
 #ifndef USE_POSIX_SHM
 #define JACK_SHM_REGISTRY_KEY JACK_SEMAPHORE_KEY
 #endif
 
+#ifdef __QNX__
+static sem_t *sem = NULL;
+#else
 static int semid = -1;

-#ifdef WIN32
+#if defined(WIN32)
 
 #include <psapi.h>
 #include <lmcons.h>
 
 static BOOL check_process_running(DWORD process_id)
 {
@@ -180,12 +187,56 @@
 static int
 semaphore_init () {return 0;}
 
 static  int

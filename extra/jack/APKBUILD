# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=jack
pkgver=1.9.22
pkgrel=0
pkgdesc="The Jack Audio Connection Kit"
url="https://jackaudio.org/"
arch="all"
license="GPL-2.0-or-later"
depends="qnx-alsa qnx-io-sock libsysv-ipc-shim opus dbus libc++"
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends="
    qnx-alsa-dev
    qnx-io-sock-dev
    dbus-dev
    expat-dev
    libsamplerate-static
    libsamplerate-dev
    libsndfile-dev
    libsysv-ipc-shim-dev
    ncurses-dev
    opus-dev
    python3
    readline-dev
    libc++-dev
    "
subpackages="$pkgname-dev $pkgname-doc $pkgname-dbus"
source="https://github.com/jackaudio/jack2/archive/v$pkgver/jack2-v$pkgver.tar.gz
    qnx-IS_QNX.patch
    qnx-named-sem.patch
    qnx-SA_RESTART.patch
    fix-execinfo.patch
    increase-api-version.patch
    importlib.patch
    "
builddir="$srcdir/jack2-$pkgver"
#options="!check" # Check depends on an existing jack installation.

build() {
    export CPPFLAGS="$CPPFLAGS -I/usr/include/shims -D_QNX_SOURCE -Qunused-arguments"
    export LDFLAGS="$LDFLAGS -lsocket"

    ./waf configure \
        --prefix=/usr \
        --mandir=/usr/share/man/man1 \
        --libdir=/usr/lib \
        --dbus \
        --alsa \
        --classic \
        "$(want_check && echo --tests || echo --no-tests)"

    ./waf build -v
}

check() {
    export JACK_CLIENT_DEBUG=on
    ./build/tests/jack_test
    ./build/tests/jack_cpu
    ./build/tests/jack_iodelay
    ./build/tests/jack_multiple_metro
}

package() {
    ./waf --destdir="$pkgdir" install
}

dbus() {
    pkgdesc="Jack D-Bus launcher"
    depends="dbus libexpat opus"

    amove usr/bin/jackdbus
    amove usr/share/dbus*
}


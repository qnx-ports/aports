pkgname=linenoise
pkgver=2.0
pkgrel=0
pkgdesc="Minimal replacement for readline and libedit"
url="https://github.com/antirez/linenoise"
arch="all"
license="BSD-2-Clause"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/antirez/linenoise/archive/refs/tags/$pkgver.tar.gz
	build-shared-lib.patch
	"
depends="libc++"
makedepends="
	libc++-dev
	qnx-io-sock-dev
	"
build() {
	make
}

check() {
    ./linenoise-test
}

package() {
	make DESTDIR="$pkgdir" install
}


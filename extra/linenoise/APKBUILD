pkgname=linenoise
pkgver=2.0
pkgrel=0
pkgdesc="Minimal replacement for readline and libedit"
url="https://github.com/antirez/linenoise"
arch="all"
options="!check"  # No test suite.
license="BSD-2-Clause"
subpackages="$pkgname-dev"
source="linenoise-$pkgver.tar.gz::https://github.com/antirez/linenoise/archive/archive/refs/tags/$pkgver.tar.gz
	build-shared-lib.patch
	"
depends="libc++"
makedepends="
libc++-dev
qnx-io-sock-dev
"

build() {
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

